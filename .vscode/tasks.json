{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build (x64 debug)",
            "type": "process",
            "command": "scons",
            "args": [
                "arch=x64",
                "config=debug",
                "-j8"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "windows": {
                "command": "cmd.exe",
                "args": [
                    "/d",
                    "/s",
                    "/c",
                    "call .\\.vscode\\scripts\\VS2026DevCmd.cmd x64 debug 8"
                ]
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$msCompile",
                "$gcc"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": false,
                "showReuseMessage": false
            }
        },
