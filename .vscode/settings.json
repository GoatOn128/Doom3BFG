{
    "terminal.integrated.profiles.windows": {
        "VS 2026 Developer Command Prompt (x64)": {
            "path": "${env:windir}\\System32\\cmd.exe",
            "args": [
                "/k",
                "call .\\.vscode\\scripts\\VS2026DevCmd.cmd"
            ],
            "icon": "terminal-cmd"
        }
    },
    "terminal.integrated.cwd": "${workspaceFolder}",
    "terminal.integrated.defaultProfile.windows": "VS 2026 Developer Command Prompt (x64)",
    "terminal.integrated.scrollback": 10000,
    "terminal.integrated.enablePersistentSessions": true,
    "C_Cpp.default.cStandard": "c11",
    "C_Cpp.default.cppStandard": "c++17",
    "C_Cpp.errorSquiggles": "enabled",
    "C_Cpp.intelliSenseEngine": "default",
    "editor.formatOnSave": false,
    "[c]": {
        "editor.defaultFormatter": "zachflower.uncrustify"
    },
    "[cpp]": {
        "editor.defaultFormatter": "zachflower.uncrustify"
    },
    "uncrustify.configPath.windows": "${workspaceFolder}/uncrustify.cfg",
    "uncrustify.configPath.linux": "${workspaceFolder}/uncrustify.cfg"
}
