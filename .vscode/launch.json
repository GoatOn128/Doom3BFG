{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "WolfSP (Windows, x64, debug)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/bin/WolfSP_x64.exe",
            "cwd": "${workspaceFolder}/bin",
            "preLaunchTask": "Build (x64 debug)",
            "args": [
                "+set",
                "r_fullscreen",
                "0",
                "+set",
                "win_viewlog",
                "1",
                "+set",
                "sv_cheats",
                "1",
                "+set",
                "developer",
                "1"
            ],
            "terminal": "integrated",
            "stopOnEntry": false,
            "sourceLanguages": [
                "c",
                "cpp"
            ],
            "initCommands": [
                "settings set target.max-children-count 256",
                "settings set target.max-string-summary-length 2048",
                "settings set target.x86-disassembly-flavor intel"
            ],
            "env": {
                "PATH": "C:\\Program Files\\LLVM\\bin;${env:PATH}"
            }
        },
