{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Doom3BFG (x64 debug)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/bin/Doom3BFG.exe",
            "args": [
                "+set",
                "r_fullscreen",
                "0"
            ],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "Build (x64 debug)",
            "initCommands": [
                "settings set target.max-children-count 256",
                "settings set target.max-string-summary-length 2048"
            ]
        },
