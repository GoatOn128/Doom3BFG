renderProg shadow_moments {
	hlsl_vp {

struct VS_IN {
	float4 position : POSITION;
};

struct VS_OUT {
	float4 position : POSITION;
};

void main( VS_IN vertex, out VS_OUT result ) {
	result.position.x = dot4( vertex.position, rpMVPmatrixX );
	result.position.y = dot4( vertex.position, rpMVPmatrixY );
	result.position.z = dot4( vertex.position, rpMVPmatrixZ );
	result.position.w = dot4( vertex.position, rpMVPmatrixW );
}
	}
	hlsl_fp {

struct PS_IN {
	float4 position : VPOS;
};

struct PS_OUT {
	float4 color : COLOR;
};

void main( PS_IN fragment, out PS_OUT result ) {
	// the window depth of the caster fragment becomes the first two
	// moments, the blur pass spreads them over the tile so the
	// receivers can run a Chebyshev occlusion test
	float depth = fragment.position.z;
	result.color = float4( depth, depth * depth, 1.0, 1.0 );
}
	}
}
