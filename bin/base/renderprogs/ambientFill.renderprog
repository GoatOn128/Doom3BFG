renderProg ambientFill {
	hlsl_vp {

struct VS_IN {
	float4 position : POSITION;
	float2 texcoord : TEXCOORD0;
};

struct VS_OUT {
	float4 position : POSITION;
	float2 texcoord0 : TEXCOORD0;
};

void main( VS_IN vertex, out VS_OUT result ) {
	result.position.x = dot4( vertex.position, rpMVPmatrixX );
	result.position.y = dot4( vertex.position, rpMVPmatrixY );
	result.position.z = dot4( vertex.position, rpMVPmatrixZ );
	result.position.w = dot4( vertex.position, rpMVPmatrixW );

	// the fill uses the diffuse texture directly, no texture matrix
	result.texcoord0.xy = vertex.texcoord.xy;
}
	}
	hlsl_fp {

uniform sampler2D samp0 : register(s0);
// the baked ambient fill color of the model
uniform float4 rpUser0 : register(c128);

struct PS_IN {
	float4 position : VPOS;
	float2 texcoord0 : TEXCOORD0_centroid;
};

struct PS_OUT {
	float4 color : COLOR;
};

void main( PS_IN fragment, out PS_OUT result ) {
	float4 diffuse = tex2D( samp0, fragment.texcoord0 );

	// the fill is added on top of the light contributions, the alpha
	// stays zero so the destination alpha does not change
	result.color = float4( diffuse.rgb * rpUser0.rgb, 0.0 );
}
	}
}
