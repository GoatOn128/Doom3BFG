renderProg shadow_moments_blur {
	hlsl_vp {

struct VS_IN {
	float4 position : POSITION;
	float2 texcoord : TEXCOORD0;
	float4 normal : NORMAL;
	float4 tangent : TANGENT;
	float4 color : COLOR0;
};

struct VS_OUT {
	float4 position : POSITION;
	float2 texcoord0 : TEXCOORD0;
};

void main( VS_IN vertex, out VS_OUT result ) {
	// the blur quad already spans clip space, the viewport and scissor
	// confine it to the atlas tile that is being blurred
	result.position = vertex.position;
	result.texcoord0 = vertex.texcoord;
}
	}
	hlsl_fp {

uniform float4 rpUser0 : register(c128); // xy = tile min atlas uv, zw = tile max atlas uv
uniform float4 rpUser1 : register(c129); // xy = one atlas texel in atlas uv for this pass

uniform sampler2D samp0 : register(s0);

struct PS_IN {
	float4 position : VPOS;
	float2 texcoord0 : TEXCOORD0_centroid;
};

struct PS_OUT {
	float4 color : COLOR;
};

void main( PS_IN fragment, out PS_OUT result ) {
	// map the quad coordinates to the atlas tile, every tap clamps to the
	// tile bounds so the blur never blends neighboring tiles or lights
	float2 uv = lerp( rpUser0.xy, rpUser0.zw, fragment.texcoord0.xy );
	float2 texel = rpUser1.xy;
	float4 moments = float4( 0.0, 0.0, 0.0, 0.0 );
	moments += tex2D( samp0, clamp( uv + texel * -4.0, rpUser0.xy, rpUser0.zw ) ) * 1.0;
	moments += tex2D( samp0, clamp( uv + texel * -3.0, rpUser0.xy, rpUser0.zw ) ) * 4.0;
	moments += tex2D( samp0, clamp( uv + texel * -2.0, rpUser0.xy, rpUser0.zw ) ) * 8.0;
	moments += tex2D( samp0, clamp( uv + texel * -1.0, rpUser0.xy, rpUser0.zw ) ) * 16.0;
	moments += tex2D( samp0, clamp( uv, rpUser0.xy, rpUser0.zw ) ) * 26.0;
	moments += tex2D( samp0, clamp( uv + texel * 1.0, rpUser0.xy, rpUser0.zw ) ) * 16.0;
	moments += tex2D( samp0, clamp( uv + texel * 2.0, rpUser0.xy, rpUser0.zw ) ) * 8.0;
	moments += tex2D( samp0, clamp( uv + texel * 3.0, rpUser0.xy, rpUser0.zw ) ) * 4.0;
	moments += tex2D( samp0, clamp( uv + texel * 4.0, rpUser0.xy, rpUser0.zw ) ) * 1.0;
	result.color = moments * ( 1.0 / 84.0 );
}
	}
}
