# DoomEXE equivalent: Windows GUI application.
import os

Import('env', 'build_objects', 'collect_sources', 'require_sources', 'BIN_DIR', 'DLL_BUILD', 'GUI_LINKFLAGS', 'external_lib', 'idlib_lib', 'game_static_lib', '_track_progress', 'PROJECT_ROOT', 'OBJECT_ROOT')

# premake5.lua: files from the following directories, with explicit exclusions.
doom_dirs = (
    'cm', 'framework', 'renderer', 'sound', 'swf', 'sys', 'tools', 'ui'
)
doom_excludes = [
    'framework/Session.cpp',
    'tools/compilers/roqvq/roq.m',
    'ui/GameWindow.cpp',
    'sys/win32/win_stats.*',
    'sys/win32/win_snd.cpp',
    'sys/win32/win_gamma.cpp',
    'renderer/BoundsTrack.cpp',
]
doom_all_sources = require_sources(
    'DoomEXE', collect_sources(doom_dirs, doom_excludes)
)
# Source paths are relative to neo/. The .rc resource scripts must be
# compiled by the resource compiler into linkable .res objects; the
# raw .rc files must not reach the linker (fatal error LNK1107).
doom_rc_sources = [s for s in doom_all_sources if s.lower().endswith('.rc')]
doom_sources = [s for s in doom_all_sources if not s.lower().endswith('.rc')]

main_env = env.Clone()
main_env.Append(LINKFLAGS=GUI_LINKFLAGS)
main_env.Append(LIBS=[
    'dbghelp', 'gdi32', 'glu32', 'iphlpapi', 'odbc32', 'odbccp32',
    'opengl32', 'user32', 'winmm', 'wsock32',
    'xinput', 'dinput8', 'dsound', 'dxguid',
])

# Compile the .rc resources with the resource compiler (rc.exe, or
# windres for gcc) into the object tree, mirroring build_objects' layout.
doom_resources = []
for s in doom_rc_sources:
    res_target = os.path.join(
        OBJECT_ROOT, 'DoomEXE', s + main_env.get('RESSUFFIX', '.res'))
    doom_resources.extend(main_env.RES(
        res_target, os.path.join(PROJECT_ROOT, s)))
_track_progress(main_env, doom_resources)

# The exe must also carry sys/win32/rc/Doom3BFG.manifest as resource 1
# (RT_MANIFEST): without its Win10/11 supportedOS entry GetVersionEx
# reports 6.2.9200 on modern Windows and the engine refuses to start.
# A tiny generated rc references the manifest; doom.rc itself is not
# modified because its version strings are cp1252-encoded and would be
# re-encoded by tooling.
manifest_rc = os.path.join(OBJECT_ROOT, 'DoomEXE', 'doom_manifest.rc')
os.makedirs(os.path.dirname(manifest_rc), exist_ok=True)
with open(manifest_rc, 'w') as rc_file:
    rc_file.write('1 24 "%s"\n' % os.path.join(
        PROJECT_ROOT, 'sys', 'win32', 'rc', 'Doom3BFG.manifest'))
doom_resources.extend(main_env.RES(
    os.path.join(OBJECT_ROOT, 'DoomEXE', 'doom_manifest' + main_env.get('RESSUFFIX', '.res')),
    manifest_rc))

main_objects = build_objects(main_env, 'DoomEXE', doom_sources)
main_inputs = list(main_objects) + list(doom_resources) + [external_lib, idlib_lib]
if not DLL_BUILD:
    main_inputs.append(game_static_lib)

doom_target_nodes = main_env.Program(
    os.path.join(BIN_DIR, 'Doom3BFG.exe'), main_inputs
)
_track_progress(main_env, doom_target_nodes)
doom_target = doom_target_nodes[0]
Return('doom_target')
