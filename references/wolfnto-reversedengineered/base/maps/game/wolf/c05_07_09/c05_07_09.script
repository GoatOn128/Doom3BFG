/* 
------------------------------
Post Super Soldaten chain door 
------------------------------
*/


void chain_door_tryopen(entity a, entity t)
{
	$chain_door_tryopen_use.hide();
	
	entity door = $chain_door;
	vector ang = '0 7 0';

	if(door.isRotating()) return;
	door.setParmsForTime(0.4, 0.3, 0.0);
	door.rotateOnce(ang);
	
	sys.waitFor(door);
	if(door.isRotating()) return;	
	door.setParmsForTime(0.3, 0.0, 0.2);
	door.rotateOnce(-ang);

	sys.waitFor(door);
	if(door.isRotating()) return;	
	door.setParmsForTime(0.3, 0.2, 0.0);
	door.rotateOnce(ang);

	sys.waitFor(door);
	if(door.isRotating()) return;	
	door.setParmsForTime(0.8, 0.0, 0.7);
	door.rotateOnce(-ang);
	
	sys.wait(0.5);
	$chain_door_tryopen_use.show();

}

/* 
VO moving past windows
*/

void call_tr_vo_passbys ( entity activatedEntity, entity activator )
{
    $vo_mover_outsidewindows.time( 20 );
    $vo_mover_outsidewindows.accelTime( 0 );
    $vo_mover_outsidewindows.decelTime( 0 );
    $vo_mover_outsidewindows.followSpline($vo_spline_outsidewindows, 0, 0);
}

