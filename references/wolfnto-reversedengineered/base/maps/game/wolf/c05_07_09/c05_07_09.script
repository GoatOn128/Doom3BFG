//Occupied sarcophagus falling

void sarcophagus_occupied_falling ( entity activatedEntity, entity activator )
{
	$c09_sarcophagus_occupied.time( 1.2 );
    $c09_sarcophagus_occupied.accelTime( 1.2 );
    $c09_sarcophagus_occupied.decelTime( 0 );
	$c09_sarcophagus_occupied.move( DIR_DOWN, 210 );
	sys.wait(2);
	$c09_target_show_supersoldat1.activate(activatedEntity);
}

