// Scripts related to herr Faust
// Start moving along the spline
void FaustStart( entity activatedEntity, entity activator )
{
	sys.print("FaustStart\r");
	$func_mover_faust.time( 90.0 );
	$func_mover_faust.accelTime( 2 );
	$func_mover_faust.decelTime( 2 );
	$func_mover_faust.followSpline($gp1_spline_faust, 0, 0);
}

void FaustEnter( entity activatedEntity, entity activator )
{
	sys.print("FaustEnter\r");
}

void FaustExit( entity activatedEntity, entity activator )
{
	sys.print("FaustExit\r");
}

void TrainDoorExitOpen1( entity activatedEntity, entity activator )
{
	 $sound_sp_train_door.activate( activator );	
     $gp1_gp7_func_movers_mover_traindoor_1.time( 2.0 );
     $gp1_gp7_func_movers_mover_traindoor_1.accelTime( 1 );
     $gp1_gp7_func_movers_mover_traindoor_1.decelTime( 1 );
     $gp1_gp7_func_movers_mover_traindoor_1.move( DIR_BACK, 50 );
}

