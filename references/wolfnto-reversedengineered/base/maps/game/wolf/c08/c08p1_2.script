//EXECUTION View free look 
void FreeLook( entity activatedEntity, entity activator ) 
{
	$thirdPersonHands_0.setViewAnglesFromCamera();
	$thirdPersonHands_0.attachLimitViewCamera( "camera", 5, 1, 10.0f, 5.0f );
}
//Release PL from FPE 
void FPErelease( entity 	activatedEntity, entity activator ) {
	$gp_func_firstpersonevent_execution.forceEndFirstPersonEvent();
}

