{
     $gp_func_movers_mover_2.time( 20.0 );
     $gp_func_movers_mover_2.accelTime( 2 );
     $gp_func_movers_mover_2.decelTime( 3 );
     $gp_func_movers_mover_2.move( DIR_BACK, 381 );
}

