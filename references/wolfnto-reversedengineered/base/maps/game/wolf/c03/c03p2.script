void TeleportToBridge( entity activatedEntity, entity activator ) {
	sys.print("Temp: Teleport player to bridge part\r");
	$player1.teleport( $cb_info_null_start_bridge_start.getOrigin(), $cb_info_null_start_bridge_start.getAngles() );
}

//start gate 
