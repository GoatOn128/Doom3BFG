//Obsolete
//Awesome Boom script Boom1 
float   b1_orgXRotation = 0.0f;
boolean b1_updateBarrier = true;

void B1_updateBarrier( entity activatedEntity, entity activator )
{
    while (b1_updateBarrier) 
    {
        float percentDone = $gp_prop_useable_continuallyused_1.getUsePercent();
        float angle = -60 * percentDone;
        
        vector v;       
        v = $gp_func_mover_boom1.getAngles();
        
        if (b1_orgXRotation == 0.0f)
        {
            b1_orgXRotation = v_x;
        }
        
        v_x = b1_orgXRotation + angle;
        
        $gp_func_mover_boom1.setAngles(v);
        sys.waitFrame();
    }
}

void B1_setBarrierDone( entity activatedEntity, entity activator )
{
    b1_updateBarrier = false;
}


//Awesome Boom script Boom2
float   b2_orgXRotation = 0.0f;
boolean b2_updateBarrier = true;

void B2_updateBarrier( entity activatedEntity, entity activator )
{
    while (b2_updateBarrier) 
    {
        float percentDone = $gp_prop_useable_continuallyused_3.getUsePercent();
        float angle = 60 * percentDone;
        
        vector v;       
        v = $gp_func_mover_boom2.getAngles();
        
        if (b2_orgXRotation == 0.0f)
        {
            b2_orgXRotation = v_x;
        }
        
        v_x = b2_orgXRotation - angle;
        
        $gp_func_mover_boom2.setAngles(v);
        sys.waitFrame();
    }
}

void B2_setBarrierDone( entity activatedEntity, entity activator )
{
    b2_updateBarrier = false;
}

