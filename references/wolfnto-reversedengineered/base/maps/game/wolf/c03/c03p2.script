float XrayTowerElev02pos = -1000;

void XrayTowerElev02up( entity activatedEntity, entity activator )
{
	float height = Vec_z( $gp_lift_tower_02.getWorldOrigin() );
     $gp_lift_tower_02.time( 16.0 );
     $gp_lift_tower_02.accelTime( 5 );
     $gp_lift_tower_02.decelTime( 5 );
     $gp_lift_tower_02.move( DIR_UP, XrayTowerElev02pos - height );
 	 $sound_sp_shortelev_up_front.activate( $acti );
 	 $sound_sp_shortelev_up_rear.activate( $acti );	
	 
}

void XrayTowerElev02down( entity activatedEntity, entity activator )
{
	float height = Vec_z( $gp_lift_tower_02.getWorldOrigin() );
	if (XrayTowerElev02pos == -1000){
		XrayTowerElev02pos = height;
	}

     $gp_lift_tower_02.time( 16.0 );
     $gp_lift_tower_02.accelTime( 5 );
     $gp_lift_tower_02.decelTime( 5 );
     $gp_lift_tower_02.move( DIR_DOWN, height - ( XrayTowerElev02pos - 616 ) );
 	 $sound_sp_shortelev_down_front.activate( $acti );
 	 $sound_sp_shortelev_down_rear.activate( $acti );
}

