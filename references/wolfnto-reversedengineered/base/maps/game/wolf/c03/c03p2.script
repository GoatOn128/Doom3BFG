float XrayTowerElev01pos = -1000;

void XrayTowerElev01up( entity activatedEntity, entity activator )
{
	if (XrayTowerElev01pos == -1000){
		XrayTowerElev01pos = Vec_z( $gp_func_movers_mover_elev.getWorldOrigin() );
	}
     $gp_func_movers_mover_elev.time( 6.0 );
     $gp_func_movers_mover_elev.accelTime( 2 );
     $gp_func_movers_mover_elev.decelTime( 3 );
     $gp_func_movers_mover_elev.move( DIR_UP, 227 );
	 $sound_sp_techelevator_up_front.activate( $acti );
	 $sound_sp_techelevator_up_rear.activate( $acti );
}

void XrayTowerElev01down( entity activatedEntity, entity activator )
{
	float height = Vec_z( $gp_func_movers_mover_elev.getWorldOrigin() );

     $gp_func_movers_mover_elev.time( 6.0 );
     $gp_func_movers_mover_elev.accelTime( 2 );
     $gp_func_movers_mover_elev.decelTime( 3 );
     $gp_func_movers_mover_elev.move( DIR_DOWN, ( height - XrayTowerElev01pos ) );
	 $sound_sp_techelevator_down_front.activate( $acti );
	 $sound_sp_techelevator_down_rear.activate( $acti );
}

