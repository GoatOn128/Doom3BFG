////////////////////////////////////////////
//Menutriggers
////////////////////////////////////////////

// Skip fixcoffee event 
void call_skip_fixcoffee ( entity activatedEntity, entity activator )
{
	$gp_changestate_skip_coffee.activate(activator);
	
	$gp_firstpersonevent_fix_coffee.forceEndFirstPersonEvent();
}

//Lightthingy
void fadebubi ( entity activatedEntity, entity activator )
{
	$lightref_lightmap_light_point_65.fadeOutLight( 1.0 );
	$lightref_lightmap_light_point_67.fadeOutLight( 1.0 );

	$lightref_lightmap_light_point_65.fadeInLight( 10.0 );
	$lightref_lightmap_light_point_67.fadeInLight( 10.0 );

}