//View free look 
void FreeLook( entity activatedEntity, entity activator ) {
	$thirdPersonHands_0.setViewAnglesFromCamera();
	$thirdPersonHands_0.attachLimitViewCameraMinMax( "camera", 1, '40 50 0', '40 50 0', 0.0 );
}

//View free look tight 
void FreeLookTight( entity activatedEntity, entity activator ) {
	$thirdPersonHands_0.setViewAnglesFromCamera();
	$thirdPersonHands_0.attachLimitViewCameraMinMax( "camera", 1, '1.01 1.01 0', '1.01 1.01 0', 150.0 );
}


//View free look medium 
void FreeLookMedium( entity activatedEntity, entity activator ) {
	$thirdPersonHands_0.setViewAnglesFromCamera();
	$thirdPersonHands_0.attachLimitViewCameraMinMax( "camera", 1, '15 15 0', '15 15 0', 0.0 );
}


//View free look object 
void FreeLookOff( entity activatedEntity, entity activator ) {
	$thirdPersonHands_0.setViewAnglesFromCamera();
	$thirdPersonHands_0.attachLimitViewCameraMinMax( "camera", 1, '0.01 0.01 0', '0.01 0.01 0', 150.0 );
}

void lighttest( entity activatedEntity, entity activator )
{
     $lightref_misc_godrays_1.time( 4.0 );
     $lightref_misc_godrays_1.accelTime( 1 );
     $lightref_misc_godrays_1.decelTime( 1 );
     $lightref_misc_godrays_1.move( DIR_LEFT, -2000 );
}


////////////////////////////////////////////
//First Part 
////////////////////////////////////////////


// First down 
void WorldSmall01down( entity activatedEntity, entity activator )
{
     $gp_func_mover_1.time( 1.0 );
     $gp_func_mover_1.move( DIR_DOWN, 1000 );
}

// First to last spot  
void WorldSmall01back( entity activatedEntity, entity activator )
{
     $gp_func_mover_1.time( 1.0 );
     $gp_func_mover_1.move( DIR_FORWARD, 24576 );
}

// First up to launch 
void WorldSmall01up( entity activatedEntity, entity activator )
{
     $gp_func_mover_1.time( 1.0 );
     $gp_func_mover_1.move( DIR_UP, 1000 );
}

// First part launches
void WorldSmall01launch( entity activatedEntity, entity activator )
{
     $gp_func_mover_1.time( 9.0 );
     $gp_func_mover_1.move( DIR_BACK, 24576 );
}


