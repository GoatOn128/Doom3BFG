     $gp_func_mover_door_exit_1.decelTime( 1 );
     $gp_func_mover_door_exit_1.move( DIR_LEFT, 62 );
}


void Door1close( entity activatedEntity, entity activator )
{
     $gp_func_mover_door_1.time( 1.0 );
     $gp_func_mover_door_1.accelTime( 1 );
     $gp_func_mover_door_1.decelTime( 1 );
     $gp_func_mover_door_1.move( DIR_RIGHT, 64 );
     $sound_sp_door_close.activate( activator );
}

