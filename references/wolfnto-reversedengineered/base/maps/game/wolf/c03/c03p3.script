void Door1open( entity activatedEntity, entity activator )
{
     $gp_func_mover_door_1.time( 1.0 );
     $gp_func_mover_door_1.accelTime( 1 );
     $gp_func_mover_door_1.decelTime( 1 );
     $gp_func_mover_door_1.move( DIR_LEFT, 64 );
     $sound_sp_door_open.activate( activator );

}

void Door2open( entity activatedEntity, entity activator )
{
     $gp_func_mover_door_2.time( 1.0 );
     $gp_func_mover_door_2.accelTime( 1 );
     $gp_func_mover_door_2.decelTime( 1 );
     $gp_func_mover_door_2.move( DIR_RIGHT, 64 );
}

void DoorExitOpen( entity activatedEntity, entity activator )
