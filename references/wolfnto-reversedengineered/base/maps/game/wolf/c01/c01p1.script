void call_enemyplane_down( entity activatedEntity, entity activator ) {
	
	// Track active planes
	globalActive--;
	sys.print( "Enemy plane down (" + globalActive + " plane(s) left)\n" );
	
	if ( activatedEntity.numTargets() <= 0 ) {
		return;
	}
	
	entity track = activatedEntity.getTarget( 0 );
	if ( track != $null ) {
		
		// Make sure we know it's the 'trackSpawn' entity
		if ( track.numTargets() != 13 ) {
			return;
		}
		
		// Remove everything from master list except the tracking objects
		int i;
		for ( i = 0; i < 11; i++ ) {
			$target_remove_plane_all.removeTarget( track.getTarget( i ) );
		}
		
		// Clear targets
		track.clearTargets();
	}
	
	// Clear targets
	activatedEntity.clearTargets();
}

void call_try_spawn_plane( entity activatedEntity, entity activator ) {

	if ( globalActive < 3 ) {
		globalActive++;
		sys.print( "Spawning enemy plane (" + globalActive + " plane(s) active)\n" );

		$target_relay_spawn_enemyplane.activate( activator );
	}
}

