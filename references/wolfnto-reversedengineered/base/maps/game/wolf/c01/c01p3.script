    $gp_func_mover_weights.accelTime( 2 );
    $gp_func_mover_weights.decelTime( 1 );
	$gp_func_mover_weights.move( DIR_DOWN, 240 );
	
	$func_mover_chain_front01a.time( 5 );
    $func_mover_chain_front01a.accelTime( 2 );
    $func_mover_chain_front01a.decelTime( 1 );
	$func_mover_chain_front01a.move( DIR_DOWN, 240 );
	
