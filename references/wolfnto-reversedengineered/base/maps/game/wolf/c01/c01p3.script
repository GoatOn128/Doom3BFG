void moveturretwagon ( entity activatedEntity, entity activator )
{
    sys.print("The wagon should move now.\n");
	$c01p3_gp__func_mover_turretwagon.time( 43 );
    $c01p3_gp__func_mover_turretwagon.accelTime( 1 );
    $c01p3_gp__func_mover_turretwagon.decelTime( 3 );
	$c01p3_gp__func_mover_turretwagon.followSpline($c01p3_gp__spline_path_turretwagon, 0, 0);
}

