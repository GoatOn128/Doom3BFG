//Part of making Fergus move when Supersoldaten gets close. Called from relay activated by volume.
void check_supersoldaten_fergus (entity activatedEntity, entity activator)
{
	//Filter out Fergus & Wyatt so that only Supersoldaten movement count.
	if (activator.getName() == "c01p3_gp__ai_tungsten_supersoldaten")
	{
		sys.print("Supersoldaten entered a volume.\n");
		//Identify the volume entered
		if (activatedEntity.getName() == "c01p3_gp__target_relay_supersoldatroom_1")
		{
			//If Fergus is in the identified volume Supersoldaten entered, move him.
			if ($c01p3_gp__volume_enter_exit_ai_supersoldatroom_1.isEntityTouchingVolume($c01p3_gp__ai_tungsten_c01_part_03_fergus_supersoldaten_1))
			{
				sys.print("Both Fergus and Supersoldaten in volume c01p3_gp__target_relay_supersoldatroom_1\n");
				$c01p3_gp__target_relay_random_supersoldatfight_changeposition_fergus_1.activate($activator);
				$c01p3_gp__target_relay_random_supersoldaten_closetofergus_vo.activate($activator);
			}
			//If Wyatt is in the identified volume Supersoldaten entered, move him.
			if ($c01p3_gp__volume_enter_exit_ai_supersoldatroom_1.isEntityTouchingVolume($c01p3_gp__ai_tungsten_c01_part_03_wyatt_supersoldaten_1))
			{
				sys.print("Both Wyatt and Supersoldaten in volume c01p3_gp__target_relay_supersoldatroom_1\n");
				$c01p3_gp__target_relay_random_supersoldatfight_changeposition_wyatt_1.activate($activator);
				$c01p3_gp__target_relay_random_supersoldaten_closetowyatt_vo.activate($activator);
			}
		}
		if (activatedEntity.getName() == "c01p3_gp__target_relay_supersoldatroom_2")
		{
			if ($c01p3_gp__volume_enter_exit_ai_supersoldatroom_2.isEntityTouchingVolume($c01p3_gp__ai_tungsten_c01_part_03_fergus_supersoldaten_1))
			{
				sys.print("Both Fergus and Supersoldaten in volume c01p3_gp__target_relay_supersoldatroom_2\n");
				$c01p3_gp__target_relay_random_supersoldatfight_changeposition_fergus_2.activate($activator);
				$c01p3_gp__target_relay_random_supersoldaten_closetofergus_vo.activate($activator);
			}
			if ($c01p3_gp__volume_enter_exit_ai_supersoldatroom_2.isEntityTouchingVolume($c01p3_gp__ai_tungsten_c01_part_03_wyatt_supersoldaten_1))
			{
				sys.print("Both Wyatt and Supersoldaten in volume c01p3_gp__target_relay_supersoldatroom_2\n");
				$c01p3_gp__target_relay_random_supersoldatfight_changeposition_wyatt_2.activate($activator);
				$c01p3_gp__target_relay_random_supersoldaten_closetowyatt_vo.activate($activator);
			}
		}
		if (activatedEntity.getName() == "c01p3_gp__target_relay_supersoldatroom_3")
		{
			if ($c01p3_gp__volume_enter_exit_ai_supersoldatroom_3.isEntityTouchingVolume($c01p3_gp__ai_tungsten_c01_part_03_fergus_supersoldaten_1))
			{
				sys.print("Both Fergus and Supersoldaten in volume c01p3_gp__target_relay_supersoldatroom_3\n");
				$c01p3_gp__target_relay_random_supersoldatfight_changeposition_fergus_3.activate($activator);
				$c01p3_gp__target_relay_random_supersoldaten_closetofergus_vo.activate($activator);
			}
			if ($c01p3_gp__volume_enter_exit_ai_supersoldatroom_3.isEntityTouchingVolume($c01p3_gp__ai_tungsten_c01_part_03_wyatt_supersoldaten_1))
			{
				sys.print("Both Wyatt and Supersoldaten in volume c01p3_gp__target_relay_supersoldatroom_3\n");
				$c01p3_gp__target_relay_random_supersoldatfight_changeposition_wyatt_3.activate($activator);
				$c01p3_gp__target_relay_random_supersoldaten_closetowyatt_vo.activate($activator);
			}
		}
		if (activatedEntity.getName() == "c01p3_gp__target_relay_supersoldatroom_4")
		{
			if ($c01p3_gp__volume_enter_exit_ai_supersoldatroom_4.isEntityTouchingVolume($c01p3_gp__ai_tungsten_c01_part_03_fergus_supersoldaten_1))
			{
				sys.print("Both Fergus and Supersoldaten in volume c01p3_gp__target_relay_supersoldatroom_4\n");
				$c01p3_gp__target_relay_random_supersoldatfight_changeposition_fergus_4.activate($activator);
				$c01p3_gp__target_relay_random_supersoldaten_closetofergus_vo.activate($activator);
			}
			if ($c01p3_gp__volume_enter_exit_ai_supersoldatroom_4.isEntityTouchingVolume($c01p3_gp__ai_tungsten_c01_part_03_wyatt_supersoldaten_1))
			{
				sys.print("Both Wyatt and Supersoldaten in volume c01p3_gp__target_relay_supersoldatroom_4\n");
				$c01p3_gp__target_relay_random_supersoldatfight_changeposition_wyatt_4.activate($activator);
				$c01p3_gp__target_relay_random_supersoldaten_closetowyatt_vo.activate($activator);
			}
		}
		if (activatedEntity.getName() == "c01p3_gp__target_relay_supersoldatroom_5")
		{
			if ($c01p3_gp__volume_enter_exit_ai_supersoldatroom_5.isEntityTouchingVolume($c01p3_gp__ai_tungsten_c01_part_03_fergus_supersoldaten_1))
			{
				sys.print("Both Fergus and Supersoldaten in volume c01p3_gp__target_relay_supersoldatroom_5\n");
				$c01p3_gp__target_relay_random_supersoldatfight_changeposition_fergus_5.activate($activator);
				$c01p3_gp__target_relay_random_supersoldaten_closetofergus_vo.activate($activator);
			}
			if ($c01p3_gp__volume_enter_exit_ai_supersoldatroom_5.isEntityTouchingVolume($c01p3_gp__ai_tungsten_c01_part_03_wyatt_supersoldaten_1))
			{
				sys.print("Both Wyatt and Supersoldaten in volume c01p3_gp__target_relay_supersoldatroom_5\n");
				$c01p3_gp__target_relay_random_supersoldatfight_changeposition_wyatt_5.activate($activator);
				$c01p3_gp__target_relay_random_supersoldaten_closetowyatt_vo.activate($activator);
			}
		}
		if (activatedEntity.getName() == "c01p3_gp__target_relay_supersoldatroom_6")
		{
			if ($c01p3_gp__volume_enter_exit_ai_supersoldatroom_6.isEntityTouchingVolume($c01p3_gp__ai_tungsten_c01_part_03_fergus_supersoldaten_1))
			{
				sys.print("Both Fergus and Supersoldaten in volume c01p3_gp__target_relay_supersoldatroom_6\n");
				$c01p3_gp__target_relay_random_supersoldatfight_changeposition_fergus_6.activate($activator);
				$c01p3_gp__target_relay_random_supersoldaten_closetofergus_vo.activate($activator);
			}
			if ($c01p3_gp__volume_enter_exit_ai_supersoldatroom_6.isEntityTouchingVolume($c01p3_gp__ai_tungsten_c01_part_03_wyatt_supersoldaten_1))
			{
				sys.print("Both Wyatt and Supersoldaten in volume c01p3_gp__target_relay_supersoldatroom_6\n");
				$c01p3_gp__target_relay_random_supersoldatfight_changeposition_wyatt_6.activate($activator);
				$c01p3_gp__target_relay_random_supersoldaten_closetowyatt_vo.activate($activator);
			}
		}
	}
}


/*
The following part controls the Supersoldaten boss.
Originally scripted by Olle.
*/

object ripOffMaskObject {
	int explodeCount;
	entity scriptObj;
	void init();
	void onTrigger( entity activator );
	
};

void ripOffMaskObject::init() {
	explodeCount = 0;
}

void ripOffMaskObject::onTrigger( entity activator ) {
	explodeCount++;
	
	if ( explodeCount == 2 ) {
		// Call the animevent, and then remove ourselves
		scriptObj.activate( activator );
		entity super = self.getTarget( 0 );
		super.decreaseHealth( 125 );
	}
}


object explodeObject {
	entity ripOffMaskObj;
	void onExplode( entity attacker );
};

void explodeObject::onExplode( entity attacker ) {
	ripOffMaskObj.activate( attacker );
	$ai_tungsten_c01_part_03_supersoldaten_test_1.removeAttachment( self );
	self.disablePhysics();
	$c01p3_gp__target_relay_faceexposed.activate($activator);
}


/*
Debug stuff
*/

void print_trigger ( entity activatedEntity, entity activator )
{
	sys.print("Activated trigger:" + activatedEntity.getName() + "\n" );
	$c01p3_gp__func_mover_incineratordoor.time( 0.7 );
    $c01p3_gp__func_mover_incineratordoor.accelTime( 0.2 );
    $c01p3_gp__func_mover_incineratordoor.decelTime( 0.4 );
	$c01p3_gp__func_mover_incineratordoor.move( DIR_DOWN, 110 );
	sys.wait(0.8);
	$c01p3_gp__func_mover_incineratordoor.time( 0.6 );
    $c01p3_gp__func_mover_incineratordoor.accelTime( 0.2 );
    $c01p3_gp__func_mover_incineratordoor.decelTime( 0.2 );
	$c01p3_gp__func_mover_incineratordoor.move( DIR_UP, 110 );
}

/*
Falling rocks from the planecrash
*/

void call_fallingstones( entity activatedEntity, entity activator ) 
{

	
	sys.wait( 1.0f );
	
	//FallingStone_1
	$wc_mover_fallingstone_1.time( 3.5f );
	$wc_mover_fallingstone_1.decelTime( 0.1f );
	$wc_mover_fallingstone_1.followSpline( $wc_fallingstone_spline_1, 0, false ); 

	//FallingStone_2
	$wc_mover_fallingstone_2.time( 4.1f );
	$wc_mover_fallingstone_2.decelTime( 0.1f );
	$wc_mover_fallingstone_2.followSpline( $wc_fallingstone_spline_2, 0, false ); 

}

/*
Scripted AI Handgrenades
*/

void call_handgrenade_1( entity activatedEntity, entity activator ) 
{
	
	//Hand Grenade 1
	$mover_handgrenade_1.time( 1.9f );
	$mover_handgrenade_1.decelTime( 1.8f );
	$mover_handgrenade_1.followSpline( $spline_grenade_1, 0, false ); 


}

void call_removesolid( entity activatedEntity, entity activator )
{
	$anim_takedown_dummy.setContents( 0 );
}

void call_touch_test ( entity activatedEntity, entity activator )
{
	$death_func_movers_mover_torch.time( 1 );
    $death_func_movers_mover_torch.accelTime( 0 );
    $death_func_movers_mover_torch.decelTime( 0.5 );
	$death_func_movers_mover_torch.followSpline($death_spline_path_with_orientation_torch, 0, 0);
}

void call_painting_test ( entity activatedEntity, entity activator )
{
	$death_func_mover_painting_test.time( 0.5 );
    $death_func_mover_painting_test.accelTime( 0 );
    $death_func_mover_painting_test.decelTime( 0 );
	$death_func_mover_painting_test.move( DIR_DOWN, 82 );
	sys.wait(0.3);
	$death_func_mover_painting_test.time( 0.7 );
    $death_func_mover_painting_test.accelTime( 0.5 );
    $death_func_mover_painting_test.decelTime( 0 );
	$death_func_mover_painting_test.rotateOnce( '0 0 -145' );
}


void startAiming_benson( entity activatedEntity, entity activator )
{
	sys.print("Starting to aim - B");
    $wc_func_animatedsimple_character_benson.setFocus( activatedEntity, true, true, AIMPOINT_CENTER );
}

void stopAiming_benson( entity activatedEntity, entity activator )
{
	sys.print("Stopping aim - B");
	entity emptyEnt;
    $wc_func_animatedsimple_character_benson.setFocus( emptyEnt, true, true, AIMPOINT_CENTER );
}

