// These are called if the wood planks are shot while an AI is on them. if so, the AI will die
// but also take the entire section of wood down with him.
void destroy_alla_plankor_one ( entity activatedEntity, entity activator ) {
	$worlddestructible_c01_environment_woodplanks_break_01_1.breakAll();
	$worlddestructible_c01_environment_woodplanks_break_02_1.breakAll();
	$worlddestructible_c01_environment_woodplanks_break_03_1.breakAll();

}

