// Script for moving some explosions and sound to surround the player
// killing him nice and easy. If there was a way to call GetForwardDir() in this
// crummy script system I wouldn't have to do four explosions
void PlayerMineEffect( entity activatedEntity, entity activator ) {
	sys.print("Aouw! Stepped on a mine did we?\r");
	$gp_mine_fx_null.teleport( $player1.getOrigin(), $player1.getAngles() );
}

// open bunker door ( should be opened already when one gets there, so it opens superduper fast)
// But we do not position itself in open state from the beginning, so we have control of it's position 
// after closing it.
void script_bunkerdoor_open( entity activatedEntity, entity activator ) {
	
	sys.print( "Opening bunker door.");

	$gp_bunkerdoor_joint.time( 0.1 );
	$gp_bunkerdoor_joint.rotateOnce( ' 0 83 0' );			
}

// open bunker door
void script_bunkerdoor_close( entity activatedEntity, entity activator ) {

	sys.print( "Closing bunker door.");
	$gp_bunkerdoor_joint.time( 5.0 );
	$gp_bunkerdoor_joint.accelTime( 1.0 );
	$gp_bunkerdoor_joint.decelTime( 1.0 );
	$gp_bunkerdoor_joint.rotateOnce( ' 0 -83 0' );				
}

void call_surfacefire( entity activatedEntity, entity activator )
{
	$pos_watertrails.teleport( $player1.getOrigin(), $player1.getAngles() );
}

//Push the ammo traversal
void ammo_push ( entity activatedEntity, entity activator )
{
	$gp_func_mover_ammo.time( 10 );
    $gp_func_mover_ammo.accelTime( 1 );
    $gp_func_mover_ammo.decelTime( 6 );
	$gp_func_mover_ammo.move( DIR_RIGHT, 1100 );
}

//The elevator goes up
void elevator_up ( entity activatedEntity, entity activator )
{
	$gp_func_mover_elevator.time( 45 );
    $gp_func_mover_elevator.accelTime( 0 );
    $gp_func_mover_elevator.decelTime( 4 );
	$gp_func_mover_elevator.move( DIR_UP, 955 );
}

void call_elevator_up_checkpoint ( entity activatedEntity, entity activator )
