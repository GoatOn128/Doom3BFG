/*================================================================================
FLOATING BLOATED BODIES, WE SHOULD MAKE THEM MORE BLOATED!! 	
================================================================================*/

object floatingBodies
{
	float bobSpeed;
	float bobVectorX;
	float bobVectorY;
	float bobVectorZ;
	float bobPhase;
	
	void init();
};

void floatingBodies::init()
{
	vector movement = '1 1 1';
	movement_x+= bobVectorX;
	movement_y+= bobVectorY;		
	movement_z+= bobVectorZ;
	
	self.bob( bobSpeed, bobPhase, movement); 
}

/*================================================================================
Bunker cannons, set angles.
================================================================================*/
void call_switch_artillery_lower( entity activatedEntity, entity activator )
{
	sys.print("Setting joints");
//	$func_animatedsimple_character_1.unbind();
	$gp_func_animatedsimple_generic_artillery_lower.pauseAnim( true, -1, false );
    vector yawAngle = $gp_func_animatedsimple_generic_artillery_lower.getJointAngle( 1 );
	vector pitchAngle = $gp_func_animatedsimple_generic_artillery_lower.getJointAngle( 2 );
	vector startAngles;
	startAngles_y = yawAngle_y + 90.87;
	startAngles_x = pitchAngle_x;
	sys.print("Val: " + startAngles_x + " " + startAngles_y + "\n" );
	$gp_prop_useable_turret_artillery_lower.setStartAngles( startAngles );
	$gp_prop_useable_turret_artillery_lower.show();
	sys.waitFrame();
	sys.waitFrame();
	$gp_func_animatedsimple_generic_artillery_lower.hide();
}

void call_switch_artillery_upper( entity activatedEntity, entity activator )
{
	sys.print("Setting joints");
//	$func_animatedsimple_character_1.unbind();
	$gp_func_animatedsimple_generic_artillery_upper.pauseAnim( true, -1, false );
    vector yawAngle = $gp_func_animatedsimple_generic_artillery_upper.getJointAngle( 1 );
	vector pitchAngle = $gp_func_animatedsimple_generic_artillery_upper.getJointAngle( 2 );
	vector startAngles;
	startAngles_y = yawAngle_y + 134.5;
	startAngles_x = pitchAngle_x;
	sys.print("Val: " + startAngles_x + " " + startAngles_y + "\n" );
	$gp_prop_useable_turret_artillery_upper.setStartAngles( startAngles );
	$gp_prop_useable_turret_artillery_upper.show();
	sys.waitFrame();
	sys.waitFrame();
	$gp_func_animatedsimple_generic_artillery_upper.hide();
}

