//Allow player to exit the plane turret manually
void call_enable_exit_turret ( entity activatedEntity, entity activator )
{
	sys.print("Allowing player to exit plane turret");
	$gp_prop_useable_turret_brokencockpit_checkpoint.enableManualExit( true );
	$gp_prop_useable_turret_brokencockpit.enableManualExit( true );
}


//Running the AA explosions going off in the air
//Random time between explosions, particles selected randomly
void aa_explosions (entity activatedEntity, entity activator)
{
	int i = 1;
	while (i > 0)
	{
		int iWaitingseconds = sys.randomInt(8);
		int iParticleeffectid = sys.randomInt(10);
		string sEffectname = "fx_func_emitter_" + iParticleeffectid;
		sys.getEntity(sEffectname).activate(activator);
		sys.wait(iWaitingseconds);				
	}
}

