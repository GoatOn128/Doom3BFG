// Wall crush movers to stop player from clipping through NPCs
object wallCrushMover {
	float distance;
	float duration;
	int direction; // -5 = fwd, -4 = right, -3 = left, -6 = bwd
	
	void onTrigger( entity activator );
};

void wallCrushMover::onTrigger( entity activator ) {
	self.time( duration );
	self.accelTime( 0.2 );
    self.decelTime( 0.2 );
    self.move( direction, distance );
}


// Pushes player aside
object playerPusher {
	
	float pushSpeed;
	float pushRadius;
	float pushDuration;
	
	__noedit boolean pushing; 
	__noedit vector prevPos;
	
	void init();
	void startPushing();
	void stopPushing();
	
	void pushPlayer();
};


void playerPusher::init(){
	pushing = false;
}

void playerPusher::startPushing(){
	if ( !pushing ) {
		prevPos = self.getWorldOrigin();
		pushing = true;
		thread pushPlayer();
	}
}

void playerPusher::stopPushing(){
	pushing = false;	
	
}

void playerPusher::pushPlayer() {
	while ( pushing ) {
		vector moveDir = self.getWorldOrigin() - prevPos;
		prevPos = self.getWorldOrigin();
		
		// Push away/aside player when close enough
		if ( self.distanceTo( $player1 ) < pushRadius ) {
			if ( ( moveDir_x == 0.0f ) && ( moveDir_y == 0.0f ) ) {
				// Stationary, push away player
				$player1.push( $player1.getWorldOrigin() - self.getWorldOrigin(), 1.0f, 0.1f );
			} else {
				// Moving, push aside player	
				vector side = sys.vecCrossProduct( moveDir, Vec(0,0,1) );
				if ( sys.vecDotProduct( side, $player1.getWorldOrigin() - self.getWorldOrigin() ) < 0.0f ) {
					side = -side;
				}			
				$player1.push( side, pushSpeed, pushDuration );
			}
		}
		sys.waitFrame();
	}
}


void call_startpushing_wyatt( entity activatedEntity, entity activator ) {
	$gp_ai_tungsten_c01_part_03_wyatt_supersoldaten.callFunction( "startPushing" );
} 

void call_stoppushing_wyatt( entity activatedEntity, entity activator ) {
	$gp_ai_tungsten_c01_part_03_wyatt_supersoldaten.callFunction( "stopPushing" );
} 

void call_startpushing_blondie( entity activatedEntity, entity activator ) {
