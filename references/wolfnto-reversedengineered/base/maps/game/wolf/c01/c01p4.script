	$player1.equipBestWeapon();
}


/*
Debug stuff
*/

void print_trigger ( entity activatedEntity, entity activator )
{
	sys.print("Activated trigger:" + activatedEntity.getName() + "\n" );
	$c01p3_gp__func_mover_incineratordoor.time( 0.7 );
    $c01p3_gp__func_mover_incineratordoor.accelTime( 0.2 );
    $c01p3_gp__func_mover_incineratordoor.decelTime( 0.4 );
	$c01p3_gp__func_mover_incineratordoor.move( DIR_DOWN, 110 );
	sys.wait(0.8);
	$c01p3_gp__func_mover_incineratordoor.time( 0.6 );
    $c01p3_gp__func_mover_incineratordoor.accelTime( 0.2 );
    $c01p3_gp__func_mover_incineratordoor.decelTime( 0.2 );
	$c01p3_gp__func_mover_incineratordoor.move( DIR_UP, 110 );
}