} 





/*
The following part controls the Supersoldaten boss.
*/

#define ANIM_TUBE_LEFT 0
#define ANIM_TUBE_RIGHT 1
#define ANIM_MASK_VIA_TUBE_LEFT 0
#define ANIM_MASK_VIA_TUBE_RIGHT 1

list superSoldatTubes;
boolean hideSuperSoldatTubes = true;

object ripOffMaskObject {
	int explodeCount;
	void init();
	void onTrigger( entity activator );
	void onExplosionTubeLeft();	
	void onExplosionTubeRight();
};

void ripOffMaskObject::init() {
	explodeCount = 0;
}

void ripOffMaskObject::onTrigger( entity activator ) {
	explodeCount++;
	
	if ( explodeCount == 2 ) {
		// Call the animevent, and then remove ourselves
		entity super = self.getTarget( 0 );
		
		if ( super.isDead() ) {
			return;
		}
		
		//Only attack the player
		super.addAggression( $player1, 100, -1 );
		
		// Go berserk!
		super.setCloseMeleeInterval(0, 0);
		super.setMediumMeleeInterval(0, 0);
		super.setLongMeleeInterval(0, 0);
		super.enableTaunts( false );
		
		$sound_sp_px_breathing_fast.stopSound( SND_CHANNEL_ANY, 0 );
		$sound_tr_sound_sp_supersoldat_pain.activate($activator);
		
		// Disable most of wyatts/fergus' scenepoints so there's a greater chance they stand close to their post bossfight event positions
		$friendlysps_info_scenepoint_disablescenepoints_postmaskremoved.activate( self ); 		
		
		// Start backup expose face sequence ( normal sequence is started by anim event)
		super.callFunction( "backupExposeFace" );
	} else if ( explodeCount == 1 ) {
		// Reset health on remaining tube so it's harder to destroy than first one.
		int i;	
		for ( i = 0; i < superSoldatTubes.size(); i++ ) {
			if ( superSoldatTubes.get( i ).getHealth() > 0.0f ) {
				superSoldatTubes.get( i ).resetHealth();
			}
		}	
	}
}

void ripOffMaskObject::onExplosionTubeLeft() {
	if ( self.getTarget( 0 ).isDead() ) {
		return;
	}

	if ( explodeCount > 0 ) {
		//sys.print( "MASK VIA TUBE LEFT\n");
		$gp_target_anim_changestate_ripmask_left.activate( $activator );
	} else {
		//sys.print( "TUBE LEFT\n");
		$gp_ai_scriptedanimweb_px46_explodetubes.setScriptedAnimWebState( ANIM_TUBE_LEFT );	
	}
}

void ripOffMaskObject::onExplosionTubeRight() {
	if ( self.getTarget( 0 ).isDead() ) {
		return;
	}

	if ( explodeCount > 0 ) {
		//sys.print( "MASK VIA TUBE RIGHT\n");
		$gp_target_anim_changestate_ripmask_right.activate( $activator );
	} else {
		//sys.print( "TUBE RIGHT\n");
		$gp_ai_scriptedanimweb_px46_explodetubes.setScriptedAnimWebState( ANIM_TUBE_RIGHT );
	}	
}

object explodeObject {
	entity ripOffMaskObj;
	boolean isLeftTube;
	boolean canUpdateEffects; 
	float breathingEffectsInterval;
	
	void init();
	void startEffects();
	void stopEffects();
	void updateEffects();
	void onExplode( entity attacker );
};

void explodeObject::init() {
	
	// Register self for use by supersoldat
	superSoldatTubes.append( self );
	self.setHighlight( HIGHLIGHT_COLOR_EXPLODE );	
	self.setTakesDamage( false );
	
	// The tubes are hidden but visuals have not been updated properly for some reason, show and hide again for now
	sys.wait( 1.0 );
	if ( hideSuperSoldatTubes ) {
		self.show();
		self.hide();
	}
}

void explodeObject::startEffects() {
	canUpdateEffects = true;
	thread updateEffects();
}

void explodeObject::stopEffects() {
	canUpdateEffects = false;
	self.setHighlight( HIGHLIGHT_COLOR_NONE );
	self.setTakesDamage( false ); // Don't want these to explode after px46 dies, effects look bad
}

void explodeObject::updateEffects() {
	while ( canUpdateEffects ) {
		if ( isLeftTube ) {
		self.startFX( FX_VEH_START_BOOST );
	  } else {
		self.startFX( FX_VEH_START_BOOST2 );
	  }
	  sys.wait( breathingEffectsInterval );
	}
}

void explodeObject::onExplode( entity attacker ) {
	canUpdateEffects = false;
	ripOffMaskObj.activate( attacker ); 
	self.disablePhysics();
	self.setHighlight( HIGHLIGHT_COLOR_NONE );	

	if ( isLeftTube ) {
	  	ripOffMaskObj.callFunction( "onExplosionTubeLeft" );
	} else {
		ripOffMaskObj.callFunction( "onExplosionTubeRight" );
	}
	
	$gp_target_relay_supersoldaten_faceexposed.activate( $activator );		
}



// Super soldier auxiliary script
object supersoldat {
	float pushRadius;
	float exposeFaceInterval;
	float exposeFaceDamageThreshold;
	float destroyTubeThreshold;

	__noedit float lastFaceHurtTime;
	__noedit int faceHurtCount;
	__noedit boolean isAttacking;
	__noedit float damageCanExposeFaceTime;
	__noedit float exposeFaceDamage;
	__noedit boolean tubesDestroyed;
	__noedit float destroyTubeDamage;

	void exitSarcophagus();
	void startFight();
	void pushNPCs();
	void startAttack();
	void endAttack();
	void exposedFace();
	void exposedFaceSequence();
	void backupExposeFace();
	void backupExposeFaceSequence();
	void pushPlayer();
	
	void init();
    void onDamage( entity attacker, float health, decl damageDecl, float damageAmount, int killed );
};

void supersoldat::init() {
	if ( exposeFaceInterval == 0.0f ) {
		exposeFaceInterval = 10.0f;
	}
	if ( exposeFaceDamageThreshold == 0.0f ) {
		exposeFaceDamageThreshold = 20.0f;	
	}
	if ( destroyTubeThreshold == 0.0f ) {
		destroyTubeThreshold = 50.0f;
	}
};


void supersoldat::exitSarcophagus() {
	thread pushPlayer();	
}

void supersoldat::startFight() {
	// Allow tubes to take damage
	int i;
	for ( i = 0; i < superSoldatTubes.size(); i++ ) {
		superSoldatTubes.get( i ).setTakesDamage( true );
		superSoldatTubes.get( i ).show();
	}	
	hideSuperSoldatTubes = false;
	lastFaceHurtTime = 0.0f;
	faceHurtCount = 0;
	isAttacking = false;
	exposeFaceDamage = 0.0f;
	damageCanExposeFaceTime = 0.0;
	tubesDestroyed = false;
	destroyTubeDamage = 0.0f;
	
	// Restrict takedown to the center of the room
	$gp_volume_takedownrestriction.show();
	self.setTakedownRestrictionVolume( $gp_volume_takedownrestriction );
	
	// Set shot clip only on guys lying down
	$gp_func_animatedsimple_character_prendergast_sarcophagus.setContents( CONTENTS_SHOTCLIP );	
	$gp_func_animatedsimple_character_even_faker_blondie.setContents( CONTENTS_SHOTCLIP );

	// Stop pushing player
	sys.killThread(	"supersoldat::pushPlayer" );
			
	// Start pushing NPCs around
	thread pushNPCs();
}

void supersoldat::pushPlayer() {
	while ( !self.isDead() ) {
		// Push away player during exit from sarcophagus
		if ( self.distanceTo( $player1 ) < 100.0f ) {
			$player1.push( $player1.getWorldOrigin() - self.getWorldOrigin(), 5.0f, 0.1f );
		}
		sys.waitFrame();
	}
}


void supersoldat::pushNPCs() {
	while ( !self.isDead() ) {
		// Fake collision handling by hitting wyatt/fergus if they come close enough
		// Note that the hit relays disable themselves when wyatt/fergus is down
		if ( self.distanceTo( $gp_ai_tungsten_c01_part_03_fergus_supersoldaten ) < pushRadius ) {
			$c01p3_gp__target_relay_fergus_hit.activate( self );
		}
		if ( self.distanceTo( $gp_ai_tungsten_c01_part_03_wyatt_supersoldaten ) < pushRadius ) {
			$c01p3_gp__target_relay_wyatt_hit.activate( self );
		}
		sys.waitFrame();
	}
}


void supersoldat::startAttack() {
	isAttacking = true;	
}

void supersoldat::endAttack() {
	isAttacking = false;	
}

void supersoldat::exposedFace() {
	tubesDestroyed = true;
	thread exposedFaceSequence();
}

void supersoldat::exposedFaceSequence() {
	damageCanExposeFaceTime = sys.getTime() + 3.0;

	// Allow damage to expose face again after a while 
	sys.wait( 3.0f ); 
	exposeFaceDamage = 0.0f;
	
	// Wait a while, complete any attacks and face player before automatically exposing face again
	sys.wait( exposeFaceInterval - 3.0f );
	while ( !self.isDead() && 
		   ( isAttacking || ( sys.vecDotProduct( self.getModelForward(), sys.vecNormalize( $player1.getWorldOrigin() - self.getWorldOrigin() ) ) < 0.87f ) ) ) {
		sys.waitFrame();
	}
	if ( !self.isDead() ) {
		$gp_ai_scriptedanimweb_px46_exposeface.activate( self );
		sys.killThread( "supersoldat::backupExposeFaceSequence" );
		backupExposeFace();
	}
}

void supersoldat::backupExposeFace() {
	thread backupExposeFaceSequence(); 
}

void supersoldat::backupExposeFaceSequence() {
	// Safety backup to avoid overly long face exposing intervals (and failsafe in case of bugs)
	while ( !self.isDead() ) {
		sys.wait( exposeFaceInterval * 1.5f );
		sys.println( "Used supersoldat::backupExposeFaceSequence" );
		sys.killThread( "supersoldat::exposedFaceSequence" );
		if ( !self.isDead() ) {
			$gp_ai_scriptedanimweb_px46_exposeface.activate( self );
		}
	}
}


void supersoldat::onDamage( entity attacker, float health, decl damageDecl, float damageAmount, int killed ) {
	if ( !killed && !self.isDead() ) {
		
		if ( !tubesDestroyed ) {
			// First stage, tubes have not been destroyed
			if ( attacker.isClass( "idPlayer" ) ) {
				destroyTubeDamage = destroyTubeDamage + damageAmount;
				if ( destroyTubeDamage > destroyTubeThreshold ) {
					// Destroy a tube, if possible		
					destroyTubeDamage = 0.0f;
					int i;
					for ( i = 0; i < superSoldatTubes.size(); i++ ) {
						if ( superSoldatTubes.get( i ).getHealth() > 0.0f ) {
							superSoldatTubes.get( i ).damage( attacker, attacker, @damage( "damage/tungsten/heavy" ), 1000.0f, Vec( 0, 0, 1 ) ); // Damagedecl is otherwise given as e.g. @damage( "damage/tungsten/heavy" )
							break;
						} 
					}	
				}	
			}
		} else {
			// Second stage, tubes have been destroyed
			// Lots of damage when damage cannot expose face is assumed to be face hits
			if ( ( sys.getTime() < damageCanExposeFaceTime ) && 
				 ( damageAmount > 30 ) && 
				 ( sys.getTime() > lastFaceHurtTime + 4.0 ) ) {
				if ( faceHurtCount == 0) {
					$gp_vo_shot_in_face1.activate( attacker );
				} else if ( faceHurtCount == 1) {
					$gp_vo_shot_in_face2.activate( attacker );
				}
				faceHurtCount++;
				lastFaceHurtTime = sys.getTime();
			}
			
			// When having accumulated enough damage since face was covered again we expose face
			if ( sys.getTime() > damageCanExposeFaceTime ) {
				exposeFaceDamage = exposeFaceDamage + damageAmount;	
				if ( exposeFaceDamage > exposeFaceDamageThreshold ) {
					// Expose face!
					damageCanExposeFaceTime = sys.getTime() + 5.0;
					exposeFaceDamage = 0.0f;
					sys.killThread( "supersoldat::exposedFaceSequence" );
					sys.killThread( "supersoldat::backupExposeFaceSequence" );
					$gp_ai_scriptedanimweb_px46_exposeface.activate( self );
					backupExposeFace();
				}
				if ( useDebug() ) sys.println( sys.getTime() + ": Damage: " + damageAmount + " Accumulated: " + exposeFaceDamage );
			} else {
				if ( useDebug() ) sys.println( sys.getTime() + ": Damage can not expose face" );
			}
		}
	}
}


