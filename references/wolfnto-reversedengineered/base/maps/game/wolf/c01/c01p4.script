{
	vector viewAngles = $player1.getViewAngles(); 
	viewAngles_x = 0.0;
	viewAngles_z = 0.0;
	$func_firstpersonevent_diebyfire.teleport( $player1.getOrigin(), viewAngles );
	$func_firstpersonevent_diebyfire.activate( $player1 );
}

