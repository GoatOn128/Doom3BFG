}

void call_supersoldat_gib( entity activatedEntity, entity activator ) {
	int i;
	for ( i = 0; i < superSoldatTubes.size(); i++ ) {
		superSoldatTubes.get( i ).callFunction( "stopEffects" );
		superSoldatTubes.get( i ).remove();
	}
}

void call_supersoldat_smash( entity activatedEntity, entity activator ) {
	// Lots of extra damage to cornered player
	vector maxBounds = $gp_volume_takedownrestriction.getMaxs() + $gp_volume_takedownrestriction.getWorldOrigin() + Vec( 40.0,40,0 );
	vector minBounds = $gp_volume_takedownrestriction.getMins() + $gp_volume_takedownrestriction.getWorldOrigin() - Vec( 40.0,40,0 );
	vector playerPos = $player1.getWorldOrigin();
	vector supersoldatPos = $gp_ai_tungsten_c01_part_03_supersoldaten_bossfight.getWorldOrigin();
	if ( useDebug() ) sys.drawText( "SUPERSOLDAT SMASH!", inFrontOfPlayer( 400.0 ) + Vec(0,0,10), 1, Vec(1,1,1), 1, 1.0 );
	if ( useDebug() ) sys.debugBounds( Vec(1,0.5,0), minBounds, maxBounds, 1.0 );
	
	// Is baby in a corner?
	boolean cornered = false;
	if ( ( playerPos_x > maxBounds_x ) && ( playerPos_y > maxBounds_y ) ) {
		if ( ( playerPos_x > supersoldatPos_x ) && ( playerPos_y > supersoldatPos_y ) ) {
			cornered = true;
		}
	} else if ( ( playerPos_x > maxBounds_x ) && ( playerPos_y < minBounds_y ) ) {
		if ( ( playerPos_x > supersoldatPos_x ) && ( playerPos_y < supersoldatPos_y ) ) {
			cornered = true;
		}
	} else if ( ( playerPos_x < minBounds_x ) && ( playerPos_y > maxBounds_y ) ) {
		if ( ( playerPos_x < supersoldatPos_x ) && ( playerPos_y > supersoldatPos_y ) ) {
			cornered = true;
		}
	} else if ( ( playerPos_x < minBounds_x ) && ( playerPos_y < minBounds_y ) ) {
		if ( ( playerPos_x < supersoldatPos_x ) && ( playerPos_y < supersoldatPos_y ) ) {
			cornered = true;
		}
	}
	
	if ( cornered ) {
		// Player is near corner and super is towards center of room. Check if super is facing player and is close enough to squish him.
		float dist = sys.vecLength( playerPos - supersoldatPos );
		if ( useDebug() ) sys.drawText( "Cornered, dist: " + dist, inFrontOfPlayer( 400.0 ), 1, Vec(1,1,0), 1, 1.0 );
		if ( dist < 80.0 ) {
			vector supersoldatDir = $gp_ai_tungsten_c01_part_03_supersoldaten_bossfight.getModelForward();
			if ( sys.vecDotProduct( supersoldatDir, playerPos - supersoldatPos ) > 0.707 * dist ) {
				// Facing somewhat towards player, smash!
				$player1.damage( $gp_ai_tungsten_c01_part_03_supersoldaten_bossfight, $gp_ai_tungsten_c01_part_03_supersoldaten_bossfight, @damage( "damage/fists/melee/supersoldat1946_tackle" ), 20.0f, Vec(0,0,1) );
				if ( useDebug() ) sys.debugArrow( Vec(1,0,0), supersoldatPos, supersoldatPos + supersoldatDir * 60.0, 1, 1 );
				if ( useDebug() ) sys.drawText( "Hit!", inFrontOfPlayer( 400.0 ) - Vec(0,0,10), 1, Vec(1,0,0), 1, 3.0 );
				
			} else {
				if ( useDebug() ) sys.debugArrow( Vec(0,1,0), supersoldatPos, supersoldatPos + supersoldatDir * 60.0, 1, 1 );
				if ( useDebug() ) sys.drawText( "Miss!", inFrontOfPlayer( 400.0 ) - Vec(0,0,10), 1, Vec(0,1,0), 1, 3.0 );
			}
		}
	}
}


float pushFromNorthWall = false;
float pushFromWestWall = false;

float getPushFall() {
	// Hacks within hacks... We need to teleport player to be absolutely sure he gets pushed away from obstacles during wall crush event (since the player "physics" suck)
	// and must therefore simulate gravity while being pushed in case you've jumped when push starts :P
	// Make damn sure we don't fall too low, so we might float a smidgeon or two.
	if ( Vec_z( $player1.getWorldOrigin() ) > Vec_z( $wallcrushlineref.getWorldOrigin() ) + 8.0 ) {
		return -100.0; 
	} 
	return 0.0;
}

void call_pushfromnorthwall( entity activatedEntity, entity activator ) {
	pushFromNorthWall = true;
	pushFromWestWall = false;
	
	if ( useDebug() ) sys.drawText( "PUSH FROM NORTH WALL", inFrontOfPlayer( 400.0 ) , 1, Vec(1,1,1), 1, 5 );

	while ( pushFromNorthWall ) {
		// Push player south so we won't get squished between west wall and mover covering NPCs 
		vector npcCorner = $gp_func_mover_crushevent_pushfromnpcs.getMins() + $gp_func_mover_crushevent_pushfromnpcs.getWorldOrigin();
		
		// Push if we're between npcs and west wall
		vector playerPos = $player1.getWorldOrigin();
		if ( playerPos_x < npcCorner_x ) {
			// Push if player north bounds is north of southmost npc corner (with some slop)
			vector playerCorner = $player1.getMaxs() + $player1.getWorldOrigin();
			if ( playerCorner_y > npcCorner_y - 10.0f ) {
				$player1.push( Vec(0,-1,0), 50.0f, 0.5f );  

				// Push fails in some circumstances, incrementally teleport player as well
				$player1.setWorldOrigin( $player1.getWorldOrigin() + Vec(0,-50,getPushFall()) * sys.getFrameTime() );
			}	
		}
		if ( useDebug() ) sys.debugArrow( Vec(1,1,0), npcCorner, npcCorner + Vec(0, -200, 0), 1, 0 );
		sys.waitFrame();
	}
}

void call_pushfromwestwall( entity activatedEntity, entity activator ) {
	pushFromWestWall = true;
	pushFromNorthWall = false;

	if ( useDebug() ) sys.drawText( "PUSH FROM WEST WALL", inFrontOfPlayer( 400.0 ) , 1, Vec(1,1,1), 1, 5 );
	
	while ( pushFromWestWall ) {
		// Push player east so we won't get squished between south wall and mover covering NPCs 
		vector npcCorner = $gp_func_mover_crushevent_pushfromnpcs.getMins();
		npcCorner_x = Vec_x( $gp_func_mover_crushevent_pushfromnpcs.getMaxs() );
		npcCorner = $gp_func_mover_crushevent_pushfromnpcs.getWorldOrigin() + npcCorner;
		
		// Push if player west bounds is west of eastmost npc corner (with some slop)
		vector playerCorner = $player1.getMins() + $player1.getWorldOrigin();
		if ( playerCorner_x < npcCorner_x + 10.0f ) {
			$player1.push( Vec(1,0,0), 50.0f, 0.5f );  

			// Push fails in some circumstances, incrementally teleport player as well
			$player1.setWorldOrigin( $player1.getWorldOrigin() + Vec(50,0,getPushFall()) * sys.getFrameTime() );

			if ( useDebug() ) sys.debugArrow( Vec(1,0,0), npcCorner, npcCorner + Vec(200,0,0), 1, 0 );
			if ( useDebug() ) sys.debugArrow( Vec(1,0,0), npcCorner + Vec(200,0,0), npcCorner + Vec(200,0,50), 1, 0 );
		} else {
			if ( useDebug() ) sys.debugArrow( Vec(1,1,0), npcCorner, npcCorner + Vec(200,0,0), 1, 0 );
		}
		sys.waitFrame();
	}
}

void call_pushfromsouthwall( entity activatedEntity, entity activator ) {

	if ( useDebug() ) sys.drawText( "PUSH FROM SOUTH WALL", inFrontOfPlayer( 400.0 ) , 1, Vec(1,1,1), 1, 5 );
	
	float endPushTime = sys.getTime() + 3.0;	
	while ( sys.getTime() < endPushTime ) {
		// Push player northeast so we won't be able to slip inside the broken collision of the west moving wall
		vector toPlayer = $player1.getWorldOrigin() - $gp_info_null_brokencollisionpos.getWorldOrigin();
		toPlayer_z = 0.0;
		if ( sys.vecLength( toPlayer ) < 80.0 ) {
			$player1.push( Vec(1,1,0), 100.0f, 0.5f );  

			// Push fails in some circumstances, incrementally teleport player as well
			$player1.setWorldOrigin( $player1.getWorldOrigin() + Vec(50,50,getPushFall()) * sys.getFrameTime() );
		}
		if ( useDebug() ) sys.debugCircle( Vec(1,1,0), $gp_info_null_brokencollisionpos.getWorldOrigin(), Vec(0,0,1), 80.0, 12, 0 );
		sys.waitFrame();
	}
}


//events/c01/player_wall_squeezed/
void startLookEvent( entity activatedEntity, entity activator )
{
	// Place fpevent relative to player along the line extending from 
	// wallcrushlineref to just before door
    vector playerAngles = $player1.getViewAngles();
	vector refPos = $wallcrushlineref.getOrigin();
    vector fpPos = refPos;
    fpPos_x = Vec_x( $player1.getOrigin() );
	if ( fpPos_x < refPos_x ) {
		fpPos_x = refPos_x;
	} else if ( fpPos_x > refPos_x + 190.0f ) {
		fpPos_x = refPos_x + 190.0f;
	}
	
	// Trigger appropriate fpevent
    if ( playerAngles_y > 0 ) {
        $wallcrush_right.setOrigin( fpPos );
        $wallcrush_right.activate( $player1 );

    } else {
        $wallcrush_left.setOrigin( fpPos );
        $wallcrush_left.activate( $player1 );
    }
	pushFromNorthWall = false;
	pushFromWestWall = false;
	sys.wait(0.8);
	$player1.teleport( $target_teleport_backtoincinerator.getOrigin(), playerAngles );
}

void trigger_name ( entity activatedEntity, entity activator )
{
	sys.print("Activated trigger:" + activatedEntity.getName() + "\n" );
}

void call_start_viewfade_from_black( entity activatedEntity, entity activator ) 
{ 
//	sys.print( "call_start_viewfade_from_black" );
//	sys.print( "call_start_viewfade_from_black: first fade" );
	$player1.fadeView( Vec(0,0,0), 1.0, 0 );
	sys.waitFrame();
	sys.waitFrame();
	sys.waitFrame();
	sys.waitFrame();
//	sys.print( "call_start_viewfade_from_black: actual fade" );
	$player1.fadeView( Vec(0,0,0), 0.0, 250 );
}


void attach_splinters( entity activatedEntity, entity activator )
{
	$gp_func_mover_splinter_player_1.bindToJoint( $thirdpersonhands_0, "", "righthandattach", true );
	$gp_func_mover_splinter_player_2.bindToJoint( $thirdpersonhands_0, "", "lefthandattach", true );
}

void equipBestWeaponPostSarcofagus( entity activatedEntity, entity activator )
