void main() {

}


void call_gp_func_movers_mover_rightlane_fast( entity activatedEntity, entity activator )
{
    $gp_func_movers_mover_righlane_fast.time( 40 );
    $gp_func_movers_mover_righlane_fast.accelTime( 0 );
    $gp_func_movers_mover_righlane_fast.decelTime( 0 );
	$gp_func_movers_mover_righlane_fast.followSpline($gp_spline_path_cars_rightlane, 1, 0);
}

