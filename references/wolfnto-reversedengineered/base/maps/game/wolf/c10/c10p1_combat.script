/*================================================================================
LOADINGAREA COMBAT 
================================================================================*/
		
#define MAX_ACTIVE_AIS 7

void masterSpawner( entity ai, entity pos, boolean blind, entity scenePoint, boolean checkLimit, boolean detectEnemy ) {	
	if ( !ai.isHidden() ) {
		return;
	}

	if ( checkLimit && sys.numActiveAIs() >= MAX_ACTIVE_AIS ) {
		sys.print("Spawn fail. To many AIs active.\n");
		return;
	}
	
	//if( pos != $NULL ) {		
		ai.teleport( pos.getOrigin(), pos.getAngles() );
	//}
	$sys.waitFrame();
	ai.show();
	ai.setPerceptionFlag( blind );
	ai.setOverrideScenePoint( scenePoint );	
	if ( detectEnemy ) {
		ai.detectPlayer();
	}
}


void call_1wave( entity activatedEntity, entity activator ) 
{
				//( entity ai, entity pos, boolean blind, entity scenePoint, boolean checkLimit, boolean detectEnemy )
	sys.print( "1st WAVE - VAR 1\n");	
	
	masterSpawner( $cb_ai_rifle_infantry60_1, $cb_spawnspot_1, true, $NULL, true, false );
	masterSpawner( $cb_ai_supersoldat_1, $cb_spawnspot_3, true, $NULL, true, false );
	masterSpawner( $cb_ai_supersoldat_2, $cb_spawnspot_2, true, $NULL, true, false );
	masterSpawner( $cb_ai_blackguard_1, $cb_spawnspot_6, true, $NULL, true, false );
	masterSpawner( $cb_ai_blackguard_2, $cb_spawnspot_4, true, $NULL, true, false );
	masterSpawner( $cb_ai_blackguard_3, $cb_spawnspot_5, true, $NULL, true, false );
}

