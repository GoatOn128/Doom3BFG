void sound_Alarm( entity activatedEntity, entity activator ) 
{
	$cb_ai_blackguard_1.setPerceptionFlag( false );
	$cb_ai_supersoldat_1.setPerceptionFlag( false );;
	$cb_ai_supersoldat_2.setPerceptionFlag( false );
	$cb_ai_rifle_infantry60_1.setPerceptionFlag( false );
	$cb_ai_rifle_infantry60_2.setPerceptionFlag( false );
	$cb_ai_rifle_infantry60_3.setPerceptionFlag( false );
	
	$cb_ai_blackguard_1.detectPlayer();
	$cb_ai_supersoldat_1.detectPlayer();
	$cb_ai_supersoldat_2.detectPlayer();
	$cb_ai_rifle_infantry60_1.detectPlayer();
	$cb_ai_rifle_infantry60_2.detectPlayer();
	$cb_ai_rifle_infantry60_3.detectPlayer();
	
	$cb_trigger_call_sound_alarm.makeActivatable( false );
	$cb_trigger_eventlistener_call_sound_alarm.makeActivatable( false );
	$cb_trigger_call_2wave.makeActivatable( true );
	$cb_trigger_call_3wave.makeActivatable( true );
	$gp_trigger_call_tripedal_loader2.makeActivatable( false );
}
	
