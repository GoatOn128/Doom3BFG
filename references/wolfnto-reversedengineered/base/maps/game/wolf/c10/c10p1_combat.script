{
				//( entity ai, entity pos, boolean blind, entity scenePoint, boolean checkLimit, boolean detectEnemy )
	sys.print( "2nd WAVE - VAR 1\n");
	
	masterSpawner( $cb_ai_blackguard_2, $cb_spawnspot_9, false, $NULL, true, false );
	masterSpawner( $cb_ai_rifle_infantry60_5, $cb_spawnspot_8, false, $NULL, true, false );
	masterSpawner( $cb_ai_rifle_infantry60_6, $cb_spawnspot_7, false, $NULL, true, false );
}

