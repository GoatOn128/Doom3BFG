/*================================================================================
Hallway door controlled by player. Sick! Oh you're so pro Grawert~
================================================================================*/

object waterlevel
{
	int risingSpeed;
	int height;
	int parentWaterLevel;

	float _initialPos;
	
	void init();
		
	void startWaterlevel();
	void stopWaterlevel();
	void updateWaterLevel();
	
	boolean isAtTop();	
	boolean isAtPipe();
};

boolean waterlevel::isAtTop()
{
	vector pos = self.getOrigin();
	float dist = abs(self._initialPos + self.height - pos_z);
	
	return (dist < 0.1);
}

boolean waterlevel::isAtPipe()
{
	vector pos = self.getOrigin();
	float dist2 = abs(self._initialPos + self.parentWaterLevel - pos_z);
	
	return (pos_z > _initialPos + parentWaterLevel );
}


void waterlevel::init()
{
	vector pos = self.getOrigin();
	self._initialPos = pos_z;
	
	if(!self.height)
	{
		pos = self.getMaxs() - self.getMins();
		self.height = pos_z - 24;
	}
	
	if(!self.parentWaterLevel)
	{
		pos = self.getMaxs() - self.getMins();
		self.parentWaterLevel = pos_z - 24;
	}
	
	if(!self.risingSpeed) self.risingSpeed = 100;
}

void waterlevel::startWaterlevel()
{
	thread updateWaterLevel();
}


void waterlevel::updateWaterLevel( )
{
	sys.println( "Raise water" );
	self.stopMoving();

	sys.wait( 1.8 );

	vector pos = self.getOrigin();
			
	float dist = self._initialPos + self.height - pos_z;
	if(dist == 0) return;
		
	float t = dist/self.risingSpeed;
	float at;
	if(t > 0.5) at = 0.5;
	else at = t;				
								
	self.time(t);
	self.accelTime(at);
	self.move(DIR_UP, dist);
	
	while( true )
	{ 
		sys.waitFrame();
		
		if(self.isAtPipe()) 
		{
			sys.println( "Bind sewer water" );
			$gp_func_dynamicwater_20.bind( $gp_func_dynamicwater_19 );
			break;
		}	
	}
	
	sys.waitFor( self );
			
	if(self.isAtTop()) 
	{
		sys.println( "Water at Top Level" );
		$gp_holdhandle_fpevent_raisewater.setFirstPersonEventAnimState( 2 );
		$gp_use_raisewaterlevel.remove();
	}
}

void waterlevel::stopWaterlevel()
{
	sys.println( "Stop water again" );
		
	sys.wait( 0.4 );	
	
	self.stopMoving();
}

void raiseWaterlevel(entity targ, entity acti)
{
	entity water = $water;
	water.callFunction("startWaterlevel");		
}

void stopWaterlevel(entity targ, entity acti)
{
	entity water = $water;
	water.callFunction("stopWaterlevel");	
}

/*================================================================================
Waterwheels puzzle and mine bobbing 
================================================================================*/

float targetSpeed, currentSpeed;


void startWheels(entity targ, entity acti)
{
	sys.println( "Start wheels" );
	
	targetSpeed = 25;
}

void stopWheels(entity targ, entity acti)
{
	sys.println( "Stop wheels" );
	
	targetSpeed = 0;
}

boolean inArea = true; 

void main()
{
	vector movement = '5 5 0';
	movement_x+= sys.random(5);
	movement_y+= sys.random(5);		
	movement_z+= sys.random(5);		

	$gp_mover_mine_20.bob(0.5, sys.random(1), movement);
	$gp_mover_mine_21.bob(0.5, sys.random(1), movement);
	
	sys.println( "ACTIVATE" );
	while( inArea )
	{
		
		if(currentSpeed < targetSpeed) currentSpeed = currentSpeed + 0.1;
		if(currentSpeed > targetSpeed) currentSpeed = currentSpeed - 0.3;
		
		$wheel1.action_SetRotateSpeed(0, 0, currentSpeed);		
		$wheel2.action_SetRotateSpeed(0, 0, currentSpeed);
		
		sys.waitFrame();
	}
}

void stopWheelLoop(entity targ, entity acti)
{
	sys.println( "INACTIVATE" );
	inArea = false;
}


