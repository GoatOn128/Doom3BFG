void call_elevator ( entity actiEnt, entity acti )
{
	$gp_use_elevator.hide();
	$gp_use_elevator_down.hide();
	
	$sound_sp_elevator_front.activate( acti );	
	$sound_sp_elevator_rear.activate( acti );	
	$gp_mover_elevator.time( 5.0f );
	$gp_mover_elevator.accelTime( 2.0f );
	$gp_mover_elevator.decelTime( 2.0f );
	$gp_mover_elevator.move( DIR_UP, 704 );
	
	sys.wait( 5.0f );
	$gp_use_elevator_down.show();
}

