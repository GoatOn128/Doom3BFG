//Enable or Disable sitting soldier aim - Fredrik L

void StartDudeAiming( entity activatedEntity, entity activator) {
    sys.print("Called Dude start aiming");
    $gp_animatedsimple_loot_aim.setFocus( $player1, true, true, AIMPOINT_HEAD );
}

void StopDudeAiming( entity activatedEntity, entity activator) {
    sys.print("Called Dude stop aiming");
    $gp_animatedsimple_loot_aim.setFocus( $menutrigger0, true, true, AIMPOINT_HEAD );
}



//Guy steps out of door, closes when he is through

void call_open_servicetunnel_first ( entity activatedEntity, entity activator )
{
	$gp_moverjoint_maintenancedoor.time( 2.0f );
	$gp_moverjoint_maintenancedoor.decelTime( 0.5f );
	$gp_moverjoint_maintenancedoor.rotateOnce( '0 90 0' );
}

void call_close_servicetunnel_first ( entity activatedEntity, entity activator )
{
	$gp_moverjoint_maintenancedoor.time( 2.0f );
	$gp_moverjoint_maintenancedoor.decelTime( 0.5f );
	$gp_moverjoint_maintenancedoor.rotateOnce( '0 -90 0' );
}

void call_entrance_finalwave (entity activatedEntity, entity activator ) 
{
	//Doors
	$gp_func_mover_exhibitiondoor_right.time( 3.0f );
	$gp_func_mover_exhibitiondoor_right.accelTime( 2.0f );
	$gp_func_mover_exhibitiondoor_right.decelTime( 1.0f );
	$gp_func_mover_exhibitiondoor_right.move(DIR_UP, 336);
	
	$sound_sp_exhibition_doors_open.activate($activator);
}

