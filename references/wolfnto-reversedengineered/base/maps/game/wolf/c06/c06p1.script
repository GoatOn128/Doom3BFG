	$gp_mover_gate_left.accelTime( 0.5f );
	$gp_mover_gate_left.decelTime( 0.5f );	
	$gp_mover_gate_left.rotateOnce( '0 90 0' );

	$gp_mover_gate_right.time( 3.0f );
	$gp_mover_gate_right.accelTime( 0.5f );
	$gp_mover_gate_right.decelTime( 0.5f );	
