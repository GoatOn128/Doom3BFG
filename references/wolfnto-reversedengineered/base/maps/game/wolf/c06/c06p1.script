//================================================================================
// Elevator ending 
//================================================================================

void call_hatch ( entity activatedEntity, entity activator )
{
	$sound_sp_hatch_open.activate( activator );
	$sound_fade_music.activate( activator );
	
    $gp_mover_moonroom_backdrop_hatch.time( 0.7f );
	$gp_mover_moonroom_backdrop_hatch.accelTime( 0.7f );
	$gp_mover_moonroom_backdrop_hatch.rotateOnce( '85 0 0' );

	sys.waitFor($gp_mover_moonroom_backdrop_hatch);
    $gp_mover_moonroom_backdrop_hatch.time( 0.2f );
	$gp_mover_moonroom_backdrop_hatch.accelTime( 0.0f );
	$gp_mover_moonroom_backdrop_hatch.decelTime( 0.2f );
	$gp_mover_moonroom_backdrop_hatch.rotateOnce( '-8 0 0' );
	
	sys.waitFor($gp_mover_moonroom_backdrop_hatch);	
    $gp_mover_moonroom_backdrop_hatch.time( 0.2f );
	$gp_mover_moonroom_backdrop_hatch.accelTime( 0.2f );
	$gp_mover_moonroom_backdrop_hatch.decelTime( 0.0f );
	$gp_mover_moonroom_backdrop_hatch.rotateOnce( '8 0 0' );
}

void call_elevator ( entity activatedEntity, entity activator )
{
    $gp_mover_elevatorcounterweight.time( 2 );
    $gp_mover_elevatorcounterweight.accelTime( 2 );
	$gp_mover_elevatorcounterweight.move( DIR_DOWN, 320 );

	$gp_mover_elevator.time( 8 );
    $gp_mover_elevator.accelTime( 3 );
	$gp_mover_elevator.move( DIR_UP, 3280 );
	
	sys.wait(2.0f);
	$gp_relay_fx_elevator.activate( activator );
	
	sys.wait( 6.0f );
	$gp_jobs_hangar_end.activate( activator );
	$gp_relay_fx_elevator.activate( activator );
}


