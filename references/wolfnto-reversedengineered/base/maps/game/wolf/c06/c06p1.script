	//First person event pushed back from explosion shockwave 
	$gp_firstpersonevent_shockwave.activate( $player1 );
	$gp_changestate_hotwirecar_explosion.activate( activator );
		
	//Trigger the big shockwave dustcloud 				
	sys.wait( 2.5f );
	//$fx_debris_rumble_outside.activate( $player1 );
	
	sys.wait( 7.5f );
	$fx_dustscreeneffect.activate( activator );
	
	sys.wait( 1.0f );
	//Fix the environment volume, spawn ambient dust around rubble and show the debris 
	show_parking_explosion(activatedEntity, activator);
	$fx_explosiondust.activate( activator );	
	$gp_envolume_override_parking.makeActivatable( true );	
	
	//Extra gameplay stuff 
	$gp_animatedsimple_panzerhund.show();	
	$gp_trigger_surprise3.makeActivatable( true );
	$gp_vehicle_car.makeActivatable( true );
	$fx_target_remove_drive_stuff.activate( activator );
}


