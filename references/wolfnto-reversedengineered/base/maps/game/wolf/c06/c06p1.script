/*================================================================================
Swinging object (in this case the rocket in the hallway 
================================================================================*/

object pendulum 
{
	entity bindMover;
	
	float swingTime;
	
	vector swingRotation;

	void init();
	
	void onTrigger( entity activator );
	
	boolean shouldRotate;
	
	entity landingPos; 
	
	float fallTime;
};

void pendulum::init()
{
	bindMover.bind( self );
	
	self.accelTime( swingTime * 0.5 );	
	self.decelTime( swingTime * 0.5 );
	self.time( swingTime );
	
	self.setAngles( self.getAngles() + (swingRotation * 0.5) );
	
	while ( shouldRotate == true )
	{
		self.rotateOnce( -swingRotation );
		sys.waitFor( self );
		
		if (shouldRotate == false )
		{
			break;
		} 
		
		self.rotateOnce( swingRotation );
		sys.waitFor( self );
	}
}

void pendulum::onTrigger( entity activator )
{
	shouldRotate = false; 
	
	self.stopRotating();
	
	bindMover.time( fallTime );
	bindMover.accelTime( fallTime );	
	
	bindMover.moveToPos( landingPos.getOrigin());
	bindMover.rotateToShortest( landingPos.getAngles() );	
} 



/*
================================================================================
Hallway door controlled by player. Sick! Oh you're so pro Grawert~
================================================================================
*/

object holding_door
{
	int openSpeed;
	int closeSpeed;
	int height;

	entity roller;

	float _initialPos;
	
	void init();
	
	void startOpen();
	void abortOpen();
	
	boolean isAtTop();
	boolean isAtBottom();
	
};

boolean holding_door::isAtTop()
{
	vector pos = self.getOrigin();
	float dist = abs(self._initialPos + self.height - pos_z);
	
	return (dist < 0.1);
}

boolean holding_door::isAtBottom()
{
	vector pos = self.getOrigin();
	float dist = abs(self._initialPos - pos_z);
	return (dist < 0.1);
}

void holding_door::init()
{
	vector pos = self.getOrigin();
	self._initialPos = pos_z;
	
	if(!self.height)
	{
		pos = self.getMaxs() - self.getMins();
		self.height = pos_z - 24;
	}
	if(!self.openSpeed) self.openSpeed = 100;
	if(!self.closeSpeed) self.closeSpeed = 110;
	
}

void holding_door::startOpen()
{
	self.stopMoving();
	roller.stopMoving();	
	
	vector pos = self.getOrigin();
	float dist = self._initialPos + self.height - pos_z;
	
	if(dist == 0) return;	
	
	float t = dist/self.openSpeed;
	float at;
	if(t > 0.5) at = 0.5;
	else at = t;
	
	self.time(t);
	self.accelTime(at);
	self.move(DIR_UP, dist);	
	self.roller.time(t);
	self.roller.accelTime(at);
	float rotate_ang = dist * 360 / 64; //64 = ca cirucumference of roller
	roller.rotateOnceXYZ( 0, rotate_ang, 0 ); //Sometimes this randomly rotates in the wrong direction? Why?
	
	//Start playing open sounds
	$sound_sp_servo_down.off(); //Make sure closing sound is off		
	$sound_sp_servo_up.on(); //Servo loop
	$sound_sp_steelshutter_start_up.on(); //Start "clang"
	if(t > 0.3) 
	{ 
		sys.wait(0.3);
		$sound_sp_metal_loop.on(); //Movement loop
	}

	sys.waitFor(self);	
	if(self.isAtTop()) 
	{
		//Stop playing the opening sounds.
		$sound_sp_servo_up.off(); //Servo loop
		$sound_sp_metal_loop.off(); //Movement loop
		//Start playing top hit sounds.
		$sound_sp_steel_shutter_stop_top.on();
		$gp_holdhandle_fpevent.setFirstPersonEventAnimState( 2 );
	}
}


void holding_door::abortOpen()
{
	self.stopMoving();
	roller.stopMoving();

	vector pos = self.getOrigin();
	float dist = self._initialPos - pos_z;
	if(dist == 0) return;	
	
	float t = abs(dist/self.closeSpeed);
	float at;
	if(t > 0.5) at = 0.5;
	else at = t;

	self.time(t);
	self.accelTime(at);
	self.move(DIR_UP, dist);
	self.roller.time( t );
	self.roller.accelTime(at);
	float rotate_ang = dist * 360 / 64; //64 = ca cirucumference of roller
	roller.rotateOnceXYZ( 0, rotate_ang, 0 ); //Sometimes this randomly rotates in the wrong direction? Why?
	
	//Start playing close sounds
	$sound_sp_servo_up.off(); //Make sure opening sound is off	
	$sound_sp_servo_down.on(); //Servo loop
	$sound_sp_steelshutter_startdown.on(); //Start "clang"
	if(t > 0.3) 
	{ 
		sys.wait(0.3);
		$sound_sp_metal_loop.on(); //Movement loop
	}
	
	sys.waitFor(self);

	if(self.isAtBottom()) //The door hasn't changed direction during this call
	{
		//Stop playing the closing sounds.
		$sound_sp_servo_down.off(); //Servo loop
		$sound_sp_metal_loop.off(); //Movement loop
		//Start playing bottom hit sounds.
		$sound_sp_steel_shutter_stop_floor.on();
	}
}


void holding_door_start_open(entity targ, entity acti)
{
	entity door = $gp_mover_rollupdoor;
	door.callFunction("startOpen");	
	
	
}


void holding_door_abort_open(entity targ, entity acti)
{
	entity door = $gp_mover_rollupdoor;
	door.callFunction("abortOpen");	
}

//================================================================================
// Hallway 
//================================================================================

#define ROBOT_DOOR_HEIGHT 160
#define ROBOT_DOOR_OPENTIME 2.5
#define ROBOT_DOOR_CLOSETIME 2

int clipMask;

void call_hall_robot (entity activatedEntity, entity activator ) 
{
	//Doors
	float dist = ROBOT_DOOR_HEIGHT;
	
	$gp_mover_rollupdoor.time( ROBOT_DOOR_OPENTIME );
	$gp_mover_rollupdoor.move(DIR_UP, dist);
	
	$gp_mover_roller.time( ROBOT_DOOR_OPENTIME );
	$gp_mover_roller.rotateOnceXYZ( 0, dist*360/64, 0 );
	
	$sound_sp_exhibition_doors_open.activate($activator);
		
	$combat_relay_robotsquad.activate( activator );
	
	sys.wait( 0.5f );
	$cb_movetoscenepoint_hallrobot.activate( activator );
	
	sys.wait(1);
	
//	$gp_mover_rollupdoor.removeClipMaskFlag(MASK_NPCSOLID);
	clipMask = $gp_mover_rollupdoor.getClipMask();
	$gp_mover_rollupdoor.setClipMask(0);
	
}

void call_hall_robot_inposition (entity activatedEntity, entity activator ) 
{
	//Doors

	float dist = -ROBOT_DOOR_HEIGHT;
	
	$gp_mover_rollupdoor.time( ROBOT_DOOR_CLOSETIME );
	$gp_mover_rollupdoor.move(DIR_UP, dist);
	
	$gp_mover_roller.time( ROBOT_DOOR_CLOSETIME );
	$gp_mover_roller.rotateOnceXYZ( 0, dist*360/64, 0 );
	
	$gp_mover_rollupdoor.setClipMask(clipMask);
	
	$sound_sp_exhibition_doors_close.activate($activator);
}

void call_rocket (entity activatedEntity, entity activator ) 
{
	$gp_animatedsimple_enginepath_rocket.setAnimState( 0, 0, false );
	
	sys.wait( 0.96f );
	$gp_func_mover_rocket.remove();
	$gp_func_fx_rocketdust.activate( activator );
	$gp_dymanic_hallrobotdead.show();
	$combat_robot_dead.activate( activator );
	sys.wait (0.1);
	//$gp_triggers_hurt_1.remove();	
}

void call_rocket_checkpoint (entity activatedEntity, entity activator ) 
{
	$gp_func_mover_rocket.remove();
	$gp_dymanic_hallrobotdead.show();
	$combat_robot_dead.activate( activator );	
}

//================================================================================
// BROKEN GLASS POSTERS  
//================================================================================


object breakable_poster_trigger
{
	int num;
};

void breakable_poster_trigger::onTrigger(entity acti)
{
	entity fx = sys.getEntity( "gp_fx_posterglass_"+num );
	entity shards = sys.getEntity( "gp_posterglass_shards_"+num );	
	entity poster = sys.getEntity( "gp_posterglass_"+num );	
	entity glass = sys.getEntity( "gp_posterglass_brk_"+num );
	
	fx.activate( $player1 );
	poster.remove();
	glass.show();
	
	sys.wait( 1.3 );
	shards.show();								
}

void destroy_poster (int num)
{
	entity fx = sys.getEntity( "gp_fx_posterglass_"+num );
	entity shards = sys.getEntity( "gp_posterglass_shards_"+num );	
	entity poster = sys.getEntity( "gp_posterglass_"+num );	
	entity glass = sys.getEntity( "gp_posterglass_brk_"+num );
	
	fx.activate( $player1 );
	poster.remove();
	glass.show();
	
	sys.wait( 1.3 );
	shards.show();								
}

