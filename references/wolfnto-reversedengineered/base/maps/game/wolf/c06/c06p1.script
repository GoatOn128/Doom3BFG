/*==================
object objectFollowSpline 
==================*/

object objectFollowSpline {	
	void init();
	void onTrigger( entity activator );
	
	entity splineToFollow;
	entity bindObject;	
	
	float moveTime;
	float moveAccelTime;
	float moveDecelTime;
};

void objectFollowSpline::init() {
	
	bindObject.bind( self );
}


void objectFollowSpline::onTrigger( entity activator ) {
	
	self.time(moveTime);
	self.accelTime( moveAccelTime );
	self.decelTime( moveDecelTime );	
	self.followSpline( splineToFollow, false, false );
}


