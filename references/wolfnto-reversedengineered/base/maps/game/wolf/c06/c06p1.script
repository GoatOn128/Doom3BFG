void call_bobbys_sacrifice ( entity activatedEntity, entity activator ) 
{
	$gp_moverjoint_blimp.time( 240.0f );
	$gp_moverjoint_blimp.followSpline ( $gp_spline_blimp_after_exp, 1, false );
		
	//If you change this let Markus S know about it as it affects animations 				
