/*================================================================================
SEARCHLIGHTS (On blimp this time)
================================================================================*/

object searchLight 
{
	entity bindEffect;
	entity bindLight;
	
	float timeToPos;
	float accelTimeToPos;
	float decelTimeToPos;
	float pausTime;

	void init();
	
	void onTrigger ( entity activator );
	boolean shouldSearch;
};

void searchLight::init()
{
	bindEffect.bind( self );
	bindLight.bind( self );
	
	self.accelTime( accelTimeToPos );	
	self.decelTime( decelTimeToPos );
	self.time( timeToPos );
	
	entity nextTarget = self;
	
	vector targetAngle;
		
	shouldSearch = true;
	
	while ( shouldSearch )
	{
		nextTarget = self.randomTarget( nextTarget.getName() );
		
		targetAngle = sys.vecToAngles( nextTarget.getWorldOrigin() - self.getWorldOrigin());
		
		self.rotateTo( targetAngle );
		
		sys.waitFor( self );
		sys.wait( pausTime );		
	}
}

void searchLight::onTrigger( entity activator )
{
	shouldSearch = false;
}

