	$cb_ai_rifle_9.setPerceptionFlag( false );
	$cb_ai_rifle_10.setPerceptionFlag( false );
	$cb_ai_rifle_11.setPerceptionFlag( false );
	$cb_ai_robot_5.setPerceptionFlag( false );	
}

void detect_hall( entity activatedEntity, entity activator ) {
	wake_hall( activatedEntity, activator );
	
	$cb_ai_rifle_8.detectPlayer();
	$cb_ai_rifle_9.detectPlayer();
	$cb_ai_rifle_10.detectPlayer();
	$cb_ai_rifle_11.detectPlayer();
	$cb_ai_robot_5.detectPlayer();
	
	sound_Alarm( activatedEntity, activator );
}

