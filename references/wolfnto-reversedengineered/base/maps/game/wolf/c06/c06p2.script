void open_vents(entity targ, entity activ)
{	
	entity vent;
	int i;
	for(i = 3 ; i > 0 ; i--)
	{ 
		vent = sys.getEntity("gp_monitor_vents_"+i);

		vent.time(2);
		vent.accelTime(1.5);
		vent.decelTime(0.25);
		vent.rotateOnce('0 0 93');
		sys.wait(0.5);
	}	
}


//Lift Platform
