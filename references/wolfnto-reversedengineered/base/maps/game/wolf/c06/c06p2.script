void clear_lower_floor( entity activatedEntity, entity activator ) {
	alarmOff = true;

	int i = 1;
	for( ; i <= 20 ; i++ ) {
		string aiName = "cb_ai_elite_" + i;
		entity ai = sys.getEntity( aiName );
		if ( ai != $NULL ) {
			ai.remove();		
		}
	}
	
	$cb_ai_rifle_8.remove();
	$cb_ai_rifle_9.remove();
	$cb_ai_rifle_10.remove();
	$cb_ai_rifle_11.remove();
	$cb_ai_robot_2.remove();	
	$cb_ai_robot_4.remove();	
	$cb_ai_robot_5.remove();	
}

