{
	
	$sound_sp_hangarelev_front.activate( $acti );	
	$sound_sp_hangarelev_rear.activate( $acti );
	$c06p2_exit_lift.time( 10.0f );
	$c06p2_exit_lift.accelTime( 2.0f );
	$c06p2_exit_lift.decelTime( 2.0f );
	$c06p2_exit_lift.move( DIR_DOWN, 480 );
}



//================================================================================
//	Spawn Scripts
//================================================================================

#define MAX_ACTIVE_AIS 10

// Should've extended this one to have detectplayer as wll
void c06p2spawn( entity ai, entity pos, boolean blind, entity scenePoint, boolean checkLimit, boolean detectEnemy ) {	
	if ( !ai.isHidden() ) {
		return;
	}

	if ( checkLimit && sys.numActiveAIs() >= MAX_ACTIVE_AIS ) {
		sys.print("Spawn fail. To many AIs active.\n");
		return;
	}
		
	ai.teleport( pos.getOrigin(), pos.getAngles() );
	$sys.waitFrame();
	ai.show();
	ai.setPerceptionFlag( blind );
	ai.setOverrideScenePoint( scenePoint );	
	if ( detectEnemy ) {
		ai.detectPlayer();
	}
}

int numElitesSpawned = 1;
int spawnPos = 1;
boolean alarmOff = false;
boolean alarmCalled = false;
boolean alarmOK = false;

// The alarm can be turned on by any of the AIs in the main hall upon detecting the player
void sound_Alarm( entity activatedEntity, entity activator ) {	
	if ( alarmCalled || !alarmOK ) {
		return;
	}
	
	// hack for now, wake up the other dudes.	
	
	$cb_ai_rifle_8.detectPlayer();
	$cb_ai_rifle_9.detectPlayer();
	$cb_ai_rifle_10.detectPlayer();
	$cb_ai_rifle_11.detectPlayer();
	$cb_ai_robot_5.detectPlayer();
	
	alarmCalled = true;
	
	sys.print("ALARM!\n");
	
	while ( !alarmOff ) {
		sys.wait( 4.0f );			
		if ( sys.numActiveAIs() >= MAX_ACTIVE_AIS ) {
			sys.print( "Too many AIs active. Postponing Elite spawning.\n" );
			continue;
		}
		
		if ( numElitesSpawned >= 5 ) {
			sys.print( "All elites spawned Cancelling alarm.\n" );
			alarmOff = true;
			return;
		}
			
		string aiName = "cb_ai_elite_" + numElitesSpawned;
		entity ai = sys.getEntity( aiName );	
	  
		// determine where player is	
		vector playerPos = sys.getPlayerPos();
		string spawnPosName = "";
		if ( $cb_volume_reinforcement_section_1.isPointInVolume( playerPos ) ) {
			spawnPosName = "cb_elite_section1_" + spawnPos;
			sys.print( "Player in SECTION 1\n" );
		} else if ( $cb_volume_reinforcement_section_2.isPointInVolume( playerPos ) ) {
			spawnPosName = "cb_elite_section2_" + spawnPos;		
			sys.print( "Player in SECTION 2\n" );
		} else if ( $cb_volume_reinforcement_section_3_1.isPointInVolume( playerPos ) || 
					$cb_volume_reinforcement_section_3_2.isPointInVolume( playerPos ) ) {
			spawnPosName = "cb_elite_section3_" + spawnPos;		
			sys.print( "Player in SECTION 3\n" );
		} else {
			sys.print("Player not in any volume, delaying spawn of reinforcements");
			continue;
		}		
		
		c06p2spawn( ai, sys.getEntity( spawnPosName ), false, $NULL, true, true );
		
		sys.print( "Spawning AI " + aiName );
		sys.print(" at location " + spawnPosName +"\n");		
		spawnPos++;
		if ( spawnPos > 5 ) {
			spawnPos = 1;
		}
		numElitesSpawned++;
	}	
}

