void call_lkwlab_cleanup( entity activatedEntity, entity activator ) 
{
	$gp_remove_lkstuff.activate( activator );
	$gp_mover_lkw_block.remove();
	$gp_mover_lkw_barrier.remove();
}

void call_checkpoint_junction( entity activatedEntity, entity activator ) 
{
	call_lkwlab_cleanup( activatedEntity, activator ); 
	mainroom_spawn( activatedEntity, activator ); 
}

void call_checkpoint_hangar_robotboss( entity activatedEntity, entity activator ) 
{
	call_lkwlab_cleanup( activatedEntity, activator ); 
	spawn_robot( activatedEntity, activator ); 
}

void call_checkpoint_elevatorshaft ( entity activatorEntity, entity activator )
{
	$elevator_1.time( 0.2 );
	$elevator_1.move( DIR_DOWN, 1920 );
}

