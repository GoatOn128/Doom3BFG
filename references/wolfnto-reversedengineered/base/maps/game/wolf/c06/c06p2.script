	$cb_ai_rifle_2.setPerceptionFlag( false );
	$cb_ai_rifle_3.setPerceptionFlag( false );
	$cb_ai_rifle_4.setPerceptionFlag( false );
	$cb_ai_rifle_5.setPerceptionFlag( false );
	$cb_ai_rifle_6.setPerceptionFlag( false );
	$cb_ai_rifle_7.setPerceptionFlag( false );
	$cb_ai_pistol_1.setPerceptionFlag( false );
	$cb_ai_robot_2.setPerceptionFlag( false );
	$cb_ai_robot_1.setPerceptionFlag( false );
	$cb_ai_robot_3.setPerceptionFlag( false );
}

void setLeftSafetyVolume_Shooting( entity activatedEntity, entity activator ) {
	setLeftSafetyVolume_Leaving( activatedEntity, activator );
	$cb_ai_rifle_1.detectPlayer();
	$cb_ai_rifle_2.detectPlayer();
	$cb_ai_rifle_3.detectPlayer();
	sys.waitFrame();
	$cb_ai_rifle_4.detectPlayer();
	$cb_ai_rifle_5.detectPlayer();
	$cb_ai_rifle_6.detectPlayer();
	sys.waitFrame();
	$cb_ai_rifle_7.detectPlayer();
	$cb_ai_pistol_1.detectPlayer();
	$cb_ai_robot_2.detectPlayer();
	sys.waitFrame();
	
	$cb_ai_robot_1.detectPlayer();
	$cb_ai_robot_3.detectPlayer();
	
	sound_Alarm( activatedEntity, activator );
}


