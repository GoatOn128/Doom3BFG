// hangar alarm
int numElitesSpawned_hangar = 1;
boolean alarmOff_hangar = false;
boolean alarmCalled_hangar = false;

void spawn_robot( entity activatedEntity, entity activator ) {
	
	sys.wait( 5.0f );	
				
	sys.print(" Spawn Robot ");
	alarmOff_hangar = true;
	c06p2spawn( $cb_ai_robot_x_1, $cb_pos_ai_robot_x_1, true, $NULL, false, true );	
	
	$cb_func_hangardoor_upper.time( 3.5f );
	$cb_func_hangardoor_upper.accelTime( 1.0f );
	$cb_func_hangardoor_upper.decelTime( 1.0f );
	$cb_func_hangardoor_upper.move( DIR_UP, 200.0f );

	$cb_func_hangardoor_lower.time( 3.5f );
	$cb_func_hangardoor_lower.accelTime( 1.0f );
	$cb_func_hangardoor_lower.decelTime( 1.0f );
	$cb_func_hangardoor_lower.move( DIR_DOWN, 128.0f );
	
	sys.wait( 4.0f );
	$cb_ai_robot_x_1.setOverrideScenePoint( $cb_info_scenepoint_combat_robot );
	$cb_ai_robot_x_1.setPerceptionFlag( false );
}

#define MAX_HANGAR_REINFORCEMENT 5
void sound_Alarm_hangar( entity activatedEntity, entity activator ) {	
	if ( alarmCalled_hangar ) {
		return;
	}
	
	alarmCalled_hangar = true;
	
	sys.print("ALARM in hangar!\n");
	while ( !alarmOff_hangar ) {
		sys.wait( 4.0f );			
		if ( sys.numActiveAIs() >= MAX_ACTIVE_AIS ) {
			sys.print( "Too many AIs active. Postponing Elite spawning.\n" );
			continue;
		}
		
		if ( numElitesSpawned_hangar > MAX_HANGAR_REINFORCEMENT ) {			
			//spawn_robot( $NULL, $NULL );			
			sys.print( "All elites spawned Cancelling alarm.\n" );
			alarmOff_hangar = true;
			return;
		}
			
		string aiName = "cb_ai_elite_x_" + numElitesSpawned_hangar;
		entity ai = sys.getEntity( aiName );	

		// determine where player is	
		vector playerPos = sys.getPlayerPos();
		string spawnPosName = "";
		entity secScenePoint = $NULL;
		if ( $cb_volume_hangar_section_1.isPointInVolume( playerPos ) ) {
			spawnPosName = "cb_elite_x_section1_1";
			sys.print( "Player in SECTION X 1\n" );
			
			secScenePoint = $cb_info_scenepoint_combat_run_section1;			
			
		} else if ( $cb_volume_hangar_section_2.isPointInVolume( playerPos ) ) {
			spawnPosName = "cb_elite_x_section2_1";
			sys.print( "Player in SECTION X 2\n" );
			
			secScenePoint = $cb_info_scenepoint_combat_run_section2;				
			
		} else if ( $cb_volume_hangar_section_3.isPointInVolume( playerPos ) ) {
			spawnPosName = "cb_elite_x_section3_1";
			sys.print( "Player in SECTION X 3\n" );
						
			secScenePoint = $cb_info_scenepoint_combat_run_section3;				
			
		} else if ( $cb_volume_hangar_section_4.isPointInVolume( playerPos ) ) {
			spawnPosName = "cb_elite_x_section4_1";
			
			secScenePoint = $cb_info_scenepoint_combat_run_section4;							
			sys.print( "Player in SECTION X 4\n" );
		} else {
			sys.print("Player not in any volume, delaying spawn of reinforcements");
			continue;
		}		
		
		// AAS seems a bit broken, they cannot move to the upper level :(
		c06p2spawn( ai, sys.getEntity( spawnPosName ), false, secScenePoint, true, true );
		
		sys.print( "Spawning AI " + aiName );
		sys.print(" at location " + spawnPosName +"\n");		
		numElitesSpawned_hangar++;
	}	
}

boolean hangarDetected = false;
void hangar_detect( entity activatedEntity, entity activator ) {
	if ( hangarDetected ) {
		return;
	}
	hangarDetected = true;
	sys.print("Hangar Detect");
	
	$cb_ai_rifle_x_3.setOverrideScenePoint( $cb_info_scenepoint_combat_113 );
	$cb_ai_rifle_x_3.detectPlayer();
	$cb_ai_rifle_x_4.setOverrideScenePoint( $cb_info_scenepoint_combat_115 );
	$cb_ai_rifle_x_4.detectPlayer();
	$cb_ai_rifle_x_5.setOverrideScenePoint( $cb_info_scenepoint_combat_120 );
	$cb_ai_rifle_x_5.detectPlayer();
	$cb_ai_rifle_x_6.detectPlayer();
	
	sound_Alarm_hangar( activatedEntity, activator );
}

void call_robots_combatmode( entity activatorEntity, entity activator ) {
	// Widen robot FOV so they won't appear retarded when fighting
	$cb_ai_tungsten_c06_part_02_robot_guardrobot_aastest_1.setFOV( 180.0 );
	$cb_ai_tungsten_c06_part_02_robot_guardrobot_aastest128_1.setFOV( 180.0 );
}


object heavyrobot {
	void init();
	void onTrigger( entity activator ){};	
    void onDamage( entity attacker, float health, decl damageDecl, float damageAmount, int killed );	

	void updateGunSight();
	__noedit boolean isDying;
	__noedit float revengeSightTime;
};


void heavyrobot::init() {
	isDying = false;
	revengeSightTime = 0.0;
	sys.wait( 15.0 );
	thread updateGunSight();
}

void heavyrobot::onDamage( entity attacker, float health, decl damageDecl, float damageAmount, int killed ){
	if ( killed == 1 ) {
		isDying = true;
	} else {
		// When damaged, we can "see" from our guns for a while
		revengeSightTime = sys.getTime() + 10.0f;
	}	
};	


void heavyrobot::updateGunSight() {
	// Fake sight from guns since level has way too much stuff at robot eye height
	boolean teslaSight = false;
	while ( !isDying ) {
		
		// Only allow this when recently damaged
		if ( sys.getTime() < revengeSightTime ) {
			// Alternate between laser and tesla gun
			entity sightPos = $cb_info_null_heavyrobot_gunaim;
			if ( teslaSight ) {
				sightPos = $cb_info_null_heavyrobot_teslaaim;
			} 
			teslaSight = !teslaSight;

			// Check angle
			if ( ClampAngle( sightPos.angleTo( $player1 ) ) < 30.0 ) {
				// Check LOS towards player head height
				vector aimPoint = $player1.getWorldOrigin();
				aimPoint_z = Vec_z( $player1.getAimPoint( AIMPOINT_HEAD ) );
				if ( sys.tracePoint( sightPos.getWorldOrigin(), aimPoint, CLIPMASK_SHOT, $player1 ) == 1.0f ) {
					self.fakeSenseStimulus( AISTIMULUS_SIGHT, $player1, $player1.getWorldOrigin(), 0.45 );   	
				}
			}
		}
		
		sys.wait( 0.5 );	
	}
}


