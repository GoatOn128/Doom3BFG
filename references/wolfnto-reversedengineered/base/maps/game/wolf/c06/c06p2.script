void call_blastdoor_startpos ( entity activatorEntity, entity activator )
{
	$gp_mover_lab_blastdoor_left.time( 0.1 );
	$gp_mover_lab_blastdoor_left.move( DIR_BACK, 52 );	
	
	$gp_mover_lab_blastdoor_right.time( 0.1 );
	$gp_mover_lab_blastdoor_right.move( DIR_FORWARD, 52 );
}

void call_blastdoor ( entity activatorEntity, entity activator )
{
	$gp_mover_lab_blastdoor_left.time( 0.5 );
	$gp_mover_lab_blastdoor_left.accelTime( 0.2 );
	$gp_mover_lab_blastdoor_left.move( DIR_FORWARD, 52 );	
	
	$gp_mover_lab_blastdoor_right.time( 0.5 );
	$gp_mover_lab_blastdoor_right.accelTime( 0.2 );
	$gp_mover_lab_blastdoor_right.move( DIR_BACK, 52 );
}

void call_lkw( entity activatedEntity, entity activator ) 
{
	sys.wait( 2 );
	
	$fx_lkw_light.activate( activator );
	$gp_use_pickup_lkw.makeActivatable( false );
	
	$sound_sp_laser_rises.activate( activator );
	
	$gp_moverjoint_lkw_mount_ring.time(1.0f);
	$gp_moverjoint_lkw_mount_ring.accelTime( 0.5f );
	$gp_moverjoint_lkw_mount_ring.decelTime( 0.5f );
	$gp_moverjoint_lkw_mount_ring.rotateOnce('0 0 40');
	
	sys.wait( 1.3f );

	$sound_sp_laser_turns.activate( activator );
	$sound_sp_laser_cut.activate( activator );
	$sound_sp_laser_cut_success.activate( activator );
	
	$gp_dummy_fire_laser.activate( activator );
	$fx_lkw_trail.activate( activator );
	
	$gp_moverjoint_lkw_mount_rotating.time(3.0f);
	$gp_moverjoint_lkw_mount_rotating.rotateOnce('720 0 0');
	
	$gp_activate_hurt_lkwlaser.activate( activator );	
	
	sys.wait( 3.5f );
	
	$sound_sp_laser_down.activate( activator );
	$gp_moverjoint_lkw_mount_ring.time(1.0f);
	$gp_moverjoint_lkw_mount_ring.accelTime( 0.5f );
	$gp_moverjoint_lkw_mount_ring.decelTime( 0.5f );
	$gp_moverjoint_lkw_mount_ring.rotateOnce('0 0 -40');
	
	$fx_laserkw_noblock_temp.activate( activator );	
	$fx_lkw_trail.activate( activator );
	
	$gp_inactivate_hurt_lkwlaser.activate( activator );
		
	sys.wait( 1.0f );	
	
	$gp_prop_use_lkwbutton.show();
	$gp_use_pickup_lkw.makeActivatable( true );
	$gp_show_use_pickup_lkw.activate( activator );
	$fx_lkw_light.activate( activator );
}

void call_cutlkwchain( entity activatedEntity, entity activator ) 
{
	$gp_animatedsimple_enginepath_lkwbarrier.setAnimState( 0, 0, false );
	
	$fx_laserkw.makeActivatable( true );
	$fx_laserkw_blocked.makeActivatable( false );
	$gp_show_use_pickup_lkw.makeActivatable( true );
	$gp_dynamic_lkw_barrier.remove();
	$fx_lkw_trail.remove();
	
	$sound_fade_success_layer.activate( activator );
}

void call_lockpick_lkw( entity activatedEntity, entity activator ) 
{
	$gp_mover_lkw_hatch.time( 1.5f );
	$gp_mover_lkw_hatch.decelTime( 1.0f );
	$gp_mover_lkw_hatch.move( DIR_BACK, 10 );
	
	sys.wait( 1.8f );
	$gp_mover_lkw_hatch.time( 1.0f );
	$gp_mover_lkw_hatch.decelTime( 1.0f );
	$gp_mover_lkw_hatch.move( DIR_LEFT, 130 );
	
	$gp_use_pickup_lkw.show();
}



