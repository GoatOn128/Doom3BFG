void call_chase_to_ruble_safety (entity activatedEntity, entity activator )
{          	
	$gp_firstpersonevent_chase_toruble.activate (activator );
	$gp_changestate_chase_to_ruble.activate( activator );
	$gp_target_anim_changestate_1.activate( activator );
	$gp_delay_car.activate( activator );	
}


