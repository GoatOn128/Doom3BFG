void call_panzerhund_death_safety (entity activatedEntity, entity activator )
{   	
		$gp_changestate_panzerhund_maze_die.activate( activator );
		$gp_firstpersonevent_chase_panzerhud_death.activate (activator );
		$gp_ai_panzerhund_chase.remove();
		$gp_changestate_panzerhund_death.activate( activator );
		$sound_music_modifier_cue_2_off.activate( activator );
		$gp_remove_panzerhund_ruble.activate( activator );
		$gp_trigger_call_panzerhund_death.remove();
		$gp_trigger_call_panzerhund_death_safety.remove();
}

