void main() {

}

void secretdooropen( entity activatedEntity, entity activator )
{
//	 $sound_sp_train_door.activate( activator );	
     $gp_func_movers_mover_secretdoor.time( 7.0 );
     $gp_func_movers_mover_secretdoor.accelTime( 2 );
     $gp_func_movers_mover_secretdoor.decelTime( 2 );
     $gp_func_movers_mover_secretdoor.move( DIR_BACK, 520 );
}

void secretdoorclose( entity activatedEntity, entity activator )
{
//	 $sound_sp_train_door.activate( activator );	
     $gp_func_movers_mover_secretdoor.time( 7.0 );
     $gp_func_movers_mover_secretdoor.accelTime( 2 );
     $gp_func_movers_mover_secretdoor.decelTime( 2 );
     $gp_func_movers_mover_secretdoor.move( DIR_BACK, -1300 );
}

