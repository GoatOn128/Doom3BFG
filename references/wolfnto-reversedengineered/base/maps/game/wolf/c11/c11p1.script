//View free look 
void freelook( entity activatedEntity, entity activator ) {
	$thirdPersonHands_0.setViewAnglesFromCamera();
	$thirdPersonHands_0.attachLimitViewCamera( "camera", 5, 1, 30.0f, 30.0f );

}

//View free look 
void freelooktight( entity activatedEntity, entity activator ) {
	$thirdPersonHands_0.setViewAnglesFromCamera();
	$thirdPersonHands_0.attachLimitViewCamera( "camera", 5, 1, 15.0f, 15.0f );
}

