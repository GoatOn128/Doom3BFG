void londonMonitor::destroyedMissilePod( boolean left, entity pod ){
	// Blammo!
	numMissilePods--;
	pod.switchMeshKit( MESH_KIT_GEAR, "Destroyed" );
	missileHintCount = -1;

	// Abort priming effect
	pod.stopFX( FX_CINEMATIC_1 ); 
	
	// Explosion!
	pod.startFX( FX_CINEMATIC_2 );
	
	// No target lock any more
	pod.enableTargetLock( false );

	if ( left ) {
	    self.setAnimStateAdditive( LM_ANIM_ADD_DESTROY_MISSILEPOD_RIGHT );
	} else {
	    self.setAnimStateAdditive( LM_ANIM_ADD_DESTROY_MISSILEPOD_LEFT );
	}
}

void londonMonitor::hitEye() {
	thread state_Blinded();
}

void londonMonitor::hitCore() {
	if ( !allowCoreHits ) {
		return;
	}
	
	// Stop timer closing core hatch
	sys.killThread( "londonMonitor::delayedCloseCoreHatch" );
	
	// Don't allow damage until next time hatch is opened
	$boss_triggers_damagetype_hitnearcore.makeActivatable( false );
	allowCoreHits = false;

	// Only count core hits from fairly close underneath to avoid rocket exploit
	if ( IsWithin2DRange( target.getWorldOrigin(), $boss_triggers_damagetype_core.getWorldOrigin(), 400.0 ) ) {
		// Only count hits when LM is blinded or has lost all missilepods
		if ( ( numMissilePods == 0 ) || isBlinded ) {
			// Damage first time, death the second
			numCoreHits++;
		} else if ( lmUseDebug() ) {
			 sys.drawText( "HIT WHEN NOT VULNERABLE", $boss_triggers_damagetype_core.getWorldOrigin(), 1.0, Vec(1,1,1), 1, 5.0 );
		}
	} else if ( lmUseDebug() ) {
		sys.drawText( "HIT FROM OUTSIDE RANGE", $boss_triggers_damagetype_core.getWorldOrigin(), 1.0, Vec(1,1,1), 1, 5.0 );
		sys.debugCircle( Vec(1,1,1), $boss_triggers_damagetype_core.getWorldOrigin() - Vec(0,0,300), Vec(0,0,1), 400.0, 12, 5 );
	}

	if ( numCoreHits < 2 ) {
		thread updateCoreHit();
	} else {
		die();
	}
}

void londonMonitor::updateCoreHit() {
	coreHitTime = sys.getTime();
	movementType = LM_MOVE_DISTANCE;
    self.setAnimStateAdditive( LM_ANIM_ADD_DESTROY_MISSILEPOD_RIGHT );
    self.startFX( FX_START_DAMAGE_LEVEL_1 );
	sys.killThread( "londonMonitor::delayedSpeakCoreMiss" );
	eyeBeamCooldownTime	= sys.getTime() + 1000.0;
	$boss_triggers_damagetype_hitnearcore.makeActivatable( false );
	$boss_func_animatedsimple_generic_corehatch.enableTargetLock( false );
	self.stopFX( FX_WEAPON_COOLEDAFTEROVERHEATED );

	sys.wait( 1.0 );
	
	if ( !hasSpokenCoreHit && ( numCoreHits == 1 ) ) {
		// Klaus cheers
		if ( speak( $boss_vo_klaus_feedback_niceshootingagain_7076 ) ) {
			hasSpokenCoreHit = true;
		}	
	} else if ( !speakKlausEncouragement() ) {
		// Stop hitting me in ze core!
		speakDamaged( true );
	}
	
	// Don't close core hatch until hit effects have had time to play out
	sys.wait( 1.0 );
	closeCoreHatch();
	eyeBeamCooldownTime	= sys.getTime();	
//	if ( lmUseDebug() ) sys.drawText( "CORE HIT DONE", self.getWorldOrigin() + Vec(0,0,100), 2, Vec(1,1,1), ALIGN_RIGHT, 5.0);
}

void londonMonitor::hitNearCore() {
	if ( !hasSpokenCoreMiss && ( sys.getTime() > coreHitTime + 10.0 ) ) {
		// Start delayed thread that will be killed if we hit core
		thread delayedSpeakCoreMiss();
	}
}

void londonMonitor::destroyedMachineguns() {
	machinegunsDestroyed = true;
	deactivateMachineGuns();
}

void londonMonitor::updateFlameThrower( boolean waitForSpeak, float pilotFlameDuration, float burnDuration, float cooldown ) {
	// Flammenwerfer: es werfs flammen!
	sys.wait( 1.0 );
//	if ( lmUseDebug() ) sys.drawText( "FLAME ON!", self.getWorldOrigin() + Vec(0,0,200), 2, Vec(1,0,0), ALIGN_RIGHT, 5.0);

	if ( sys.getTime() < flameThrowerCooldownTime ) {
		return;
	}
	
	// Don't allow flame thrower to restart while burning
	flameThrowerCooldownTime = sys.getTime() + 1000.0;

	// Ignite pilot flame
	self.startFX( FX_EXPLODABLE_STEAM_02 );
	
	// Wait a while then unleash the area hurtsings
	float minTime = sys.getTime() + pilotFlameDuration;
	while ( ( waitForSpeak && ( sys.getTime() < speakTimeout ) ) || // Waiting for speak
			( sys.getTime() < minTime ) ) {							// Waiting for mintime
		sys.wait( 0.2 );
	}

	// Burn baby, burn!
	self.stopFX( FX_EXPLODABLE_STEAM_02 );
	self.startFX( FX_EXPLODABLE_STEAM_01 );
	float damageTime = sys.getTime() + burnDuration;
	float damageChance = 0.0;
	while ( sys.getTime() < damageTime ) {
//		if (lmUseDebug()) sys.debugCircle( Vec(1,0,0), self.getWorldOrigin(), Vec(0,0,1), 250.0f, 16, 0 );
		if ( self.distanceTo( $player1 ) < 250.0f ) {
			vector away = $player1.getWorldOrigin() - self.getWorldOrigin(); 
			if ( damageChance > 1.0 ) {
				$player1.damage( self, self, @damage( "damage/tungsten/ai/londonmonitor_gas" ), 1.0f, away );
				damageChance = 0.0;
			} else {
				damageChance = damageChance + sys.random( 1.0 );
			}
			$player1.pushSoft( away, 100.0f, 0.1f );
		}
		sys.waitFrame();
	}
	self.stopFX( FX_EXPLODABLE_STEAM_01 );

	flameThrowerCooldownTime = sys.getTime() + cooldown;
}

void londonMonitor::abortFlameThrower() {
	sys.killThread( "londonMonitor::updateFlameThrower" );
	self.stopFX( FX_EXPLODABLE_STEAM_02 );
	self.stopFX( FX_EXPLODABLE_STEAM_01 );
	flameThrowerCooldownTime = sys.getTime();
}

int londonMonitor::getMove()
{
	if ( movementType == LM_MOVE_STOP ) {
		// Stop when we reach mh, then maintain it. 
		return -1;
	}

	int bestSpot = 0;
	if ( movementType == LM_MOVE_RANDOM ) {
		// Move to random position. 
		bestSpot = sys.randomInt( 5 );	
		
		// Stay put if already there
		if ( currentPos == bestSpot ) {
			return -1;
		}
		
	} else {
		// Move towards/away from target or go to center if already at best position
		float bestDistance;
		if ( movementType == LM_MOVE_DISTANCE ) {
			bestDistance = -1;
		} else  {
			bestDistance = 1000000;
		}

		float distance;
		vector pos;
		int i = 0;
		for( ;i < 4; i++ ) {
			pos = sys.getEntity( "boss_sensor_" + i ).getOrigin();	
			
			distance = sys.vecLength( knownTargetPos - pos );
			
			if ( ( ( movementType == LM_MOVE_CLOSE ) && ( distance < bestDistance ) ) || 
				 ( ( movementType == LM_MOVE_DISTANCE ) && ( distance > bestDistance ) ) ) {						
				bestDistance = distance;
				bestSpot = i;
			}
		}
		
		if ( bestSpot == currentPos ) {
			// Already at best spot, move to center or randomly away if there.
			if ( bestSpot == 4) {
				bestSpot = sys.randomInt( 4 ); 
			} else {
				bestSpot = 4;
			}
		}
	}

	if ( currentPos != 4 ) { 
		// Not at center or best spot. Move to center and see where we want to go when we get there.  
		// Anim to get to center = current pos + 2 % 4 (See above)
		bestSpot = ( currentPos + 2 ) % 4;
		currentPos = 4;
		return bestSpot;
		
	} else { 
		// We are in center, anim to get to best pos = bestSpot
		currentPos = bestSpot;
		return bestSpot;
	}
}


void londonMonitor::updateMovement() {

	if ( isDying ) {
		return;
	}
			
	waitForMovement = false;

	// Movement is updated whenever a movement anim is finished (via triggerAnimDone on the monitor) or periodically when static.
	// Pause for a while after each movement
	if ( self.getAnimState() != LM_ANIM_MH ) {
		self.setAnimState( LM_ANIM_MH, 200, false);
	}
	sys.wait( 1.0 );
	
	// Time to select next move
	while ( !isDying ) {
		int anim = getMove();
		if ( anim >= 0 ) {
			self.setAnimState(anim, 200, false);
			return;		
		} else {
			// Stay put in mh
			if ( self.getAnimState() != LM_ANIM_MH ) {
				self.setAnimState( LM_ANIM_MH, 200, false);
			}
		}
		sys.wait( 2.0 );
	}
}

void londonMonitor::updateFocus() {

	// Track towards target until we can lock or target hides
	float focusMinRange = lmParmFloat( "focusMinRange" );
	float focusMinRangeSqr = focusMinRange * focusMinRange;
	float trackingMaxSpeed = lmParmFloat( "trackingMaxSpeed" );
	float targetLockDistance = lmParmFloat( "targetLockDistance" );
	float focusAcc = lmParmFloat( "focusAcc" );
	float trackingAccClamp = lmParmFloat( "trackingAccClamp" );
	
	while ( true ) {

		// Check if focus can move in a straight line towards target or if it has to detour around us.
		vector acceleration;
		vector moveDir = knownTargetPos - focus.getWorldOrigin();
		if ( moveDir != Vec(0,0,0) ) {
			moveDir_z = 0.0;
			float moveDistance = sys.vecLength( moveDir );
			moveDir = moveDir / moveDistance; // Normalize 
			vector toFocus = focus.getWorldOrigin() - self.getWorldOrigin();
			toFocus_z = 0.0;
			float moveDirToFocusDot = sys.vecDotProduct( moveDir, toFocus );
			float sqrFactor = Square( moveDirToFocusDot ) - sys.vecDotProduct( toFocus, toFocus ) + focusMinRangeSqr;
			if ( sqrFactor <= 0.0 ) {
				// Line from focus to target pos does not intersect focus min range circle (or just touches it), move in straight line 
				acceleration = moveDir;
			} else if ( moveDirToFocusDot > 0.0 ) {
				// Focus wants to move away from us, move in straight line
				acceleration = moveDir;
			} else {
				// Line does intersect, check where
				float sqrtFactor = sys.sqrt( sqrFactor );
				float intersectDistance1 = -moveDirToFocusDot - sqrtFactor;
				float intersectDistance2 = -moveDirToFocusDot + sqrtFactor;
				if ( ( intersectDistance1 > moveDistance ) && ( intersectDistance2 > moveDistance ) ) {
					// Target in front of circle, move in straight line
					acceleration = moveDir;
				} else {
					// Target is inside circle or on the other side, flock towards it pushing away from us
					float toFocusDistance = sys.vecLength( toFocus );
					vector repulsion;
					if ( toFocusDistance > moveDistance ) {
						// Front half of circle, push away in direction of target pos
						repulsion = knownTargetPos - self.getWorldOrigin();  
					} else {
						// Back half or beyond circle, push away orthogonally
						repulsion = sys.vecCrossProduct( toFocus, Vec(0,0,1) );
						if ( sys.vecDotProduct( repulsion, knownTargetPos - self.getWorldOrigin() ) < 0.0 ) {
							repulsion = -repulsion;
						}  
					}
					// Repulsion grows when focus nears circle
					repulsion_z = 0.0;
					repulsion = sys.vecNormalize( repulsion ) * 2.0f * ( 400.0 / FMax(400.0, 400.0 + toFocusDistance - focusMinRange ) );
					acceleration = sys.vecNormalize( moveDir + repulsion );
//					if ( lmUseDebug() ) sys.debugArrow( Vec(0.5,1,0), focus.getWorldOrigin() + Vec(0,0,20), focus.getWorldOrigin() + repulsion * 50 + Vec(0,0,20), 5, 0);
				}
			}

			// Accelerate		
			if ( !sys.isValidVector( acceleration ) ) {
				acceleration = Vec( 0,0,0 ); // PS4 failsafe
			} 
			focusVelocity = focusVelocity + acceleration * ( focusAcc * sys.getFrameTime() ); 
			focusVelocity_z = 0.0;
			if ( moveDistance < targetLockDistance ) {
				// Decelerate to target pos
				if ( ( sys.vecDotProduct( moveDir, focusVelocity ) > 0.0 ) && ( sys.vecLength( focusVelocity ) > moveDistance ) ) {
					// Clamp velocity when nearing target
					focusVelocity = sys.vecNormalize( focusVelocity ) * trackingAccClamp * moveDistance;
				}	
			} else {
				// Clamp focus speed
				if ( sys.vecLength( focusVelocity ) > trackingMaxSpeed ) {
					focusVelocity = sys.vecNormalize( focusVelocity ) * trackingMaxSpeed;
				}
			}
			if ( !sys.isValidVector( focusVelocity ) ) {
				focusVelocity = Vec( 0,0,0 ); // PS4 failsafe
			}
			
			// Move focus
			vector newPos = focus.getWorldOrigin() + focusVelocity * sys.getFrameTime();
			if ( IsWithin2DRange( newPos, self.getWorldOrigin(), focusMinRange ) ) {
				// Inside min focus range, push out to nearest edge (note that this allows tunneling, but focus shouldn't move that fast :)).
				vector away = sys.vecNormalize( newPos - self.getWorldOrigin() );
				if ( !sys.isValidVector( away ) ) {
					away = Vec( 1,0,0 );
				}
				newPos = self.getWorldOrigin() + ( away * ( focusMinRange + 10.0 ) );
				focusVelocity = ( newPos - focus.getWorldOrigin() ) / sys.getFrameTime();	
				focusVelocity_z = 0.0;
				if ( ( sys.vecDotProduct( focusVelocity, toFocus ) < 0 ) || !sys.isValidVector( focusVelocity ) ) {
					// Stop velocity towards us
					focusVelocity = Vec(0.0, 0.0, 0.0);
				}
//				if ( lmUseDebug() ) {
//					vector badPos = focus.getWorldOrigin() + focusVelocity * sys.getFrameTime();
//					sys.debugBounds( Vec(0.5,1,0), badPos - Vec(10,10,10), badPos + Vec(10,10,10), 0); 		
//					sys.debugArrow( Vec(0.5,1,0), badPos, newPos, 5, 0);
//				}
			}
			// Straight lerp of focus height
			float focusHeight = Vec_z( focus.getWorldOrigin() );
			newPos_z = focusHeight + ( Vec_z( knownTargetPos ) - focusHeight ) * 0.1f;
			
			if ( sys.isValidVector( newPos ) ) { // PS4 failsafe
				focus.setWorldOrigin( newPos );
			}
		}
		
//		if ( lmUseDebug() ) {
//			sys.debugCircle( Vec(0.5,0.5,0), self.getWorldOrigin(), Vec(0,0,1), focusMinRange, 16, 0);
//			sys.debugBounds( Vec(1,1,0), focus.getWorldOrigin() - Vec(40,40,40), focus.getWorldOrigin() + Vec(40,40,40), 0); 		
//			sys.debugBounds( Vec(0,1,0), knownTargetPos - Vec(20,20,20), knownTargetPos + Vec(20,20,20), 0); 		
//			sys.debugArrow( Vec(0,0.3,0), $boss_checklos_pos.getWorldOrigin(), knownTargetPos, 5, 0); 		
//			sys.debugArrow( Vec(0.5,0.5,0), $boss_checklos_pos.getWorldOrigin(), focus.getWorldOrigin(), 5, 0); 		
//			vector dir = focus.getWorldOrigin() - target.getWorldOrigin();
//			float dist = sys.vecLength( dir );
//			dir = dir / dist;
//			sys.debugArrow( Vec(0.75,0.75,0), target.getWorldOrigin() + Vec(0,0,40), target.getWorldOrigin() + dir * 500.0, 5, 0); 		
//			sys.drawText( "D: " + dist + "F: " + focus.getName() + " / " + $boss_info_null_offsetfocus.getName() + " T: " + target.getName(), self.getWorldOrigin() + Vec(0,0,300), 1.0, Vec(1,1,1), 1, 0 );
//			if ( !sys.isValidFloat( dist ) )
//				sys.drawText( "NAN!!!!!!!!!!!!!!!! ", self.getWorldOrigin() + Vec(0,0,0), 5, Vec(1,1,1), 1, 0 );
//			sys.debugArrow( Vec(1,1,0), focus.getWorldOrigin(), focus.getWorldOrigin() + focusVelocity, 5, 0);
//			sys.debugArrow( Vec(1,0.5,0), focus.getWorldOrigin() + Vec(0,0,10), focus.getWorldOrigin() + acceleration * 50 + Vec(0,0,10), 5, 0);
//		}
				
		// Tick!
		sys.waitFrame();

		checkTargetLOS();
	}
}

boolean londonMonitor::checkTargetLOS() {
	
	// If turret has spotted player, we know his position at least
	if ( $boss_turret_machineguns.enemyVisible() ) {
		targetLocated();
	}		
	
	// Trace from eye (offset outside of own collision) to target aim position to see if anything except the target obstructs the line of sight.
	// Use height of aim position only. XY is above origin, to enable player to lean without being spotted. 
	vector aimPoint = target.getWorldOrigin();
	vector eyePos = $boss_checklos_pos.getWorldOrigin();
	aimPoint_z = Vec_z( target.getAimPoint( AIMPOINT_HEAD ) );
	if ( !isOblivious && ( sys.tracePoint( eyePos, aimPoint, CLIPMASK_SHOT, target ) == 1.0f ) ) {
	
		// In LOS
		targetLocated();
		if ( targetLOSTime < 0.0 ) {
			// We did not have LOS last check, set time if also within forward angle
			if ( ClampAngle( $boss_checklos_pos.angleTo( target ) ) < lmParmFloat( "viewAngle" ) ) {
				targetLOSTime = sys.getTime();
			}
		}

//		if (lmUseDebug()) sys.debugLine( Vec(0,1,0), eyePos, sys.getTraceEndPos(), 0);  
//		if (lmUseDebug()) sys.drawText( "LOS time: " + ( sys.getTime() - targetLOSTime ) , self.getWorldOrigin() + Vec(0,0,700), 5, Vec(0,1,0), ALIGN_RIGHT, 0.01 );
						
		return true;
		
	} else {
		// Not in LOS, reset time and keep known position
		targetLOSTime = -1000.0;
//		if (lmUseDebug()) sys.debugLine( Vec(1,0,0), eyePos, sys.getTraceEndPos(), 0);  
//		if (lmUseDebug()) sys.drawText( "No LOS" , self.getWorldOrigin() + Vec(0,0,700), 5, Vec(1,0,0), ALIGN_RIGHT, 0.01 );
		return false;
	}
}

boolean londonMonitor::hasMaintainedTargetLOS( float _time ) {
	return ( targetLOSTime > 0.0f ) && ( sys.getTime() > targetLOSTime + _time );
}

boolean londonMonitor::targetLocatedRecently( float _time ){
	return ( targetLocatedTime > 0.0f ) && ( sys.getTime() < targetLocatedTime + _time );
}

void londonMonitor::activateMachineGuns(){
	if ( !machinegunsDestroyed ) {
		$boss_turret_machineguns.activate( target );
		$boss_triggers_damagetype_turret1.makeActivatable( true );
		$boss_triggers_damagetype_turret2.makeActivatable( true );
		$boss_triggers_damagetype_turret3.makeActivatable( true );
		$boss_turret_machineguns.enableTargetLock( true );
	}
}

void londonMonitor::deactivateMachineGuns(){
	$boss_turret_machineguns.deactivate();
	$boss_triggers_damagetype_turret1.makeActivatable( false );
	$boss_triggers_damagetype_turret2.makeActivatable( false );
	$boss_triggers_damagetype_turret3.makeActivatable( false );
	$boss_triggers_damagetype_turret1.resetHealth();
	$boss_triggers_damagetype_turret2.resetHealth();
	$boss_triggers_damagetype_turret3.resetHealth();
	$boss_turret_machineguns.enableTargetLock( false );	
}

boolean londonMonitor::speakDamaged( boolean force ) {

	// Always speak the first few damaged lines, then only speak them at random intervals
	// Damaged lines will loop if all have been played
	if ( force || 
		 ( vo_DamagedIndex < 3 ) || 
		 ( sys.random( 1.0 ) < 0.1f ) ) {
		if ( speak( vo_Damaged.get( vo_DamagedIndex % vo_Damaged.size() ) ) ) {
			vo_DamagedIndex++;	
			return true;
		}
	}
	return false;
}

boolean londonMonitor::speakKlausEncouragement() {
	if ( vo_KlausEncouragementIndex < vo_KlausEncouragement.size() ) {
		if ( speak( vo_KlausEncouragement.get( vo_KlausEncouragementIndex ) ) ) { 
			vo_KlausEncouragementIndex++;
			return true;
		}
	}
	return false;
}

void londonMonitor::delayedSpeakCoreMiss() {
	sys.wait( 2.0 );
	
	if ( !hasSpokenCoreMiss ) {
		// Klaus explains
		if ( speak( $boss_vo_klaus_powercore_shootitfrombelow_7058 ) ) {
			hasSpokenCoreMiss = true;
		}	
	} 
}

boolean londonMonitor::speak( entity vo ) {
	if ( sys.getTime() < speakTimeout ) {
		// Can't speak
		return false;
	}

	// Speak!
	vo.activate( self );
	speakTimeout = sys.getTime() + 6.0; // Failsafe, also used for checkpoint intro line 
//	if (lmUseDebug()) sys.println("Speaking " + vo.getName() + " @ " + sys.getTime());	
	return true;
}

void londonMonitor::doneSpeaking() {
	speakTimeout = sys.getTime();
//	if (lmUseDebug()) sys.println("Done speaking @ " + sys.getTime());	
}

void londonMonitor::targetLocated() {
	if ( !isOblivious ) {
		targetLocatedTime = sys.getTime();
		knownTargetPos = target.getWorldOrigin();
	}
}

void londonMonitor::makeOblivious( boolean oblivious ) {
	if ( !isOblivious && oblivious ) {
		targetLocatedTime = -1000.0f;
		targetLOSTime = -1000.0f;
	}
	isOblivious = oblivious;
}

void londonMonitor::targetInHiding() {
	targetInHidingTime = sys.getTime();
}

void londonMonitor::updateBlindedIndicator( float endBlindedTime ){
	// Blink blinding indicator before unblinding
	//if ( sys.getTime() < endBlindedTime - 3.0f ) {
	//	sys.wait( endBlindedTime - 3.0f - sys.getTime() );
	//}
	
