#ifndef C14P1_BOSS
#define C14P1_BOSS

float ClampAngle( float angle ) {
	angle = angle % 360.0;
	if ( angle > 180 ) {
		angle -= 360;
	} 
	if ( angle < -180 ) {
		angle += 360;
	} 
	return angle;
}

float Square( float val ) {
	return val*val;
}

boolean IsWithin2DRange( vector pos1, vector pos2, float range ) {
	return ( Square( pos1_x - pos2_x ) + Square( pos1_y - pos2_y ) < Square( range ) );
};

