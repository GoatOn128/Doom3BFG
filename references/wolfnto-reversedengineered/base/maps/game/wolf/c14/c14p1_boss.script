void londonMonitor::start() {
	startCommon();
	thread state_Intro();
}


void londonMonitor::checkpointStart() {
	startCommon();
	thread state_CheckpointIntro();
}

void londonMonitor::die() {
	isDying = true;
	
	sys.killThread( "londonMonitor::updateMovement" );
	sys.killThread( "londonMonitor::updateFocus" );
	sys.killThread( "londonMonitor::state_Searching" );	
	sys.killThread( "londonMonitor::state_EyeBeam" );	
	sys.killThread( "londonMonitor::state_Blinded" );	
	sys.killThread( "londonMonitor::delayedSpeakCoreMiss" );
	sys.killThread( "londonMonitor::state_Intro" );
	sys.killThread( "londonMonitor::state_CheckpointIntro" );
	
	self.setFocus( $null, false, false, 0 );
	
	// Stop any buildup and core venting effects
	self.stopFX( FX_CINEMATIC_10 );
	focus.stopFX( FX_CINEMATIC_2 );
	self.stopFX( FX_WEAPON_COOLEDAFTEROVERHEATED );

	// Disable damage 	
	$boss_triggers_damagetype_core.makeActivatable( false );
	$boss_triggers_damagetype_hitnearcore.makeActivatable( false );
	deactivateMachineGuns();

	// No target locks
	$boss_func_animatedsimple_generic_corehatch.enableTargetLock( false );
	$boss_func_animatedsimple_generic_eyeshield.enableTargetLock( false );
	$boss_turret_machineguns.enableTargetLock( false );
	$boss_func_animatedsimple_generic_missilepod_left_1.enableTargetLock( false );
	$boss_func_animatedsimple_generic_missilepod_left_2.enableTargetLock( false );
	$boss_func_animatedsimple_generic_missilepod_left_3.enableTargetLock( false );
	$boss_func_animatedsimple_generic_missilepod_right_1.enableTargetLock( false );
	$boss_func_animatedsimple_generic_missilepod_right_2.enableTargetLock( false );
	$boss_func_animatedsimple_generic_missilepod_right_3.enableTargetLock( false );
	
	// Stop any primed effects
	closeMissileHatches();

	int i;
	for ( i = 0; i < vo_KlausHideHint.size(); i++ ) {
		vo_KlausHideHint.get( i ).stopSound( 0, 0 );
	}
	for ( i = 0; i < vo_KlausPowercoreHint.size(); i++ ) {
		vo_KlausPowercoreHint.get( i ).stopSound( 0, 0 );
	}
	for ( i = 0; i < vo_Damaged.size(); i++ ) {
		vo_Damaged.get( i ).stopSound( 0, 0 );
	}
	for ( i = 0; i < vo_Warning.size(); i++ ) {
		vo_Warning.get( i ).stopSound( 0, 0 );
	}
	for ( i = 0; i < vo_Hidden.size(); i++ ) {
		vo_Hidden.get( i ).stopSound( 0, 0 );
	}

	// Blend straight to death enter anim (and hope we don't clip too much geo)
	self.setAnimState( LM_ANIM_DEATH_ENTER, 200, false );
	self.startFX( FX_START_DEATH_1 );
			
	sys.waitFrame();
	sys.killThread( "londonMonitor::updateCoreHit" );
	sys.killThread( "londonMonitor::updateFlameThrower" );
	self.stopFX( FX_EXPLODABLE_STEAM_01 );
	
	// Open hatches	
	$boss_func_animatedsimple_generic_corehatch.setAnimState( LM_ANIM_HATCH_OPEN_MH, 500, false );	
	$boss_func_animatedsimple_generic_eyeshield.setAnimState( LM_ANIM_HATCH_OPEN, 0, false );		
	
	// Wait a while for death enter to go into death MH 
	sys.wait( 3.5 );
	$boss_end_jobs_defeat_london_monitor.activate( target );
	$boss_target_achievement_defeat_london_monitor.activate( target );
	$gp_inventory_givesecrets_secret_model_london_monitor.activate( target ); 
	
	// Wait until player can see LM properly or after timeout
	float deathTimeout = sys.getTime() + 15.0;
	if ( lmUseDebug() ) deathTimeout = deathTimeout + 10000;
	boolean isVisible = false;
	list visibilityPos;
	//visibilityPos.append( $boss_func_mover_footclip1 );	
	//visibilityPos.append( $boss_func_mover_footclip2 );	
	//visibilityPos.append( $boss_func_mover_footclip3 );	
	visibilityPos.append( $boss_checklos_pos );
	while ( !isVisible && ( sys.getTime() < deathTimeout ) ) {
		// Check if player can see LM and is facing towards it
		for ( i = 0; i < visibilityPos.size(); i++ ) {
			vector lookDir = sys.angToForward( $player1.getViewAngles() );
			vector lookPos = $player1.getViewPos();
			vector LMViewPos = visibilityPos.get( i ).getWorldOrigin();// + Vec( 0,0,400 );
			if ( lmUseDebug() ) sys.debugArrow( Vec(1,1,0), lookPos + ( lookDir * 20.0 ) - Vec(0,0,5), LMViewPos, 1, 0.2 );
			
			if ( sys.vecDotProduct( sys.vecNormalize( LMViewPos - lookPos ), lookDir ) > lmParmFloat( "deathViewCos" ) ) {
				// Looking in somewhat that direction
				if ( sys.tracePoint( lookPos + ( lookDir * 20.0 ), LMViewPos, CLIPMASK_SHOT, self ) == 1.0f ) {
					// Have LOS
					if ( lmUseDebug() ) {
						 sys.debugArrow( Vec(0,1,0), lookPos + ( lookDir * 20.0 ), LMViewPos, 1, 0.2 );
					} else {
						isVisible = true;	
						break;
					}
				}		
			}
			
			sys.wait( 0.2 );	
		}
	}
	
	// Start proper death anim 
	self.setAnimState( LM_ANIM_DEATH, 500, false );
		
	// Anim events should do the rest, but just to be safe
	sys.wait( 30.0 );
	$boss_target_nextmap.activate( target ); 
}


void londonMonitor::state_Intro() {
	// Intro dialogue (move to intro anim when done)
	$boss_target_timedevents_introdialogue.activate( self );

	//if ( lmUseDebug() ) sys.drawText( "INTRO", self.getWorldOrigin() + Vec(0,0,800), 10, Vec(1,1,1), ALIGN_RIGHT, 20.0);

	// Start focusing straight forward after a while
	sys.wait( 5.0 );
	targetLocated();
	sys.wait( 15 );
	focus.setWorldOrigin( self.getJointPos( eyeJointHandle ) + sys.angToForward( self.getJointAngle( eyeJointHandle ) ) * 2500.0 );	
	self.setFocus( $boss_info_null_offsetfocus, true, true, 0 ); // Hack: Use offset focus to compensate for aiming bug. It is bound to proper focus.

	// Checkpoint!
	$boss_target_player_checkpoint_bossfight_started.activate( $player1 );

	// Lower focus to search volume level, then start tracking target
	float startSearchingTime = sys.getTime() + 5.0;
	vector startFocusPos = self.getJointPos( eyeJointHandle ) + sys.angToForward( self.getJointAngle( eyeJointHandle ) ) * 2500.0;
	while ( sys.getTime() < startSearchingTime ) {
		sys.waitFrame();

		checkTargetLOS();

		// Lerp focusPos to known target pos over time
		vector focusPos = startFocusPos + ( ( knownTargetPos - startFocusPos ) * ( 1.0 - ( ( startSearchingTime - sys.getTime() ) / 5.0 ) ) );
		focus.setWorldOrigin( focusPos );

//		if (lmUseDebug()) sys.debugArrow( Vec(1,1,1), focus.getWorldOrigin(), self.getJointPos( eyeJointHandle ), 1000, 0 );
//		if (lmUseDebug()) sys.drawText("focus start", self.getWorldOrigin() + Vec(0,0,600), 5.0, Vec(1,1,1), 1, 0); 
	}
	thread updateFocus();
	
	// Wait until done moving
	waitForMovement = true;
	while ( waitForMovement ) {
		sys.waitFrame();
	}
	
	// The task at hand...
	$gp_jobs_defeat_london_monitor.activate( $player1 );

	// Find the little gnat and fry him good
	if ( checkTargetLOS() ) {
		thread state_EyeBeam();
	} else {
		thread state_Searching();
	}
}

void londonMonitor::state_CheckpointIntro() {

	$boss_target_timedevents_introdialogue.hide();
	$boss_target_timedevents_introdialogue.makeActivatable( false );

	// Anim (to position LM correctly)
	self.setAnimState( LM_ANIM_CHECKPOINT, 0, false);

	// Start tracking target.
	sys.wait( 0.1 );
	focus.setWorldOrigin( target.getWorldOrigin() );
	self.setFocus( $boss_info_null_offsetfocus, true, true, 0 ); // Hack: Use offset focus to compensate for aiming bug. It is bound to proper focus.
	
	// The task at hand...
	$gp_jobs_defeat_london_monitor.activate( $player1 );

	//if ( lmUseDebug() ) sys.drawText( "CHECKPOINT INTRO", self.getWorldOrigin() + Vec(0,0,800), 10, Vec(1,1,1), ALIGN_RIGHT, 6.8 );

	// Start updating focus after a while. Safety fix fo PS4.
	sys.wait( 0.8 );
	if ( !IsWithin2DRange( focus.getWorldOrigin(), target.getWorldOrigin(), 10000.0 ) ) {
		focus.setWorldOrigin( target.getWorldOrigin() ); 
	}
	thread updateFocus();
	
	// Checkpoint intro line
	speak( $boss_vo_lm_intro_surrender_7022 ); // This vo won't call speakDone, but failsafe is enough.
	sys.wait( 6.0 );
	speakTimeout = sys.getTime() + 1.0; // So we don't speak immediately again
				
	// Find the little gnat and fry him good
	if ( checkTargetLOS() ) {
		thread state_EyeBeam();
	} else {
		thread state_Searching();
	}

	// Wait for state to decide how to move, then start moving
	sys.wait( 0.1 ); 
	thread updateMovement();
}


void londonMonitor::state_Searching(){

	movementType = LM_MOVE_DISTANCE;
	float hiddenTime = sys.getTime();
	boolean spokenHidden = false;
	float spotTime = lmParmFloat( "spotTime" );
	float hiddenDuration = spotTime + 1.0f;
	float instaSpotTime = eyeBeamCooldownTime + lmParmFloat( "eyeBeamHiddenDuration" );
	float targetLockDistance = lmParmFloat( "targetLockDistance" );
	float targetMinRange = lmParmFloat( "focusMinRange" );
	int checkHiddenIndex = 0;
	boolean checkHiddenPosVisible = false;
	float failsafeTime = sys.getTime() + 20.0;
	
	// Activate machine guns for a while
	activateMachineGuns();
	float activateMachineGunsMinTime = sys.getTime() + lmParmFloat( "turretMinDuration" );
	
	while ( true ) {

		// When hidden for a while, we spot immediately
		float curTime = sys.getTime();
		if ( curTime > instaSpotTime ) {
			spotTime = 0;
		}	
									
		// Has target been in LOS for a while?
		boolean targetLOS = hasMaintainedTargetLOS( spotTime );
		if ( targetLOS ) {
			hiddenTime = curTime;
		}
	
		// Should we speak hidden line? Hidden lines repeat.
		if ( !spokenHidden ) {
			if ( curTime > FMax( hiddenTime + hiddenDuration, speakTimeout + 2.0 ) ) {
				if ( curTime < targetInHidingTime + 1.0f ) {
					if ( speak( vo_Hidden.get( vo_HiddenIndex % vo_Hidden.size() ) ) ) {
						vo_HiddenIndex++;
						spokenHidden = true;
						spotTime = 0;
					}
				}
			}		
		}
		
		// Past laser cooldown and not speaking? 
		if ( ( curTime > eyeBeamCooldownTime ) && 
			 ( curTime > speakTimeout ) && 
			 ( curTime > activateMachineGunsMinTime ) ) {

			// Fire if we have LOS or we have spoken our hidden line (in which case we will fire blindly)
			if ( targetLOS || spokenHidden ) {	
				// Fire if focus is close enough to where we think target is. 
				// Note that since focus can't move within a min range from us, we will never fire eye beam if target is too close. 	
				if ( IsWithin2DRange( focus.getWorldOrigin(), knownTargetPos, targetLockDistance ) ) {
					thread state_EyeBeam();
					return;
				}
			}
		}
		
		// Failsafe, not firing eye gun is a progression blocker
		if ( curTime > failsafeTime ) {
			thread state_EyeBeam();
			return;
		}
				
		// Check LOS from various positions at regular intervals to see if target is in hiding (not just obstructed by ourselves). 
		if ( checkHiddenPosVisible || targetLOS ) {
			// Target is visible
			checkHiddenPosVisible = true;
		} else {
			// We haven't seen target yet this round, check from current position
			vector aimPoint = target.getWorldOrigin();
			aimPoint_z = Vec_z( target.getAimPoint( AIMPOINT_HEAD ) );
			if ( sys.tracePoint( checkHiddenPos.get( checkHiddenIndex ).getWorldOrigin(), aimPoint, CLIPMASK_SHOT, target ) == 1.0f ) {
				checkHiddenPosVisible = true;	
			}
		}
		checkHiddenIndex++;		
		if ( checkHiddenIndex >= checkHiddenPos.size() ) {
			// All positions checked this round
			if ( !checkHiddenPosVisible ) {
				// None could see target, he is in hiding.
				targetInHiding();
			}
			checkHiddenIndex = 0;
			checkHiddenPosVisible = false;
		}
		
		if ( lmUseDebug() ) sys.drawText( "SEARCHING", self.getWorldOrigin() + Vec(0,0,800), 10, Vec(1,1,0), ALIGN_RIGHT, 0.2);
		sys.wait( 0.2f );
	}					
}

void londonMonitor::state_EyeBeam(){
	movementType = LM_MOVE_STOP;
	closeCoreHatch();
		
	if ( lmUseDebug() ) sys.drawText( "FIRE EYE BEAM", self.getWorldOrigin() + Vec(0,0,800), 10, Vec(0,0,1), ALIGN_RIGHT, lmParmFloat( "eyebeambuilduptime" ) + lmParmFloat( "eyebeamfiredpause" ) );

	// No machinegun fire during buildup
	deactivateMachineGuns();
	
	// Speak warning if appropriate
	if ( ( sys.getTime() > speakTimeout + 4.0 ) && ( vo_WarningIndex < vo_Warning.size() ) ) {
		if ( ( vo_WarningIndex < 2 ) || ( sys.random( 1.0 ) < 0.1 ) ) {
			if ( speak( vo_Warning.get( vo_WarningIndex ) ) ) {
				vo_WarningIndex++;
				float turretActivateRange = lmParmFloat( "turretActivateRange" );
				float turretMaxRange = lmParmFloat( "turretMaxRange" );
				while ( sys.getTime() < speakTimeout ) {
					sys.wait( 0.1 );
				}
			}
		}
	} 

	// Eye is vulnerable
	$boss_func_animatedsimple_generic_eyeshield.setAnimState( LM_ANIM_HATCH_OPEN, 0, false );	
	$boss_triggers_damagetype_eye.makeActivatable( true );
	$boss_func_animatedsimple_generic_eyeshield.enableTargetLock( true );	
	float buildUpTime = lmParmFloat( "eyebeambuilduptime" );
	float obliviousTime = lmParmFloat( "eyebeamoblivioustime" );

	// Start buildup (update focus will handle targeting)
	self.startFX( FX_CINEMATIC_10 );
	focus.startFX( FX_CINEMATIC_1 );
	thread buildUpBurn();

	// Start flamethrowers as a precautionary measure so rebel scum won't be able to hit us in the 'nads
	// (they will be aborted if LM is blinded)
	thread updateFlameThrower( false, buildUpTime - obliviousTime - 1.0, lmParmFloat( "coreHatchOpenDuration" ) + 0.5, 1.0 );	

	// Start fire anim 3.1s before shot (must sync this with anim)
	sys.wait( buildUpTime - 3.1 );
	self.setAnimStateAdditive( LM_ANIM_ADD_FIRE_EYEBEAM );	
	
	// When buildup is almost done, we become oblivious (so player can get the hell out of there)
	sys.wait( 3.1 - obliviousTime );
	makeOblivious( true );
	vector trailPos = target.getWorldOrigin();		
	
	// Open core hatch to vent excess heat from reactor.
	openCoreHatch();	
	sys.wait( obliviousTime );
	
	// Eye is no longer vulnerable
	$boss_func_animatedsimple_generic_eyeshield.setAnimState( LM_ANIM_HATCH_CLOSE, 200, false );	
	$boss_triggers_damagetype_eye.makeActivatable( false );
	$boss_triggers_damagetype_eye.resetHealth();
	$boss_func_animatedsimple_generic_eyeshield.enableTargetLock( false );
					
	// Stop buildup effects
	focus.stopFX( FX_CINEMATIC_2 );
	self.stopFX( FX_CINEMATIC_10 );
	
	// Fire!
	$boss_dummyfire_eyegun_blast.activate( self );
	if ( numMissilePods > 0 ) {
		eyeBeamCooldownTime	= sys.getTime() + lmParmFloat( "eyebeamCooldown" );
	}
	
	// Speak Klaus hint line if available
	sys.wait( lmParmFloat( "eyebeamfiredpause" ) );
	makeOblivious( false );
	knownTargetPos = trailPos;
	if ( numMissilePods > 0 ) {
		if ( blindingHintCount > -1 ) {
			blindingHintCount++;
		}	
		if ( blindingHintCount == 4 ) {
			if ( !speak( $boss_vo_klaus_eyehint_laser_7061 ) ) {
				blindingHintCount--;
			}
		} else if ( blindingHintCount == 6 ) {
			if ( !speak( $boss_vo_klaus_eyehint_charging_7062 ) ) {
				blindingHintCount--;
			}
		} else if ( vo_KlausHideHintIndex < vo_KlausHideHint.size() ) {
			if ( speak( vo_KlausHideHint.get( vo_KlausHideHintIndex ) ) ) {
				vo_KlausHideHintIndex++;
			}
		}
	} else {
		// No missile pods left, hint about the power core if player is not underneath it already
		if ( ( vo_KlausPowercoreHintIndex < vo_KlausPowercoreHint.size() ) && 
			 ( self.distanceTo( target ) > 600.0f ) ) {
			if ( speak( vo_KlausPowercoreHint.get( vo_KlausPowercoreHintIndex ) ) ) {
				vo_KlausPowercoreHintIndex++;
			}
		}
	}
						
	thread state_Searching();
}

void londonMonitor::state_Blinded() {
	// Abort current beamer and flammenwerfer
	sys.killThread( "londonMonitor::state_EyeBeam" );	
	abortFlameThrower();
	
	// Stop any buildup effect
	self.stopFX( FX_CINEMATIC_10 );
	focus.stopFX( FX_CINEMATIC_2 );

	// Abort buildup effect
    self.startFX( FX_TESLA_ABORT );
	
	// Target shot us so we know where he is. That location will get clobbered by missiles.
	targetLocated();
	
	// Can't see!
	blindingHintCount = -1;
	isBlinded = true;
	makeOblivious( true );
	self.setAnimStateAdditive( LM_ANIM_ADD_BLINDED );
	movementType = LM_MOVE_RANDOM;
	deactivateMachineGuns();

	// Eye is no longer vulnerable
	$boss_triggers_damagetype_eye.makeActivatable( false );
	$boss_func_animatedsimple_generic_eyeshield.setAnimState( LM_ANIM_HATCH_CLOSE, 200, false );	
	$boss_func_animatedsimple_generic_eyeshield.enableTargetLock( false );
		
	// Stay blind for a while
	float blindedEndTime;
	if ( numMissilePods > 0 ) {
		blindedEndTime = sys.getTime() + lmParmFloat( "blindedDuration" );
	} else {
		blindedEndTime = sys.getTime() + lmParmFloat( "blindedDuration" ) * 0.4f;
	}
	float fireMissilesTime = sys.getTime() + lmParmFloat( "missilesCooldown" );
	int numMissilePodsStart = numMissilePods;
	thread updateBlindedIndicator( blindedEndTime );

	// Open core hatch to vent aborted build up heat after a while
	sys.wait( 0.5f );
	openCoreHatch();
	
	// Speak blinded lines
	sys.wait( 1.5f );
	if ( !hasSpokenBlinded ) {
		// First time both Klaus and LM speak if possible
		if ( speak( $boss_vo_klaus_feedback_crackshootingblinded_7072 ) ) {
			hasSpokenBlinded = true;
			while ( sys.getTime() < speakTimeout ) {
				sys.wait( 0.2f );
			}
			sys.wait( 1.0f );
			blindedEndTime = sys.getTime() + lmParmFloat( "blindedDuration" ); // Extend blinded time			
		}
	}
	
	if ( numMissilePods > 0 ) { 
		// Have pods left, speak damaged lines sometimes, Klaus encouragement sometimes
		if ( !speakDamaged( false ) ) {
			speakKlausEncouragement();			
		}
	} else {
		// No missile pods left, hint about the power core if we have lines left
		if ( vo_KlausPowercoreHintIndex < vo_KlausPowercoreHint.size() ) {
			if ( speak( vo_KlausPowercoreHint.get( vo_KlausPowercoreHintIndex ) ) ) {
				vo_KlausPowercoreHintIndex++;
			}
		} else {
			// No pods and no Klaus lines, fill the inaction with impotent complaining
			speakDamaged( true );
		}
	}	
	
	boolean hasSpokenMissilePodDestroyed = false;
	while ( sys.getTime() < blindedEndTime ) {
		if ( lmUseDebug() ) sys.drawText( "BLINDED", self.getWorldOrigin() + Vec(0,0,800), 10, Vec(0,0,1), ALIGN_RIGHT, 0.5 );
				
		// Fire missiles if...
		if ( ( sys.getTime() > speakTimeout ) && 			// We're not speaking
			 ( numMissilePods > 0 ) && 						// We have pods left
			 ( sys.getTime() > fireMissilesTime ) && 		// We're past cooldown
			 ( numMissilePodsStart == numMissilePods ) ) {	// No pod has been destroyed during this blinded period
			
			// Prepare to fire missiles!	
			openMissileHatches();
			primeMissiles();
			sys.wait( 0.5f );
			
			// Klaus warning if not already used
			if ( !hasSpokenMissilesWarning ) {
				if ( speak( $boss_vo_klaus_warning_missiles_7019 ) ) {
					hasSpokenMissilesWarning = true;
				}
			} else if ( missileHintCount == 5 ) {
				if ( !speak( $boss_vo_klaus_missilehint_openup_7065 ) ) {
					missileHintCount--; 
				}
			}
			
			sys.wait( 2.5f );
			
			// Fire missiles blindly
			missiletarget.setWorldOrigin( focus.getWorldOrigin() );
//			if (lmUseDebug()) {
//				sys.debugArrow( Vec(1,0,0), $boss_dummy_fire_left_rocket_1.getWorldOrigin(), missiletarget.getWorldOrigin(), 10, 5.0f );	
//				sys.debugArrow( Vec(1,0,0), $boss_dummy_fire_right_rocket_1.getWorldOrigin(), missiletarget.getWorldOrigin(), 10, 5.0f );	
//			}
			
			// Fire!
			if ( numMissilePods > 0 ) {
				// Should replace this firing sequence with anim events
				float minInterval = lmParmFloat( "missileBarrageIntervalMin" );
				float maxInterval = lmParmFloat( "missileBarrageIntervalMax" );
				if ( !missilePodLeft1Destroyed ) {
					$boss_dummy_fire_left_rocket_1.activate( self );
					$boss_func_animatedsimple_generic_missilepod_left_1.stopFX( FX_CINEMATIC_1 );
				}
				if ( !missilePodRight1Destroyed ) {
					$boss_dummy_fire_right_rocket_1.activate( self );
					$boss_func_animatedsimple_generic_missilepod_right_1.stopFX( FX_CINEMATIC_1 );
				}
				sys.wait( RandomRangeFloat(minInterval, maxInterval) ); 
				if ( !missilePodLeft2Destroyed ) {
					$boss_dummy_fire_left_rocket_2.activate( self );
					$boss_func_animatedsimple_generic_missilepod_left_2.stopFX( FX_CINEMATIC_1 );
				}
				if ( !missilePodRight2Destroyed ) {
					$boss_dummy_fire_right_rocket_2.activate( self );
					$boss_func_animatedsimple_generic_missilepod_right_2.stopFX( FX_CINEMATIC_1 );
				}
				sys.wait( RandomRangeFloat(minInterval, maxInterval) ); 
				if ( !missilePodLeft3Destroyed ) {
					$boss_dummy_fire_left_rocket_3.activate( self );
					$boss_func_animatedsimple_generic_missilepod_left_3.stopFX( FX_CINEMATIC_1 );
				}
				if ( !missilePodRight3Destroyed ) {
					$boss_dummy_fire_right_rocket_3.activate( self );
					$boss_func_animatedsimple_generic_missilepod_right_3.stopFX( FX_CINEMATIC_1 );
				}
			}
			
			// Wait until just after first impact
			sys.wait( 1.0 ); // TODO: Detect impact
			
			// Wait a while before firing missiles again
			fireMissilesTime = sys.getTime() + lmParmFloat( "missilesCooldown" );
			
			// Wait a while before using eye gun
			eyeBeamCooldownTime	= sys.getTime() + lmParmFloat( "eyebeamCooldown" ) + 1.0;
			
			// We assume target has moved but have no idea where, so take a wild guess
			knownTargetPos_x = knownTargetPos_x + ( 2 * sys.randomInt( 2 ) - 1) * RandomRangeFloat( 800.0, 1600.0 );
			knownTargetPos_y = knownTargetPos_y + ( 2 * sys.randomInt( 2 ) - 1) * RandomRangeFloat( 800.0, 1600.0 );
		}

		if ( numMissilePods < numMissilePodsStart ) {
			missileHintCount = -1;
			if ( !hasSpokenMissilePodDestroyed ) {
				// Speak indignant line because someone destroyed a missile pod		
				closeMissileHatches();
				sys.wait( 1.0 );
				if ( speakDamaged( numMissilePodsStart == 6 ) ) {
					hasSpokenMissilePodDestroyed = true;
				}
			} 
		}
		
		sys.wait( 0.1 );
	}

	closeMissileHatches();
	
	if ( missileHintCount > -1 ) {
		missileHintCount++;
		if ( missileHintCount == 3 ) {
			// Try to speak missile hint until we succeed
			sys.wait( 1.0 );
			if ( !speak( $boss_vo_klaus_missilehint_explodeinpod_7064 ) ) {
				missileHintCount--; 
			}
		}
	}
		
	// We can see again! Hooray!
	makeOblivious( false );
	isBlinded = false;
		
	thread state_Searching();
}


void londonMonitor::buildUpBurn() {
	// Start suffering damage after being in the build up beam for a while
	 float buildUpEndTime = sys.getTime() + lmParmFloat( "eyebeambuilduptime" );
	 float burnedDuration = 0.0f;
	 while ( sys.getTime() < buildUpEndTime ) {
		if ( hasMaintainedTargetLOS( 0.5 ) ) {
			vector toTarget = target.getWorldOrigin() - focus.getWorldOrigin();
			float dist = sys.vecLength( toTarget );
			if ( dist < 300.0 ) {
				// Only suffer damage if near enough and in LOS
				float damageScale = 1.0;
				if ( Vec_z( target.getWorldOrigin() ) < Vec_z( self.getWorldOrigin() ) - 50.0f ) {
					// It's safer belowground
					burnedDuration = burnedDuration + 0.05;
					damageScale = 0.5;
				} else {
					burnedDuration = burnedDuration + 0.1;
				}
				
				if ( burnedDuration > 2.0 ) {
					if ( dist > 100.0 ) {
						damageScale = damageScale * ( 1.0 - ( ( dist - 100.0 ) * 0.005 ) );
					}
					target.damage( self, self, @damage( "damage/tungsten/ai/londonmonitor_eyegun_buildup" ), damageScale, toTarget );
				}
			}
		}
		sys.wait( 0.1 );
	 }
}

void londonMonitor::openCoreHatch(){
	if ( !coreHatchOpen ) {
		coreHatchOpen = true;
		$boss_func_animatedsimple_generic_corehatch.setAnimState( LM_ANIM_HATCH_OPEN, 0, false );	
		$boss_triggers_damagetype_core.makeActivatable( true );
		allowCoreHits = true; // Enable/disable damagetype trigger should be enough, but isn't. Events may be delayed perhaps? 
		$boss_triggers_damagetype_hitnearcore.makeActivatable( true );
		$boss_func_animatedsimple_generic_corehatch.enableTargetLock( true );
		self.startFX( FX_WEAPON_OVERHEATED );
		self.startFX( FX_WEAPON_COOLEDAFTEROVERHEATED );
		sys.killThread( "londonMonitor::delayedCloseCoreHatch" );
		if ( numMissilePods > 0 ) {
			// Auto close the hatch after a while. Longer duration when more missile pods have been destroyed.
			thread delayedCloseCoreHatch( lmParmFloat( "coreHatchOpenDuration" ) - ( 0.5 * numMissilePods ) + 0.5 );
		} else {
			// Auto close the hatch after longer time when missile pods have been destroyed
			thread delayedCloseCoreHatch( lmParmFloat( "coreHatchOpenDuration" ) + 3.0 );
		}
	}
}

void londonMonitor::closeCoreHatch(){
	if ( coreHatchOpen ) {
		coreHatchOpen = false;
		$boss_func_animatedsimple_generic_corehatch.setAnimState( LM_ANIM_HATCH_CLOSE, 200, false );	
		$boss_triggers_damagetype_hitnearcore.makeActivatable( false );
		allowCoreHits = false; 
		$boss_func_animatedsimple_generic_corehatch.enableTargetLock( false );
		self.stopFX( FX_WEAPON_COOLEDAFTEROVERHEATED );
		
		// Fire off flame throwers for good measure :)
		thread updateFlameThrower( true, 3.0, 5.0, 1.0 );

		sys.wait( 0.3 );
		$boss_triggers_damagetype_core.makeActivatable( false );
	}
}

void londonMonitor::delayedCloseCoreHatch( float delay ) {
	if ( isBlinded || ( numMissilePods == 0 ) || ( delay <= 1.0 ) ) {
		// Player should be able to shoot hatch keep it open the entire duration
		sys.wait( delay );
	} else {
		// Wait a short while, then close when delay is up or player comes near hatch
		float closeTime = sys.getTime() + delay;
		sys.wait( 1.0 );
		while ( sys.getTime() < closeTime ) { 
			if ( IsWithin2DRange( target.getWorldOrigin(), $boss_triggers_damagetype_core.getWorldOrigin(), 400.0 ) ) {
				// Close prematurely
				if ( lmUseDebug() ) sys.drawText( "PLAYER NEAR, CLOSE HATCH PREMATURELY", $boss_triggers_damagetype_core.getWorldOrigin(), 1.0, Vec(1,1,1), 1, 5.0 );
				break;
			}
			sys.wait( 0.1 );
		}
	}
	closeCoreHatch();
}


void londonMonitor::openMissileHatches(){
	if ( !missileHatchesOpen ) {
		missileHatchesOpen = true;
		$boss_func_animatedsimple_generic_missilepod_left_1.setAnimState( LM_ANIM_HATCH_OPEN, 0, false );	
		$boss_func_animatedsimple_generic_missilepod_left_2.setAnimState( LM_ANIM_HATCH_OPEN, 0, false );	
		$boss_func_animatedsimple_generic_missilepod_left_3.setAnimState( LM_ANIM_HATCH_OPEN, 0, false );	
		$boss_func_animatedsimple_generic_missilepod_right_1.setAnimState( LM_ANIM_HATCH_OPEN, 0, false );	
		$boss_func_animatedsimple_generic_missilepod_right_2.setAnimState( LM_ANIM_HATCH_OPEN, 0, false );	
		$boss_func_animatedsimple_generic_missilepod_right_3.setAnimState( LM_ANIM_HATCH_OPEN, 0, false );	
	}
}

void londonMonitor::primeMissiles() {
	// Prime missile pods
	if ( !missilePodLeft1Destroyed ) {
		$boss_func_animatedsimple_generic_missilepod_left_1.startFX( FX_CINEMATIC_1 );
		$boss_triggers_damagetype_missilepod_left_1.makeActivatable( true );
		$boss_func_animatedsimple_generic_missilepod_left_1.enableTargetLock( true );
	}
	if ( !missilePodLeft2Destroyed ) {
		$boss_func_animatedsimple_generic_missilepod_left_2.startFX( FX_CINEMATIC_1 );
		$boss_triggers_damagetype_missilepod_left_2.makeActivatable( true );
		$boss_func_animatedsimple_generic_missilepod_left_2.enableTargetLock( true );
	}
	if ( !missilePodLeft3Destroyed ) {
		$boss_func_animatedsimple_generic_missilepod_left_3.startFX( FX_CINEMATIC_1 );
		$boss_triggers_damagetype_missilepod_left_3.makeActivatable( true );
		$boss_func_animatedsimple_generic_missilepod_left_3.enableTargetLock( true );
	}
	if ( !missilePodRight1Destroyed ) {
		$boss_func_animatedsimple_generic_missilepod_right_1.startFX( FX_CINEMATIC_1 );
		$boss_triggers_damagetype_missilepod_right_1.makeActivatable( true );
		$boss_func_animatedsimple_generic_missilepod_right_1.enableTargetLock( true );
	}
	if ( !missilePodRight2Destroyed ) {
		$boss_func_animatedsimple_generic_missilepod_right_2.startFX( FX_CINEMATIC_1 );
		$boss_triggers_damagetype_missilepod_right_2.makeActivatable( true );
		$boss_func_animatedsimple_generic_missilepod_right_2.enableTargetLock( true );
	}
	if ( !missilePodRight3Destroyed ) {
		$boss_func_animatedsimple_generic_missilepod_right_3.startFX( FX_CINEMATIC_1 );
		$boss_triggers_damagetype_missilepod_right_3.makeActivatable( true );
		$boss_func_animatedsimple_generic_missilepod_right_3.enableTargetLock( true );
	}
}

void londonMonitor::closeMissileHatches(){
	// Abort priming effect
	$boss_func_animatedsimple_generic_missilepod_left_1.stopFX( FX_CINEMATIC_1 );
	$boss_func_animatedsimple_generic_missilepod_left_2.stopFX( FX_CINEMATIC_1 );
	$boss_func_animatedsimple_generic_missilepod_left_3.stopFX( FX_CINEMATIC_1 );
	$boss_func_animatedsimple_generic_missilepod_right_1.stopFX( FX_CINEMATIC_1 );
	$boss_func_animatedsimple_generic_missilepod_right_2.stopFX( FX_CINEMATIC_1 );
	$boss_func_animatedsimple_generic_missilepod_right_3.stopFX( FX_CINEMATIC_1 );
			
	// Batten the hatches!
	if ( missileHatchesOpen ) {
		missileHatchesOpen = false;
		$boss_func_animatedsimple_generic_missilepod_left_1.setAnimState( LM_ANIM_HATCH_CLOSE, 200, false );	
		$boss_func_animatedsimple_generic_missilepod_left_2.setAnimState( LM_ANIM_HATCH_CLOSE, 200, false );	
		$boss_func_animatedsimple_generic_missilepod_left_3.setAnimState( LM_ANIM_HATCH_CLOSE, 200, false );	
		$boss_func_animatedsimple_generic_missilepod_right_1.setAnimState( LM_ANIM_HATCH_CLOSE, 200, false );	
		$boss_func_animatedsimple_generic_missilepod_right_2.setAnimState( LM_ANIM_HATCH_CLOSE, 200, false );	
		$boss_func_animatedsimple_generic_missilepod_right_3.setAnimState( LM_ANIM_HATCH_CLOSE, 200, false );	
		thread delayedDisableMissilePodDamage();
	} else {
		disableMissilePodDamage();
	}
}

void londonMonitor::delayedDisableMissilePodDamage(){
	sys.wait( 0.7 );
	disableMissilePodDamage();
}

void londonMonitor::disableMissilePodDamage(){
	$boss_triggers_damagetype_missilepod_left_1.makeActivatable( false );
	$boss_triggers_damagetype_missilepod_left_2.makeActivatable( false );
	$boss_triggers_damagetype_missilepod_left_3.makeActivatable( false );
	$boss_triggers_damagetype_missilepod_right_1.makeActivatable( false );
	$boss_triggers_damagetype_missilepod_right_2.makeActivatable( false );
	$boss_triggers_damagetype_missilepod_right_3.makeActivatable( false );
	
	$boss_func_animatedsimple_generic_missilepod_left_1.enableTargetLock( false );
	$boss_func_animatedsimple_generic_missilepod_left_2.enableTargetLock( false );
	$boss_func_animatedsimple_generic_missilepod_left_3.enableTargetLock( false );
	$boss_func_animatedsimple_generic_missilepod_right_1.enableTargetLock( false );
	$boss_func_animatedsimple_generic_missilepod_right_2.enableTargetLock( false );
	$boss_func_animatedsimple_generic_missilepod_right_3.enableTargetLock( false );
}

