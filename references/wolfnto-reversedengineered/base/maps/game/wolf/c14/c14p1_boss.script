object londonmonitorturret {
	__noedit boolean turret1_destroyed;
	__noedit boolean turret2_destroyed;
	__noedit boolean turret3_destroyed;
	
	void init();
	void onTrigger( entity activator ){};	

	void destroyTurret1();
	void destroyTurret2();
	void destroyTurret3();
	void destroyedTurret();
};

void londonmonitorturret::init() {
	turret1_destroyed = false;
	turret2_destroyed = false;
	turret3_destroyed = false;
	self.switchMeshKit( MESH_KIT_HEADS, "turret_01_intact" );
	self.switchMeshKit( MESH_KIT_GEAR, "turret_02_intact" );
	self.switchMeshKit( MESH_KIT_GORE, "turret_03_intact" );
}

void londonmonitorturret::destroyTurret1() {
	turret1_destroyed = true;
	self.startFX( FX_CINEMATIC_1 ); // Explosion
	//self.startFX( FX_CINEMATIC_4 ); // Smoke
	//self.switchMeshKit( MESH_KIT_HEADS, "turret_01_destroyed" );
	//destroyedTurret();
	// Suppress machineguns, don't destroy them 
	$boss_londonmonitor.callFunction( "deactivateMachineGuns" );
}

void londonmonitorturret::destroyTurret2() {
	turret2_destroyed = true;
	self.startFX( FX_CINEMATIC_2 ); // Explosion
	//self.startFX( FX_CINEMATIC_5 ); // Smoke
	//self.switchMeshKit( MESH_KIT_GEAR, "turret_02_destroyed" );
	//destroyedTurret();
	// Suppress machineguns, don't destroy them 
	$boss_londonmonitor.callFunction( "deactivateMachineGuns" );
}

void londonmonitorturret::destroyTurret3() {
	turret3_destroyed = true;
	self.startFX( FX_CINEMATIC_3 ); // Explosion
	//self.startFX( FX_CINEMATIC_6 ); // Smoke
	//self.switchMeshKit( MESH_KIT_GORE, "turret_03_destroyed" );
	//destroyedTurret();
	// Suppress machineguns, don't destroy them 
	$boss_londonmonitor.callFunction( "deactivateMachineGuns" );
}

void londonmonitorturret::destroyedTurret() {

	if ( turret1_destroyed && turret2_destroyed && turret3_destroyed) {
		// All turrets destroyed
		self.deactivate();
		self.makeActivatable( false );
		$boss_londonmonitor.callFunction( "destroyedMachineguns" );
		return;
	}
	
	// Deactivate machine guns when one is destroyed
	$boss_londonmonitor.callFunction( "deactivateMachineGuns" );

	// We start off using turret1, so we only need to switch firing point if that is destroyed
	if ( turret1_destroyed ) {
		if ( !turret2_destroyed ) {
			$boss_turret_machineguns.switchFiringPoint( "muzzle_2", "turret_root_jnt", "turret_02_jnt", "turret_02_spinner_jnt", ATTACK_LEFT );
		} else {
			$boss_turret_machineguns.switchFiringPoint( "muzzle_3", "turret_root_jnt", "turret_03_jnt", "turret_03_spinner_jnt", ATTACK_RIGHT );
		}
	}
}

