void londonMonitor::init(){
	currentPos = 4;
	focusVelocity = Vec(0,0,0);
	targetLocatedTime = -1000.0;
	targetLOSTime = -1000.0;
	waitForMovement = false;
	movementType = LM_MOVE_STOP;
	checkPlayerTargeting = false;
	playerTargetingTime = -1000.0f;
	playerTargetingPos = Vec(0,0,0);
	numMissilePods = 6;
	eyeBeamCooldownTime = 0;
	isOblivious = false;
	missilePodLeft1Destroyed = false;
	missilePodLeft2Destroyed = false;
	missilePodLeft3Destroyed = false;
	missilePodRight1Destroyed = false;
	missilePodRight2Destroyed = false;
	missilePodRight3Destroyed = false;
	coreHatchOpen = false;
	hasSpokenMissilesWarning = false;
	hasSpokenMissilePodHit = false;
	hasSpokenCoreHit = false;
	hasSpokenCoreMiss = false;
	speakTimeout = 0.0;
	targetInHidingTime = 0.0f;
	missileHatchesOpen = false;
	coreHitTime = 0.0;
	machinegunsDestroyed = false;
	flameThrowerCooldownTime = 0.0f;
	isDying = false;
	numCoreHits = 0;
	allowCoreHits = false;
	blindingHintCount = 0;
	missileHintCount = 0;
	isBlinded = false;
}

