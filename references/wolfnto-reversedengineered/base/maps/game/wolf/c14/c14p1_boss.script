void londonMonitor::stomp1(){
	stomp( $boss_func_movers_stomper1.getWorldOrigin() );
	$boss_func_movers_stomper1.hide();
};
void londonMonitor::stomp2(){
	stomp( $boss_func_movers_stomper2.getWorldOrigin() );
	$boss_func_movers_stomper2.hide();
};
void londonMonitor::stomp3(){
	stomp( $boss_func_movers_stomper3.getWorldOrigin() );
	$boss_func_movers_stomper3.hide();
};
void londonMonitor::stomp( vector pos ) {
	// Push player away from stomp with set force tapering off from 200 units to set radius.
	vector away = $player1.getWorldOrigin() - pos;
	if ( away_z > -50.0 ) {
		float distance = FMax( 1.0, sys.vecLength( away ) );
		float frac = FMax( 0.0, FMin( 1.0, ( distance - 200.0 ) / ( lmParmFloat( "stompPushRadius" ) - 200.0 ) ) ); 
		if ( frac < 0.95 ) {
			$player1.pushSoft( away / distance, lmParmFloat( "stompPushForce" ) * ( 1.0 - frac ), 0.5 );
		}
	}
};


void londonMonitor::liftfoot1(){
	$boss_func_movers_stomper1.show();
};
void londonMonitor::liftfoot2(){
	$boss_func_movers_stomper2.show();
};
void londonMonitor::liftfoot3(){
	$boss_func_movers_stomper3.show();
};
	

void londonMonitor::testPauseEyeBeam(){
	eyeBeamCooldownTime	= sys.getTime() + 180.0f;
};

