	float stompPushForce;
	float turretActivateRange;
	float turretMaxRange;
	float deathViewCos;
	float turretMinDuration;
	
	void init(){};
};


//---------------------------------------------------------------------
boolean firstPodHit = false;
object missilepoddamage {
	void init();
	void onTrigger( entity activator ){};
    void onDamage( entity attacker, float health, decl damageDecl, float damageAmount, int killed );	
	
	entity missilePod;
	__noedit float damageEffectCooldown;
};

void missilepoddamage::init() {
	damageEffectCooldown = 0.0;
};

void missilepoddamage::onDamage( entity attacker, float health, decl damageDecl, float damageAmount, int killed ) {
	// The first pod will be destroyed by one substantial hit.
	if ( !firstPodHit && ( health > 0 ) && ( damageAmount > 10 ) ) {
		// Kablam!
		self.damage( attacker, attacker, damageDecl, 100.0f, Vec( 0.0, 0.0, 1.0 ) );
		firstPodHit = true;
	}
	//if (lmUseDebug()) sys.drawText( "DMG: " + damageAmount, self.getWorldOrigin(), 5, Vec(1,0,0), 1, 5 );	
	
	// In case it's been destroyed by lots of low damage attacks
	if ( health <= 0 ) {
		firstPodHit = true;
	}
	
	// Damage effect
	if ( ( missilePod != $null ) && ( self.getHealth() > 0 ) && ( damageAmount > 5 ) && ( sys.getTime() > damageEffectCooldown ) ) {
		missilePod.startFX( FX_CINEMATIC_3 );
		damageEffectCooldown = sys.getTime() + 1.0;
	}
}	


