float lmParmFloat( string name ) {
	return $boss_info_lmparameters.getScriptObjectFloat( name );	
};
int lmParmInt( string name ) {
	return $boss_info_lmparameters.getScriptObjectInt( name );	
};
boolean lmUseDebug() {
	return ( sys.getcvar( "animatedSimple_debugLevel" ) == "-1" );	
}

