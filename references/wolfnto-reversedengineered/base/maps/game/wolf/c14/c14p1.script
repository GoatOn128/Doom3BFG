	int current_slide = 1;

void next_slide( entity acti, entity activator )
{
	current_slide = current_slide + 1;
	if(current_slide > 8) current_slide = 0;
	                             
	int i = 0;
	for( ; i < 8 ; i++)
		{
		if(i == current_slide) 
		{
	sys.getEntity("gp_light_point_slideshow"+i).show();
	sys.getEntity("gp_sound_vo_thehappypresenter_"+i).activate( $player1 );	
	$sound_sp_projector_slide.activate( $acti );
	}else
		{
		sys.getEntity("gp_light_point_slideshow"+i).hide();                                                                          
		}
	sys.wait(0.3);	
	$sound_sp_projector_hide.activate( $acti );
	}
}

