void gibb_bubi (entity targ, entity acti)
{
	$gp_ai_tungsten_c16_part_01_bubi_gibb.triggerGore( "body_vaporize" );
	$gp_func_animatedsimple_character_bubi.hide();
}

void knife_bubi (entity targ, entity acti)
{
	sys.print("Knife bubi");
	$gp_func_animatedsimple_knife_knife_bubi.show();
	$gp_func_firstpersonevent_knife_bubi.attachEntity( $gp_func_animatedsimple_knife_knife_bubi, "right_hand" );
}