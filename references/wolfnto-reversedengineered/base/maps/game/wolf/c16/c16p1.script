// Elevator  //
void elevator( entity activatedEntity, entity activator )
{
	 $sound_sp_elevatordown_front.activate( $acti );	
	 $sound_sp_elevatordown_rear.activate( $acti );
     $gp_func_movers_mover_elevator.time( 10.0 );
     $gp_func_movers_mover_elevator.accelTime( 4 );
     $gp_func_movers_mover_elevator.decelTime( 4 );
     $gp_func_movers_mover_elevator.move( DIR_DOWN, 1232 );
}




