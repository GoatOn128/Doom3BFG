boolean endUsableActivated = false;
void call_stage3_mdh_collapsed( entity activatedEntity, entity activator ){

	$sound_mus_killhim_01.setWorldOrigin( $cb_ai_mecha_deathshead_stage3.getWorldOrigin() );
	$sound_mus_killhim_02.setWorldOrigin( $cb_ai_mecha_deathshead_stage3.getWorldOrigin() );

	if ( endUsableActivated ){
		return;
	} 
	
	// Unhide safety backup usables (can be used from all directions) in case MDH has collapsed in an awkward position
	if ( Vec_y( $cb_prop_useable_use_stage3_end.getWorldOrigin() ) < Vec_y( $pipe_func_fx_01_decorative.getWorldOrigin() ) ) {
		$cb_prop_useable_use_stage3_end_safetybackup1.show();
		$cb_prop_useable_use_stage3_end_safetybackup2.show();
		$cb_prop_useable_use_stage3_end_safetybackup3.show();
		$cb_prop_useable_use_stage3_end_safetybackup4.show();
		$cb_prop_useable_use_stage3_end_safetybackup5.show();
	} else {
		// Unhide safety backup usables as a last resort if player stands near MDH for a while looking at usable
		vector usablePos = $cb_prop_useable_use_stage3_end.getWorldOrigin();
		//vector usableFwd = sys.angToForward( $cb_prop_useable_use_stage3_end.getAngles() );
		int lookAtUsableCount = 0;
		while ( lookAtUsableCount < 100 ) {
			sys.wait( 0.1 );

			// Is player close?
			if ( $player1.distanceTo( $cb_ai_mecha_deathshead_stage3 ) < 200.0 ) {
				if ( useDebug() ) sys.debugCircle( Vec(0,1,0), usablePos, Vec(0,0,1), 200, 12, 0.1 );
				
				// Is player looking towards interactive marker?
				vector fromPlayerView = sys.vecNormalize( $gp_misc_interactivemarker_use_deathshead.getWorldOrigin() - $player1.getViewPos() );
				if ( sys.vecDotProduct( fromPlayerView, sys.angToForward( $player1.getViewAngles() ) ) > 0.9 ) {
					lookAtUsableCount++;						
					if ( useDebug() ) sys.debugArrow( Vec(0,1,0), $player1.getWorldOrigin(), usablePos, 1, 0.1 );
				}
			}
			
			if ( endUsableActivated ){
				return;
			} 
		}
		
		// We've been trying to find usable long enough
		if ( useDebug() ) sys.debugBounds( Vec(0,1,0), $cb_prop_useable_use_stage3_end_safetybackup1.getWorldOrigin() - Vec(10,10,10), $cb_prop_useable_use_stage3_end_safetybackup1.getWorldOrigin() + Vec(10,10,10), 2000 );
		if ( useDebug() ) sys.debugBounds( Vec(0,1,0), $cb_prop_useable_use_stage3_end_safetybackup2.getWorldOrigin() - Vec(10,10,10), $cb_prop_useable_use_stage3_end_safetybackup2.getWorldOrigin() + Vec(10,10,10), 2000 );
		if ( useDebug() ) sys.debugBounds( Vec(0,1,0), $cb_prop_useable_use_stage3_end_safetybackup3.getWorldOrigin() - Vec(10,10,10), $cb_prop_useable_use_stage3_end_safetybackup3.getWorldOrigin() + Vec(10,10,10), 2000 );
		if ( useDebug() ) sys.debugBounds( Vec(0,1,0), $cb_prop_useable_use_stage3_end_safetybackup4.getWorldOrigin() - Vec(10,10,10), $cb_prop_useable_use_stage3_end_safetybackup4.getWorldOrigin() + Vec(10,10,10), 2000 );
		if ( useDebug() ) sys.debugBounds( Vec(0,1,0), $cb_prop_useable_use_stage3_end_safetybackup5.getWorldOrigin() - Vec(10,10,10), $cb_prop_useable_use_stage3_end_safetybackup5.getWorldOrigin() + Vec(10,10,10), 2000 );
		$cb_prop_useable_use_stage3_end_safetybackup1.show();
		$cb_prop_useable_use_stage3_end_safetybackup2.show();
		$cb_prop_useable_use_stage3_end_safetybackup3.show();
		$cb_prop_useable_use_stage3_end_safetybackup4.show();
		$cb_prop_useable_use_stage3_end_safetybackup5.show();
	}
}

void call_stage3_hide_end_usables( entity activatedEntity, entity activator ){
	endUsableActivated = true;
}


void call_pushawayfromstairswhendying( entity activatedEntity, entity activator ){
	
	// Push backwards off the stairs
	vector dir = Vec( 0.0, 1.0, 0.0 );
	if ( Vec_y( $cb_ai_mecha_deathshead_stage3.getModelForward() ) > 0.0f ) {
		dir_y = -1.0;		
	}
	$cb_ai_mecha_deathshead_stage3.push( dir, 150.0, 1.5 );
	
	//sys.debugArrow( Vec(1,1,0), $cb_ai_mecha_deathshead_stage3.getWorldOrigin(), $cb_ai_mecha_deathshead_stage3.getWorldOrigin() + dir * 400.0, 1, 5.0 );
	//sys.debugArrow( Vec(0,1,0), $cb_ai_mecha_deathshead_stage3.getWorldOrigin() + Vec(0,0,100), $cb_ai_mecha_deathshead_stage3.getWorldOrigin() + $cb_ai_mecha_deathshead_stage3.getModelForward() * 400.0 + Vec(0,0,100), 1, 5.0 );
}

boolean playerIsAtGlassCover() {
	return $cb_volume_default_jumping_restrict1.isPointInVolume( $player1.getWorldOrigin() );
}

//------------------------------------------------------------------------------------

object prototyperobot {
	void init();
	void onTrigger( entity activator ){};	
    void onDamage( entity attacker, float health, decl damageDecl, float damageAmount, int killed );	
	vector getWantedAnimDeltaScale();
	
	void start();
	void disabled();
	void update();
	boolean canJump();
	boolean jumpLandingAllowed( vector posLand, vector posSlide );
	void jump();
	void forceJump();
	void jumpLaunch();
	void updateJump();
	void jumpLand();
	void jumpDone();
	void allowJump();
	void whiteBrainsCantJump();
	void stunned();
	void vulnerable();
	void invulnerable();
	void startUseTesla();
	
	__noedit boolean allowJumping;
	__noedit float jumpCooldownTime;
	__noedit boolean isJumping;
	__noedit float jumpLengthScale;
	__noedit list jumpingVolumes;
	__noedit list jumpingNoLandingVolumes;
	__noedit int stunnedCount;
};

void prototyperobot::init(){ 
	allowJumping = false; 
	jumpCooldownTime = 0;
	isJumping = false;
	jumpLengthScale = 8.0; // Land after ~1000 units, slide another ~200 units.
};

void prototyperobot::onDamage( entity attacker, float health, decl damageDecl, float damageAmount, int killed ) {
}

void prototyperobot::start(){
	self.showAttachment( "right_hand" );
	allowJump();
	
	jumpingVolumes.append( $cb_volume_default_jumping1 );
	jumpingVolumes.append( $cb_volume_default_jumping2 );
	jumpingVolumes.append( $cb_volume_default_jumping3 );
	jumpingVolumes.append( $cb_volume_default_jumping4 );
	jumpingVolumes.append( $cb_volume_default_jumping5 );
	jumpingVolumes.append( $cb_volume_default_jumping6 );
	jumpingVolumes.append( $cb_volume_default_jumping7 );
	
	jumpingNoLandingVolumes.append( $cb_volume_default_jumping_restrict1 );
	jumpingNoLandingVolumes.append( $cb_volume_default_jumping_restrict2 );
	jumpingNoLandingVolumes.append( $cb_volume_default_jumping_restrict3 );
	jumpingNoLandingVolumes.append( $cb_volume_default_jumping_restrict4 );
	jumpingNoLandingVolumes.append( $cb_volume_default_jumping_restrict5 );
	jumpingNoLandingVolumes.append( $cb_volume_default_jumping_restrict6 );
	jumpingNoLandingVolumes.append( $cb_volume_default_jumping_restrict7 );
	jumpingNoLandingVolumes.append( $cb_volume_default_jumping_restrict8 );
	jumpingNoLandingVolumes.append( $cb_volume_default_jumping_restrict9 );
	jumpingNoLandingVolumes.append( $cb_volume_default_jumping_restrict10 );
	jumpingNoLandingVolumes.append( $cb_volume_default_jumping_restrict11 );
	
	stunnedCount = 0;
	self.setEMPStunDuration( 0.1 );
	$cb_target_show_stage1_vulnerable_use.makeActivatable( false );
	$cb_target_show_stage1_vulnerable_marker.makeActivatable( false );
	
	self.startFX( FX_CINEMATIC_2 );
	
	thread update();
}

void prototyperobot::disabled(){
	sys.killThread( "prototyperobot::update" );
	sys.killThread( "prototyperobot::updateJump" );
	sys.killThread( "prototyperobot::forceJump" );
	allowJumping = false;
	self.setTakesDamage( false ); // Do not allow stun during end event
}

vector prototyperobot::getWantedAnimDeltaScale() {
	return Vec( jumpLengthScale, 1.0, 1.0 + ( jumpLengthScale * 0.0625 ) );
}

//head
//hide_brainjar

void prototyperobot::update(){
	float lastVisibleTime = sys.getTime();
	float curTime;
	while ( true ) {
		curTime = sys.getTime();
		
		boolean playerAtGlassCover = playerIsAtGlassCover();
		if ( self.isEntityVisible( $player1 ) || playerAtGlassCover ) {
			lastVisibleTime = curTime + sys.getFrameTime();
		}

		if ( playerAtGlassCover ) {
			if ( sys.random( 1.0 ) < 0.1 ) {
				self.fakeSenseStimulus( AISTIMULUS_SIGHT, $player1, $player1.getWorldOrigin(), 1.0 ); // Robot will fire on glass
			} else {
				self.fakeSenseStimulus( AISTIMULUS_HEARING, $player1, $player1.getWorldOrigin(), 1.0 ); // Robot will just walk to scenepoints
			}
		}

		if ( sys.getcvar( "ai_debuglevel" ) != "0" ) {
			// Debug draw avoid entity name if we have one
		    entity ae = self.getAvoidEntity();
		    if ( ae != $null ) {
				sys.drawText("Avoid " + ae.getName(), self.getWorldOrigin() + Vec(0,0,220), 1, Vec(1,0,0), 1, 0.5 );	
			} else {
				sys.drawText("No avoid entity", self.getWorldOrigin() + Vec(0,0,220), 1, Vec(0,1,0), 1, 0.5 );	
			}
		}
			
		if ( allowJumping && !isJumping && ( curTime > jumpCooldownTime ) ) {
			entity avoidEntity = self.getAvoidEntity();
			if ( avoidEntity != $null ) {
				if ( avoidEntity.getClass() == "idProjectile_Grenade" ) {
					// Grenade dodge!
					thread forceJump();
				}
			} else if ( ( curTime > jumpCooldownTime + 4.0 ) && 
						( curTime > lastVisibleTime + 1.0 ) ) {
				// Peekaboo!
				if ( canJump( ) ) {
					jump();
				}
			} else if ( ( curTime > jumpCooldownTime + 7.0 ) &&
						( self.distanceTo( $player1 ) > 1000.0 ) ) {
				if ( canJump() ) {
					// Too far to slog along ground, Geronimo!
					jump();
				}
			} 
		}
		
		// In case of bugs where jump isn't launched for whatever reason
		if ( curTime > jumpCooldownTime + 30 ) {
			isJumping = false;
		}
		
		sys.wait( 0.5 );
	} 	
}

boolean prototyperobot::jumpLandingAllowed( vector posLand, vector posSlide ) {
	int i;
	entity volume;
	vector ownPos = self.getWorldOrigin();
	for ( i = 0; i < jumpingNoLandingVolumes.size(); i++ ) {
		volume = jumpingNoLandingVolumes.get( i );
		if ( volume != $null ) {
			if ( volume.isPointInVolume( posLand ) ) {
				// Restricted landing zone
				if (useDebug()) sys.debugBounds( Vec(1,0,0), posLand - Vec(10,10,10), posLand + Vec(10,10,10), 5 );
				if (useDebug()) sys.debugBounds( Vec(1,0,0), posSlide - Vec(10,10,10), posSlide + Vec(10,10,10), 5 );
				return false;
			}
			if ( volume.isPointInVolume( posSlide ) ) {
				// Restricted landing zone
				if (useDebug()) sys.debugBounds( Vec(0,1,0), posLand - Vec(10,10,10), posLand + Vec(10,10,10), 5 );
				if (useDebug()) sys.debugBounds( Vec(1,0,0), posSlide - Vec(10,10,10), posSlide + Vec(10,10,10), 5 );
				return false;
			}
		}
	}
	// All clear!
	if (useDebug()) sys.debugBounds( Vec(0,1,0), posLand - Vec(10,10,10), posLand + Vec(10,10,10), 5 );
	if (useDebug()) sys.debugBounds( Vec(0,1,0), posSlide - Vec(10,10,10), posSlide + Vec(10,10,10), 5 );
	return true;
}

boolean prototyperobot::canJump(){

	// Check which volumes we're in
	// Note: isPointInVolume checks against AA bounding box, not against actual volume, so we use only AABB volumes :P
	int i;
	list insideVolumes;
	entity volume;
	vector ownPos = self.getWorldOrigin();
	for ( i = 0; i < jumpingVolumes.size(); i++ ) {
		volume = jumpingVolumes.get( i );
		if ( volume != $null ) {
			if ( volume.isPointInVolume( ownPos ) ) {
				insideVolumes.append( volume );

				if (useDebug()) sys.debugBounds( Vec(0.5,0.5,0.5), volume.getWorldOrigin() + volume.getMins(), volume.getWorldOrigin() + volume.getMaxs(), 1.0 );
			}			
		}	
	}
	
	// If jumping towards player, we should adjust length to land on top of him. Otherwise jump as far as possible.
	float minDist = 400.0;
	float maxDist = 1000.0;
	float idealDist = maxDist;
	vector jumpDir = self.getModelForward();
	vector toPlayer = $player1.getWorldOrigin() - ownPos;
	float playerDist = sys.vecLength( toPlayer );
	if ( playerDist > minDist ) {
		if ( sys.vecDotProduct( jumpDir, toPlayer / playerDist ) > 0.95 ) {
			idealDist = playerDist;			
		}
	}

	if (useDebug()) sys.debugArrow(Vec(1,1,0), ownPos, ownPos + toPlayer, 1.0, 1.0);	
	
	// Check if we can make a jump inside volume
	float dist = idealDist;
	float delta = -200.0;
	vector landPos; 
	vector slidePos; 
	while ( dist <= maxDist ) {
		landPos = ownPos + jumpDir * dist; 
		slidePos = ownPos + jumpDir * dist * 1.3;
		for ( i = 0; i < insideVolumes.size(); i++ ) {
			volume = insideVolumes.get( i );
			if ( volume.isPointInVolume( landPos ) ) {
				// End pos is inside same volume, check for landing restrictions 
				if ( jumpLandingAllowed( landPos, slidePos ) ) {
					// Found valid jump distance!
					jumpLengthScale = dist / 125.0; // Scale 8.0 == 1000 units
					if (useDebug()) sys.debugArrow(Vec(0,1,0), ownPos, ownPos + jumpDir * 300, 1.0, 1.0);	
					return true;
				}
			}
		}
		
		// Try next range
		dist = dist + delta;
		if ( dist < minDist ) {
			// Below min, try longer ranges than ideal
			delta = 200.0;
			dist = idealDist + delta;
		} 
		// Spread the load, to be safe
		sys.waitFrame();
		jumpDir = self.getModelForward();
		ownPos = self.getWorldOrigin();
	}
	
	// Cannot jump in any jumping volumes
	if (useDebug()) sys.debugArrow(Vec(1,0,0), ownPos, ownPos + jumpDir * 300, 1.0, 1.0);	
	return false;
}


void prototyperobot::forceJump(){
	// Move into position to jump as soon as possible, counts as jumping until we do or jump is aborted
	isJumping = true;
	
	if ( canJump() ) {
		jump();
		return;
	} 
	
	// Turn towards center
	$cb_info_scenepoint_modifyscenepoint_enable_forcejump.activate( self );
	self.setOverrideScenePoint( $cb_info_scenepoint_forcejump );
	sys.waitFrame();
	
	// Try to jump until aborted or timed out
	float endTime = sys.getTime() + 3.0;
	while ( isJumping && allowJumping && ( sys.getTime() < endTime ) ) {
		if ( canJump() ) {
			$cb_info_scenepoint_modifyscenepoint_disable_forcejump.activate( self );
			jump();
			return;
		} 
		sys.waitFrame();
	}

	// Failed to jump
	$cb_info_scenepoint_modifyscenepoint_disable_forcejump.activate( self );
	isJumping = false;
}

void prototyperobot::jump(){
	// Trigger jump anim. This will trigger jump launch in turn.
	isJumping = true;
	$cb_target_anim_changestate_jump_single.activate( self );
	
	// No push from obstacles until we land
	enablePushFromObstacleTriggers( false );
}

void prototyperobot::jumpLaunch(){
	// No damage while jumping (so we don't get emp'd in mid air)
	self.setTakesDamage( false );
	thread updateJump();
}

void prototyperobot::updateJump() {
	// Push player aside when in air
	float endTime = sys.getTime() + 2.0f; //Jump should never be longer than this
	vector jumpDir = self.getModelForward();
	vector sideDir = sys.vecCrossProduct( jumpDir, Vec( 0,0,1 ) );

	while ( sys.getTime() < endTime ) {
		vector toPlayer = $player1.getWorldOrigin() - self.getWorldOrigin();
		if ( sys.vecDotProduct( jumpDir, toPlayer ) > 0.0 ) { 
			// Player in front of us
			float dist = sys.vecLength( toPlayer );
			if ( dist < 200.0 ) {
				toPlayer_z = 20.0; // Count player as sligthly up
				vector dir = ( toPlayer / dist ); // Bias to side if player is way below us
				if ( sys.vecDotProduct( sideDir, toPlayer ) ) {
					dir = dir + sideDir;
				} else {
					dir = dir - sideDir;
				}
				// Push player aside
				$player1.push( dir, 500.0, 0.5 );
			}
		}
		sys.waitFrame();		
	}
}

void prototyperobot::jumpLand(){
	sys.killThread( "prototyperobot::updateJump" );

	// Can take damage again
	self.setTakesDamage( true );
	
	// Slide off obstacles	
	enablePushFromObstacleTriggers( true );
}

void prototyperobot::jumpSmash(){
	// Mighty fist of doom!
	int handJoint = self.getJointHandle( "tm_lefthand" );
	vector smashPos = self.getJointPos( handJoint );
	sys.radiusDamage( smashPos, self, self, self, "damage/tungsten/ai/melee/prototyperobot_jumpsmash", 1.0 );
}

void prototyperobot::jumpDone(){
	isJumping = false;
	jumpCooldownTime = sys.getTime() + 1.0f;
}

void prototyperobot::allowJump(){
	allowJumping = true;
}
void prototyperobot::whiteBrainsCantJump(){
	allowJumping = false;
}

void prototyperobot::stunned(){
	// No jumping for a while
	isJumping = false;
	jumpCooldownTime = sys.getTime() + 10.0f;
	self.setTakesDamage( true );
}
void prototyperobot::vulnerable(){
	if ( sys.getcvar( "ai_debuglevel" ) != "0" ) {
		sys.drawText( "VULNERABLE", self.getWorldOrigin() + Vec(0,0,100), 1, Vec(1,1,1), 1, 3 );
	}
}
void prototyperobot::invulnerable(){
	// Ready to jump when exiting stun
	jumpCooldownTime = sys.getTime(); 

	// After we've been vulnerable once, we can grab the brain holder and end the stage 	
	$cb_target_show_stage1_vulnerable_use.makeActivatable( true );
	$cb_target_show_stage1_vulnerable_marker.makeActivatable( true );

	// Increase stun time for next stun	
	if ( stunnedCount < 4 ) {
		stunnedCount++;
		self.setEMPStunDuration( stunnedCount );
	}
}

// Called from animevent
void prototyperobot::startUseTesla() {
	jumpCooldownTime = sys.getTime() + 5.0f;
}


//------------------------------------------------------------------------------------
// Grenade respawning system

int numGrenadesPickedUp = 0;
void call_stage1_pickupgrenade( entity activatedEntity, entity activator ){
	numGrenadesPickedUp++;
}

object grenaderespawner {
	void init();
	void onTrigger( entity activator ){};	
	
	void respawnGrenade();
};

void grenaderespawner::init(){ 
	thread respawnGrenade(); 
};

void grenaderespawner::respawnGrenade() {
	
	// Wait until enough grenades have been picked up before respawning any
	while ( numGrenadesPickedUp < 10 ) {
		sys.wait( sys.random( 10.0 ) );
	}

	// Start checking for respawn	
	while ( isStage1 && ( self.numTargets() > 0 ) ) {
		
		entity grenade = self.getTarget( 0 );
		if ( grenade == $null ) {
			// Grenade has been picked up, respawn if player is far enough away
			if ( self.distanceTo( $player1 ) > 1000.0 ) {
				grenade = sys.spawn( "prop/weapon/handgrenadeemp" );
				grenade.setWorldOrigin( self.getWorldOrigin() );
				grenade.setAngles( self.getAngles() );
				self.clearTargets();
				self.addTarget( grenade );
				if ( useDebug() ) sys.drawText( "RESPAWNED " + grenade.getName(), self.getWorldOrigin(), 1, Vec(1,1,1), 1, 5.0 );				
			} else {
				if ( useDebug() ) sys.drawText( "PLAYER IS CLOSE, DON'T RESPAWN", self.getWorldOrigin(), 1, Vec(1,1,1), 1, 5.0 );				
			}			
		} 
		sys.wait( sys.random( 12.0 ) );
	}
}

//------------------------------------------------------------------------------------

object mechadeathshead_stage2 {
	void init();
	void onTrigger( entity activator ){};	
    void onDamage( entity attacker, float health, decl damageDecl, float damageAmount, int killed );	
	
	void start();
	void end();
	void rechargeShield( boolean stagger );
	void zeppelinsDown();
	void setShieldEffects( float prevFraction, float curFraction );
	void setShieldGlow( float curFraction );
	void update();

	float shieldStrength;
	__noedit float curShieldStrength;
	__noedit boolean isRecharging;
	__noedit boolean rechargeWillOverload;
	__noedit boolean hasBeenHit;
	__noedit float damageEffectCooldown;
	__noedit boolean stageDone;
};

void mechadeathshead_stage2::init(){
}

void mechadeathshead_stage2::onDamage( entity attacker, float health, decl damageDecl, float damageAmount, int killed ) {
	
	if ( damageAmount == 0 ) {
		return;
	}
	
	// Shield is hit
	if ( sys.getTime() > damageEffectCooldown ) {
		self.startFX( FX_CINEMATIC_2 );
		damageEffectCooldown = sys.getTime() + 0.5 + sys.random( 0.5 );
	}

	
	// Don't actually suffer any damage
	self.resetHealth();

	// No damage suffered while recharging
	if ( !isRecharging ) {
		
		// Do we need to recharge?
		curShieldStrength = curShieldStrength - damageAmount;
		
		if ( curShieldStrength <= 0 ) {
			thread rechargeShield( true );
		} else {
			setShieldEffects( ( curShieldStrength + damageAmount ) / shieldStrength, curShieldStrength / shieldStrength ); 
			
			if ( !hasBeenHit ) {
				// Play stagger anim first time we're hit
				hasBeenHit = true;
				$cb_target_anim_changestate_stagger.activate( self );
			}
		}
	}
}	

void mechadeathshead_stage2::start(){
	curShieldStrength = 0.0;
	isRecharging = false;
	rechargeWillOverload = false;
	hasBeenHit = false;
	damageEffectCooldown = 0.0;
	stageDone = false;
	
	// Start exhaust effects
	self.startFX( FX_CINEMATIC_4 ); 
	
	// Switch to proper mesh kit
	self.switchMeshKit( MESH_KIT_GEAR, "Stage2" ); 

	// Always start by recharging
	thread rechargeShield( false );
	
	thread update();
}

void mechadeathshead_stage2::end(){
	sys.killThread( "mechadeathshead_stage2::rechargeShield" );
	sys.killThread( "mechadeathshead_stage2::update" );
	stageDone = true;
}


void mechadeathshead_stage2::rechargeShield( boolean stagger ) {
	isRecharging = true;
	curShieldStrength = 0.0;
	
	if ( rechargeWillOverload ) {
		// Uh, oh, tesla coil has gone haywire. Stage2 complete!
		self.stopFX( FX_START_DAMAGE_LEVEL_1 );
		self.stopFX( FX_START_DAMAGE_LEVEL_2 );
		self.stopFX( FX_START_DAMAGE_LEVEL_3 );
		self.stopFX( FX_START_DAMAGE_LEVEL_4 );
		sys.println( sys.getTime( ) + " Stopped FX_START_DAMAGE_LEVEL_1,2,3,4 on overload" );
		self.startFX( FX_AI_DMG_TANK );
		$cb_target_relay_stage2_end.activate( self );
		return;	
	}
	
	if ( stagger ) {
		// Stagger, then recharge
		$gp_target_relay_deathshead_recharge_vo.activate( self );
		$cb_target_anim_changestate_rechargeshield_stagger.activate( self );
		sys.wait( 2.5 );
	} else {
		// No stagger, straight to recharge
		$gp_target_relay_deathshead_recharge_vo.activate( self );
		$cb_target_anim_changestate_recharge_direct.activate( self );
		sys.wait( 1.0 );
	}
	
	// Stop shield stages effects
	self.stopFX( FX_START_DAMAGE_LEVEL_1 );
	self.stopFX( FX_START_DAMAGE_LEVEL_2 );
	self.stopFX( FX_START_DAMAGE_LEVEL_3 );
	self.stopFX( FX_START_DAMAGE_LEVEL_4 );
	sys.println( sys.getTime( ) + " Stopped FX_START_DAMAGE_LEVEL_1,2,3,4 on recharge start" );
	
	// Recharge effect
	self.startFX( FX_CINEMATIC_1 ); 

	// Increase shield glow over time
	while ( curShieldStrength < shieldStrength ) {
		curShieldStrength = curShieldStrength + ( shieldStrength / 70.0 );
		setShieldGlow( curShieldStrength / shieldStrength );
		sys.wait( 0.1 );
	} 
		
	// Shield is fully operational
	curShieldStrength = shieldStrength;
	self.startFX( FX_START_DAMAGE_LEVEL_1 );
	sys.println( sys.getTime( ) + " Started FX_START_DAMAGE_LEVEL_1 on recharge end" );
	
	// Exit recharge anim
	isRecharging = false;
	$cb_target_anim_changestate_rechargeshield_exit.activate( self );
}

void mechadeathshead_stage2::zeppelinsDown() {
	rechargeWillOverload = true;
}

void mechadeathshead_stage2::setShieldEffects( float prevFraction, float curFraction ){

	// Switch effects at appropriate fractions
	if ( curFraction <= 0.3 ) {
		if ( prevFraction > 0.3 ) {
			self.startFX( FX_START_DAMAGE_LEVEL_4 );
			self.stopFX( FX_START_DAMAGE_LEVEL_1 );
			self.stopFX( FX_START_DAMAGE_LEVEL_2 );
			self.stopFX( FX_START_DAMAGE_LEVEL_3 );
			sys.println( sys.getTime( ) + " Stopped FX_START_DAMAGE_LEVEL_1, 2, 3, started 4" );
		}
	} else if ( curFraction <= 0.7 ) {
		if ( prevFraction > 0.7 ) {
			self.startFX( FX_START_DAMAGE_LEVEL_3 );
			self.stopFX( FX_START_DAMAGE_LEVEL_1 );
			self.stopFX( FX_START_DAMAGE_LEVEL_2 );
			sys.println( sys.getTime( ) + " Stopped FX_START_DAMAGE_LEVEL_1, 2, started 3" );
		}
	} else if ( curFraction <= 0.95 ) {
		if ( prevFraction > 0.95 ) {
			self.startFX( FX_START_DAMAGE_LEVEL_2 );
			self.stopFX( FX_START_DAMAGE_LEVEL_1 );
			sys.println( sys.getTime( ) + " Stopped FX_START_DAMAGE_LEVEL_1, started 2" );
		}
	}
	
	setShieldGlow( curFraction );
}

void mechadeathshead_stage2::setShieldGlow( float curFraction ){
	// Glow on coils
	float glow; 
	if ( curFraction > 0.8 ) {
		glow = ( ( curFraction - 0.8 ) / 0.2 ) * 990.0 + 10.0;
	} else {
		glow = ( curFraction / 0.8 );
		glow = glow * glow * glow * 9.5 + 0.5;	
	}
	self.blendRenderParameter( AIRENDERPARAM_SELFDESTRUCTGLOW, glow, 0.1 ); 
}

void mechadeathshead_stage2::update() {
	float teslaWasActive = false;
	while ( !stageDone ) {
		
		// Deathshead has access to camera feeds inside his cockpit :)
	    self.fakeSenseStimulus( AISTIMULUS_HEARING, $player1, $player1.getWorldOrigin(), 0.5 );
	
		// Update tesla fire at glass cover stuff
		if ( playerIsAtGlassCover() ) {

			// Fire at one of these points
			self.addTeslaBlindFirePosition( $cb_info_null_behindglass_teslatarget_01.getWorldOrigin() );			
			self.addTeslaBlindFirePosition( $cb_info_null_behindglass_teslatarget_02.getWorldOrigin() );			
			self.addTeslaBlindFirePosition( $cb_info_null_behindglass_teslatarget_03.getWorldOrigin() );			
			self.addTeslaBlindFirePosition( $cb_info_null_behindglass_teslatarget_04.getWorldOrigin() );			
			
			if ( self.teslaIsActive() ) {
				teslaWasActive = true;
			} else if ( teslaWasActive ) {
				// Reduced cooldown when target is behind glass cover
				self.setTeslaCooldown( 3.0 );
				teslaWasActive = false;
			}
			
		} else {
			// Player is not at glass cover, clear blind fire positions
			self.clearTeslaBlindFirePositions();
		}
		
		// Zap player if he comes too close
		vector away = $player1.getWorldOrigin() - self.getWorldOrigin();
		float dist = sys.vecLength( away );
		if ( dist < 250 ) {
			float damageScale = 1.0 - ( 0.01 * ( dist - 150 ) );
	    	$player1.damage( self, self, @damage( "damage/tungsten/ai/melee/mechadeatshhead_proximityzapper" ), damageScale, away ); 
		  	self.startFX( FX_CINEMATIC_5 );
	  	}
	  	sys.wait( 0.2 );
    }
}


