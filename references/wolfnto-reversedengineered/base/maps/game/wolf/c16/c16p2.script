// For obstacles robot should slide over
void call_pushfromobstacle( entity activatedEntity, entity activator ){
	if ( isStage1 && ( activator == $cb_ai_prototyperobot ) ) {
		if (useDebug()) sys.debugArrow( Vec(1,1,0), $cb_ai_prototyperobot.getWorldOrigin(), $cb_ai_prototyperobot.getWorldOrigin() + ($cb_ai_prototyperobot.getModelForward() * 100 ), 1, 2.0 );
		$cb_ai_prototyperobot.push( $cb_ai_prototyperobot.getModelForward(), 200, 0.5 );
	}
}

// For obstacles robot should slide away from
void call_pushaway( entity activatedEntity, entity activator ) {
	if ( isStage1 && ( activator == $cb_ai_prototyperobot ) ) {
		vector away = $cb_ai_prototyperobot.getWorldOrigin() - activatedEntity.getWorldOrigin();
		away_z = 0.0;
		if ( abs( away_x ) < 0.1 ) {
			// Make sure we slide east/west (currently we can only get stuck south of one such obstacle)
			if ( away_x > 0.0) {
				away_x = 0.1; 
			} else {
				away_x = -0.1;
			}
		}
		if (useDebug()) sys.debugArrow( Vec(1,1,0), $cb_ai_prototyperobot.getWorldOrigin(), $cb_ai_prototyperobot.getWorldOrigin() + (away * 100 ), 1, 2.0 );
		$cb_ai_prototyperobot.push( away, 100.0, 0.5 );
	}
}

void enablePushFromObstacleTriggers( boolean enabled ) {
	// Disable cover slide triggers
	$cb_triggers_trigger_pushfromobstacle1.makeActivatable( enabled );
	$cb_triggers_trigger_pushfromobstacle2.makeActivatable( enabled );
	$cb_triggers_trigger_pushfromobstacle3.makeActivatable( enabled );
	$cb_triggers_trigger_pushfromobstacle4.makeActivatable( enabled );
	$cb_triggers_trigger_pushfromobstacle5.makeActivatable( enabled );
	$cb_triggers_trigger_pushfromobstacle6.makeActivatable( enabled );
	$cb_triggers_trigger_pushfromobstacle7.makeActivatable( enabled );
	$cb_triggers_trigger_pushfromobstacle8.makeActivatable( enabled );
	$cb_triggers_trigger_pushfromobstacle9.makeActivatable( enabled );
	$cb_triggers_trigger_pushfromobstacle10.makeActivatable( enabled );
	$cb_triggers_trigger_pushfromobstacle11.makeActivatable( enabled );
	$cb_triggers_trigger_pushfromobstacle12.makeActivatable( enabled );
	$cb_triggers_trigger_pushfromobstacle13.makeActivatable( enabled );
}

void call_stage1_end( entity activatedEntity, entity activator ){
	$cb_ai_prototyperobot.callFunction( "disabled" );
	isStage1 = false;
	enablePushFromObstacleTriggers( false );
	
	//Abort ongoing stun, then trigger event
	$cb_ai_prototyperobot.setEMPStunDuration( 0.0 );
	$gp_ai_scriptedanimweb_disable_prototype_robot_brain_control.activate( $player1 );
}

void call_stage2_start( entity activatedEntity, entity activator ){
	$cb_ai_mecha_deathshead_stage2.callFunction( "start" );	
	isStage1 = false;
	enablePushFromObstacleTriggers( false );
	
	// Prototype robot switcheroo
	$cb_ai_prototyperobot.hide();
	$gp_target_relay_fakedeadprototyperobot.activate( $player1 );
	
	// Move player into good position to see MDH, zeppelin and tesla coil
	$player1.teleport( $gp_player_start_checkpoint_2.getWorldOrigin(), $gp_player_start_checkpoint_2.getAngles() );
}

void call_disableTesla_Stage2( entity activatedEntity, entity activator ){
	$cb_ai_mecha_deathshead_stage2.setTeslaCooldown( 1.0 );
}

boolean hiddenAtCuttable = false;
void call_hideAtCuttable( entity activatedEntity, entity activator ){
	hiddenAtCuttable = true;
	int count = sys.randomInt(10) + 10;
	while ( hiddenAtCuttable ) {
		sys.wait( 0.5 );
		count--;
		if ( count == 0 ) {
			// Fake spot player so MDH will shoot through cuttable
			$cb_ai_mecha_deathshead_stage2.fakeSenseStimulus( AISTIMULUS_SIGHT, $player1, $player1.getWorldOrigin() + Vec( sys.random( 80.0 ) - 40.0, sys.random( 80.0 ) - 40.0, sys.random( 16.0 ) ), 1.0 );
			if ( !$cb_ai_mecha_deathshead_stage2.teslaIsActive() ) {
				$cb_ai_mecha_deathshead_stage2.setTeslaCooldown( 4.0 );
			}
			count = sys.randomInt(20) + 10;
		}
	}
}
void call_unhideAtCuttable( entity activatedEntity, entity activator ){
	hiddenAtCuttable = false;	
}

