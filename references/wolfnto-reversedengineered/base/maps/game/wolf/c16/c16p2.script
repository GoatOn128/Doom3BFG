object mechadeathshead_stage3 {
	void init(){};
	void onTrigger( entity activator ){};	
    void onDamage( entity attacker, float health, decl damageDecl, float damageAmount, int killed );	
	
	void start();
	void die();
	void updatePlayerVisible();
	void speakWhenReady();
	void doneSpeaking();
	
	__noedit float maxHealth;
	__noedit float healthFraction;
	__noedit float staggerCoolDown;
	__noedit boolean dying;
	__noedit float damageEffectCooldown;
	__noedit float staggerDamage;
	__noedit float lastDamageTime;
	__noedit int vo_index;
	__noedit float playerVisibleTime;
	__noedit boolean isSpeaking;
};

void mechadeathshead_stage3::start(){
	// Start exhaust effects
	self.startFX( FX_CINEMATIC_4 );
	
	// Switch to proper mesh kit
	self.switchMeshKit( MESH_KIT_GEAR, "Stage3" ); 
	self.hideIndividualMeshKit( MESH_KIT_GEAR, "tesla" ); 
	
	
	$cb_prop_useable_use_stage3_end.hide();
	$cb_prop_useable_use_stage3_end_safetybackup1.hide();
	$cb_prop_useable_use_stage3_end_safetybackup2.hide();
	$cb_prop_useable_use_stage3_end_safetybackup3.hide();
	$cb_prop_useable_use_stage3_end_safetybackup4.hide();
	$cb_prop_useable_use_stage3_end_safetybackup5.hide();
	$gp_misc_interactivemarker_use_deathshead.hide();
	
	maxHealth = self.getHealth();
	healthFraction = 1.0;
	staggerCoolDown = 0.0;
	dying = false;
	damageEffectCooldown = 0.0;
	self.setAnimWebScriptBlend( 1.0 ); 
	staggerDamage = -1.0;
	vo_index = 0;
	playerVisibleTime = 0.0;
	isSpeaking = false;
	
	thread updatePlayerVisible();
	
	// Autospot player after "die allied schweinhund" line to start fight if player hides.
	sys.wait( 5.0 );
    self.fakeSenseStimulus( AISTIMULUS_HEARING, $player1, $player1.getWorldOrigin(), 3.0 );
}

void mechadeathshead_stage3::die(){
	dying = true;
};

void mechadeathshead_stage3::onDamage( entity attacker, float health, decl damageDecl, float damageAmount, int killed ) {
	if ( dying ) {
		return;
	}
	
	// Free to act if damaged while speaking
	doneSpeaking();

	// Random damage effects from time to time 	
	if ( sys.getTime() > damageEffectCooldown ) {
	    self.startFX( FX_AI_DMG_SMOKE );
	  self.startFX( FX_EXPLODABLE_STEAM_01 + sys.randomInt( 4 ) );
		damageEffectCooldown = sys.getTime() + 0.5 + sys.random( 0.5 );
	}

	// Check for damage thresholds		
	float curFraction = health / maxHealth;
	if ( ( curFraction <= 0.9 ) && ( healthFraction > 0.9 ) ) {
		self.startFX( FX_START_DEATH_1 );
		$cb_target_anim_changestate_deathshead_angry_1.activate( self );
		self.setAnimWebScriptBlend( 0.7 ); 
		if ( useDebug() ) sys.drawText( "DAMAGE 1", self.getWorldOrigin() + Vec(0,0,200), 1, Vec(1,1,1), 1, 5.0 );
	} 
	if ( ( curFraction <= 0.75 ) && ( healthFraction > 0.75 ) ) {
		self.startFX( FX_START_DEATH_2 );
		self.setSkin( "Damaged1" );
		$cb_target_anim_changestate_deathshead_angry_2.activate( self );
		self.setAnimWebScriptBlend( 0.4 ); 
		if ( useDebug() ) sys.drawText( "DAMAGE 2", self.getWorldOrigin() + Vec(0,0,200), 1, Vec(1,1,1), 1, 5.0 );
	} 
	if ( ( curFraction <= 0.5 ) && ( healthFraction > 0.5 ) ) {
		self.startFX( FX_START_DEATH_3 );
		self.setSkin( "Damaged1" );
		$cb_target_anim_changestate_deathshead_angry_3.activate( self );
		self.setAnimWebScriptBlend( 0.0 ); 
		if ( useDebug() ) sys.drawText( "DAMAGE 3", self.getWorldOrigin() + Vec(0,0,200), 1, Vec(1,1,1), 1, 5.0 );
	} 
	if ( ( curFraction <= 0.2 ) && ( healthFraction > 0.2 ) ) {
		self.startFX( FX_START_DEATH_4 );
		self.setSkin( "Damaged1" );
		$cb_target_anim_changestate_deathshead_angry_1.activate( self );
		
		// Switch to broken walk cycle
		self.setAnimWebScriptBlend( 2.0 ); 
		
		if ( useDebug() ) sys.drawText( "DAMAGE 4", self.getWorldOrigin() + Vec(0,0,200), 1, Vec(1,1,1), 1, 5.0 );
	} 
		
	// Check for staggers
	if ( staggerDamage < 0 ) {
		// Bonus stagger damage the first time we're hit
		staggerDamage = damageAmount + 50.0;
	} else if ( sys.getTime() > lastDamageTime + 2.0 ) {
		// Reset accumulated stagger damage if we haven't kept the pressure up
		staggerDamage = damageAmount;
	} else {
		staggerDamage = staggerDamage + damageAmount;
	}
		
	if ( sys.getTime() > staggerCoolDown ) {
		// Less damage required to cause stagger the less health MDH has.
		if ( staggerDamage > ( 50.0 + 50.0 * curFraction ) ) {
			$cb_ai_scriptedanimweb_mdh_stagger.activate( self );
			staggerCoolDown = sys.getTime() + 8.0;
			staggerDamage = 0;
		}
	}
	
	// Save current health fraction
	healthFraction = curFraction;

	// Save time of damage	
	lastDamageTime = sys.getTime();
}	

void mechadeathshead_stage3::updatePlayerVisible(){
	while ( !dying ) {
		if ( self.isEntityVisible( $player1 ) ) {
			playerVisibleTime = sys.getTime();
		}
		sys.wait( 0.1 );
	}
}

void mechadeathshead_stage3::speakWhenReady() {
	// This is called when appropriate time has passed since last dialogue. 
	// Wait until MDH is somewhat distant from player and hasn't seen him for a while, then speak line.
	while ( ( sys.getTime() < playerVisibleTime + 6.0 ) || 
			( sys.getTime() < lastDamageTime + 6.0 ) ||
		    ( self.distanceTo( $player1 ) < 300.0 ) ) {
		sys.wait( 0.2 );
	}		
	if ( vo_index < $gp_info_null_stage3_vo_list.numTargets() ) {
		// Speak, and stop shooting for a while (or until we get shot back or get close to target)
		entity vo = $gp_info_null_stage3_vo_list.getTarget( vo_index );
		vo.makeActivatable( true );
		vo.activate( self );
		vo_index++;
		isSpeaking = true;
		$gp_target_ai_aicommand_vo_stage3_pause_fire.activate( self );
		
		while ( isSpeaking ) {
			sys.wait( 0.5 );
			float dist = self.distanceTo( $player1 );
			if ( ( dist < 200.0 ) || 
				 ( ( dist < 600.0 ) && ( sys.getTime() < playerVisibleTime + 0.6 ) ) ){
				// Target is close, don't hold off firing anymore
				doneSpeaking();
			}
		}
	}
}

void mechadeathshead_stage3::doneSpeaking() {
	if ( isSpeaking ) {
		isSpeaking = false;
		$gp_target_ai_aicommand_vo_stage3_unpausepause_fire.activate( self );				
	}
}

//------------------------------------------------------------------------------------

int numActiveFlames = 0;
int smokeCondition = FX_CINEMATIC_1;

list lActiveFlamesBursts;

object flameburstprefab {
	void init();
	void onTrigger( entity activator );	
	void turnOff();	
	
	float warningFlameDuration;
	__noedit int flameCondition;
};

void flameburstprefab::init() {
	// Save the start condition for later and change it to the warning effect condition.  
	// This enables us to more easily preview the flame effects as well as have varying flames even though we use the same warning effect.
	flameCondition = self.getStartCondition();
	self.setStartCondition( FX_CINEMATIC_1 );
}

void flameburstprefab::onTrigger( entity activator ) {

	sys.setThreadName( self.getName() + "::onTrigger" );

	// We're active
	lActiveFlamesBursts.append( self );

	// Show warning effect
	self.show();
	
	sys.wait( warningFlameDuration );
	
	// Flame is on! 
	self.stopFX( FX_CINEMATIC_1 );
	self.startFX( flameCondition );
	
	// Set clip contents to obscure sight
	self.setContents( CONTENTS_OPAQUE );
	
	// Make all targets activatable and activate them (hurt triggers etc)
	int i = 0;
	for (; i < self.numTargets(); i++ ) {
		self.getTarget( i ).makeActivatable( true );
		self.getTarget( i ).activate( self );		
	}
	
	// Check if we should increase general smoke level
	numActiveFlames++;
	if ( ( numActiveFlames % 3 ) == 0 ) {
		// Allow increase of smoke level every three flames
		if (useDebug()) sys.drawText( "Increase smoke to " + smokeCondition, $player1.getWorldOrigin() + Vec(100, 0, 80 ), 1, Vec(1,1,0), 1, 5);
		$pipe_func_fx_postprocess_smoke.stopFX( smokeCondition - 1);
		$pipe_func_fx_postprocess_smoke.startFX( smokeCondition );
		smokeCondition++;
	}
}

void flameburstprefab::turnOff() {
	sys.killThread( self.getName() + "::onTrigger" );
	
	self.stopFX( FX_CINEMATIC_1 );
	self.stopFX( flameCondition );
	
	// Disable all targets (hurt triggers etc)
	int i = 0;
	for (; i < self.numTargets(); i++ ) {
		self.getTarget( i ).makeActivatable( false );
	}
}

void turnOffNearbyFlames( vector pos, float range ) {
	int i = 0;
	entity flameBurst;
	for (; i < lActiveFlamesBursts.size(); i++ ) {
		flameBurst = lActiveFlamesBursts.get( i );
		if ( flameBurst != $null ) {
			// If flame is near position, turn it off
			vector flamePos = flameBurst.getWorldOrigin() + ( 100 * sys.angToForward( flameBurst.getAngles() ) );
			if ( sys.vecLength( pos - flamePos ) < range ) {
				flameBurst.callFunction( "turnOff" );
				
				// Wait a while before turning off next flame		
				sys.wait( sys.random( 1.0 ) + 0.5 );
			}
		}
	}
}

//------------------------------------------------------------------------------------

void call_stage3_end( entity activatedEntity, entity activator ) {
	// MDH is dying
	$cb_ai_mecha_deathshead_stage3.callFunction( "die" );
	
	// Deathshead will stop looking at player
	$cb_func_animatedsimple_character_deathshead_stage3.setFocus( $null, false, false, 0 );	
	
	// Push away from stairs
	$cb_triggers_trigger_pushawayfromstairswhendying.makeActivatable( true );
	
	// Wait for MDH to collapse
	sys.wait( 7.0 );

	// Turn off all flames near MDH	
	thread turnOffNearbyFlames( $cb_ai_mecha_deathshead_stage3.getWorldOrigin(), 250.0 );
	
	// Stop pushing
	$cb_triggers_trigger_pushawayfromstairswhendying.makeActivatable( false );
	
	// Set up event MDH
	$gp_func_animatedsimple_generic_deathsheadsmech_deceive_event.setSkin( "Damaged1" );
	$gp_func_animatedsimple_generic_deathsheadsmech_deceive_event.switchMeshKit( MESH_KIT_GEAR, "Dead" );
}

void call_smotherFlamesOnDecieve( entity activatedEntity, entity activator ) {
	// Turn off all flames near player	
	thread turnOffNearbyFlames( $gp_info_null_deceivepos.getWorldOrigin(), 450.0 );
}

void disablebrain_fpevent (entity activatedEntity, entity activator) 
{
	vector angles = $cb_ai_prototyperobot.getBodyOrientation();
	angles_x = 0.0;	
	angles_z = 0.0;	
	angles_y = angles_y + 180;
	$cb_func_firstpersonevent_disable_prototype_robots_brain_control.teleport( $cb_ai_prototyperobot.getOrigin(), angles );
	$cb_func_firstpersonevent_disable_prototype_robots_brain_control.activate( activator );

}

void deathshead_notarget (entity activatedEntity, entity activator) 
{
	$cb_ai_mecha_deathshead_stage2.setIndicateTarget(FALSE);
	$cb_ai_mecha_deathshead_stage2.setPlayerShouldLowerWeapon(TRUE);

}

