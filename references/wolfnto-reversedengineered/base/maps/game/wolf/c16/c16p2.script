}

void call_stage2_updatecowardspeech ( entity activatedEntity, entity activator ){
	// Speak coward line if player is running away from deaths head for a while
	float runningAwayTime = sys.getTime();
	float playingVOTime = sys.getTime(); // Don't allow coward speech for a little while
	while ( true ) {
		if ( $cb_ai_mecha_deathshead_stage2.isPlayingVoiceOver() ) {
			playingVOTime = sys.getTime();	
		} 
		
		// Only allow coward speech after being silent a while
		if ( sys.getTime() > playingVOTime + 2.0 ) { 
			if ( ( Vec_x( $player1.getUserMove() ) > 10 ) &&
				 ( sys.vecDotProduct( $cb_ai_mecha_deathshead_stage2.getWorldOrigin() - $player1.getWorldOrigin(), sys.angToForward( $player1.getViewAngles() ) ) < 0.0 ) ) {
				// Running forward and facing away from MDH
				if ( sys.getTime() > runningAwayTime + 1.0 ) {
					// Speech time!
					break;
				}
												
			} else {
				// Not running away
				runningAwayTime = sys.getTime();
			}
		} else {
			// Not allowed to speak
			runningAwayTime = sys.getTime();
		}
		sys.wait( 0.1 );
	}

	// Speech time!
	$gp_target_relay_cowardspeech.activate( $cb_ai_mecha_deathshead_stage2 );	
}


