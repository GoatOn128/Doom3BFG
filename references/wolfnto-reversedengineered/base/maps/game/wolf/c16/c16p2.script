void open_exitdoors (entity activatedEntity, entity activator) 
{
	$gp_func_mover_exitdoor_left.time(1);
	$gp_func_mover_exitdoor_left.accelTime(0.3);
	$gp_func_mover_exitdoor_left.decelTime(0.2);
	$gp_func_mover_exitdoor_left.move(DIR_FORWARD, 110);

	$gp_func_mover_exitdoor_right.time(1);
    $gp_func_mover_exitdoor_right.accelTime(0.3);
    $gp_func_mover_exitdoor_right.decelTime(0.2);
	$gp_func_mover_exitdoor_right.move(DIR_BACK, 110);
	
	/* 
	$gp_func_mover_labdoor1.time(1);
	$gp_func_mover_labdoor1.accelTime(0.3);
	$gp_func_mover_labdoor1.decelTime(0.2);
	$gp_func_mover_labdoor1.move(DIR_UP, 120);

	$gp_func_mover_labdoor2.time(1);
    $gp_func_mover_labdoor2.accelTime(0.3);
    $gp_func_mover_labdoor2.decelTime(0.2);
	$gp_func_mover_labdoor2.move(DIR_DOWN, 120);
	*/
}

void close_exitdoors (entity activatedEntity, entity activator) 
{
	$gp_func_mover_exitdoor_left.time(6);
	$gp_func_mover_exitdoor_left.accelTime(0.3);
	$gp_func_mover_exitdoor_left.decelTime(0.2);
	$gp_func_mover_exitdoor_left.move(DIR_BACK, 110);

	$gp_func_mover_exitdoor_right.time(6);
    $gp_func_mover_exitdoor_right.accelTime(0.3);
    $gp_func_mover_exitdoor_right.decelTime(0.2);
	$gp_func_mover_exitdoor_right.move(DIR_FORWARD, 110);
}

