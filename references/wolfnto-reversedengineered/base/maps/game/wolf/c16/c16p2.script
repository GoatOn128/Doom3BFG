}

// Pre battle tesla dummy attack /////////////////////////////////////////////////////////////
boolean prebattleAttackActive = false;
int preBattleAttackNum = 0;
 
void call_prebattle_robotattack_start( entity activatedEntity, entity activator ){
	preBattleAttackNum++;
    $cb_ai_prototyperobot.startFX( FX_CINEMATIC_10 ); // Just in case Yann wants to prettify
    $cb_ai_prototyperobot.startFX( FX_TESLA_CHARGE ); 
    prebattleAttackActive = true;

    sys.wait( 0.8 );

	if ( !prebattleAttackActive ) {
		return;
	}

	// Discharge
    $cb_ai_prototyperobot.startFX( FX_TESLA_DISCHARGE ); 
	vector teslaPos = $gp_func_fx_prebattle_teslaexplosion.getWorldOrigin();
	vector targetDir = $player1.getWorldOrigin() - teslaPos;
	targetDir_z = 0.0f;
	teslaPos = teslaPos + targetDir * 0.4;
	$gp_func_fx_prebattle_teslaexplosion.setWorldOrigin( teslaPos );
    $gp_func_fx_prebattle_teslaexplosion.startFX( FX_TESLA_BOMB );
	$gp_misc_electricbolt_prebattleattack.activate( $cb_ai_prototyperobot ); 

	// Bomb is being charged
    float bombExplodeTime = sys.getTime() + 4.2;
	int flickerCountdown = 10 + sys.randomInt( 10 );
	while ( prebattleAttackActive && ( sys.getTime() < bombExplodeTime ) ) {
		sys.radiusDamage( teslaPos, $cb_ai_prototyperobot, $cb_ai_prototyperobot, $cb_ai_prototyperobot, "damage/tungsten/ai/robot/teslabomb_buildup", 1.0 ); 
		flickerCountdown--;
		if ( flickerCountdown <= 0 ) {
			$gp_misc_electricbolt_prebattleattack.activate( $cb_ai_prototyperobot ); 
			flickerCountdown = 10 + sys.randomInt( 10 );
		}
		sys.waitFrame();
	} 

	if ( !prebattleAttackActive ) {
		return;
	}

	// Kablazappo!
    $cb_ai_prototyperobot.startFX( FX_CINEMATIC_9 );
    $cb_ai_prototyperobot.stopFX( FX_CINEMATIC_10 );
    $cb_ai_prototyperobot.stopFX( FX_TESLA_BOMB );
    $gp_func_fx_prebattle_teslaexplosion.startFX( FX_TESLA_EXPLOSION );
    $gp_func_fx_prebattle_teslaexplosion.stopFX( FX_TESLA_BOMB );
	vector dir = $player1.getWorldOrigin() - $gp_func_fx_prebattle_teslaexplosion.getWorldOrigin();
	if ( preBattleAttackNum > 1 ) {
		// Lethal attack
	    $player1.damage( $cb_ai_prototyperobot, $cb_ai_prototyperobot, @damage( "damage/tungsten/ai/robot/prototyperobot_tesla" ), 1000.0f, dir ); 
	} else {
		// Non-lethal attack
	    $player1.damage( $cb_ai_prototyperobot, $cb_ai_prototyperobot, @damage( "damage/tungsten/ai/robot/prototyperobot_tesla_nonlethal" ), 1.0f, dir ); 
		float curHealth = FMax( $player1.getHealth(), 1.0 );
		$player1.setHealth( FMin( curHealth, sys.randomInt( 8 ) + 3 ) );	
	}
	$gp_target_anim_changestate_prebattle_exit.activate( $cb_ai_prototyperobot );	
	
	sys.wait( 3.0 );
	if ( prebattleAttackActive ) {	
		// Rinse and repeat
		$gp_ai_scriptedanimweb_prototype_robot_introattack.activate( $cb_ai_prototyperobot );	
	}
}


void call_prebattle_robotattack_abort( entity activatedEntity, entity activator ){
	prebattleAttackActive = false;	
    $cb_ai_prototyperobot.stopFX( FX_CINEMATIC_10 );
    $cb_ai_prototyperobot.stopFX( FX_TESLA_ABORT );
	$gp_misc_electricbolt_prebattleattack.hide();
    $gp_func_fx_prebattle_teslaexplosion.stopFX( FX_TESLA_ABORT );
    $gp_func_fx_prebattle_teslaexplosion.stopFX( FX_TESLA_BOMB );
	$gp_target_relay_prebattle_robotattack_started.makeActivatable( false );
	$gp_ai_scriptedanimweb_prototype_robot_introattack.makeActivatable( false );
	$gp_target_relay_prebattle_robotattack_animdelay.makeActivatable( false );
	$gp_target_ai_aicommand_prebattle_robotattack.makeActivatable( false );
	$gp_target_relay_prebattle_robotattack.makeActivatable( false );
	$gp_misc_electricbolt_prebattleattack.hide();
}
// Pre battle tesla dummy attack end /////////////////////////////////////////////////////////
