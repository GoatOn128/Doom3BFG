#define ELEVATOR_SHAFT_HEIGHT 1026

#define ELEVATOR_GATES_HALF_DISTANCE 65
#define ELEVATOR_GATES_MOVE_TIME 0.6
#define ELEVATOR_GATES_ACCEL_TIME 0
#define ELEVATOR_GATES_DECEL_TIME 0.2

#define ELEVATOR_ACCEL_TIME 3
#define ELEVATOR_DECEL_TIME 3
#define ELEVATOR_RIDE_TIME  10

void call_elevatorgates_part2_open( entity activatedEntity, entity activator )
{	
	$gp_func_elevatorgate_01_part2.time( ELEVATOR_GATES_MOVE_TIME );
    $gp_func_elevatorgate_01_part2.accelTime( ELEVATOR_GATES_ACCEL_TIME );
    $gp_func_elevatorgate_01_part2.decelTime( ELEVATOR_GATES_DECEL_TIME );
    $gp_func_elevatorgate_01_part2.move( DIR_UP, ELEVATOR_GATES_HALF_DISTANCE );

	$gp_func_elevatorgate_02_part2.time( ELEVATOR_GATES_MOVE_TIME );
    $gp_func_elevatorgate_02_part2.accelTime( ELEVATOR_GATES_ACCEL_TIME );
    $gp_func_elevatorgate_02_part2.decelTime( ELEVATOR_GATES_DECEL_TIME );
    $gp_func_elevatorgate_02_part2.move( DIR_DOWN, ELEVATOR_GATES_HALF_DISTANCE );
