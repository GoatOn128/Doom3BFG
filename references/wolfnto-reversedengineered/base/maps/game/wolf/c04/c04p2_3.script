//-------------------------------------------------------------------------------
//Panzer Hund
//-------------------------------------------------------------------------------

object panzerhund_move {
	void	init();
};

void panzerhund_move::init() {
	
	self.time( 1 );
	self.accelTime( 0 );
	self.decelTime( 0 );
	self.rotateOnce( '8 3 0' );
	sys.waitFor( self );
	sys.wait( .1 );
		
	while( 1 ){
		self.time( 0.4 );
		self.accelTime( 0.1 );
		self.decelTime( 0.2 );
		
		self.rotateOnce( '-30 0 0' );
		
		sys.waitFor( self );
		sys.wait( .1 );
		
		self.rotateOnce( '30 0 0' );
		
		sys.waitFor( self );
		sys.wait( .1 );
	}
}

