}

void call_roadkill_1( entity activatedEntity, entity activator ) {

	sys.print(" ROAD KILL! ");	
	$gp_anim_roadkill_1.show();
	
	int state = sys.randomInt(2) + 4; 
	$gp_target_startsoundshader_roadkill.activate( activator );
	$gp_anim_roadkill_1.setAnimState( state, 200, false );
}

