// Executed before one comes to Zellenblock (always), putting the elevator in the "Down" position
void elevator_part2_force_set_down( entity activatedEntity, entity activator )
{	
	// open lower flaps
	vector angle;
	angle_x = 0;
	angle_y = 90;
	angle_z = 0;
	$gp_joint_elevatorflap_1.teleport($gp_joint_elevatorflap_1.getOrigin(), $gp_joint_elevatorflap_1.getAngles() - angle);
	$gp_joint_elevatorflap_2.teleport($gp_joint_elevatorflap_2.getOrigin(), $gp_joint_elevatorflap_2.getAngles() + angle);
	
	// close gate
    vector v;
    v_x = 0;
    v_y = 0;    
    v_z = ELEVATOR_GATES_HALF_DISTANCE;

	$gp_func_elevatorgate_1.teleport($gp_func_elevatorgate_1.getOrigin() + v, $gp_func_elevatorgate_1.getAngles());
	$gp_func_elevatorgate_2.teleport($gp_func_elevatorgate_2.getOrigin() - v, $gp_func_elevatorgate_2.getAngles());
	$gp_func_elevatorgate_3.teleport($gp_func_elevatorgate_3.getOrigin() + v, $gp_func_elevatorgate_3.getAngles());
	$gp_func_elevatorgate_4.teleport($gp_func_elevatorgate_4.getOrigin() - v, $gp_func_elevatorgate_4.getAngles());

	// Setup the phys
	$gp_func_dynamic_elevator_blocker.hide();	
}

// Executed if one skips the elevator and goes up in Zellenblock, putting the elevator in the "Up" position
// Note that elevator_part2_force_set_down(...) function has been called prior to this one, so we need to do some resets.
void elevator_part2_force_set_up( entity activatedEntity, entity activator )
{
	// open upper and close lower flaps
	vector angle;
	angle_x = 0;
	angle_y = 90;
	angle_z = 0;

	$gp_joint_elevatorflap_1.teleport($gp_joint_elevatorflap_1.getOrigin(), $gp_joint_elevatorflap_1.getAngles() + angle);
	$gp_joint_elevatorflap_2.teleport($gp_joint_elevatorflap_2.getOrigin(), $gp_joint_elevatorflap_2.getAngles() - angle);
	$gp_joint_elevatorflap_3.teleport($gp_joint_elevatorflap_3.getOrigin(), $gp_joint_elevatorflap_3.getAngles() - angle);
	$gp_joint_elevatorflap_4.teleport($gp_joint_elevatorflap_4.getOrigin(), $gp_joint_elevatorflap_4.getAngles() + angle);
	$gp_joint_elevatorflap_5.teleport($gp_joint_elevatorflap_5.getOrigin(), $gp_joint_elevatorflap_5.getAngles() - angle);
	$gp_joint_elevatorflap_6.teleport($gp_joint_elevatorflap_6.getOrigin(), $gp_joint_elevatorflap_6.getAngles() + angle);

    // teleport elevator and flaps to upper position
    vector v;
    v_x = 0;
    v_y = 0;    
    v_z = ELEVATOR_SHAFT_HEIGHT;

	$gp_joint_elevatorflap_1.teleport($gp_joint_elevatorflap_1.getOrigin() + v, $gp_joint_elevatorflap_1.getAngles());
	$gp_joint_elevatorflap_2.teleport($gp_joint_elevatorflap_2.getOrigin() + v, $gp_joint_elevatorflap_2.getAngles());
	$gp_joint_elevatorflap_3.teleport($gp_joint_elevatorflap_3.getOrigin() + v, $gp_joint_elevatorflap_3.getAngles());
	$gp_joint_elevatorflap_4.teleport($gp_joint_elevatorflap_4.getOrigin() + v, $gp_joint_elevatorflap_4.getAngles());
	$gp_joint_elevatorflap_5.teleport($gp_joint_elevatorflap_5.getOrigin() + v, $gp_joint_elevatorflap_5.getAngles());
	$gp_joint_elevatorflap_6.teleport($gp_joint_elevatorflap_6.getOrigin() + v, $gp_joint_elevatorflap_6.getAngles());
