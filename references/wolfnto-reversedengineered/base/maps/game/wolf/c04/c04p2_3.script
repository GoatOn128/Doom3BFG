void elevator_part2_ride_up( entity activatedEntity, entity activator )
{
	$gp_func_elevator.time( ELEVATOR_RIDE_TIME );
    $gp_func_elevator.accelTime( ELEVATOR_ACCEL_TIME );
    $gp_func_elevator.decelTime( ELEVATOR_DECEL_TIME );
    $gp_func_elevator.move(DIR_UP, ELEVATOR_SHAFT_HEIGHT );

  	$gp_joint_elevatorflap_1.time( ELEVATOR_RIDE_TIME );
    $gp_joint_elevatorflap_1.accelTime( ELEVATOR_ACCEL_TIME );
    $gp_joint_elevatorflap_1.decelTime( ELEVATOR_DECEL_TIME );
    $gp_joint_elevatorflap_1.move(DIR_UP, ELEVATOR_SHAFT_HEIGHT );

  	$gp_joint_elevatorflap_2.time( ELEVATOR_RIDE_TIME );
    $gp_joint_elevatorflap_2.accelTime( ELEVATOR_ACCEL_TIME );
    $gp_joint_elevatorflap_2.decelTime( ELEVATOR_DECEL_TIME );
    $gp_joint_elevatorflap_2.move(DIR_UP, ELEVATOR_SHAFT_HEIGHT );

  	$gp_joint_elevatorflap_3.time( ELEVATOR_RIDE_TIME );
    $gp_joint_elevatorflap_3.accelTime( ELEVATOR_ACCEL_TIME );
    $gp_joint_elevatorflap_3.decelTime( ELEVATOR_DECEL_TIME );
    $gp_joint_elevatorflap_3.move(DIR_UP, ELEVATOR_SHAFT_HEIGHT );

  	$gp_joint_elevatorflap_4.time( ELEVATOR_RIDE_TIME );
    $gp_joint_elevatorflap_4.accelTime( ELEVATOR_ACCEL_TIME );
    $gp_joint_elevatorflap_4.decelTime( ELEVATOR_DECEL_TIME );
    $gp_joint_elevatorflap_4.move(DIR_UP, ELEVATOR_SHAFT_HEIGHT );

  	$gp_joint_elevatorflap_5.time( ELEVATOR_RIDE_TIME );
    $gp_joint_elevatorflap_5.accelTime( ELEVATOR_ACCEL_TIME );
    $gp_joint_elevatorflap_5.decelTime( ELEVATOR_DECEL_TIME );
    $gp_joint_elevatorflap_5.move(DIR_UP, ELEVATOR_SHAFT_HEIGHT );

  	$gp_joint_elevatorflap_6.time( ELEVATOR_RIDE_TIME );
    $gp_joint_elevatorflap_6.accelTime( ELEVATOR_ACCEL_TIME );
    $gp_joint_elevatorflap_6.decelTime( ELEVATOR_DECEL_TIME );
    $gp_joint_elevatorflap_6.move(DIR_UP, ELEVATOR_SHAFT_HEIGHT );

  	$gp_joint_elevatorhandle.time( ELEVATOR_RIDE_TIME );
    $gp_joint_elevatorhandle.accelTime( ELEVATOR_ACCEL_TIME );
    $gp_joint_elevatorhandle.decelTime( ELEVATOR_DECEL_TIME );
    $gp_joint_elevatorhandle.move(DIR_UP, ELEVATOR_SHAFT_HEIGHT );
}

