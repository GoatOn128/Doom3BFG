//-------------------------------------------------------------------------------
// Freeing chained prisoners
//-------------------------------------------------------------------------------

#define CHAINED_PRISONERS 5
int freed_prisoners = 0;
int animstate_non_fergus = 7;

// This scriptobject is set on each chained prisoner.
// They share a global counter to determine if they 
// will turn into Fergus or randomize their animation 
// response when being freed,

object chainEvent {
	void onTrigger( entity activator );
};

void chainEvent::onTrigger(entity activator) {
	freed_prisoners++;
	if ( freed_prisoners < CHAINED_PRISONERS ) {	
		// using magic numbers 7,9,11,13,15 due to how the prisoners have their animations set up
		// Todo: find a way to put these in a list and randomize.
		self.setAnimState(animstate_non_fergus,-1,false);
		animstate_non_fergus += 2;
	} else {	
		// Last prisoner freed is Fergus
		self.setAnimState(2,-1,false);
        $sound_music_cue09_switch2.activate( $activator );												
																
		// Teleport and Show the usable for removing Fergus's mask				
		$use_free_fergus.teleport(self.getOrigin(), self.getAngles());
		$gp_misc_interactivemarker_companion.bindToJoint(self, "", "spine2", 1.0);
		$gp_prisoner_vo_pos.bindToJoint(self, "", "head", 1.0);
	}
}

