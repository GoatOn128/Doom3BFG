//-------------------------------------------------------------------------------
// Fergus kicks grating
//-------------------------------------------------------------------------------

void grating_kick( entity activatedEntity, entity activator )
{
	$joint_grating.time( 0.3 );
    $joint_grating.rotateOnce( '90 0 0' );
}


void sudow( entity activatedEntity, entity activator )
{
	$player1.teleport( $fergus_info_null_2.getOrigin(), $fergus_info_null_2.getAngles() );
	$ai_part3_zellenblock_b_fergus2.teleport( $fergus_info_null_1.getOrigin(), $fergus_info_null_1.getAngles() );
	sys.waitFrame();
	$ai_part3_zellenblock_b_fergus2.show();
}

// Fergus | Wyatt don't lock in player script 
void friendly_waitoutside( entity activatedEntity, entity activator )
{
	sys.print( "Friend wait outside\n");
	$ai_tungsten_c04_part_03_rifle_wyatt1.setOverrideScenePoint( $fergus_info_scenepoint_combat_waitoutside );
	$ai_part3_zellenblock_b_fergus2.setOverrideScenePoint( $fergus_info_scenepoint_combat_waitoutside );
}


