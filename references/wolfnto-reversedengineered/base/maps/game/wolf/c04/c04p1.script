//-------------------------------------------------------------------------------
// spotlight
//-------------------------------------------------------------------------------


#define SpotNotStarted 0
#define SpotStarting 1
#define SpotRunning 2
#define SpotHit 3
#define SpotDone 4



void SpotEventDoneFunc( entity activatedEntity, entity activator ) {
	$spot_mover.callFunction("spotEventDone");
}


object spotMover {
	float startDelay;
	entity light;
	entity shadowLight;
	entity target;
	entity activate_at_event_start;
	entity activate_at_event_spotted;
	entity volumeEffect;
	int state;
	float spotAngle;
	void init();
	void onTrigger( entity activator );
	void startMove( );
	void moveSpot( );
	vector getDir( entity target );
	void spotEventDone();
	void turnOffLights();
	void turnOnLights();
	
	boolean entityInSpot(entity testEntity);
};


void spotMover::spotEventDone() {
	state = SpotDone;
	target.activate(self);
	light.off();
	shadowLight.off();
}

void spotMover::init() {
	state = SpotNotStarted;
	self.hide();
	spotAngle = sys.cos( spotAngle / 2 );
}

void spotMover::turnOnLights() {
	light.on ();
	shadowLight.on();
	volumeEffect.show();
}

void spotMover::turnOffLights() {
	light.off ();
	shadowLight.off();
	volumeEffect.hide();
}


#define lerpTime 2
void spotMover::startMove() {
	state = SpotStarting;
	sys.wait( startDelay );
	
	self.hide();

	target.activate(self);
	activate_at_event_start.activate(self);

	sys.wait( 8 );

	turnOnLights();
	sys.wait( 0.1 );
	turnOffLights();
	sys.wait( 0.15 );
	turnOnLights();
	sys.wait( 0.1 );
	turnOffLights();
	sys.wait( 0.14 );
	turnOnLights();	

	self.waitFrame();
	self.waitFrame();
	state = SpotRunning;	
}

vector spotMover::getDir( entity target ) {
	vector target_offset = target.getMaxs() - target.getMins();
	vector targetPos = target.getWorldOrigin() + target_offset;
	vector selfPos = self.getWorldOrigin();
	vector diff = selfPos - targetPos;
	return sys.vecNormalize(diff);	
}


void spotMover::onTrigger( entity activator ) {
	
	if ( state == SpotRunning ) {
		if(	entityInSpot($player1) ) {
			activate_at_event_spotted.activate(self);
			sys.println( "hit!" );
			sys.wait( 5 );
//			int i;
//			for( i = 0; i < 10; i++ ) {
//			sys.wait( 0.5 );
//				$player1.decreaseHealth( 5 );
//			}
//		$player1.kill();
			state = SpotHit;
		}
	} else if ( state == SpotNotStarted ) {
		startMove ();
	}
};

void spotMover::moveSpot() {
	vector dir = getDir ( target );
	vector angles = sys.vecToAngles(dir);
	self.setAngles(angles);
}

boolean spotMover::entityInSpot(entity testEntity) {
	vector dir = getDir( testEntity );
	vector lightDir = sys.angToForward( light.getAngles() );
	float dot = sys.vecDotProduct( dir, lightDir);
	return dot >= spotAngle;
}



object spotTarget {
	boolean isRunning;
	void init();
	void onTrigger( entity activator );
};

void spotTarget::init() {
	self.disableSplineAngles();
	self.hide();
	boolean isRunning = false;
}

void spotTarget::onTrigger( entity activator ) {
	
	isRunning = !isRunning;

	self.hide();	
		
	while ( isRunning ) {
		self.startSpline($spline_path_2);
		sys.waitFor ( self );
	}
	
};

void randomRotateMover( entity mover, entity linked ) {
    // Make sure mover object does one revelation in one second
    mover.time( 1.0 );
	if ( linked != $null ) {
		linked.time( 1.0 );
	}
    
    while ( true ) {

        // Randomize an animtion time between 0.5 and 2.5
        float animtime = 0.5 + sys.random( 2.0 );
        
        // Randomize rotation between 90 and 270 degrees
        float angle = 90 + sys.random( 180.0 );
        
        // Randomize if we should rotate clockwise or anti-clockwise
        boolean clockwise = sys.randomInt( 2 ) % 2 == 0;
		if ( clockwise ) {
		    angle = -angle;
		}

        // Setup rotation angle (assume un-rotated entity)
        vector v;
        v_x = 0;
        v_y = 0;
        v_z = angle;

        // Set object to rotate
        mover.rotate( v );
		if ( linked != $null ) {
			linked.rotate( v );
		}
        
        // call wait on object before doing a new randomization run on angle and direction
        mover.wait( animtime );
    }
}

object RandomObjectRotate {

	string link;

	// Called when object is first initialized (maybe map start? I'm not sure.)
    void init();
    
    // Called whenever the object is activated (from trigger, activate code etc.)
    void onTrigger( entity activator );
};

void RandomObjectRotate::init() {

	entity linked = $null;
	if ( sys.strLength( link ) > 0 ) {
		linked = sys.getEntity( link );
	}

    // Uncomment to make object rotate immediately when initialized
    randomRotateMover( self, linked );
}

void RandomObjectRotate::onTrigger( entity activator ) {
    // Uncomment to make object rotate when 'activated'
    //randomRotateMover( self, $null );
}


