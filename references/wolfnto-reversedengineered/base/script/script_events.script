// respawns the player with a fade for in-map teleports
scriptEvent void respawnWithFade( string spawnSpot, int fadeTimeMS );

// fades the screen to a color over a time duration in MS
scriptEvent void fadeView( vector color, float alpha, int fadeTimeMS );

