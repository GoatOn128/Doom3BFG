#define	TL_KEY_DOF_FAR_BEGIN								11			// Start distance for "far" region
#define	TL_KEY_DOF_FAR_AMOUNT								12			// Amount of blur in "far" region
#define	TL_KEY_DOF_SKY_AMOUNT								13			// Amount of blur for background pixels
#define	TL_KEY_MAX											14

#define	TL_KEYTYPE_BOOL										0			// boolean valuebool
#define	TL_KEYTYPE_INT										1			// integer valueint
#define	TL_KEYTYPE_FLOAT									2			// floating point valuefloat
#define	TL_KEYTYPE_FLOAT3									3			// 3-float valueidVec3
#define	TL_KEYTYPE_COLOR_RGB								4			// rgb color valueidVec3
#define	TL_KEYTYPE_FLOAT4									5			// 4-float valueidVec4
#define	TL_KEYTYPE_COLOR_RGBA								6			// rgba color valueidVec4
#define	TL_KEYTYPE_STRING									7			// string valueidStr(can't be animated)
#define	TL_KEYTYPE_FLOAT6									8			// 6-float valueidVec6
#define	TL_KEYTYPE_MAX										9

#define	GROUP_AVERAGE_HEALTH								0			// trigger on the average health of the group members
#define	GROUP_MEMBERS_DEAD									1			// trigger on the number of dead group members
#define	GROUP_MEMBERS_DEAD_UNALERTED						2			// trigger on the number of dead group members if the group has not yet been alerted
#define	GROUP_MEMBERS_ALIVE									3			// trigger on the number of group members remaining
#define	GROUP_MEMBERS_ALIVE_UNALERTED						4			// trigger on the number of members remaining in group that is not alerted
#define	GROUP_PERCENT_ALIVE									5			// trigger on percentage of total group still alive
#define	GROUP_NUMBERS_ADVANTAGE								6			// trigger on number of living group members minus number of known group enemies
#define	AVERAGE_ENEMY_HEALTH								7			// trigger on the average health of all enemies known to the group
#define	LOWEST_PLAYER_HEALTH								8			// trigger on health of player with lowest health
#define	LOWEST_TARGET_PLAYER_HEALTH							9			// trigger on the health of player with lowest health that is a target of the group
#define	HIGHEST_PLAYER_HEALTH								10			// trigger on health of player with lowest health
#define	HIGHEST_TARGET_PLAYER_HEALTH						11			// trigger on the health of player with lowest health that is a target of the group
#define	GROUP_LEADER_HEALTH									12			// trigger on the health of the group leader
#define	HAS_ENEMY											13			// true if more than 1/2 of the group members have an enemy target (search or combat)
#define	NUM_IN_COMBAT										14			// returns the number of living group members in the combat state
#define	NUM_IN_SEARCH										15			// returns the number of living group members in the search state
#define	NUM_IN_RELAXED										16			// returns the number of living group members in the relaxed state
#define	NUM_WITH_ENEMY										17			// returns the number of living group members that have an enemy
#define	NUM_WITH_PLAYER_ENEMY								18			// returns the number of living group members that have a player as the enemy
#define	TRIGGERVAR_MAX										19			// internal use only! do not use in editor!

#define	ACTIVATOR_NONE										0			// pass a NULL activator
#define	ACTIVATOR_GROUP_LEADER								1			// pass the group leader as the activator of the trigger
#define	ACTIVATOR_RANDOM_GROUP_MEMBER						2			// pass a randomly selected member of the group as the activator of the trigger (include dead members)
#define	ACTIVATOR_RANDOM_LIVE_GROUP_MEMBER					3			// pass a randomly selected living member of the group as the activator of the trigger ( NULL if no living members )
#define	ACTIVATOR_RANDOM_DEAD_GROUP_MEMBER					4			// pass a randomly selected dead member of the group as the activator of the trigger ( NULL if no dead members )
#define	ACTIVATOR_RANDOM_ENEMY								5			// pass a randomly selected enemy from the known enemies of the group as the activator of the trigger
#define	ACTIVATOR_TARGET_PLAYER_LOWEST_HEALTH				6			// pass the player with the lowest health who is a known enemy of the group as the activator of the trigger ( if no targeted players, choose from non-targeted players )
#define	ACTIVATOR_TARGET_PLAYER_HIGHEST_HEALTH				7			// pass the player with the highest health who is a known enemy of the group as the activator of the trigger ( if no targeted players, choose from non-targeted players )
#define	ACTIVATOR_PLAYER_LOWEST_HEALTH						8			// pass the player with the lowest health as the activator of the trigger
#define	ACTIVATOR_PLAYER_HIGHEST_HEALTH						9			// pass the player with the highest health as the activator of the trigger

#define	TRIGGEROP_LESS_THAN									0			// trigger when the trigger variable is less than the test value
#define	TRIGGEROP_LESS_THAN_EQUAL							1			// trigger when the trigger variable is less than or equal to the test value
#define	TRIGGEROP_EQUAL										2			// trigger when the trigger variable equals the test value
#define	TRIGGEROP_GREATER_THAN								3			// trigger when the trigger variable is greater than the test value
#define	TRIGGEROP_GREATER_THAN_EQUAL						4			// trigger when the trigger variable is greater than or equal to the test value

#define	AIMOVESTATUS_DONE									0
#define	AIMOVESTATUS_MOVING									1
#define	AIMOVESTATUS_ERROR									2
#define	AIMOVESTATUS_NO_AAS									3			// no aas
#define	AIMOVESTATUS_INVALID_ENTITY							4			// tried to move to a NULL entity
#define	AIMOVESTATUS_UNREACHABLE							5			// point or entity is unreachable
#define	AIMOVESTATUS_NOT_IN_AAS								6			// AI could not be pushed into a valid AAS area.
#define	AIMOVESTATUS_PATHING_FAILED							7			// couldn't find a path to the destination point
#define	AIMOVESTATUS_OBSTRUCTED								8			// obstacle in the way
#define	AIMOVESTATUS_NO_PATH_GROUP							9			// no path group was found
#define	AIMOVESTATUS_NO_PATH_POINT							10			// no closest path point was found
#define	AIMOVESTATUS_STUCK									11			// not making any progress for an unknown reason
#define	AIMOVESTATUS_MAX									12

#define	ONOFFAUTO_OFF										0
#define	ONOFFAUTO_ON										1
#define	ONOFFAUTO_AUTO										2

#define	TAKEDOWNTYPE_DEFAULT								0			// Default, if friendly won't be able to do takedowns
#define	TAKEDOWNTYPE_NOTAKEDOWN								1			// Can't do takedowns on this ai
#define	TAKEDOWNTYPE_FORCEFRIENDLYTAKEDOWN					2			// Can do takedown even if friendly

#define	ACTION_SET_CLASSES									0
#define	ACTION_ADD_CLASSES									1
#define	ACTION_REMOVE_CLASSES								2

#define	TARGETJOB_ACCEPTED									0
#define	TARGETJOB_READYTOTURNIN								1
#define	TARGETJOB_COMPLETED									2
#define	TARGETJOB_FAILED									3

#define	TLC_ACTIVATE										0
#define	TLC_ACTIVATE_FROM_DEACTIVE							1
#define	TLC_DEACTIVATE_IN_MAP								2
#define	TLC_ADD_DEACTIVE_TO_PLAYER							3
#define	TLC_REMOVE_FROM_PLAYER								4
#define	TLC_REMOVE_FROM_GAME								5
#define	TLC_REMOVE_MARK_ACTIVE_NEXT_MAP_LOAD				6
#define	TLC_REMOVE_MARK_DEACTIVE_NEXT_MAP_LOAD				7

#define	TARGETLAYERCHANGE_NONE								0
#define	TARGETLAYERCHANGE_ACTIVATE							1
#define	TARGETLAYERCHANGE_DEACTIVATE						2

#define	BLOCKED_NONE										0
#define	BLOCKED_WORLD										1			// World blocks dummyFire from shooting
#define	BLOCKED_AI											2			// AI blocks dummyFire from shooting
#define	BLOCKED_PLAYER										4			// Player blocks dummyFire from shooting
#define	BLOCKED_VEHICLE										8			// Vehicles block dummyFire from shooting

#define	WHEN_GOING_ABOVE_COUNT								0
#define	WHEN_GOING_BELOW_COUNT								1
#define	WHEN_REACHING_COUNT									2

#define	MODE_AUTO											0
#define	MODE_MANUAL											1

#define	HELPBUTTON_NONE										0
#define	HELPBUTTON_USE										1
#define	HELPBUTTON_JUMP										2
#define	HELPBUTTON_CROUCH									3
#define	HELPBUTTON_JOURNAL									4
#define	HELPBUTTON_LOOK										5
#define	HELPBUTTON_SPRINT									6
#define	HELPBUTTON_FIRE										7
#define	HELPBUTTON_EXIT										8
#define	HELPBUTTON_MAX										9

#define	PUSH_AWAY											0			// Push targets away from this entity
