// init the camera springs to the specified spring constant
scriptEvent void camera_InitSprings( float k );

// set the camera springs to the default values
scriptEvent void camera_InitDefaultSprings();

// set the camera to follow the specified entity
scriptEvent void camera_FollowEntity( entity entity );

// set the camera to follow the specified joint on the specified entity
scriptEvent void camera_FollowEntityJoint( entity entity, string jointName, int duration );

