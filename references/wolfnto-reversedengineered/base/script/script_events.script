// Removes this object from the game.
scriptEvent void remove();

/*
================================================
	idThread
================================================
*/

// Disassociates the thread from it's thread entity and deletes the thread.
scriptEvent void remove();

// Terminates this thread.
scriptEvent void endThread();

// Terminates a thread.
scriptEvent void terminate( int threadHandle );

// Pauses the current thread.
scriptEvent void pause();

// Suspends execution of the current thread for the given number of seconds.
scriptEvent void wait( float time );

// Suspends execution for one game frame.
scriptEvent void waitFrame();

// Waits for the given entity to complete it's move.
scriptEvent void waitFor( entity ent );

// Waits for the given thread to terminate.
scriptEvent void waitForThread( int threadHandle );

// 
scriptEvent void waitForEvent( int eventId );

// Waits for any of the specified flags to be set.
scriptEvent void waitForFlags( int flags );

// Prints the given string to the console.
scriptEvent void print( string text );

// Prints the given line to the console.
scriptEvent void println( string text );

// Prints this line in multiplayer.
scriptEvent void say( string text );

// Breaks if the condition is zero. (Only works in debug builds.)
scriptEvent void assert( float value );

// Triggers the given entity.
scriptEvent void trigger( entity ent, entity activator );

// Sets a cvar.
scriptEvent void setcvar( string name, string value );

// Returns the string for a cvar.
scriptEvent string getcvar( string name );

// Returns a random value X where 0 <= X < range.
scriptEvent float random( float range );

// Returns a random value X where 0 <= X < range.
scriptEvent int randomInt( int range );

// Returns the current game time in seconds.
scriptEvent float getTime();

// Sets the name of the current thread.
scriptEvent void setThreadName( string name );

// REturns the name of the current thread
scriptEvent string getThreadName();

// entity associated with this thread
scriptEvent void setThreadEntity( entity ent );

// returns the handle of the current thread
scriptEvent int getThreadHandle();

// Kills all threads with the specified name.
scriptEvent void killThread( string name );

// calls a the specified function using the entity's script object, using the entity's thread
scriptEvent void threadCall( entity ent, string functionName );

// Returns a reference to the entity with the specified name.
scriptEvent entity getEntity( string name );

// Creates an entity of the specified classname and returns a reference to the entity.
scriptEvent entity spawn( string classname );

// Returns a forward vector for the given Euler angles.
scriptEvent vector angToForward( vector ang );

// Returns a right vector for the given Euler angles.
scriptEvent vector angToRight( vector ang );

// Returns an up vector for the given Euler angles.
scriptEvent vector angToUp( vector ang );

// Returns the sine of the given angle in degrees.
scriptEvent float sin( float angle );

// Returns the cosine of the given angle in degrees.
scriptEvent float cos( float angle );

// Returns the tangent of the given angle in degrees.
scriptEvent float tan( float angle );

// Returns the arcsine of the given value in degrees.
scriptEvent float arcSin( float value );

// Returns the arccos of the given value in degrees.
scriptEvent float arcCos( float value );

// Returns the arctangent of the given value in degrees.
scriptEvent float arcTan( float value );

// Returns the arctangent of the given values in degrees.
scriptEvent float arcTan2( float y, float x );

// Returns the square root of the given number.
scriptEvent float sqrt( float theSquare );

// Returns the normalized version of the given vector.
scriptEvent vector vecNormalize( vector vec );

// Returns the length of the given vector.
scriptEvent float vecLength( vector vec );

// Returns the dot product of the two vectors.
scriptEvent float vecDotProduct( vector vec1, vector vec2 );

// Returns the cross product of the two vectors.
scriptEvent vector vecCrossProduct( vector vec1, vector vec2 );

// Returns Euler angles for the given direction.
scriptEvent vector vecToAngles( vector vec );

// Checks if a float is valid
scriptEvent boolean isValidFloat( float f );

// Checks if a vector is valid
scriptEvent boolean isValidVector( vector vec );

// Sets a script callback function for when the given signal is raised on the given entity.
scriptEvent void onSignal( int signal, entity ent, string func );

// Clears the script callback function set for when the given signal is raised on the given 
//entity.
scriptEvent void clearSignalThread( int signal, entity ent );

// Returns the fraction of movement completed before the box from 'mins' to 'maxs' hits 
//solid geometry when moving from 'start' to 'end'. The 'passEntity' is considered 
//non-solid during the move.
scriptEvent float trace( vector start, vector end, vector mins, vector maxs, int contents_mask, entity passEntity );

// Returns the fraction of movement completed before the trace hits solid geometry when 
//moving from 'start' to 'end'. The 'passEntity' is considered non-solid during the move.
scriptEvent float tracePoint( vector start, vector end, int contents_mask, entity passEntity );

// Returns the fraction of movement completed during the last call to trace or tracePoint.
scriptEvent float getTraceFraction();

// Returns the position the trace stopped due to a collision with solid geometry during the 
//last call to trace or tracePoint.
scriptEvent vector getTraceEndPos();

// Returns the normal vector of the hit plane during the last call to trace or tracePoint.
scriptEvent vector getTraceNormal();

// Returns a reference to the entity hit during the last call to trace or tracePoint.
scriptEvent entity getTraceEntity();

// Returns the namer of the skeletal joint closest to the location on the entity which was 
//hit during the last call to trace or tracePoint.
scriptEvent string getTraceJoint();

// Returns the name of the body part of the entity which was hit during the last call to 
//trace or tracePoint.
scriptEvent string getTraceBody();

// Create a decal
scriptEvent void spawnDecal( entity entityToAttachTo, vector pos, vector dir, vector size, float lifeTime, decl material );

// Starts playing background music.
scriptEvent void music( string name );

// Disables saving--forces player to wait to save his progress until enable-saves is called
scriptEvent void disableSaves();

// Enables saving--be sure to call once it's safe to save if you've called disable-saves.
scriptEvent void enableSaves();

// Issues a warning.
scriptEvent void warning( string text );

// Issues an error.
scriptEvent void error( string text );

// Returns the number of characters in the string.
scriptEvent int strLength( string string );

// Returns a string composed of the first num characters.
scriptEvent string strLeft( string string, int num );

// Returns a string composed of the last num characters.
scriptEvent string strRight( string string, int num );

// Returns the string following the first num characters.
scriptEvent string strSkip( string string, int num );

// Returns a string composed of the characters from start to start + num.
scriptEvent string strMid( string string, int start, int num );

// Returns the numeric value of a string.
scriptEvent float strToFloat( string string );

// Returns the numeric value of a string.
scriptEvent int strToInt( string string );

// Damages entities within a radius defined by the damageDef. Inflictor is the entity 
//causing the damage and can be the same as the attacker (in the case of projectiles, the 
//projectile is the inflictor, while the attacker is the character that fired the 
//projectile). Ignore is an entity to not cause damage to. dmgPower scales the damage (for 
//cases where damage is dependent on time).
scriptEvent void radiusDamage( vector origin, entity inflictor, entity attacker, entity ignore, string damageDefName, float dmgPower );

// Kills all entities of specified typ (any number of bit flags may be set)
scriptEvent void killByType( entity boundsEntity, int flags );

// Returns length of time between game frames. This is not related to renderer frame rate.
scriptEvent float getFrameTime();

// Returns the number of game frames per second. This is not related to renderer frame rate.
scriptEvent float getTicsPerSecond();

// Precaches the specified sound shader. Prevents cache hits when playing sound shaders.
scriptEvent void cacheSoundShader( string soundName );

// fades a specified sound group
scriptEvent void fadeSoundGroup( int groupNum, float toDB, float overSec );

// Draws a line for debug visualization. lifetime of 0 == 1 frame.
scriptEvent void debugLine( vector color, vector start, vector end, float lifetime );

// Draws an arrow for debug visualization. lifetime of 0 == 1 frame.
scriptEvent void debugArrow( vector color, vector start, vector end, int size, float lifetime );

// Draws a circle for debug visualization. lifetime of 0 == 1 frame.
scriptEvent void debugCircle( vector color, vector origin, vector dir, float radius, int numSteps, float lifetime );

// Draws a bounding box for debug visualization. lifetime of 0 == 1 frame.
scriptEvent void debugBounds( vector color, vector mins, vector maxs, float lifetime );

// Draws text for debug visualization. align can be 0-left, 1-center, 2-right. 
//lifetime of 0 == 1 frame.
scriptEvent void drawText( string text, vector origin, float scale, vector color, int align, float lifetime );

// returns the current map path in the format: maps/<subdir>/<mapname>/
// useful for specifying paths for dynamically created func/statics with map models
scriptEvent string getMapPath();

// Creates a array entity and returns it
scriptEvent entity createArray();

// Destroys a array entity
scriptEvent void destroyArray( entity entity );

// Checks if entity is valid
scriptEvent boolean isEntityValid( entity entity );

// Checks if a layer is turned on
scriptEvent boolean isLayerActive( string layerName );

// Checks if a layer is available to be turned on
scriptEvent boolean isLayerDeactive( string layerName );

// halts game for debug... coder use only
scriptEvent void halt();

// Returns the name of a decl as a string
scriptEvent string getDeclName( decl decl );

// Returns true of the decl is non-NULL
scriptEvent boolean isValidDecl( decl decl );

// executes a console command
scriptEvent void executeCommandText( string command );

// Returns number of active AIs
scriptEvent int numActiveAIs();

// returns player's position
scriptEvent vector getPlayerPos();

