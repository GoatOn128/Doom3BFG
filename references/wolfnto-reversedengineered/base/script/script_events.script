/*
================================================
	idEntity
================================================
*/

// Returns entity from a name
scriptEvent entity findEntity( string newName );

// Returns the name of this entity.
scriptEvent string getName();

// Returns the entity def name of this entity.
scriptEvent string getEntityDefName();

// Returns whether the entity def name contains the passed string
scriptEvent boolean entityDefNameContains( string containStr );

// Sets the name of this entity.
scriptEvent void setName( string newName );

// Called when an entity is triggered
scriptEvent void activate( entity activator );

// Causes this entity to activate all it's targets. Similar to how a trigger activates entities.
// Activator is the entity that caused the action (usually the player).
scriptEvent void activateTargets( entity activator );

// sets this entity activatable or unactivatable
scriptEvent void makeActivatable( boolean activatable );

// Returns whether the entity is activatable or not
scriptEvent boolean isActivatable();

// Returns the number of entities this entity has targeted.
scriptEvent boolean targetsReady();

// Returns the number of targets.
scriptEvent float numTargets();

// Returns the requested target entity.
scriptEvent entity getTarget( float index );

// Removes the specified entity from the target list. Returns false if not found.
scriptEvent boolean removeTarget( entity target );

// Adds the specified entity to the target list
scriptEvent void addTarget( entity target );

// Clear all entities in the target list
scriptEvent void clearTargets();

// Returns a random targeted entity. Pass in an entity name to skip that entity.
scriptEvent entity randomTarget( string ignore );

// Get the entity we're bound to
scriptEvent entity getBindMaster();

// Fixes the position and orientation of this entity relative to another entity,
// such that when the master entity moves, so does this entity.
scriptEvent void bind( entity master );

// Fixes the position (but not orientation) of this entity relative to another entity,
// such that when the master entity moves, so does this entity.
scriptEvent void bindPosition( entity master );

// Fixes the position and orientation of this entity relative to a joint on another entity,
// such that when the master's joint moves, so does this entity.
scriptEvent void bindToJoint( entity master, string animName, string jointName, float orientated );

// Detaches this entity from its master.
scriptEvent void unbind();

// Removes all attached entities from the game.
scriptEvent void removeBinds();

// Sets the owner of this entity. Entity's will never collide with their owner.
scriptEvent void setOwner( entity owner );

// Sets the progression owner of this entity. The progression owner of this entity is notified on removal/use/destruction.
scriptEvent void setProgressionOwner( entity owner );

// Notifies the progression owner of this entity so it can update it's state.
scriptEvent void notifyProgressionOwner();

// Sets the model this entity uses.
scriptEvent void setModel( string modelname );

// returns the model this entity uses.
scriptEvent string getModel();

// Sets the clip model this entity uses.
scriptEvent void setClipModel( string clipModelName );

// Set the contents of the physics object to the specified flags.
scriptEvent void setContents( int contents );

// returns the contents of the entity's physics object.
scriptEvent int getContents();

// adds the specified contents flags to the physics object's existing contents flags.
scriptEvent void addContentsFlag( int contents );

// removes the specified contents flags from the physics object's existing contents flags.
scriptEvent void removeContentsFlag( int contents );

// Set the contents of the physics object to the specified flags.
scriptEvent void setClipMask( int mask );

// returns the contents of the entity's physics object.
scriptEvent int getClipMask();

// adds the specified contents flags to the physics object's existing contents flags.
scriptEvent void addClipMaskFlag( int mask );

// removes the specified contents flags from the physics object's existing contents flags.
scriptEvent void removeClipMaskFlag( int mask );

// Sets the skin this entity uses. Set to "" to turn off the skin.
scriptEvent void setSkin( string skinname );

// Sets shader parms Parm0, Parm1, Parm2, and Parm3 (red, green, blue, and alpha respectively).
scriptEvent void setShaderParms( float parm0, float parm1, float parm2, float parm3 );

// Sets the RGBA color of this entity (shader parms Parm0, Parm1, Parm2, Parm3).
scriptEvent void setColorAndAlpha( float red, float green, float blue, float alpha );

// Sets the RGB color of this entity (shader parms Parm0, Parm1, Parm2).
scriptEvent void setColor( float red, float green, float blue );

// Gets the color of this entity (shader parms Parm0, Parm1, Parm2).
scriptEvent vector getColor();

// Returns true if the entity's model is invisible.
scriptEvent int isHidden();

// Makes this entity invisible.
scriptEvent void hide();

// Makes this entity invisible, optionally skip hide FXs
scriptEvent void hideWithOptionalFx( boolean stopFx );

// Makes this entity visible if it has a model.
scriptEvent void show();

// Pre-caches the specified sound shader. Prevents cache hits when playing sound shaders.
scriptEvent void cacheSoundShader( string soundName );

// Plays a specific sound shader on the channel and returns the length of the sound in
// seconds. This is not the preferred method of playing a sound since you must ensure
// that the sound is loaded.
scriptEvent float startSoundShader( decl shader, int channel );

// Stops a specific sound shader on the channel.
scriptEvent void stopSound( int channel, int netSync );

// Fades the sound on this entity to a new level over a period of time.
// Use SND_CHANNEL_ANY for all currently playing sounds.
scriptEvent void fadeSound( int channel, float to, float over );

// Fades pitch on this entity to a new level over a period of time. Units are in semitones. 
//The Base pitch is zero. Negative is lower and positive is higher.
// Use SND_CHANNEL_ANY for all currently playing sounds.
scriptEvent void fadePitch( int channel, float to, float over );

// Plays a voiceover on the channel and returns the length of the voice over.
scriptEvent float playVoiceOver( decl voToPlay, int channel, string talkerID );

// change how the entity flashes.
scriptEvent void setHighlight( int hlColor );

// Returns the current world space position of this entity (regardless of any bind parent).
scriptEvent vector getWorldOrigin();

// Sets the current position of this entity (regardless of any bind parent).
scriptEvent void setWorldOrigin( vector org );

// Returns the current position of this entity (relative to bind parent if any).
scriptEvent vector getOrigin();

// Sets the current position of this entity (relative to it's bind parent if any).
scriptEvent void setOrigin( vector org );

// Returns the current orientation of this entity (relative to bind parent if any).
scriptEvent vector getAngles();

// Sets the current orientation of this entity (relative to bind parent if any).
scriptEvent void setAngles( vector ang );

// Returns the current forward vector of this entity's model axis
scriptEvent vector getModelForward();

// Returns the point where an AI should look to check for visibility ( 0 = origin, 1 = head, 2 = torso )
scriptEvent vector getAimPoint( int aimPointType );

// Gets the current linear velocity of this entity. The linear velocity of a physics
// object is a vector that defines the translation of the center of mass in units per second.
scriptEvent void setLinearVelocity( vector velocity );

// Sets the current linear velocity of this entity in units per second. The linear velocity of
// a physics object is a vector that defines the translation of the center of mass in units per second.
scriptEvent vector getLinearVelocity();

// Gets the current angular velocity of this entity. The angular velocity of
// a physics object is a vector that passes through the center of mass. The
// direction of this vector defines the axis of rotation and the magnitude
// defines the rate of rotation about the axis in radians per second.
scriptEvent void setAngularVelocity( vector velocity );

// Sets the current angular velocity of this entity. The angular velocity of
// a physics object is a vector that passes through the center of mass. The
// direction of this vector defines the axis of rotation and the magnitude
// defines the rate of rotation about the axis in radians per second.
scriptEvent vector getAngularVelocity();

// Gets the size of this entity's bounding box.
scriptEvent vector getSize();

// Gets the minimum corner of this entity's bounding box.
scriptEvent vector getMins();

// Gets the maximum corner of this entity's bounding box.
scriptEvent vector getMaxs();

// Returns true if this entity touches the other entity.
scriptEvent int touches( entity ent );

// Returns this entity to the position stored in the "origin" spawn arg.
// This is the position the entity was spawned in unless the "origin" key is changed.
// Note that there is no guarantee that the entity won't be stuck in another entity
// when moved, so care should be taken to make sure that isn't possible.
scriptEvent void restorePosition();

// Returns the distance of this entity to another entity.
scriptEvent float distanceTo( entity ent );

// Returns the distance of this entity to a point.
scriptEvent float distanceToPoint( vector point );

// Returns the angle (yaw) of this entity to another entity.
scriptEvent float angleTo( entity ent );

// Suspends execution of current thread for one game frame.
scriptEvent void waitFrame();

// Suspends execution of the current thread for the given number of seconds.
scriptEvent void wait( float time );

// Returns true if an entity's script object has a specific function.
scriptEvent int hasFunction( string name );

// Calls a function on this entity's script object.
scriptEvent void callFunction( string name );

// gets the named float variable from the entity's script object
scriptEvent float getScriptObjectFloat( string name );

// gets the named float variable from the entity's script object
scriptEvent int getScriptObjectInt( string name );

// gets the named bool variable from the entity's script object
scriptEvent boolean getScriptObjectBool( string name );

// gets the named string variable from the entity's script object
scriptEvent string getScriptObjectString( string name );

// gets the named vector variable from the entity's script object
scriptEvent vector getScriptObjectVector( string name );

// sets the type of script object attached to the entity and initializes it
scriptEvent void setScriptObject( string name );

// returns the name of the type of script object attached to the entity
scriptEvent string getScriptObject();

// Enables or prevents an entity from going dormant.
scriptEvent void setCanBecomeDormant( int enable );

// teleports the entity to a location
scriptEvent void teleport( vector origin, vector angles );

// clamp 'angles' between 'center' +/- 'offset'
scriptEvent vector clampAngles( vector angles, vector center, vector offset );

// calls functionality test on entity
scriptEvent void testFunctionality();

// gets the object class type
scriptEvent string getClass();

// compare class types
scriptEvent boolean isClass( string className );

// compare class type with inheritance
scriptEvent boolean isSpecificClass( string className );

// adds the entity to the remove list
scriptEvent void remove();

// true to enable damage
scriptEvent void setTakesDamage( boolean takesDamage );

// Damage entity
scriptEvent void damage( entity inflictor, entity attacker, decl damageDecl, float damageScale, vector dir );

// signal threads
scriptEvent void signalEvent( int signal );

// resets entity's health (if it has any)
scriptEvent void resetHealth();

// return current health ( 0 if entity does not have a health component )
scriptEvent float getHealth();

// Sets whether a player should be allowed to fire at this target or not
scriptEvent void setPlayerShouldLowerWeapon( boolean shouldLowerWeapon );

// Sets whether this entity should be indicated as a target or not
scriptEvent void setIndicateTarget( boolean indicateTarget );

/*
================================================
	idPlayer
================================================
*/

// Ends the death car camera view;
scriptEvent void endDeathCameraView( int ms );

// Puts player in a vehicle
scriptEvent void enterVehicle( entity entity );

// Rotates player camera towards entity. 'percent' is amount to rotate (0.0 - 1.0)
scriptEvent void trackEntity( entity entity, float percent );

// Returns the button state from the current user command.
scriptEvent float getUserButtons();

// Returns the movement relative to the player's view angles from the current user command.
// vector_x = forward, vector_y = right, vector_z = up
scriptEvent vector getUserMove();

// Returns the angles from the current user command.
scriptEvent vector getUserAngles();

// Returns the player view angles.
scriptEvent vector getViewAngles();

// Sets the player view angles.
scriptEvent void setViewAngles( vector vAngles );

// Returns the player view position
scriptEvent vector getViewPos();

// Returns the current sprintslidestate
scriptEvent int getSprintSlideState();

// Returns current sprinting state
scriptEvent boolean getIsSprinting();

// Enables the player weapon.
scriptEvent void enableWeapon();

// Lowers and disables the player weapon.
scriptEvent void disableWeapon();

// Equips the inventory item specified by the decl name. Returns true if it was able to equip the item.
scriptEvent boolean equipItem( string declName );

