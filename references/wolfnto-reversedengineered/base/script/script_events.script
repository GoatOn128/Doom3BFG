// Push player in given direction at given speed (units/sec) for given duration (sec). Sets velocity absolutely, so will be abrupt.
scriptEvent void push( vector direction, float speed, float duration );

// Modify player velocity in given direction at given speed (units/sec) for given duration (sec).
scriptEvent void pushSoft( vector direction, float speed, float duration );

