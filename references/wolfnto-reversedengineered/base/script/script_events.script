#define	ARC_SECTOR_INVALID									-1
#define	ARC_SECTOR_INSIDE									0
#define	ARC_SECTOR_NEAR										1			// Near of arc
#define	ARC_SECTOR_LEFT										2			// Left of arc
#define	ARC_SECTOR_RIGHT									3			// Right of arc
#define	ARC_SECTOR_FAR										4			// Beyond arc

#define	NONE												0
#define	ROAM												1			// Roam ScenePoint, used in non-tension areas for patrols etc
#define	LOOK												2			// Look SceenPoint, used for making AI look at things
#define	SEARCH												3			// Search SP, used by AIs when searching
#define	COMBAT												4			// Combat SP, used by AIs while in combat. Being in cover / open areas is determined by the tactical flags used.
#define	SPAWN												5			// Spawn SP, used for spawning AIs at dynamic locations given the player's current location

#define	SCRIPTFLAG_NONE										0
#define	SCRIPTFLAG_SCRIPT									1			// Set to indicate if this scenepoint is a script scenepoint or not
#define	SCRIPTFLAG_RUN										2			// Run
#define	SCRIPTFLAG_TRACK_TARGET								4			// Track target (if any)
#define	SCRIPTFLAG_ATTACK_TARGET							8			// Attack target (if any)
#define	SCRIPTFLAG_ABORT_IF_PLAYER_NOT_IN_ARC				16			// Abort if Player not in Arc
#define	SCRIPTFLAG_ABORT_IF_PLAYER_IN_ARC					32			// Abort if Player enters Arc
#define	SCRIPTFLAG_ABORT_IF_HURT_MOVING_TO					64			// Abort if hurt while moving to scenepoint
#define	SCRIPTFLAG_ABORT_IF_HURT_STAYING_AT					128			// Abort if hurt while at scenepoint
#define	SCRIPTFLAG_ABORT_IF_DETECTING_ENEMY					256			// Abort if detecting enemy
#define	SCRIPTFLAG_ABORT_IF_SPOTTING_ENEMY					512			// Abort if spotting enemy
#define	SCRIPTFLAG_KEEP_AFTER_ABORT							1024		// Stores the last override SP on abort and restores it again as appropriate
#define	SCRIPTFLAG_ALLOW_HURTS								2048		// AI can play hurts when scripted
#define	SCRIPTFLAG_EVALUATE_RELATED							4096		// If we have related scenepoints, evaluate which one to take instead of choosing a random one.
#define	SCRIPTFLAG_TELEPORT									8192		// AI will teleport to this scenepoint with the scenepoints direction.[MOVE]
#define	SCRIPTFLAG_ALWAYSALIGN								16384		// AI will align with scenepoint regardless of other considerations. TODO: Not quite done yet, they try align but are not guaranteed to make it and will activate SP before being done.
#define	SCRIPTFLAG_ID_STUDIO_RENDER							32768		// Bit needed for rendering in idStudio if no ScriptFlags are set. Cleared upon spawn

#define	SP_NONE												0
#define	SP_LOW_PRIO											1			// Low prio, worse than any other valid non low prio SP.
#define	SP_HIGH_PRIO										2			// High Prio, better than any other valid non high prio SP.
#define	SP_REEVALUATE										4			// Periodically check if there's a better SP to switch to
#define	SP_NO_TARGET_TIMEOUT								8			// Don't release this SP from cover target timeout
#define	SP_CHECK_COVER										16			// Abort if hurt or enemy seen when in hiding
#define	SP_SLEEP											32			// AI should sleep at this scenepoint

#define	SP_SELECT_NONE										0
#define	SP_SELECT_ALLOW_TACTICAL							1			// Required to use scenepoints with leanouts/popups and blindfire if SP_SELECT_ALLOW_BLINDFIRE is also set
#define	SP_SELECT_PREFER_CLOSEST							2			// Prefer closest valid SP etc
#define	SP_SELECT_PREFER_FLANKING							4			// Prefer SPs that are away from the enemies look
#define	SP_SELECT_ALLOW_LAST								8			// We can (re)use the last SP (it still has a history score of 0.0 though)
#define	SP_SELECT_ALLOW_PLAYERCROSSING						16			// Allow scenepoints that are past the player (inside a 45 cone behind the player)
#define	SP_SELECT_FORCE_ADVANCE								32			// Only scenepoints that take us closer to the player allowed
#define	SP_SELECT_FORCE_RETREAT								64			// Only scenepoints that take us further from the player allowed
#define	SP_SELECT_DEFAULT									3

#define	COVER_NONE											0
#define	COVER_POPIN_RELOAD									1			// Go to cover if we need to reload
#define	COVER_POPOUT_BLINDFIRE								2			// Use blindfire if recently fired at
#define	COVER_POPIN_HURT									4			// Go to cover if we get hurt
#define	COVER_POPIN_AIM										8			// Go to cover if enemy is aiming at us
#define	COVER_POPIN_SHOOT									16			// Go to cover if enemy is shooting at us
#define	COVER_POPOUT_HURT									32			// Go to attack if we got hurt while in cover
#define	COVER_POPOUT_NO_AIM									64			// Go to attack if enemy is aiming away
#define	COVER_POPOUT_NO_SHOOT								128			// Go to attack if enemy is not shooting at us
#define	COVER_STAYOUT_NO_AIM								256			// Stay attacking if not aimed at
#define	COVER_STAYOUT_NO_SHOOT								512			// Stay attacking if not shot at
#define	COVER_DEFAULT										54

#define	DODGE_NONE											0
