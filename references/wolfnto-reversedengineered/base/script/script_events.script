#define	SEARCHFLAG_BELOW									32			// search below
#define	SEARCHFLAG_ID_STUDIO_RENDER							64			// Bit needed for rendering in idStudio if no SearchFlags are set. Cleared upon spawn

#define	TACFLAG_NONE										0
#define	TACFLAG_STAND										1			// STAND pose is allowed at this Combat IP
