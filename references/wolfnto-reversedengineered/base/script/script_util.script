/*
==================
object randomActivator
==================
*/
object randomActivator {
	void init();
	void onTrigger( entity activator );
	void stop();
	
	float delayMin;
	float delayMax;
	__noedit boolean activated;
};

/*
==================
randomActivator::init
==================
*/
void randomActivator::init() {
	if ( delayMin <= 0.0 ) {
		delayMin = 1.0;
	}
	if ( delayMax < delayMin ) {
		delayMax = delayMin;
	}
	activated = false;
}

/*
==================
randomActivator::onTrigger
==================
*/
void randomActivator::onTrigger( entity activator ) {	
	if ( activated ) {
		// Additional activations should not do anything
		return;
	}

	// Run until deactivated.
	activated = true;
	while ( activated ) {
		entity target = self.getTarget( sys.randomInt( self.numTargets() ) );
		target.activate( self );
		
		//wait( delayMin + sys.random( delayMax - delayMin ) );
		sys.wait( RandomRangeFloat( delayMin, delayMax ) );
	}
}

/*
==================
randomActivator::stop
==================
*/
void randomActivator::stop() {
	activated = false;
}