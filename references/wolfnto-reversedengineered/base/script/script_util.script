	sys.setcvar( "g_stopTime", "1" );
}


/*
==================
object moveSelf
==================
*/
object moveSelf {	
	void init();
	void onTrigger( entity activator );
	
	float moveTime;
	float moveAccelTime;
	float moveDecelTime;
	float distance;
	int direction; // -1 UP | -2 DOWN | -3 LEFT | -4 RIGHT | -5 FORWARD | -6 BACK
	boolean toggle; // If set, the object will move back the second time it's triggered
};

/*
==================
moveSelf::init
==================
*/
void moveSelf::init() {
	self.setParmsForTime( moveTime, moveAccelTime, moveDecelTime );
}

/*
==================
moveSelf::onTrigger
==================
*/
void moveSelf::onTrigger( entity activator ) {
	self.move( direction, distance );
	if( toggle ) distance = -distance;
}

/*
==================
object rotateSelf
==================
*/
object rotateSelf {	
	void init();
	void onTrigger( entity activator );
	
	float moveTime;
	float moveAccelTime;
	float moveDecelTime;
	vector rotationVector;
	boolean toggle; // If set, the object will rotate back the second time it's triggered
};

/*
==================
rotateSelf::init
==================
*/
void rotateSelf::init() {
	self.setParmsForTime( moveTime, moveAccelTime, moveDecelTime );
}

/*
==================
rotateSelf::onTrigger
==================
*/
void rotateSelf::onTrigger( entity activator ) {
	self.rotateOnce( rotationVector );
	if( toggle ) rotationVector = -rotationVector;
}



