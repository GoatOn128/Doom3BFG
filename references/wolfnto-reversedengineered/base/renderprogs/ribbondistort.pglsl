#version 150

#include "global.inc"

uniform vec4 _fa_ [1];
uniform sampler2D samp_distortionmap;

in vec4 vofi_TexCoord0;
in vec4 vofi_Color;

out vec4 out_FragColor0;

void main() {
	vec4 texel = tex2D( samp_distortionmap, vofi_TexCoord0.xy );
	float blur = texel.z * vofi_Color.w * vofi_TexCoord0.z;
	float mask = texel.w * vofi_Color.w * vofi_TexCoord0.z;
	vec2 distortion = ( texel.xy * vec2( 2.0 ) ) - vec2( 1.0 );
	distortion *= _fa_[0 ].xy * vofi_Color.xy * vec2( mask );
	out_FragColor0 = ComputeDistortion( distortion, blur );
}
