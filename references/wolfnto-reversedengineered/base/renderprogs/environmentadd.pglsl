#version 150

#include "global.inc"

uniform vec4 _fa_ [4];
uniform sampler2D samp_sparespecularmap;
uniform sampler2D samp_sparebumpmap;
uniform samplerCube samp_dynamicenvmap;

in vec4 vofi_TexCoord1;
in vec4 vofi_TexCoord2;
in vec4 vofi_TexCoord3;
in vec4 vofi_TexCoord4;
in vec4 vofi_TexCoord0;

out vec4 out_FragColor0;

void main() {
	vec4 specularColor = tex2D( samp_sparespecularmap, vofi_TexCoord1.xy );
	vec4 bump = tex2D( samp_sparebumpmap, vofi_TexCoord1.xy );
	vec3 localNormal = vec3( ( bump.xy * 2.0 ) - 1.0, 0.0 );
	localNormal.z = sqrt( abs( 1.0 - dot3( localNormal, localNormal ) ) );
	vec3 globalNormal;
	globalNormal.x = dot3( localNormal, vofi_TexCoord2 );
	globalNormal.y = dot3( localNormal, vofi_TexCoord3 );
	globalNormal.z = dot3( localNormal, vofi_TexCoord4 );
	globalNormal = normalize( globalNormal );
	vec3 toViewer = normalize( -vofi_TexCoord0.xyz );
	float graze = saturate( dot3( toViewer, globalNormal ) );
	graze = saturate( ( _fa_[0 ].x - max( graze, -graze ) ) / ( _fa_[0 ].x + 0.0001 ) );
	graze = mix( _fa_[1 ].x, _fa_[2 ].x, graze );
	vec4 reflection;
	reflection.xyz = ( 2.0 * globalNormal * dot3( globalNormal, toViewer ) ) - toViewer;
	reflection.w = 0;
	vec3 color;
	{
		color = texCUBElod( samp_dynamicenvmap, reflection ).xyz;
	};
	color *= specularColor.xyz;
	color *= _fa_[3 ].xyz;
	color *= graze;
	float fog = saturate( exp2( vofi_TexCoord0.w ) );
	out_FragColor0.xyz = mix( vec3( 0.0 ), color.xyz, fog );
	out_FragColor0.w = 1.0;
}
