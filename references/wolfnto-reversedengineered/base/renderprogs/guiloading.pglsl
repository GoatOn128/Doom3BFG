#version 150

#include "global.inc"

uniform vec4 _fa_ [3];
uniform sampler2D samp_transmap;

in vec4 vofi_TexCoord0;
in vec4 vofi_Color;
in vec4 vofi_TexCoord1;

out vec4 out_FragColor0;

void main() {
	float numFrames = _fa_[0 ].x;
	float numFramesRcp = 1.0 / numFrames;
	float speed = _fa_[0 ].y;
	bool mirror = _fa_[0 ].z != 0;
	float animTime = 0;
	if ( mirror ) {
		animTime = mod( _fa_[1 ].x * speed, 2.0 * ( numFrames - 1 ) );
		if ( animTime >= numFrames - 1 ) {
			animTime = ( 2.0 * numFrames - 1 ) - animTime;
		}
	} else {
		animTime = mod( _fa_[1 ].x * speed, numFrames );
	}
	vec2 texCoord = vofi_TexCoord0.xy;
	texCoord.x = mod( texCoord.x * numFramesRcp, numFramesRcp );
	float frameOffset = floor( animTime ) * numFramesRcp;
	vec4 c = tex2D( samp_transmap, texCoord + vec2( frameOffset, 0.0 ) ) * vofi_Color + vofi_TexCoord1;
	out_FragColor0.xyz = pow3( saturate( c.xyz ), _fa_[2 ].x ) * c.w;
	out_FragColor0.w = c.w;
}
