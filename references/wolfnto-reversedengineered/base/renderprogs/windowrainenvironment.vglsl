#version 150

#include "global.inc"

uniform vec4 _va_ [13];

in vec4 in_Position;
in vec2 in_TexCoord;
in vec4 in_Color;

out vec4 vofi_TexCoord0;
out vec4 vofi_TexCoord1;
out vec4 vofi_TexCoord2;
out vec4 vofi_TexCoord4;
out vec4 vofi_TexCoord3;
out vec4 vofi_Color;

void main() {
	gl_Position.x = dot4( in_Position, _va_[0 ] );
	gl_Position.y = dot4( in_Position, _va_[1 ] );
	gl_Position.z = dot4( in_Position, _va_[2 ] );
	gl_Position.w = dot4( in_Position, _va_[3 ] );
	vofi_TexCoord0 = in_TexCoord.xyxy;
	vofi_TexCoord1.x = dot4( in_TexCoord, _va_[4 ] );
	vofi_TexCoord1.y = dot4( in_TexCoord, _va_[5 ] );
	vofi_TexCoord1.zw = vec2( 0.0 );
	vofi_TexCoord2.x = dot4( in_TexCoord, _va_[6 ] );
	vofi_TexCoord2.y = dot4( in_TexCoord, _va_[7 ] );
	vofi_TexCoord2.zw = vec2( 0.0 );
	vofi_TexCoord3.x = dot4( in_TexCoord, _va_[8 ] );
	vofi_TexCoord3.y = dot4( in_TexCoord, _va_[9 ] );
	vofi_TexCoord3.zw = vec2( 0.0 );
	vofi_TexCoord4.x = dot4( in_TexCoord, _va_[10 ] );
	vofi_TexCoord4.y = dot4( in_TexCoord, _va_[11 ] );
	vofi_TexCoord4.zw = vec2( 0.0 );
	vofi_Color = swizzleColor( in_Color ) * _va_[12 ];
}
