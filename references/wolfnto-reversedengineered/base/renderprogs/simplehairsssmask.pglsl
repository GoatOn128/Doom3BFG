#version 150

#include "global.inc"

uniform vec4 _fa_ [2];
uniform sampler2D samp_dither256map;
uniform sampler2D samp_transmap1;
uniform sampler2D samp_viewdepthmap;

in vec4 gl_FragCoord;
in vec4 vofi_TexCoord0;

out vec4 out_FragColor0;

void main() {
	{ if ( _fa_[0 ].x < 1.0 ) {
			vec2 texcoord = gl_FragCoord.xy * ( 1.0 / 256.0 );
			float dither = _fa_[0 ].y * tex2D( samp_dither256map, texcoord ).x + _fa_[0 ].z;
			clip( _fa_[0 ].x - 0.2 - dither * 0.6 );
		}
	};
	vec4 coverage;
	{
		{
			vec2 dx = dFdx( vofi_TexCoord0.xy ) * 0.5;
			vec2 dy = dFdy( vofi_TexCoord0.xy ) * 0.5;
			vec2 dxh = dx * 0.5;
			vec2 dyh = dy * 0.5;
			coverage = vec4( 0.0 );
			coverage += tex2DGrad( samp_transmap1, vofi_TexCoord0.xy, dx, dy);
			coverage += tex2DGrad( samp_transmap1, vofi_TexCoord0.xy - dxh - dyh, dx, dy);
			coverage += tex2DGrad( samp_transmap1, vofi_TexCoord0.xy + dxh - dyh, dx, dy);
			coverage += tex2DGrad( samp_transmap1, vofi_TexCoord0.xy - dxh + dyh, dx, dy);
			coverage += tex2DGrad( samp_transmap1, vofi_TexCoord0.xy + dxh + dyh, dx, dy);
			coverage *= vec4( 1.0 / 5.0 );
		};
	};
	{
		clip( coverage.w - 0.3 );
	};
	{
		vec2 screenTexCoord = screenPosToTexcoord( gl_FragCoord.xy, _fa_[1 ] );
		float interpolatedZOverW = gl_FragCoord.z;
		float srcDepth = interpolatedZOverW;
		float dstDepth = tex2Ddepth( samp_viewdepthmap, screenTexCoord );
		float zReject = dstDepth - srcDepth + 1e-4;
		clip( zReject );
	};
	out_FragColor0.xyz = vec3( 0.0, 1.0, 0.0 );
	out_FragColor0.w = 0.0;
}
