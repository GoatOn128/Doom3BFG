#version 150

#include "global.inc"

uniform vec4 _fa_ [5];
uniform sampler2D samp_adaptiveluminance;
uniform sampler2D samp_glaremap;
uniform sampler2D samp_viewcolormap;
uniform sampler2D samp_frameexposuremap;

in vec4 gl_FragCoord;

out vec4 out_FragColor0;

void main() {
	vec2 texcoord = screenPosToTexcoord( gl_FragCoord.xy, _fa_[0 ] );
	vec2 translate = _fa_[0 ].zw;
	vec4 luminance = tex2D( samp_adaptiveluminance, clamp( texcoord, _fa_[1 ].xy, _fa_[1 ].zw ) );
	vec3 glare = tex2D( samp_glaremap, clamp( texcoord, _fa_[1 ].xy, _fa_[1 ].zw ) ).xyz;
	vec3 total = tex2D( samp_viewcolormap, clamp( texcoord, _fa_[1 ].xy, _fa_[1 ].zw ) ).xyz;
	vec3 frame = tex2D( samp_frameexposuremap, clamp( texcoord, _fa_[1 ].xy, _fa_[1 ].zw ) ).xyz;
	total = total * 0.5;
	float minThreshold = _fa_[2 ].x;
	float maxThreshold = _fa_[2 ].y;
	float avgSceneBrightness = _fa_[2 ].z;
	float threshold = mix( minThreshold, maxThreshold, luminance.x );
	total *= ( avgSceneBrightness / threshold );
	vec3 finalColor = saturate( total - vec3( threshold ) - vec3( _fa_[3 ].x ) );
	out_FragColor0.xyz = finalColor.xyz * _fa_[4 ].xyz + glare * 4.0 + frame * 1.0;
	out_FragColor0.w = 1.0;
}
