#version 150

#include "global.inc"

uniform vec4 _fa_ [2];
uniform sampler2D samp_radiositypreviewmap;
uniform sampler2D samp_viewcolormap;

in vec4 vofi_TexCoord1;
in vec4 gl_FragCoord;
in vec4 vofi_TexCoord0;

out vec4 out_FragColor0;
out vec4 out_FragColor1;
out vec4 out_FragColor2;

void main() {
	vec2 tc;
	tc.x = vofi_TexCoord1.x / vofi_TexCoord1.w;
	tc.y = vofi_TexCoord1.y / vofi_TexCoord1.w;
	tc = ( tc + 1.0 ) * 0.5;
	vec4 color = tex2D( samp_radiositypreviewmap, tc );
	vec4 window;
	window.xy = screenPosToTexcoord( gl_FragCoord.xy, _fa_[0 ] );
	window.z = 0.0;
	window.w = 0.0;
	float shadow = tex2Dlod( samp_viewcolormap, window ).w;
	shadow = saturate( shadow + 0.5 );
	color.xyz *= shadow;
	float fog = saturate( exp2( vofi_TexCoord0.z ) );
	out_FragColor0 = mix( _fa_[1 ], color, fog );
	out_FragColor1 = vec4( 0.0 );
	{
		out_FragColor2.xyz = vec3( 0.0 ).xyz * vec3( 0.5 ) + vec3( 0.5 );
		out_FragColor2.w = dot( vec4( 0.0 ).rgb, vec3( 1.0 / 3.0 ) );
	};
}
