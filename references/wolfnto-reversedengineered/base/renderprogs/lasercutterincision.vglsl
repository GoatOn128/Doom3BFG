#version 150

#include "global.inc"

uniform vec4 _va_ [11];

in vec4 in_Position;
in vec2 in_TexCoord;
in vec4 in_Color;

out vec4 vofi_TexCoord1;
out vec4 vofi_TexCoord2;
out vec4 vofi_TexCoord0;
out vec4 vofi_Color;

void main() {
	gl_Position.x = dot4( in_Position, _va_[0 ] );
	gl_Position.y = dot4( in_Position, _va_[1 ] );
	gl_Position.z = dot4( in_Position, _va_[2 ] );
	gl_Position.w = dot4( in_Position, _va_[3 ] );
	vofi_TexCoord0.x = dot4( in_TexCoord, _va_[4 ] );
	vofi_TexCoord0.y = dot4( in_TexCoord, _va_[5 ] );
	vofi_TexCoord0.z = in_TexCoord.x;
	vofi_TexCoord0.w = in_TexCoord.y;
	vofi_TexCoord1.x = dot4( in_TexCoord, _va_[6 ] );
	vofi_TexCoord1.y = dot4( in_TexCoord, _va_[7 ] );
	vofi_TexCoord1.z = 0.0;
	vofi_TexCoord1.w = 0.0;
	vofi_TexCoord2.xyz = in_Position.xyz * _va_[8 ].xyz;
	vofi_TexCoord2.w = 0.0;
	vofi_Color = swizzleColor( in_Color ) * _va_[9 ];
	vofi_Color.xyz *= _va_[10 ].xyz;
}
