#version 150

#include "global.inc"

uniform vec4 _fa_ [6];
uniform sampler2D samp_viewdepthmap;

in vec4 gl_FragCoord;

out vec4 out_FragColor0;

void main() {
	vec2 texcoord = screenPosToTexcoord( gl_FragCoord.xy, _fa_[0 ] );
	float ndcZ = tex2Ddepth_fast( samp_viewdepthmap, texcoord.xy ) * 2.0 - 1.0;
	float viewZ = ndcZ * _fa_[1 ].w / ( ndcZ + _fa_[1 ].z );
	float fogDepth = clamp( viewZ - _fa_[2 ].x, 0.0, _fa_[3 ].x ) * _fa_[4 ].x;
	float fog = saturate( exp2( -fogDepth ) );
	out_FragColor0.xyz = _fa_[5 ].xyz;
	out_FragColor0.w = fog;
}
