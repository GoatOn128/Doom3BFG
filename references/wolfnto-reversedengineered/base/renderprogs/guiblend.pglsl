#version 150

#include "global.inc"

uniform vec4 _fa_ [1];
uniform sampler2D samp_transmap;

in vec4 vofi_TexCoord0;
in vec4 vofi_Color;
in vec4 vofi_TexCoord1;

out vec4 out_FragColor0;

void main() {
	vec4 c = tex2D( samp_transmap, vofi_TexCoord0.xy ) * vofi_Color + vofi_TexCoord1;
	out_FragColor0.xyz = pow3( saturate( c.xyz ), _fa_[0 ].x ) * c.w;
	out_FragColor0.w = c.w;
}
