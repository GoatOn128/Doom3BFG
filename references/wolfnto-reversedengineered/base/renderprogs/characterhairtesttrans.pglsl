#version 150

#include "global.inc"

uniform vec4 _fa_ [20];
uniform sampler2D samp_sparediffusemap;
uniform sampler2D samp_sparebumpmap;
uniform sampler2D samp_sparespecularmap;

in vec4 vofi_TexCoord0;
in vec4 vofi_TexCoord1;
in vec4 vofi_TexCoord2;
in vec4 vofi_TexCoord3;
in vec4 vofi_TexCoord5;
in vec4 vofi_TexCoord4;

out vec4 out_FragColor0;

void main() {
	vec4 surfaceDiffuse = tex2D( samp_sparediffusemap, vofi_TexCoord0.xy );
	vec4 surfaceBump = tex2D( samp_sparebumpmap, vofi_TexCoord0.xy );
	vec4 surfaceSpecular = tex2D( samp_sparespecularmap, vofi_TexCoord0.xy );
	clip( min( -( surfaceDiffuse.w - 0.8 ), surfaceDiffuse.w - 0.001 ) );
	surfaceDiffuse.xyz *= _fa_[0 ].xyz * vec3( 2.0 );
	vec3 localNormal = surfaceBump.xyz - 0.5;
	localNormal.z = sqrt( abs( dot( localNormal.xy, localNormal.xy ) - 0.25 ) );
	vec3 globalNormal;
	globalNormal.x = dot3( localNormal, vofi_TexCoord1.xyz );
	globalNormal.y = dot3( localNormal, vofi_TexCoord2.xyz );
	globalNormal.z = dot3( localNormal, vofi_TexCoord3.xyz );
	globalNormal = normalize( globalNormal );
	vec3 headNormal = normalize( vofi_TexCoord5.xyz );
	vec3 hairNormal = normalize( mix( globalNormal, headNormal, 0.5 ) );
	vec3 localAnisoDir = normalize( _fa_[1 ].xyz );
	vec3 anisoDir;
	anisoDir.x = dot3( localAnisoDir, vofi_TexCoord1.xyz );
	anisoDir.y = dot3( localAnisoDir, vofi_TexCoord2.xyz );
	anisoDir.z = dot3( localAnisoDir, vofi_TexCoord3.xyz );
	vec3 anisoBiDir = cross( anisoDir, hairNormal );
	vec3 fromViewer = normalize( vofi_TexCoord4.xyz );
	vec3 channelLight =
	+ max( hairNormal.x * _fa_[2 ].xyz, 0 )
	+ max( -hairNormal.x * _fa_[3 ].xyz, 0 )
	+ max( hairNormal.y * _fa_[4 ].xyz, 0 )
	+ max( -hairNormal.y * _fa_[5 ].xyz, 0 )
	+ max( hairNormal.z * _fa_[6 ].xyz, 0 )
	+ max( -hairNormal.z * _fa_[7 ].xyz, 0 );
	vec4 color; if ( _fa_[8 ].x > 0 ) {
		vec3 worldPosition = vofi_TexCoord4.xyz + _fa_[9 ].xyz;
		vec3 lightDir0 = normalize( _fa_[10 ].xyz - worldPosition );
		vec3 lightDir1 = normalize( _fa_[11 ].xyz - worldPosition );
		vec3 lightDir2 = normalize( _fa_[12 ].xyz - worldPosition );
		vec3 h0 = normalize( lightDir0.xyz - fromViewer );
		vec3 h1 = normalize( lightDir1.xyz - fromViewer );
		vec3 h2 = normalize( lightDir2.xyz - fromViewer );
		float betaA0 = pow( ( dot( anisoDir, h0 ) / ( _fa_[13 ].x * surfaceSpecular.x ) ), 2.0 );
		float betaA1 = pow( ( dot( anisoDir, h1 ) / ( _fa_[13 ].x * surfaceSpecular.x ) ), 2.0 );
		float betaA2 = pow( ( dot( anisoDir, h2 ) / ( _fa_[13 ].x * surfaceSpecular.x ) ), 2.0 );
		float betaB0 = pow( ( dot( anisoBiDir, h0 ) / ( _fa_[13 ].y * surfaceSpecular.x ) ), 2.0 );
		float betaB1 = pow( ( dot( anisoBiDir, h1 ) / ( _fa_[13 ].y * surfaceSpecular.x ) ), 2.0 );
		float betaB2 = pow( ( dot( anisoBiDir, h2 ) / ( _fa_[13 ].y * surfaceSpecular.x ) ), 2.0 );
		float beta0 = ( betaA0 + betaB0 ) / ( dot( hairNormal, h0 ) + 1.0 );
		float beta1 = ( betaA1 + betaB1 ) / ( dot( hairNormal, h1 ) + 1.0 );
		float beta2 = ( betaA2 + betaB2 ) / ( dot( hairNormal, h2 ) + 1.0 );
		vec3 specular0 = _fa_[14 ].x * exp( -16 * beta0 ) * _fa_[15 ].xyz;
		vec3 specular1 = _fa_[14 ].x * exp( -16 * beta1 ) * _fa_[16 ].xyz;
		vec3 specular2 = _fa_[14 ].x * exp( -16 * beta2 ) * _fa_[17 ].xyz;
		float lightFactor0 = saturate( dot3( lightDir0, hairNormal ) );
		float lightFactor1 = saturate( dot3( lightDir1, hairNormal ) );
		float lightFactor2 = saturate( dot3( lightDir2, hairNormal ) );
		vec3 light0 = _fa_[15 ].xyz * ( _fa_[14 ].y * lightFactor0 * lightFactor0 );
		vec3 light1 = _fa_[16 ].xyz * ( _fa_[14 ].y * lightFactor1 * lightFactor1 );
		vec3 light2 = _fa_[17 ].xyz * ( _fa_[14 ].y * lightFactor2 * lightFactor2 );
		color.xyz = sqrt( channelLight + light0 + light1 + light2 ) * surfaceDiffuse.xyz + sqrt( specular0 + specular1 + specular2 ) * surfaceSpecular.xyz;
		color.w = surfaceDiffuse.w;
	} else {
		vec3 h = normalize( -fromViewer + _fa_[18 ].xyz );
		float betaA = pow( ( dot( anisoDir, h ) / ( _fa_[13 ].x * surfaceSpecular.x ) ), 2.0 );
		float betaB = pow( ( dot( anisoBiDir, h ) / ( _fa_[13 ].y * surfaceSpecular.x ) ), 2.0 );
		float beta = ( betaA + betaB ) / ( dot( hairNormal, h ) + 1.0 );
		vec3 specular = _fa_[14 ].x * exp( -16 * beta ) * _fa_[19 ].xyz;
		float primeLightFactor = saturate( dot3( _fa_[18 ], hairNormal ) );
		vec3 primeLight = _fa_[19 ].xyz * ( _fa_[14 ].y * primeLightFactor * primeLightFactor );
		float fresnel = 1.0 - abs( dot( hairNormal, fromViewer ) );
		float backLightFactor = saturate( dot3( _fa_[18 ], fromViewer ) );
		vec3 backLight = _fa_[19 ].xyz * pow( backLightFactor, 5.0 ) * fresnel * fresnel;
		vec3 light = primeLight + channelLight + backLight;
		color.xyz = sqrt( light ) * surfaceDiffuse.xyz + sqrt( specular ) * surfaceSpecular.xyz;
		color.w = surfaceDiffuse.w;
	}
	out_FragColor0 = color;
}
