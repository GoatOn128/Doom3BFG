#version 150

#include "global.inc"

uniform vec4 _fa_ [2];
uniform sampler2DMS samp_texturemapmultisample;

in vec4 vofi_TexCoord0;

out vec4 out_FragColor0;

void main() {
	vec2 texcoord = vofi_TexCoord0.xy * vec2( 1.0 / _fa_[0 ].z, 1.0 / _fa_[0 ].w );
	ivec2 texcoordi = ivec2( texcoord.x, texcoord.y );
	out_FragColor0.xyz = tex2DMSFetch( samp_texturemapmultisample, texcoordi.xy, 0 ).xyz;
	out_FragColor0.w = _fa_[1 ].x;
}
