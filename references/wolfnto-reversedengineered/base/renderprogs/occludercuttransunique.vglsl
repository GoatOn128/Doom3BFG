#version 150

#include "global.inc"

uniform vec4 _va_ [7];

in vec2 in_TexCoord;
in vec4 in_Position;

out vec4 vofi_TexCoord0;

void main() {
	{
		vofi_TexCoord0 = ( in_TexCoord.xy * _va_[0 ].xy + _va_[0 ].zw ).xyxy;
	};
	{
		vec4 localPosition = in_Position * _va_[1 ] + _va_[2 ];
		gl_Position.x = dot4( localPosition, _va_[3 ] );
		gl_Position.y = dot4( localPosition, _va_[4 ] );
		gl_Position.z = dot4( localPosition, _va_[5 ] );
		gl_Position.w = dot4( localPosition, _va_[6 ] );
	};
}
