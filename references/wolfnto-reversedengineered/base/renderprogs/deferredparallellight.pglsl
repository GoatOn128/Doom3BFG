#version 150

#include "global.inc"

uniform vec4 _fa_ [24];
uniform sampler2DMS samp_viewdepthstencilmap;
uniform sampler2DShadow samp_lightdepthcomparemap;
uniform sampler2DMS samp_viewdiffusemap;
uniform sampler2DMS samp_viewnormalmapms;
uniform sampler2D samp_lightprojectmap;
uniform sampler2D samp_lightfalloffmap;
uniform samplerCube samp_dynamicenvmap;

in vec4 gl_FragCoord;

out vec4 out_FragColor0;

void main() {
	vec2 viewTexCoord = screenPosToTexcoord( gl_FragCoord.xy, _fa_[0 ] );
	vec4 windowPosition;
	windowPosition.z = tex2DMSFetch( samp_viewdepthstencilmap, ivec2( gl_FragCoord.xy ), 0 ).x;
	windowPosition.w = 1.0;
	windowPosition.xy = screenPosToTexcoord( gl_FragCoord.xy, _fa_[1 ] );
	vec4 shadowTexCoord;
	shadowTexCoord.x = dot4( windowPosition, _fa_[2 ] );
	shadowTexCoord.y = dot4( windowPosition, _fa_[3 ] );
	shadowTexCoord.z = dot4( windowPosition, _fa_[4 ] );
	shadowTexCoord.w = dot4( windowPosition, _fa_[5 ] );
	float ndcZ = windowPosition.z * 2.0 - 1.0;
	float viewZ = ndcZ * _fa_[6 ].w / ( ndcZ + _fa_[6 ].z );
	float shadow;
	{
		vec3 texCoord = shadowTexCoord.xyz / shadowTexCoord.w;
		float sliceLOD = log2( max( 1.0, viewZ * _fa_[7 ].x ) ) * _fa_[7 ].z;
		float sliceLODi = floor( sliceLOD );
		vec2 slice = min( vec2( 3.0, 3.0 ), vec2( sliceLODi, sliceLODi ) + vec2( 0.0, 1.0 ) );
		vec2 stScale = exp2( - slice * _fa_[7 ].y );
		vec4 stBias;
		stBias.xy = 0.25 + fract( slice * 0.5 );
		stBias.zw = 0.25 + floor( slice * 0.5 ) * 0.5;
		vec4 sliceTexCoords = texCoord.xxyy * stScale.xyxy + stBias;
		vec3 slice1TexCoord = vec3( sliceTexCoords.x, sliceTexCoords.z, texCoord.z );
		vec3 slice2TexCoord = vec3( sliceTexCoords.y, sliceTexCoords.w, texCoord.z );
		float fraction = saturate( ( slice.y - sliceLOD ) * _fa_[7 ].w );
		float shadow1;
		{
			float s = _fa_[8 ].y * 2.0;
			vec4 shadow4;
			{
				shadow4.x = shadow2Ddepth( samp_lightdepthcomparemap, slice1TexCoord.xyz + s * vec3( -0.375, -0.125, 0 ) );
			};
			{
				shadow4.y = shadow2Ddepth( samp_lightdepthcomparemap, slice1TexCoord.xyz + s * vec3( -0.125, 0.375, 0 ) );
			};
			{
				shadow4.z = shadow2Ddepth( samp_lightdepthcomparemap, slice1TexCoord.xyz + s * vec3( 0.125, -0.375, 0 ) );
			};
			{
				shadow4.w = shadow2Ddepth( samp_lightdepthcomparemap, slice1TexCoord.xyz + s * vec3( 0.375, 0.125, 0 ) );
			};
			shadow1 = dot( shadow4, vec4( 0.25 ) );
		};
		float shadow2;
		{
			float s = _fa_[8 ].y * 2.0;
			vec4 shadow4;
			{
				shadow4.x = shadow2Ddepth( samp_lightdepthcomparemap, slice2TexCoord.xyz + s * vec3( -0.375, -0.125, 0 ) );
			};
			{
				shadow4.y = shadow2Ddepth( samp_lightdepthcomparemap, slice2TexCoord.xyz + s * vec3( -0.125, 0.375, 0 ) );
			};
			{
				shadow4.z = shadow2Ddepth( samp_lightdepthcomparemap, slice2TexCoord.xyz + s * vec3( 0.125, -0.375, 0 ) );
			};
			{
				shadow4.w = shadow2Ddepth( samp_lightdepthcomparemap, slice2TexCoord.xyz + s * vec3( 0.375, 0.125, 0 ) );
			};
			shadow2 = dot( shadow4, vec4( 0.25 ) );
		};
		shadow = mix( shadow2, shadow1, fraction );
	};
	vec3 color;
	{
		vec4 viewDiffuse = tex2DMSFetch( samp_viewdiffusemap, ivec2( gl_FragCoord.xy ), 0 );
		vec4 viewNormal = tex2DMSFetch( samp_viewnormalmapms, ivec2( gl_FragCoord.xy ), 0 ) * 2.0 - 1.0;
		float viewSpecular = viewDiffuse.w;
		float viewPower = viewNormal.w;
		vec4 globalPosition;
		globalPosition.x = dot4( windowPosition, _fa_[9 ] );
		globalPosition.y = dot4( windowPosition, _fa_[10 ] );
		globalPosition.z = dot4( windowPosition, _fa_[11 ] );
		globalPosition.w = dot4( windowPosition, _fa_[12 ] );
		globalPosition.xyz /= globalPosition.w;
		vec3 light;
		{
			vec4 lightTexCoord;
			lightTexCoord.x = dot4( windowPosition, _fa_[13 ] );
			lightTexCoord.y = dot4( windowPosition, _fa_[14 ] );
			lightTexCoord.z = dot4( windowPosition, _fa_[15 ] );
			lightTexCoord.w = dot4( windowPosition, _fa_[16 ] );
			lightTexCoord.xyz /= lightTexCoord.w;
			vec4 lpm = h4tex2D( samp_lightprojectmap, lightTexCoord.xy );
			vec4 lfm = h4tex2D( samp_lightfalloffmap, vec2( lightTexCoord.z, 0.5 ) );
			vec3 toLight = normalize( _fa_[17 ].xyz - globalPosition.xyz );
			light = _fa_[18 ].xyz * lpm.xyz * lfm.xyz;
			light *= vec3( dot3( toLight, viewNormal.xyz ) );
			light *= shadow;
		}
		vec3 diffuse;
		{
			diffuse = viewDiffuse.xyz * _fa_[19 ].xyz * 2.0;
		}
		vec3 specular;
		{
			vec3 toViewer = normalize( _fa_[20 ].xyz - globalPosition.xyz );
			vec4 reflection;
			reflection.xyz = ( 2.0 * viewNormal.xyz * dot3( viewNormal.xyz, toViewer ) ) - toViewer;
			reflection.w = floor( ( 1.0 - viewPower ) * 4.0 + _fa_[21 ].x );
			vec3 envColor = texCUBElod( samp_dynamicenvmap, reflection ).xyz;
			specular = envColor * viewSpecular * _fa_[22 ].xyz * _fa_[23 ].xyz;
		}
		color.xyz = light * ( diffuse + specular );
	};
	out_FragColor0.xyz = color;
	out_FragColor0.w = 1.0;
}
