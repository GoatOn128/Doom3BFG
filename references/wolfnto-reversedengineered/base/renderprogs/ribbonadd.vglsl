#version 150

#include "global.inc"

uniform vec4 _va_ [10];

in vec4 in_Position;
in vec2 in_TexCoord;
in vec4 in_Color;

out vec4 vofi_TexCoord0;
out vec4 vofi_Color;

void main() {
	gl_Position.x = dot4( in_Position, _va_[0 ] );
	gl_Position.y = dot4( in_Position, _va_[1 ] );
	gl_Position.z = dot4( in_Position, _va_[2 ] );
	gl_Position.w = dot4( in_Position, _va_[3 ] );
	vofi_TexCoord0.xy = in_TexCoord.xy;
	vofi_TexCoord0.z = 0.0;
	vofi_TexCoord0.w = -( clamp( gl_Position.w - _va_[4 ].x, 0.0, _va_[5 ].x ) * _va_[6 ].x );
	float fade = saturate( abs( gl_Position.w ) * _va_[7 ].x );
	vofi_Color = swizzleColor( in_Color ) * _va_[8 ] * fade * _va_[9 ];
}
