#version 150

#include "global.inc"

uniform vec4 _fa_ [2];
uniform sampler2D samp_texturemap;

in vec4 vofi_TexCoord0;

out vec4 out_FragColor0;

void main() {
	vec4 tc;
	tc.xyz = vofi_TexCoord0.xyz;
	tc.w = _fa_[0 ].x;
	if ( _fa_[0 ].y == 1.0 ) {
		vec4 YCoCg = tex2Dlod( samp_texturemap, tc );
		YCoCg.z = ( YCoCg.z * 31.875 ) + 1.0;
		YCoCg.z = 1.0 / YCoCg.z;
		YCoCg.xy *= YCoCg.z;
		out_FragColor0.x = dot4( YCoCg, matrixCoCg1YtoRGB1X );
		out_FragColor0.y = dot4( YCoCg, matrixCoCg1YtoRGB1Y );
		out_FragColor0.z = dot4( YCoCg, matrixCoCg1YtoRGB1Z );
	} else if ( _fa_[0 ].y == 2.0 ) {
		out_FragColor0.rgb = vec3( tex2Dlod( samp_texturemap, tc ).a );
	} else {
		out_FragColor0 = tex2Dlod( samp_texturemap, tc );
	}
	out_FragColor0.w = _fa_[1 ].x;
}
