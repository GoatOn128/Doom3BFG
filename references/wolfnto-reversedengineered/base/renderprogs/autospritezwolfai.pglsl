#version 150

#include "global.inc"

uniform vec4 _fa_ [9];
uniform sampler2D samp_transmap;

in vec4 vofi_TexCoord0;

out vec4 out_FragColor0;
out vec4 out_FragColor1;
out vec4 out_FragColor2;

void main() {
	vec2 atlasScale = vec2( 0.2, 0.090909 );
	float stopTime = saturate( 1.0 - _fa_[0 ].x );
	vec2 texcoord = vofi_TexCoord0.xy;
	{
		vec3 modelFwd = vec3( _fa_[1 ].x, _fa_[2 ].x, _fa_[3 ].x );
		vec3 modelLft = vec3( _fa_[1 ].y, _fa_[2 ].y, _fa_[3 ].y );
		vec3 modelPos = vec3( _fa_[1 ].w, _fa_[2 ].w, _fa_[4 ].w );
		vec3 toModel = modelPos - _fa_[5 ].xyz;
		toModel = normalize( vec3( toModel.x, toModel.y, 0.0 ) );
		texcoord.x = texcoord.x + mod( floor( _fa_[6 ].x * stopTime * _fa_[7 ].x ), 4.0 ) + ( stopTime * _fa_[7 ].x );
		float dotFwd = dot( modelFwd, toModel );
		float dotLft = dot( modelLft, toModel );
		float sideF = abs( min( floor( dotFwd ), 0.0 ) );
		float sideB = max( ceil( dotFwd ), 0.0 );
		float sideL = abs( min( floor( dotLft ), 0.0 ) );
		float sideR = max( ceil( dotLft ), 0.0 );
		float faceF = abs( min( floor( dotFwd + 0.875 ), 0.0 ) );
		float faceB = max( ceil( dotFwd - 0.875 ), 0.0 );
		float faceL = abs( min( floor( dotLft + 0.875 ), 0.0 ) );
		float faceR = max( ceil( dotLft - 0.875 ), 0.0 );
		float faceFL = mix( sideF * sideL, 0.0, saturate( faceF + faceL ) );
		float faceBL = mix( sideB * sideL, 0.0, saturate( faceB + faceL ) );
		float faceFR = mix( sideF * sideR, 0.0, saturate( faceF + faceR ) );
		float faceBR = mix( sideB * sideR, 0.0, saturate( faceB + faceR ) );
		texcoord.y += faceF * 0.0 * _fa_[7 ].x;
		texcoord.y += faceFL * 1.0 * _fa_[7 ].x;
		texcoord.y += faceL * 2.0 * _fa_[7 ].x;
		texcoord.y += faceBL * 3.0 * _fa_[7 ].x;
		texcoord.y += faceB * 4.0 * _fa_[7 ].x;
		texcoord.y += faceBR * 5.0 * _fa_[7 ].x;
		texcoord.y += faceR * 6.0 * _fa_[7 ].x;
		texcoord.y += faceFR * 7.0 * _fa_[7 ].x;
	}
	{
		texcoord.x += min( floor( _fa_[6 ].x ), _fa_[8 ].x ) * _fa_[8 ].w;
		texcoord.y += ( _fa_[8 ].y * _fa_[8 ].w );
	}
	texcoord *= atlasScale;
	vec4 tex_color = tex2D( samp_transmap, texcoord );
	clip( tex_color.w - 0.5 );
	out_FragColor0 = tex_color;
	out_FragColor1 = vec4( 0.0 );
	{
		out_FragColor2.xyz = vec3( 0.0, 0.0, 1.0 ).xyz * vec3( 0.5 ) + vec3( 0.5 );
		out_FragColor2.w = dot( vec4( 0.0 ).rgb, vec3( 1.0 / 3.0 ) );
	};
}
