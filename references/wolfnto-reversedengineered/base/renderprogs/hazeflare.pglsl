#version 150

#include "global.inc"

uniform vec4 _fa_ [7];
uniform sampler2D samp_hazeflaremap;

in vec4 gl_FragCoord;

out vec4 out_FragColor0;

void main() {
	vec2 texcoord = screenPosToTexcoord( gl_FragCoord.xy, _fa_[0 ] );
	vec3 color = tex2D( samp_hazeflaremap, texcoord ).xyz;
	color *= exp( 0.31 * _fa_[1 ].x );
	texcoord.x = _fa_[2 ].z - clamp( texcoord.x, _fa_[2 ].x, _fa_[2 ].z );
	vec3 mirror = tex2D( samp_hazeflaremap, texcoord ).xyz;
	mirror *= exp( 0.31 * _fa_[3 ].x );
	color += mirror * _fa_[4 ].x;
	color *= _fa_[5 ].xyz;
	color *= _fa_[6 ].x;
	out_FragColor0.xyz = color;
	out_FragColor0.w = 1.0;
}
