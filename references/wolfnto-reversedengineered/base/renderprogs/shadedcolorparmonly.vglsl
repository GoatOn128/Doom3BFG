#version 150

#include "global.inc"

uniform vec4 _va_ [4];

in vec4 in_Position;
in vec4 in_Normal;

out vec4 vofi_Color;

void main() {
	gl_Position.x = dot4( in_Position, _va_[0 ] );
	gl_Position.y = dot4( in_Position, _va_[1 ] );
	gl_Position.z = dot4( in_Position, _va_[2 ] );
	gl_Position.w = dot4( in_Position, _va_[3 ] );
	vec3 normal = in_Normal.xyz * 2.0 - vec3( 1.0 );
	float r0 = dot3( normal, vec3( 0.42, 0.57, 0.71 ) );
	vofi_Color.xyz = vec3( r0 * 0.4 + 0.5 );
	vofi_Color.w = 1.0;
}
