#version 150

#include "global.inc"

uniform vec4 _fa_ [9];
uniform sampler2D samp_sparebumpmap;
uniform sampler2D samp_sparespecularmap;
uniform sampler2D samp_texturemap;

in vec4 vofi_TexCoord4;
in vec4 vofi_TexCoord0;
in vec4 vofi_TexCoord1;
in vec4 vofi_TexCoord2;
in vec4 vofi_TexCoord3;

out vec4 out_FragColor0;

void main() {
	float specularPower1 = 25.0;
	float specularPower2 = 60.0;
	float specularPower3 = 100.0;
	float fog = saturate( exp2( vofi_TexCoord4.w ) );
	vec2 texcoord = vofi_TexCoord0.xy;
	vec2 texcoordAnim = vofi_TexCoord0.zw;
	vec4 bumpMap = tex2D( samp_sparebumpmap, texcoord );
	vec4 specularMap = tex2D( samp_sparespecularmap, texcoord );
	vec3 localNormal = bumpMap.wyz - 0.5;
	localNormal.z = sqrt( abs( dot( localNormal.xy, localNormal.xy ) - 0.25 ) );
	vec4 fakeEnvMap = tex2D( samp_texturemap, texcoordAnim + ( localNormal.xy * 0.075 ) );
	vec3 globalNormal;
	globalNormal.x = dot3( localNormal, vofi_TexCoord1.xyz );
	globalNormal.y = dot3( localNormal, vofi_TexCoord2.xyz );
	globalNormal.z = dot3( localNormal, vofi_TexCoord3.xyz );
	globalNormal = normalize( globalNormal );
	vec3 fromViewer = normalize( vofi_TexCoord4.xyz );
	vec3 toViewer = -fromViewer;
	vec3 reflection = fromViewer - ( globalNormal * dot3( fromViewer, globalNormal ) * 2.0 );
	float primeShadow = saturate( ( abs( dot3( globalNormal, fromViewer ) ) - 0.2 ) * 1.5 );
	float cosd1 = saturate( dot3( globalNormal, reflection ) );
	vec3 halfVec2_1 = normalize( toViewer + _fa_[0 ].xyz );
	vec3 halfVec2_2 = normalize( toViewer - _fa_[0 ].xyz );
	float cosd2 = max( dot3( halfVec2_1, globalNormal ), dot3( halfVec2_2, globalNormal ) );
	cosd2 = saturate( ( cosd2 - 0.2 ) * 1.25 );
	vec3 halfVec3 = normalize( toViewer + _fa_[1 ].xyz );
	float cosd3 = saturate( ( dot3( globalNormal, halfVec3 ) - 0.2 ) * 1.25 );
	float cosd = 0.0;
	cosd += pow( cosd1, specularPower1 ) * 4.0;
	cosd += pow( cosd2, specularPower2 );
	cosd += pow( cosd3, specularPower3 );
	vec3 primeLight = _fa_[2 ].xyz;
	vec3 lightColor = vec3( 0.0 )
	+ abs( globalNormal.x * _fa_[3 ].xyz )
	+ abs( -globalNormal.x * _fa_[4 ].xyz )
	+ abs( globalNormal.y * _fa_[5 ].xyz )
	+ abs( -globalNormal.y * _fa_[6 ].xyz )
	+ abs( globalNormal.z * _fa_[7 ].xyz )
	+ abs( -globalNormal.z * _fa_[8 ].xyz );
	lightColor *= 0.5;
	vec3 light = ( primeLight + lightColor ) * specularMap.xyz * cosd;
	out_FragColor0.xyz = saturate( light );
	out_FragColor0.xyz += fakeEnvMap.xyz * ( primeLight + lightColor ) * specularMap.w;
	out_FragColor0.xyz *= vec3( fog );
	out_FragColor0.w = 1.0;
}
