#version 150

#include "global.inc"

uniform vec4 _fa_ [2];
uniform sampler2D samp_transmap;
uniform sampler2D samp_transmap1;

in vec4 vofi_TexCoord0;
in vec4 vofi_TexCoord1;

out vec4 out_FragColor0;

void main() {
	vec4 tex_color = tex2D( samp_transmap, vofi_TexCoord0.xy );
	vec4 tex_mask = tex2D( samp_transmap1, vofi_TexCoord1.xy );
	out_FragColor0 = tex_color * tex_mask * _fa_[0 ] * vec4( _fa_[1 ].w );
}
