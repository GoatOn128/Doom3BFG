#version 150

#include "global.inc"

uniform vec4 _fa_ [1];
uniform sampler2D samp_usercolorcorrection;

in vec4 vofi_TexCoord0;
in vec4 vofi_Color;

out vec4 out_FragColor0;

void main() {
	vec3 inColor = tex2D( samp_usercolorcorrection, vofi_TexCoord0.xy ).xyz;
	vec3 resColor = pow3( inColor, _fa_[0 ].x );
	out_FragColor0.xyz = resColor;
	out_FragColor0.w = vofi_Color.w;
}
