		vofi_TexCoord8.w = min( vofi_TexCoord8.w, distToEllipsoid );
		vofi_TexCoord8.z = min( min( wound3I, wound3J ), vofi_TexCoord8.w );
	};
	vofi_TexCoord9 = vofi_TexCoord0 * vec4( _va_[41 ].xy, 1.0, 1.0 );
