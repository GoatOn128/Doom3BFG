		vofi_TexCoord4.w = 0.0;
	};
	{
		vofi_TexCoord0 = ( in_TexCoord.xy * _va_[11 ].xy + _va_[11 ].zw ).xyxy;
	};
	vofi_TexCoord1.x = dot4( localPosition, _va_[12 ] );
	vofi_TexCoord1.y = dot4( localPosition, _va_[13 ] );
	vofi_TexCoord1.z = dot4( localPosition, _va_[14 ] );
	vofi_TexCoord1.w = dot4( localPosition, _va_[15 ] );
	vofi_TexCoord2.x = dot4( localPosition, _va_[16 ] );
	vofi_TexCoord2.y = dot4( localPosition, _va_[17 ] );
	vofi_TexCoord2.z = dot4( localPosition, _va_[18 ] );
	vofi_TexCoord2.w = dot4( localPosition, _va_[19 ] );
	vofi_TexCoord3.x = dot4( localPosition, _va_[20 ] );
	vofi_TexCoord3.y = dot4( localPosition, _va_[21 ] );
	vofi_TexCoord3.z = dot4( localPosition, _va_[22 ] );
	vofi_TexCoord3.w = dot4( localPosition, _va_[23 ] );
	vofi_TexCoord4.x = dot4( localPosition, _va_[24 ] );
	vofi_TexCoord4.y = dot4( localPosition, _va_[25 ] );
	vofi_TexCoord4.z = dot4( localPosition, _va_[26 ] );
	vofi_TexCoord4.w = dot4( localPosition, _va_[27 ] );
	localPosition.xyz -= 0.01 * normal.xyz;
	vofi_TexCoord5.x = dot4( localPosition, _va_[12 ] );
	vofi_TexCoord5.y = dot4( localPosition, _va_[13 ] );
	vofi_TexCoord5.z = dot4( localPosition, _va_[14 ] );
	vofi_TexCoord5.w = dot4( localPosition, _va_[15 ] );
	vofi_TexCoord6.x = dot4( localPosition, _va_[16 ] );
	vofi_TexCoord6.y = dot4( localPosition, _va_[17 ] );
	vofi_TexCoord6.z = dot4( localPosition, _va_[18 ] );
