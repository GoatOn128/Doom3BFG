		float wound3A = ( length( ( _va_[28 ].xyz - vertexPos.xyz ) * _va_[28 ].w ) - 1.0 );
		float wound3B = ( length( ( _va_[29 ].xyz - vertexPos.xyz ) * _va_[29 ].w ) - 1.0 );
		float wound3C = ( length( ( _va_[30 ].xyz - vertexPos.xyz ) * _va_[30 ].w ) - 1.0 );
