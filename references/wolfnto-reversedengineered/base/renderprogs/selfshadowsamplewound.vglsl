		float wound3J = ( length( ( _va_[37 ].xyz - vertexPos.xyz ) * _va_[37 ].w ) - 1.0 );
		vec3 ellipsoid;
		vec3 localPos = vertexPos.xyz - vec3( _va_[38 ].w, _va_[39 ].w, _va_[40 ].w );
		ellipsoid.x = dot( _va_[38 ].xyz, localPos.xyz );
		ellipsoid.y = dot( _va_[39 ].xyz, localPos.xyz );
		ellipsoid.z = dot( _va_[40 ].xyz, localPos.xyz );
		float distToEllipsoid = length( ellipsoid ) - 1.0;
		vofi_TexCoord8.w = min( wound3A, wound3B );
		vofi_TexCoord8.w = min( vofi_TexCoord8.w, wound3C );
		vofi_TexCoord8.w = min( vofi_TexCoord8.w, wound3D );
		vofi_TexCoord8.w = min( vofi_TexCoord8.w, wound3E );
		vofi_TexCoord8.w = min( vofi_TexCoord8.w, wound3F );
		vofi_TexCoord8.w = min( vofi_TexCoord8.w, wound3G );
