#version 150

#include "global.inc"

uniform vec4 _fa_ [1];

in vec4 gl_FragCoord;

out vec4 out_FragColor0;
out vec4 out_FragColor1;
out vec4 out_FragColor2;

void main() {
	vec3 pos;
	pos.z = 1.0 / gl_FragCoord.w;
	pos.xy = pos.z * ( 2.0 * screenPosToTexcoord( gl_FragCoord.xy, _fa_[0 ] ) - 1.0 );
	vec3 normal = -normalize( cross( dFdx( pos ), dFdy( pos ) ) );
	vec3 L = normalize( vec3( 1.0, 1.0, 0.0 ) - pos );
	out_FragColor0.xyz = vec3( dot3( normal, L ) * 0.75 );
	out_FragColor0.w = 1.0;
	out_FragColor1 = vec4( 0.0 );
	{
		out_FragColor2.xyz = vec3( 0.0, 0.0, 1.0 ).xyz * vec3( 0.5 ) + vec3( 0.5 );
		out_FragColor2.w = dot( vec4( 0.0 ).rgb, vec3( 1.0 / 3.0 ) );
	};
}
