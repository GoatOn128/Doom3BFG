			};
			{
				diffuseLight.xyz *= _fa_[25 ].xyz;
			};;;;
			vec3 finalColor = ( specularLight * surfaceSpecular.xyz ) + ( diffuseLight * surfaceDiffuse.xyz ) + ( environment * surfaceSpecular.xyz );
			color.xyz = finalColor;
			float lightFactor = 0.0;
