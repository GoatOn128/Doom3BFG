			+ max( globalNormal.y * _fa_[19 ].xyz, 0 )
			+ max( -globalNormal.y * _fa_[20 ].xyz, 0 )
			+ max( globalNormal.z * _fa_[21 ].xyz, 0 )
			+ max( -globalNormal.z * _fa_[22 ].xyz, 0 );
			diffuseLight += ambientLight;
			vec3 environment;
			{
				environment = texCUBElod( samp_dynamicenvmap, globalReflection ).xyz;;
				environment = pow3( abs( environment ), 2.2 );
			};
