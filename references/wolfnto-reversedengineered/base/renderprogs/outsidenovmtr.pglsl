		{
			float glossPowerMask = saturate( dot( surfaceSpecular.xyz, vec3( 0.299, 0.587, 0.114 ) ) );
			float cosi = max( dot3( globalReflection.xyz, _fa_[27 ].xyz ), 0.0 );
