#version 150

#include "global.inc"

uniform vec4 _va_ [18];

in vec4 in_Position;
in vec2 in_TexCoord;
in vec4 in_Normal;
in vec4 in_Tangent;
in vec4 in_Color;

out vec4 vofi_TexCoord0;
out vec4 vofi_TexCoord1;
out vec4 vofi_TexCoord2;
out vec4 vofi_TexCoord3;
out vec4 vofi_TexCoord4;
out vec4 vofi_TexCoord5;
out vec4 vofi_Color;

void main() {
	vec4 localPosition = in_Position * _va_[0 ] + _va_[1 ];
	gl_Position.x = dot4( localPosition, _va_[2 ] );
	gl_Position.y = dot4( localPosition, _va_[3 ] );
	gl_Position.z = dot4( localPosition, _va_[4 ] );
	gl_Position.w = dot4( localPosition, _va_[5 ] );
	vofi_TexCoord0.x = in_TexCoord.x;
	vofi_TexCoord0.y = in_TexCoord.y;
	vofi_TexCoord0.z = dot4( in_TexCoord, _va_[6 ] );
	vofi_TexCoord0.w = dot4( in_TexCoord, _va_[7 ] );
	vofi_TexCoord1.x = dot4( in_TexCoord, _va_[8 ] );
	vofi_TexCoord1.y = dot4( in_TexCoord, _va_[9 ] );
	vofi_TexCoord1.z = dot4( in_TexCoord, _va_[10 ] );
	vofi_TexCoord1.w = dot4( in_TexCoord, _va_[11 ] );
	vofi_TexCoord2.x = dot4( in_TexCoord, _va_[12 ] );
	vofi_TexCoord2.y = dot4( in_TexCoord, _va_[13 ] );
	vofi_TexCoord2.zw = vec2( 0.0 );
	vec3 normal = in_Normal.xyz * 2.0 - 1.0;
	vec4 tangent = in_Tangent * 2.0 - 1.0;
	normal.xyz = normalize( normal.xyz );
	tangent.xyz = normalize( tangent.xyz - normal.xyz * dot( normal.xyz, tangent.xyz ) );
	vec3 bitangent = cross( normal.xyz, tangent.xyz ) * in_Tangent.w;
	vofi_TexCoord3.x = dot3( tangent, _va_[14 ] );
	vofi_TexCoord3.y = dot3( bitangent, _va_[14 ] );
	vofi_TexCoord3.z = dot3( normal, _va_[14 ] );
	vofi_TexCoord3.w = 0.0;
	vofi_TexCoord4.x = dot3( tangent, _va_[15 ] );
	vofi_TexCoord4.y = dot3( bitangent, _va_[15 ] );
	vofi_TexCoord4.z = dot3( normal, _va_[15 ] );
	vofi_TexCoord4.w = 0.0;
	vofi_TexCoord5.x = dot3( tangent, _va_[16 ] );
	vofi_TexCoord5.y = dot3( bitangent, _va_[16 ] );
	vofi_TexCoord5.z = dot3( normal, _va_[16 ] );
	vofi_TexCoord5.w = 0.0;
	vofi_Color = swizzleColor( in_Color ) * _va_[17 ];
}
