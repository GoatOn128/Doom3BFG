#version 150

#include "global.inc"

uniform vec4 _va_ [4];

in vec4 in_Position;
in vec2 in_TexCoord;
in vec4 in_Color;
in vec4 in_Tangent;

out vec4 vofi_TexCoord0;
out vec4 vofi_Color;
out vec4 vofi_TexCoord1;

void main() {
	gl_Position.x = dot4( in_Position, _va_[0 ] );
	gl_Position.y = dot4( in_Position, _va_[1 ] );
	gl_Position.z = dot4( in_Position, _va_[2 ] );
	gl_Position.w = dot4( in_Position, _va_[3 ] );
	vofi_TexCoord0 = vec4( in_TexCoord.x, in_TexCoord.y, 0, 0 );
	vofi_Color = swizzleColor( in_Color );
	vofi_TexCoord1 = saturate( in_Tangent * vec4( 2.0*255/254 ) - vec4( 255/255 ) );
	vofi_TexCoord0.y = 1.0 - vofi_TexCoord0.y;
}
