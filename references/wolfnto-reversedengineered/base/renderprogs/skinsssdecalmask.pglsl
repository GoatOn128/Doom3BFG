#version 150

#include "global.inc"

uniform vec4 _fa_ [2];
uniform sampler2D samp_dither256map;
uniform sampler2D samp_woundtexture;
uniform sampler2D samp_viewdepthmap;

in vec4 gl_FragCoord;
in vec4 vofi_TexCoord7;
in vec4 vofi_TexCoord6;

out vec4 out_FragColor0;

void main() {
	{ if ( _fa_[0 ].x < 1.0 ) {
			vec2 texcoord = gl_FragCoord.xy * ( 1.0 / 256.0 );
			float dither = _fa_[0 ].y * tex2D( samp_dither256map, texcoord ).x + _fa_[0 ].z;
			clip( _fa_[0 ].x - 0.2 - dither * 0.6 );
		}
	};
	vec4 woundMap3 = tex2D( samp_woundtexture, vofi_TexCoord7.xy );
	{
		float clipValue = vofi_TexCoord6.w + ( woundMap3.w - 0.5 ) * 0.1;
		clip( clipValue );
	};
	vec2 texcoord = screenPosToTexcoord( gl_FragCoord.xy, _fa_[1 ] );
	float interpolatedZOverW = gl_FragCoord.z;
	float srcDepth = interpolatedZOverW;
	float dstDepth = tex2Ddepth( samp_viewdepthmap, texcoord );
	float zReject = dstDepth - srcDepth + 1e-4;
	clip( zReject );
	out_FragColor0.xyz = vec3( 1.0, 0.0, 0.0 );
	out_FragColor0.w = 0.0;
}
