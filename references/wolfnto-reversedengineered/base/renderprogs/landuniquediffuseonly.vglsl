#version 150

#include "global.inc"

uniform vec4 _va_ [10];

in vec4 in_Position;
in vec2 in_TexCoord;

out vec4 vofi_TexCoord0;
out vec4 vofi_TexCoord1;

void main() {
	vec4 position = in_Position * _va_[0 ] + _va_[1 ];
	gl_Position.x = dot( position, _va_[2 ] );
	gl_Position.y = dot( position, _va_[3 ] );
	gl_Position.z = dot( position, _va_[4 ] );
	gl_Position.w = dot( position, _va_[5 ] );
	vofi_TexCoord0 = ( in_TexCoord.xy * _va_[6 ].xy + _va_[6 ].zw ).xyxy;
	vofi_TexCoord1.x = dot3( position, _va_[7 ] );
	vofi_TexCoord1.y = dot3( position, _va_[8 ] );
	vofi_TexCoord1.z = dot3( position, _va_[9 ] );
	vofi_TexCoord1.w = 0.0;
}
