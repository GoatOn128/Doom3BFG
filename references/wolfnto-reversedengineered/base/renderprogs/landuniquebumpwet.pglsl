#version 150

#include "global.inc"

uniform vec4 _fa_ [21];
uniform sampler2D samp_landwetrippletexture;
uniform sampler2D samp_minlodmap;
uniform sampler2D samp_pagetablemap;
uniform sampler2D samp_physicalmappingsmap;
uniform sampler2D samp_physicalpagesmap0;
uniform sampler2D samp_physicalpagesmap1;
uniform sampler2D samp_physicalpagesmap2;
uniform samplerCube samp_dynamicenvmap;

in vec4 vofi_TexCoord1;
in vec4 vofi_TexCoord2;
in vec4 vofi_TexCoord3;
in vec4 vofi_TexCoord0;
in vec4 vofi_TexCoord4;
in vec4 vofi_TexCoord6;

out vec4 out_FragColor0;
out vec4 out_FragColor1;
out vec4 out_FragColor2;

void main() {
	vec4 sampleSpecular;
	vec4 sampleYCoCg;
	vec4 sampleNormal;
	vec4 feedback;
	vec4 specular;
	vec3 globalNormal;
	vec4 color;
	float wetFadeEnd = 3000;
	float wetFadeStart = 2000;
	float wetFade = 1.0 - ( vofi_TexCoord1.w - wetFadeStart ) / ( wetFadeEnd - wetFadeStart );
	vec4 worldNormal = vec4( vofi_TexCoord1.z, vofi_TexCoord2.z, vofi_TexCoord3.z, 0.0 );
	vec4 texCoord0 = vofi_TexCoord0;
	vec2 wetPertub = vec2( 0.0 );
	if ( wetFade > 0.0 && worldNormal.z > 0.0 ) {
		wetFade = clamp( wetFade, 0.0, 1.0 );
		wetFade *= vofi_TexCoord3.z * vofi_TexCoord3.z;
		float rippleMotionTime = _fa_[0 ].x * _fa_[1 ].x * 16.0;
		vec2 rippleMotion = dot( worldNormal.xy, worldNormal.xy ) < 0.01 ?
		vec2( 0.0, 0.0 ) :
		vec2( worldNormal.x > 0 ? -1.0 : 1.0, worldNormal.y > 0 ? -1.0 : 1.0) * rippleMotionTime;
		vec2 rippleTexCoord = ( vofi_TexCoord4.xy + _fa_[2 ].xy ) + rippleMotion;
		rippleTexCoord *= _fa_[3 ].x * 0.04;
		float numFramesRcp = 1.0 / 16.0;
		float animTime = _fa_[0 ].x * _fa_[4 ].x * 24.0;
		float animFrac = fract( animTime );
		float curFrameCoord = floor( animTime ) * numFramesRcp;
		float nextFrameCoord = curFrameCoord + numFramesRcp;
		rippleTexCoord.x = mod( rippleTexCoord.x * numFramesRcp, numFramesRcp );
		vec4 rippleFrame0 = tex2D( samp_landwetrippletexture, rippleTexCoord + vec2( curFrameCoord, 0.0 ) ) * 2.0 - 1.0;
		vec4 rippleFrame1 = tex2D( samp_landwetrippletexture, rippleTexCoord + vec2( nextFrameCoord, 0.0 ) ) * 2.0 - 1.0;
		vec4 rippleFrame = mix( rippleFrame0, rippleFrame1, animFrac );
		rippleFrame *= wetFade;
		rippleFrame *= _fa_[5 ].x * 0.2;
		rippleFrame.xy = mix( rippleFrame.zw, rippleFrame.xy, worldNormal.z*worldNormal.z );
		wetPertub = rippleFrame.xy;
	}
	{
		float anisoLOD;
		float sampleLOD;
		{
			float widthInTexels = _fa_[6 ].z;
			float maxAnisoLog2 = _fa_[7 ].z;
			vec2 texelCoords = texCoord0.xy * widthInTexels;
			vec2 dx = dFdx( texelCoords );
			vec2 dy = dFdy( texelCoords );
			float px = dot2( dx, dx );
			float py = dot2( dy, dy );
			float maxLod = 0.0;
			float minLod = 0.0;
			if ( px > 0.0 && py > 0.0 ) {
				maxLod = 0.5 * log2( max( px, py ) );
				minLod = 0.5 * log2( min( px, py ) );
			}
			anisoLOD = maxLod - min( maxAnisoLog2, maxLod - minLod );
		};
		{
			sampleLOD = anisoLOD;
			if ( _fa_[8 ].x != 0.0 ) {
				float minLod = tex2D( samp_minlodmap, texCoord0.xy ).x * 16 - ( 0.49 + _fa_[9 ].x );
				sampleLOD = max( anisoLOD, minLod );
			}
		};
		{
			float pageSource = _fa_[6 ].x;
			float widthInPages = _fa_[6 ].y;
			float feedbackBias = _fa_[7 ].y;
			feedback.xy = texCoord0.xy * widthInPages;
			feedback.z = max( 0.0, anisoLOD ) + feedbackBias;
			feedback.w = pageSource;
		};
		{
			feedback = floor( feedback ) / 256.0;
			vec2 xy_low = fract( feedback.xy + 0.5 / 256.0 );
			vec2 xy_high = floor( feedback.xy ) / 256.0;
			vec4 pack;
			pack.xy = xy_low;
			pack.z = xy_high.y * 16.0 + 0.5 / 256 + xy_high.x;
			pack.w = feedback.w * 16.0 + 0.5 / 256 + feedback.z;
			feedback = pack;
		};
		{
			vec3 physCoords;
			{
				vec4 virtCoordsLod = vec4( texCoord0.xy.x, texCoord0.xy.y, 0, sampleLOD - 0.5 );
				vec2 physPage = tex2Dlod( samp_pagetablemap, virtCoordsLod ).xy;
				vec4 xform = tex2D( samp_physicalmappingsmap, physPage );
				physCoords.xy = texCoord0.xy * xform.x + xform.zw;
				physCoords.z = xform.y;
			};
			{
				sampleSpecular = h4texPhys( samp_physicalpagesmap0, physCoords.xy );
				vec2 pertub = wetPertub * 0.01 * dot3( sampleSpecular.rgb, vec3( 1.0 / 3.0 ) );
				sampleYCoCg = h4texPhys( samp_physicalpagesmap1, physCoords.xy + pertub );
				sampleNormal = h4texPhys( samp_physicalpagesmap2, physCoords.xy + pertub );
			};
			if ( _fa_[8 ].y != 0.0 ) {
				vec4 sampleSpecular2, sampleYCoCg2, sampleNormal2;
				{
					vec4 virtCoordsLod = vec4( texCoord0.xy.x, texCoord0.xy.y, 0, sampleLOD + 0.5 );
					vec2 physPage = tex2Dlod( samp_pagetablemap, virtCoordsLod ).xy;
					vec4 xform = tex2D( samp_physicalmappingsmap, physPage );
					physCoords.xy = texCoord0.xy * xform.x + xform.zw;
					physCoords.z = xform.y;
				};
				{
					sampleSpecular2 = h4texPhys( samp_physicalpagesmap0, physCoords.xy );
					vec2 pertub = wetPertub * 0.01 * dot3( sampleSpecular2.rgb, vec3( 1.0 / 3.0 ) );
					sampleYCoCg2 = h4texPhys( samp_physicalpagesmap1, physCoords.xy + pertub );
					sampleNormal2 = h4texPhys( samp_physicalpagesmap2, physCoords.xy + pertub );
				};
				float trilinearFraction = fract( sampleLOD + _fa_[8 ].z );
				sampleSpecular = mix( sampleSpecular, sampleSpecular2, trilinearFraction );
				sampleYCoCg = mix( sampleYCoCg, sampleYCoCg2, trilinearFraction );
				sampleNormal = mix( sampleNormal, sampleNormal2, trilinearFraction );
			}
		};
	};
	{
		sampleYCoCg.z = ( sampleYCoCg.z * 31.875 ) + 1.0;
		sampleYCoCg.z = 1.0 / sampleYCoCg.z;
		sampleYCoCg.xy *= sampleYCoCg.z;
		color.x = dot4( sampleYCoCg, matrixCoCg1YtoRGB1X );
		color.y = dot4( sampleYCoCg, matrixCoCg1YtoRGB1Y );
		color.z = dot4( sampleYCoCg, matrixCoCg1YtoRGB1Z );
		color.w = 0.5 - _fa_[10 ].x;
		color.xyz *= _fa_[11 ].xyz;
	};
	{
		specular.xyz = sampleSpecular.xyz * 8.0 / ( sampleNormal.z * 255.0 + 8.0 );
		specular.w = sampleNormal.x;
	};
	{
		float maxVal = ( max( max( specular.x, specular.y ), specular.z ) * 255.0 );
		float normalScale = 64.0 / max( min( maxVal, 64.0 ), 1.0 );
		float normalBlend = saturate( maxVal * 0.25 );
		vec3 globalSurfaceNormal = cross( dFdx( vofi_TexCoord6.xyz ), dFdy( vofi_TexCoord6.xyz ) );
		vec3 localNormal;
		localNormal.xy = ( sampleNormal.wy - vec2( 0.5 ) ) * vec2( 2.0 * normalScale );
		localNormal.z = sqrt( 1.0 - min( dot( localNormal.xy, localNormal.xy ), 1.0 ) );
		localNormal.xy += wetPertub.xy * normalScale;
		localNormal = normalize( localNormal );
		globalNormal.x = dot3( localNormal, vofi_TexCoord1.xyz );
		globalNormal.y = dot3( localNormal, vofi_TexCoord2.xyz );
		globalNormal.z = dot3( localNormal, vofi_TexCoord3.xyz );
		globalNormal = mix( normalize( globalSurfaceNormal ), globalNormal, normalBlend );
		globalNormal = normalize( globalNormal );
	};
	{
		specular.xyz *= _fa_[12 ].xyz * _fa_[13 ].xyz;
	};
	{
	};
	specular.xyz *= vec3( 2.5 );
	{
		vec4 reflection;
		{
			vec3 fromViewerN = normalize( vofi_TexCoord4.xyz );
			{
				reflection.xyz = fromViewerN - ( globalNormal * dot3( fromViewerN, globalNormal ) * 2.0 );
			};
			reflection.w = floor( ( 1.0 - specular.w ) * 4.0 + _fa_[14 ].y );
		};
		vec3 specularLight = vec3( 0.0 );
		vec3 envColor;
		{
			envColor = texCUBElod( samp_dynamicenvmap, reflection ).xyz;
		};
		vec2 powerAndScale = _fa_[15 ].xy * ( 1.0 - specular.w ) + _fa_[15 ].zw * specular.w;
		powerAndScale *= vec2( 0.1, 1.0 );
		vec3 fragmentToViewRay = normalize( -vofi_TexCoord4.xyz.xyz );
		vec3 lightToFragmentRay = normalize( vofi_TexCoord4.xyz + _fa_[2 ].xyz - _fa_[16 ].xyz );
		vec3 lightReflectRay = lightToFragmentRay - ( globalNormal * dot3( lightToFragmentRay, globalNormal ) * 2.0 );
		vec3 blendedReflectRay = normalize( globalNormal * ( 1.0 - _fa_[17 ].x ) + lightReflectRay * _fa_[17 ].x );
		float specularBrightness;
		{
			specularBrightness = pow( max( dot3( fragmentToViewRay, blendedReflectRay ), 0.0 ), max( powerAndScale.y, 0.000001 ) ) * powerAndScale.x;
		};
		specularBrightness *= max( 0.0, 1.0 - dot3( vofi_TexCoord4.xyz, vofi_TexCoord4.xyz ) / ( _fa_[18 ].x * _fa_[18 ].x ) );
		specularLight += _fa_[19 ].xyz * specularBrightness * specular.xyz;;
		specularLight = pow3( specularLight, 1.0 / 2.2 );
		specularLight += _fa_[20 ].xyz * envColor * specular.xyz;
		color.xyz += specularLight;
	};
	out_FragColor0 = color;
	out_FragColor1 = feedback;
	specular.xyz *= vec3( 8.0 );
	{
		out_FragColor2.xyz = globalNormal.xyz * vec3( 0.5 ) + vec3( 0.5 );
		out_FragColor2.w = dot( specular.rgb, vec3( 1.0 / 3.0 ) );
	};
}
