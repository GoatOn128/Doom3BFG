#version 150

#include "global.inc"

uniform vec4 _fa_ [18];
uniform sampler2DShadow samp_lightdepthcomparemap;
uniform sampler2D samp_sparespecularmap;
uniform sampler2D samp_sparebumpmap;
uniform sampler2D samp_sparediffusemap;
uniform samplerCube samp_dynamicenvmap;
uniform sampler2D samp_texturemap;
uniform sampler2D samp_lightprojectmap;
uniform sampler2D samp_lightfalloffmap;

in vec4 vofi_TexCoord5;
in vec4 vofi_TexCoord1;
in vec4 vofi_TexCoord3;
in vec4 vofi_TexCoord4;
in vec4 vofi_TexCoord6;
in vec4 vofi_TexCoord2;
in vec4 vofi_TexCoord0;

out vec4 out_FragColor0;

void main() {
	float shadow;
	{
		vec3 absTexCoord = abs( vofi_TexCoord5.xyz );
		vec3 maxTexCoord = max( absTexCoord.xyz, max( absTexCoord.yzx, absTexCoord.zxy ) );
		vec4 axis;
		axis.xyz = vec3( greaterThanEqual( absTexCoord, maxTexCoord ) );
		axis.yz = saturate( axis.yz - axis.xx - axis.xy );
		axis.w = 0.0;
		vec4 rotate = axis.yxxy + axis.zwzw;
		vec4 flatTexCoord;
		flatTexCoord.x = dot( rotate.xy, vofi_TexCoord5.xz );
		flatTexCoord.y = dot( rotate.zw, vofi_TexCoord5.yz );
		flatTexCoord.z = -maxTexCoord.x;
		flatTexCoord.w = vofi_TexCoord5.w;
		float sBias = 0.5 + dot( axis.xyz, vec3( greaterThanEqual( vec3( 0, 0, 0 ), vofi_TexCoord5.xyz ) ) );
		float tBias = 0.5 + dot( axis.xyz, vec3( 0, 1, 2 ) );
		vec4 faceTexCoord;
		faceTexCoord.x = dot4( flatTexCoord, _fa_[0 ] + sBias * _fa_[1 ] );
		faceTexCoord.y = dot4( flatTexCoord, _fa_[2 ] + tBias * _fa_[1 ] );
		faceTexCoord.z = dot4( flatTexCoord, _fa_[3 ] );
		faceTexCoord.w = dot4( flatTexCoord, _fa_[1 ] );
		faceTexCoord.xyz /= faceTexCoord.w;
		faceTexCoord.xy *= _fa_[4 ].z;
		{
			float s = _fa_[4 ].y * 2.0;
			vec4 shadow4;
			{
				shadow4.x = shadow2Ddepth( samp_lightdepthcomparemap, faceTexCoord.xyz + s * vec3( -0.375, -0.125, 0 ) );
			};
			{
				shadow4.y = shadow2Ddepth( samp_lightdepthcomparemap, faceTexCoord.xyz + s * vec3( -0.125, 0.375, 0 ) );
			};
			{
				shadow4.z = shadow2Ddepth( samp_lightdepthcomparemap, faceTexCoord.xyz + s * vec3( 0.125, -0.375, 0 ) );
			};
			{
				shadow4.w = shadow2Ddepth( samp_lightdepthcomparemap, faceTexCoord.xyz + s * vec3( 0.375, 0.125, 0 ) );
			};
			shadow = dot( shadow4, vec4( 0.25 ) );
		};
	};
	{
		vec4 sampleSpecular = tex2D( samp_sparespecularmap, vofi_TexCoord1.xy );
		vec4 sampleNormal = tex2D( samp_sparebumpmap, vofi_TexCoord1.xy );
		vec4 sampleDiffuse;
		{
			vec2 texCoords = vofi_TexCoord1.xy;
			{
				float heightOffset = 0.125;
				float heightMask = saturate( sampleNormal.w - 0.2 ) * 1.25;
				vec3 offset = normalize( vec3( vofi_TexCoord3.w, vofi_TexCoord4.w, vofi_TexCoord6.w ) );
				texCoords -= offset.xy * vec2( heightOffset * heightMask );
			}
			{
				texCoords = texCoords - vec2( 0.5 );
				float pupilDilateClamp = clamp( _fa_[5 ].x, -0.3, -0.0375 );
				float dilateMask = saturate( length( texCoords * ( 2.5 / pupilDilateClamp ) ) );
				float dilateMask2 = 1.0 - saturate( length( vec3( texCoords, 0.0 ) * 5.3 ) );
				vec2 dilation = normalize( vec3( texCoords, 0.0 ) ).xy * dilateMask * dilateMask2 * pupilDilateClamp;
				texCoords += dilation;
				texCoords += 0.5;
			}
			sampleDiffuse = tex2D( samp_sparediffusemap, texCoords );
		}
		vec3 localNormal;
		vec3 globalSpecularNormal;
		{
			localNormal = sampleNormal.xyz * vec3( 2.0 ) - vec3( 1.0 );
			globalSpecularNormal.x = dot3( localNormal, vofi_TexCoord3 );
			globalSpecularNormal.y = dot3( localNormal, vofi_TexCoord4 );
			globalSpecularNormal.z = dot3( localNormal, vofi_TexCoord6 );
			globalSpecularNormal = normalize( globalSpecularNormal );
		}
		vec3 globalNormal;
		{
			localNormal.xy = mix( localNormal.xy * vec2( -2.0 ), localNormal.xy * vec2( 0.25 ), vec2( sampleDiffuse.w ) );
			localNormal = normalize( localNormal );
			globalNormal.x = dot3( localNormal.xyz, vofi_TexCoord3.xyz );
			globalNormal.y = dot3( localNormal.xyz, vofi_TexCoord4.xyz );
			globalNormal.z = dot3( localNormal.xyz, vofi_TexCoord6.xyz );
			globalNormal = normalize( globalNormal );
		}
		vec4 sampleFakeShadow;
		{
			sampleFakeShadow = vec4( 0.565882, 0.550588, 0.458823, 1.0 );
		}
		vec3 diffuse = sampleDiffuse.xyz * mix( _fa_[6 ].xyz, _fa_[7 ].xyz, vec3( sampleDiffuse.w ) );
		vec3 specular = sampleSpecular.xyz * vec3( 16.0 * saturate( 1.05 - sampleDiffuse.w ) );
		vec3 fakeShadow = sampleFakeShadow.xyz;
		float power = sampleSpecular.a;
		float powerExp = 64.0;
		diffuse = pow3( abs( diffuse ), 2.2 );
		vec3 toLight = normalize( _fa_[8 ].xyz - vofi_TexCoord2.xyz );
		vec3 toViewer = normalize( _fa_[9 ].xyz - vofi_TexCoord2.xyz );
		vec4 globalReflection;
		{
			globalReflection.xyz = ( 2.0 * globalSpecularNormal * dot3( globalSpecularNormal, toViewer ) ) - toViewer;
			globalReflection.w = power;
		}
		float fresnel;
		{
			float r0 = 0.228;
			float r0inv = 0.982;
			float cose = dot3( globalSpecularNormal, toViewer );
			fresnel = r0 + r0inv * pow( 1.0 - max( cose, 0.0 ), 5.0 );
		}
		vec3 environment;
		{
			environment = texCUBElod( samp_dynamicenvmap, globalReflection ).xyz;;
			environment = pow3( abs( environment ), 2.2 );
		};
		vec3 lightDiffuse;
		vec3 lightEnvironment;
		vec3 lightSpecular;
		{
			float cosd = clamp( dot3( toLight, globalNormal ) * 0.5 + 0.5, 0.03125, 0.96875 );
			float coss = saturate( dot3( toLight, globalReflection ) );
			float lpow = pow( coss, powerExp );
			vec3 light = tex2Dlod( samp_texturemap, vec4( cosd, 0.5, 0.0, 0.0 ) ).xyz;
			light *= _fa_[10 ].xyz;
			light *= ( shadow * _fa_[11 ].x ) + _fa_[11 ].y;
			lightDiffuse = light;
			{
				vec3 lightTexCoord = vofi_TexCoord0.xyz / vofi_TexCoord0.w;
				vec4 lpm = h4tex2D( samp_lightprojectmap, lightTexCoord.xy );
				vec4 lfm = h4tex2D( samp_lightfalloffmap, vec2( lightTexCoord.z, 0.5 ) );
				lpm.xyz = pow3( abs( lpm.xyz ), 2.2 );
				lfm.xyz = pow3( abs( lfm.xyz ), 2.2 );;;
				lightDiffuse *= lpm.xyz * lfm.xyz;
			};
			lightEnvironment = lightDiffuse * vec3( fresnel );
			lightSpecular = light * lpow;
			lightDiffuse *= _fa_[12 ].xyz * _fa_[13 ].xyz * vec3( 2.0 );
			lightEnvironment *= _fa_[14 ].xyz * _fa_[15 ].xyz * _fa_[16 ].xyz;
			lightSpecular *= _fa_[17 ].xyz * _fa_[15 ].xyz * _fa_[16 ].xyz;
			{
			};
			{
			};
			{
			};
		}
		vec3 color = vec3( 0.0 );
		color += diffuse * lightDiffuse;
		color += specular * lightSpecular;
		color += environment * lightEnvironment;
		color *= fakeShadow;
		{
		};
		out_FragColor0.xyz = color;
		out_FragColor0.w = 1.0;
	};
}
