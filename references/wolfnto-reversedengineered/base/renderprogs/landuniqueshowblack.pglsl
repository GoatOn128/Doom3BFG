#version 150

#include "global.inc"

in vec4 vofi_TexCoord6;

out vec4 out_FragColor0;
out vec4 out_FragColor1;
out vec4 out_FragColor2;

void main() {
	vec3 globalNormal;
	{
		globalNormal = normalize( cross( dFdx( vofi_TexCoord6.xyz ), dFdy( vofi_TexCoord6.xyz ) ) );
	};
	out_FragColor0 = vec4( 0.0 );
	out_FragColor1 = vec4( 0.0 );
	{
		out_FragColor2.xyz = globalNormal.xyz * vec3( 0.5 ) + vec3( 0.5 );
		out_FragColor2.w = dot( vec4( 0.0 ).rgb, vec3( 1.0 / 3.0 ) );
	};
}
