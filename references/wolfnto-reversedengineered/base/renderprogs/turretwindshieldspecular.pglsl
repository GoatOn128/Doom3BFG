#version 150

#include "global.inc"

uniform vec4 _fa_ [6];
uniform sampler2D samp_sparebumpmap;
uniform sampler2D samp_sparespecularmap;
uniform sampler2D samp_transmap;
uniform samplerCube samp_dynamicenvmap;
uniform sampler2D samp_texturemap;

in vec4 vofi_TexCoord0;
in vec4 vofi_TexCoord1;
in vec4 vofi_TexCoord2;
in vec4 vofi_TexCoord3;
in vec4 vofi_TexCoord4;

out vec4 out_FragColor0;

void main() {
	vec2 texcoord;
	vec4 sampleNormal;
	vec4 sampleSpecular;
	vec4 sampleAttributes;
	vec3 surfaceSpecular;
	vec3 localNormal;
	vec3 globalNormal;
	vec3 fromViewer;
	vec3 worldPosition;
	vec4 globalReflection;
	vec4 globalRefraction;
	vec3 reflectColor;
	vec3 refractColor;
	vec3 fakeEnvColor;
	float lightSpecular;
	vec3 specular;
	vec4 glassRI = vec4( 1.52, 0.042580, 0.957420, 0.657895 );
	specular = vec3( 0.0 );
	texcoord = vofi_TexCoord0.xy;
	sampleNormal = tex2D( samp_sparebumpmap, texcoord );
	sampleSpecular = tex2D( samp_sparespecularmap, texcoord );
	sampleAttributes = tex2D( samp_transmap, texcoord );
	sampleSpecular.xyz = pow3( abs( sampleSpecular.xyz ), 2.2 );
	sampleAttributes.xyz = pow3( abs( sampleAttributes.xyz ), 2.2 );
	float mask = saturate( ceil( ( 1.000001 - ( _fa_[0 ].a * 1.0 ) ) - sampleAttributes.w ) );
	localNormal = sampleNormal.wyz * vec3( 2.0 ) - vec3( 1.0 );
	localNormal.z = sqrt( 1.0 - min( dot2( localNormal.xy, localNormal.xy ), 1.0 ) );
	sampleAttributes.y = mix( 0.0, sampleAttributes.y, mask );
	localNormal = mix( vec3( 0.0, 0.0, 1.0 ), localNormal, mask );
	surfaceSpecular = vec3( sampleAttributes.y ) + ( vec3( 1.0 - sampleAttributes.y ) * sampleSpecular.xyz );
	{
		globalNormal.x = dot3( localNormal, vofi_TexCoord1.xyz );
		globalNormal.y = dot3( localNormal, vofi_TexCoord2.xyz );
		globalNormal.z = dot3( localNormal, vofi_TexCoord3.xyz );
		globalNormal = normalize( globalNormal );
	};
	{
		worldPosition = vofi_TexCoord4.xyz + _fa_[1 ].xyz;
	};
	{
		fromViewer = normalize( vofi_TexCoord4.xyz.xyz );
	};
	{
		globalReflection.xyz = fromViewer - ( globalNormal * dot3( fromViewer, globalNormal ) * 2.0 );
	};
	globalRefraction.xyz = refract( fromViewer, globalNormal, glassRI.w );
	{
		globalReflection.w = 1.0;
		{
			reflectColor = texCUBElod( samp_dynamicenvmap, globalReflection ).xyz;;
			reflectColor = pow3( abs( reflectColor ), 2.2 );
		};
		reflectColor *= _fa_[2 ].xyz;
	}
	{
		globalRefraction.w = 1.0;
		{
			refractColor = texCUBElod( samp_dynamicenvmap, globalRefraction ).xyz;;
			refractColor = pow3( abs( refractColor ), 2.2 );
		};
		refractColor *= _fa_[2 ].xyz;
	}
	{
		float crackScale = 8.0;
		vec3 localCrackNormal = normalize( localNormal * vec3( crackScale, crackScale, 1.0 ) );
		vec3 globalCrackNormal;
		{
			globalCrackNormal.x = dot3( localCrackNormal, vofi_TexCoord1.xyz );
			globalCrackNormal.y = dot3( localCrackNormal, vofi_TexCoord2.xyz );
			globalCrackNormal.z = dot3( localCrackNormal, vofi_TexCoord3.xyz );
			globalCrackNormal = normalize( globalCrackNormal );
		};
		vec4 globalCrackReflection = globalReflection;
		{
			globalCrackReflection.xyz = fromViewer - ( globalCrackNormal * dot3( fromViewer, globalCrackNormal ) * 2.0 );
		};
		vec3 lightVec = _fa_[3 ].xyz - worldPosition;
		vec3 lightDir = normalize( lightVec );
		{
			float oneOverPi8 = 0.039808917197;
			float glossPowMax = max( _fa_[4 ].x, 0.000001 );
			lightSpecular = pow( max( abs( dot( globalCrackReflection.xyz, lightDir ) ), 0.0 ), glossPowMax );
			lightSpecular *= ( glossPowMax + 8.0 ) * oneOverPi8;
			lightSpecular *= _fa_[4 ].y;
		};
	}
	{
		fakeEnvColor = tex2D( samp_texturemap, vofi_TexCoord0.zw + ( localNormal.xy * 0.075 ) ).xyz * vec3( 1.000001 );
		fakeEnvColor = pow3( abs( fakeEnvColor ), 2.2 );
	}
	specular += reflectColor + refractColor + ( _fa_[5 ].xyz * vec3( lightSpecular ) ) + fakeEnvColor;
	specular *= surfaceSpecular;
	specular = pow3( specular, 1.0 / 2.2 );
	out_FragColor0.xyz = specular;
	out_FragColor0.w = 1.0;
}
