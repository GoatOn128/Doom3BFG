#version 150

#include "global.inc"

uniform vec4 _fa_ [3];
uniform sampler2D samp_dither256map;
uniform sampler2D samp_pagetablemap;
uniform sampler2D samp_physicalmappingsmap;
uniform sampler2D samp_physicalvmtrpagesmap0;

in vec4 gl_FragCoord;
in vec4 vofi_TexCoord0;

out vec4 out_FragColor0;

void main() {
	vec2 screenTexcoord = gl_FragCoord.xy * ( 1.0 / 128.0 );
	float dither = tex2D( samp_dither256map, screenTexcoord ).x;
	clip( _fa_[0 ].x - 0.2 - dither * 0.6 );
	vec2 texcoord = vofi_TexCoord0.xy; if ( _fa_[1 ].x > 0 ) {
		texcoord = fract( texcoord ) * _fa_[2 ].xy + _fa_[2 ].zw;
	}
	vec3 physCoord = VirtualToPhysical2( samp_pagetablemap, samp_physicalmappingsmap, texcoord );
	vec4 specular = texPhys( samp_physicalvmtrpagesmap0, physCoord.xy );
	clip( specular.w - 0.5 );
	out_FragColor0 = vec4( 0.0 );
}
