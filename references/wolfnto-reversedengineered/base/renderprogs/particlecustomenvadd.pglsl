#version 150

#include "global.inc"

uniform sampler2D samp_sparespecularmap;
uniform sampler2D samp_sparebumpmap;
uniform samplerCube samp_envmap;

in vec4 vofi_TexCoord0;
in vec4 vofi_TexCoord1;
in vec4 vofi_Color;

out vec4 out_FragColor0;

void main() {
	vec4 envMask = tex2D( samp_sparespecularmap, vofi_TexCoord0.xy );
	vec3 toViewer = normalize( vofi_TexCoord1.xyz );
	vec3 dp1 = dFdx( vofi_TexCoord1.xyz );
	vec3 dp2 = dFdy( vofi_TexCoord1.xyz );
	vec2 duv1 = dFdx( vofi_TexCoord0.xy );
	vec2 duv2 = dFdy( vofi_TexCoord0.xy );
	vec3 T = normalize( vec3( duv1.x * dp1.x + duv2.x * dp2.x, duv1.x * dp1.y + duv2.x * dp2.y, duv1.x * dp1.z + duv2.x * dp2.z ) );
	vec3 B = normalize( vec3( duv1.y * dp1.x + duv2.y * dp2.x, duv1.y * dp1.y + duv2.y * dp2.y, duv1.y * dp1.z + duv2.y * dp2.z ) );
	vec3 N = cross( T, B );
	vec3 localNormal = tex2D( samp_sparebumpmap, vofi_TexCoord0.xy ).wyz;
	localNormal = vec3( localNormal.xy * 2.0 - 1.0, 0.0 );
	localNormal.z = sqrt( 1.0 - min( dot3( localNormal, localNormal ), 1.0 ) );
	vec3 globalNormal;
	globalNormal.x = dot3( localNormal, T );
	globalNormal.y = dot3( localNormal, B );
	globalNormal.z = dot3( localNormal, N );
	globalNormal = normalize( globalNormal );
	vec4 reflection;
	reflection.xyz = ( globalNormal * dot3( toViewer, globalNormal ) * 2.0 ) - toViewer;
	reflection.w = 0.0;
	vec4 color = texCUBElod( samp_envmap, reflection );
	color.w = envMask.g;
	out_FragColor0 = vofi_Color * color;
}
