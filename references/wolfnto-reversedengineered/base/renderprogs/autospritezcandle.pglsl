#version 150

#include "global.inc"

uniform vec4 _fa_ [2];
uniform sampler2D samp_distortionmap;
uniform sampler2D samp_transmap;

in vec4 vofi_TexCoord0;
in vec4 vofi_Color;

out vec4 out_FragColor0;

void main() {
	vec4 tex_distortion = tex2D( samp_distortionmap, vofi_TexCoord0.xy );
	tex_distortion.z = tex2D( samp_distortionmap, vofi_TexCoord0.zw ).z;
	vec2 texcoord = vofi_TexCoord0.zw;
	texcoord += ( tex_distortion.xy * vec2( 2.0 ) - vec2( 1.0 ) ) * _fa_[0 ].xy * vec2( tex_distortion.z );
	vec4 tex_color = tex2D( samp_transmap, saturate( texcoord ) );
	vec4 final = tex_color;
	final.xyz *= vofi_Color.xyz;
	final.xyz *= _fa_[1 ].xyz;
	final.w = 1.0;
	out_FragColor0 = final;
}
