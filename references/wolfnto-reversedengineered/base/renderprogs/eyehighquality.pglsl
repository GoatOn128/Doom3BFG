	};
	globalReflection.w = sampleSpecular.a;
	float cose = dot3( globalSpecularNormal, -fromViewerN );
	float fresnel = 1.0 - saturate( cose );
	vec3 envColor;
	{
		envColor = texCUBElod( samp_dynamicenvmap, globalReflection ).xyz;;
