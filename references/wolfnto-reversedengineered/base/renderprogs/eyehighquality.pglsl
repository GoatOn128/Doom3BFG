	+ max( globalNormal.y * _fa_[5 ].xyz, 0 )
	+ max( -globalNormal.y * _fa_[6 ].xyz, 0 )
	+ max( globalNormal.z * _fa_[7 ].xyz, 0 )
	+ max( -globalNormal.z * _fa_[8 ].xyz, 0 );
	float acceptDimShadow = 0.0;
	vec3 specularLight = vec3( 0.0 );
	vec3 diffuseLight = vec3( 0.0 ); if ( _fa_[9 ].x > 0 ) {
