		float light0Attenuation = 1.0 - ( min( light0Dist, _fa_[17 ].w ) / max( _fa_[17 ].w, 0.001 ) );
		float light1Attenuation = 1.0 - ( min( light1Dist, _fa_[18 ].w ) / max( _fa_[18 ].w, 0.001 ) );
		float light2Attenuation = 1.0 - ( min( light2Dist, _fa_[19 ].w ) / max( _fa_[19 ].w, 0.001 ) );
