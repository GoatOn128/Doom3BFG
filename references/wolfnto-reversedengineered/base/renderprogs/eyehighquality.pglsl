		float light1Factor = saturate( dot3( light1DirNormalized, globalNormal ) ) * light1Attenuation;
		float light2Factor = saturate( dot3( light2DirNormalized, globalNormal ) ) * light2Attenuation;
		vec3 light0Color = light0Factor * _fa_[17 ].xyz * saturate( selfShadow.x + _fa_[14 ].w );
