out vec4 out_FragColor1;
out vec4 out_FragColor2;

void main() {
	vec4 sampleDiffuse;
	vec4 sampleSpecular;
	vec4 sampleNormal;
	vec4 sampleFakeShadow;
	vec4 sampleEnvironment;
	vec3 fromViewerN;
	vec3 localNormal;
	vec3 globalNormal;
	vec3 globalSpecularNormal;
	vec4 globalReflection;
	vec4 color;
	float term = 0.2;
	sampleSpecular = tex2D( samp_sparespecularmap, vofi_TexCoord0.xy );
	sampleNormal = tex2D( samp_sparebumpmap, vofi_TexCoord0.xy );
	{
		vec2 texCoords = vofi_TexCoord0.xy;
