	}
	{
		sampleFakeShadow = vec4( 0.565882, 0.550588, 0.458823, 1.0 );
	}
	vec3 surfaceDiffuse = sampleDiffuse.xyz * mix( _fa_[1 ].xyz, _fa_[2 ].xyz, vec3( sampleDiffuse.w ) );
	vec3 fakeShadow = sampleFakeShadow.xyz;
	surfaceDiffuse = pow3( abs( surfaceDiffuse ), 2.2 );
	fakeShadow = pow3( abs( fakeShadow ), 2.2 );
	float specularScale = 16.0 * saturate( 1.05 - sampleDiffuse.w );
	float specularPower = 128.0;
	{
