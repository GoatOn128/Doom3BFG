			float glossPowMax = max( specularPower, 0.000001 );
			light2Specular = pow( max( max( dot( globalReflection.xyz, light2DirNormalized ), 0.0 ), 0.0 ), glossPowMax );
			light2Specular *= ( glossPowMax + 8.0 ) * oneOverPi8;
