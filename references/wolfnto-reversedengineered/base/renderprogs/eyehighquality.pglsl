		ambientLight *= ambientOcclusion;
		diffuseLight += light0Color;
		diffuseLight += light1Color;
		diffuseLight += light2Color;
		diffuseLight += ambientLight;
		specularLight += light0Color * vec3( light0Specular );
		specularLight += light1Color * vec3( light1Specular );
		specularLight += light2Color * vec3( light2Specular );
		specularLight += diffuseLight * envColor;
	} else {
		vec3 fakeSpecularDir = normalize( vec3( _fa_[20 ].x, _fa_[20 ].y, _fa_[20 ].z * 0.1 ) );
		float physicalSpecular;
		{
			float oneOverPi8 = 0.039808917197;
			float glossPowMax = max( 128.0, 0.000001 );
			physicalSpecular = pow( max( max( dot3( globalReflection.xyz, fakeSpecularDir ), 0.0 ), 0.0 ), glossPowMax );
			physicalSpecular *= ( glossPowMax + 8.0 ) * oneOverPi8;
			physicalSpecular *= specularScale;
		};
		float primeLightFactor = saturate( dot3( _fa_[20 ], globalNormal ) * 0.5 + 0.5 );
		vec3 primeLight = ( primeLightFactor * primeLightFactor ) * _fa_[21 ].xyz;
		{
			acceptDimShadow = 1.0 - ( saturate( primeLightFactor - _fa_[22 ].y ) + 0.5 + _fa_[22 ].x );
		};
		diffuseLight += ambientLight + primeLight;
		specularLight += ( diffuseLight * envColor ) + ( _fa_[21 ].xyz * physicalSpecular );
	}
	{
		diffuseLight.xyz *= _fa_[23 ].xyz;
	};
	{
		specularLight.xyz *= _fa_[24 ].xyz * _fa_[25 ].xyz;
	};
	diffuseLight *= vec3( _fa_[26 ].x );
	specularLight *= vec3( _fa_[26 ].y );;;
