		globalSpecularNormal.y = dot3( localNormal, vofi_TexCoord2 );
		globalSpecularNormal.z = dot3( localNormal, vofi_TexCoord3 );
		globalSpecularNormal = normalize( globalSpecularNormal );
	}
	{
