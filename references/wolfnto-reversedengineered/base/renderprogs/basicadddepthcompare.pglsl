#version 150

#include "global.inc"

uniform vec4 _fa_ [2];
uniform sampler2D samp_viewdepthmap;
uniform sampler2D samp_transmap;

in vec4 gl_FragCoord;
in vec4 vofi_TexCoord0;

out vec4 out_FragColor0;

void main() {
	float interpolatedZOverW = gl_FragCoord.z;
	vec2 tc = screenPosToTexcoord( gl_FragCoord.xy, _fa_[0 ] );
	float dstDepth = tex2Ddepth( samp_viewdepthmap, tc );
	float srcDepth = interpolatedZOverW;
	float r1 = 1.0 / ( 1.0 - dstDepth );
	float r2 = 1.0 / ( 1.0 - srcDepth );
	float depthDiff = abs( r1 - r2 );
	float zReject = 1.5 - depthDiff;
	clip( zReject );
	out_FragColor0 = _fa_[1 ] * tex2D( samp_transmap, vofi_TexCoord0.xy );
}
