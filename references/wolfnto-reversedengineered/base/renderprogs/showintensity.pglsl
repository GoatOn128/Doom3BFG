#version 150

#include "global.inc"

uniform vec4 _fa_ [1];
uniform sampler2D samp_spare1map;

in vec4 gl_FragCoord;

out vec4 out_FragColor0;

void main() {
	vec2 tc = screenPosToTexcoord( gl_FragCoord.xy, _fa_[0 ] );
	vec4 color = tex2D( samp_spare1map, tc );
	float maxComp = max( max( color.r, color.g ), color.b );
	out_FragColor0.rgb = ( maxComp < 0.5 ) ?
	vec3( 2.0 * ( 0.5 - maxComp ), 2.0 * maxComp, 0.0 ) :
	vec3( 0.0, 2.0 * ( 1.0 - maxComp ), 2.0 * ( maxComp - 0.5 ));
	out_FragColor0.a = 1.0;
}
