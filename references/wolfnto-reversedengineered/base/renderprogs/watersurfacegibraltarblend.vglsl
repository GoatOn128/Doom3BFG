#version 150

#include "global.inc"

uniform vec4 _va_ [24];

in vec4 in_Position;
in vec4 in_Normal;
in vec4 in_Tangent;
in vec2 in_TexCoord;
in vec4 in_Color;

out vec4 vofi_TexCoord5;
out vec4 vofi_TexCoord1;
out vec4 vofi_TexCoord2;
out vec4 vofi_TexCoord4;
out vec4 vofi_TexCoord3;
out vec4 vofi_TexCoord0;
out vec4 vofi_Color;

void main() {
	vec4 position;
	vec4 normal;
	vec4 tangent;
	{
		position = in_Position * _va_[0 ] + _va_[1 ];
		normal = in_Normal * 2.0 - 1.0;
		tangent.xyz = in_Tangent.xyz * 2.0 - 1.0;
		tangent.w = floor( in_Tangent.w * 255.1 / 128.0 ) * 2.0 - 1.0;
	};
	gl_Position.x = dot4( position, _va_[2 ] );
	gl_Position.y = dot4( position, _va_[3 ] );
	gl_Position.z = dot4( position, _va_[4 ] );
	gl_Position.w = dot4( position, _va_[5 ] );
	vec3 bitangent = cross( normal.xyz, tangent.xyz ) * tangent.w;
	vofi_TexCoord0.xy = fract( _va_[6 ].zw * _va_[7 ].x ) + ( in_TexCoord.xy * _va_[6 ].xy );
	vofi_TexCoord0.zw = fract( _va_[8 ].zw * _va_[7 ].x ) + ( in_TexCoord.xy * _va_[8 ].xy );
	vofi_TexCoord1.xy = fract( _va_[9 ].zw * _va_[7 ].x ) + ( in_TexCoord.xy * _va_[9 ].xy );
	vofi_TexCoord1.zw = fract( _va_[10 ].zw * _va_[7 ].x ) + ( in_TexCoord.xy * _va_[10 ].xy );
	vec3 r0 = _va_[11 ].xyz - in_Position.xyz;
	vofi_TexCoord2.x = dot3( tangent, r0 );
	vofi_TexCoord2.y = dot3( bitangent, r0 );
	vofi_TexCoord2.z = dot3( normal, r0 );
	vofi_TexCoord2.w = gl_Position.w;
	vofi_TexCoord3.x = dot4( position, _va_[12 ] );
	vofi_TexCoord3.y = dot4( position, _va_[13 ] );
	vofi_TexCoord3.z = dot4( position, _va_[14 ] );
	vofi_TexCoord3.w = dot4( position, _va_[15 ] );
	vec3 world_fwd = vec3( _va_[12 ].x, _va_[13 ].x, _va_[14 ].x );
	vec3 world_left = vec3( _va_[12 ].y, _va_[13 ].y, _va_[14 ].y );
	vec3 world_toPixel = vofi_TexCoord3.xyz - _va_[16 ].xyz;
	vec2 toFragment = vec2( dot( world_fwd, world_toPixel ), dot( world_left, world_toPixel ) );
	float fog = saturate( exp2( -clamp( length( toFragment ) - _va_[17 ].x, 0.0, _va_[18 ].x ) * _va_[19 ].x ) );
	vec3 sunLocalPosition;
	sunLocalPosition.x = dot4( _va_[20 ], _va_[21 ] );
	sunLocalPosition.y = dot4( _va_[20 ], _va_[22 ] );
	sunLocalPosition.z = dot4( _va_[20 ], _va_[23 ] );
	r0 = sunLocalPosition - in_Position.xyz;
	vofi_TexCoord4.x = dot3( tangent, r0 );
	vofi_TexCoord4.y = dot3( bitangent, r0 );
	vofi_TexCoord4.z = dot3( normal, r0 );
	vofi_TexCoord4.w = fog;
	vofi_TexCoord5 = in_TexCoord.xyxy;
	vofi_Color = swizzleColor( in_Color );
}
