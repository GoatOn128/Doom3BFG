#version 150

#include "global.inc"

uniform vec4 _fa_ [2];
uniform sampler2D samp_texturemap;
uniform sampler2D samp_sparebumpmap2;
uniform sampler2D samp_spare3map;
uniform sampler2D samp_transmap2;
uniform sampler2D samp_spare1map;
uniform sampler2D samp_sparebumpmap;
uniform sampler2D samp_transmap1;
uniform sampler2D samp_spare2map;

in vec4 vofi_TexCoord0;
in vec4 vofi_TexCoord1;
in vec4 vofi_TexCoord2;
in vec4 vofi_TexCoord3;
in vec4 vofi_TexCoord4;
in vec4 vofi_TexCoord5;
in vec4 vofi_Color;

out vec4 out_FragColor0;

void main() {
	vec4 windowColor = tex2D( samp_texturemap, vofi_TexCoord0.xy );
	vec3 localNormal3 = tex2D( samp_sparebumpmap2, vofi_TexCoord0.zw ).xyz;
	vec3 localNormal2 = tex2D( samp_sparebumpmap2, vofi_TexCoord1.xy ).xyz;
	vec3 localNormal4 = tex2D( samp_sparebumpmap2, vofi_TexCoord2.xy ).xyz;
	localNormal2.xy = localNormal2.xy * 2.0 - 1.0;
	localNormal3.xy = localNormal3.xy * 2.0 - 1.0;
	localNormal4.xy = localNormal4.xy * 2.0 - 1.0;
	float rainMask;
	{
		vec4 wipeMask = tex2D( samp_spare3map, vofi_TexCoord0.xy );
		float outside = 1.0 - wipeMask.r;
		float wipe1 = saturate( ceil( ( 1.0 - _fa_[0 ].x ) - ( wipeMask.g ) ) );
		float wipe2 = saturate( ceil( ( 1.0 - _fa_[0 ].x ) - ( wipeMask.a ) ) );
		rainMask = saturate( wipe1 + wipe2 + outside );
	}
	vec2 texcoord = ( localNormal2.xy * 0.01 );
	vec2 texcoord2 = ( localNormal4.xy * 0.01 );
	vec4 mask1 = tex2D( samp_transmap2, vofi_TexCoord0.xy + texcoord );
	vec4 mask2 = tex2D( samp_spare1map, vofi_TexCoord1.zw + ( texcoord2 * 0.75 ) + ( texcoord * 0.5 ));
	vec3 localNormal1 = tex2D( samp_sparebumpmap, vofi_TexCoord0.xy + texcoord ).xyz;
	localNormal1.xy = localNormal1.xy * 2.0 - 1.0;
	vec4 overlay = tex2D( samp_transmap1, vofi_TexCoord0.xy + texcoord );
	vec2 distort1 = SafeNormalizeHalf( localNormal1.xy + localNormal3.xy ) * 0.04;
	vec4 refl1 = tex2D( samp_spare2map, vofi_TexCoord0.zw + distort1 );
	vec4 refl2 = tex2D( samp_spare2map, vofi_TexCoord0.zw );
	float graze;
	{
		vec3 localNormal = vec3( 0.0, 0.0, 1.0 );
		vec3 globalNormal;
		globalNormal.x = dot3( localNormal, vofi_TexCoord3.xyz );
		globalNormal.y = dot3( localNormal, vofi_TexCoord4.xyz );
		globalNormal.z = dot3( localNormal, vofi_TexCoord5.xyz );
		globalNormal = normalize( globalNormal );
		graze = 1.0 - saturate( abs( dot( globalNormal, _fa_[1 ].xyz ) ) * 1.2 );
	}
	vec4 color = vec4( 0.0 );
	{
		float animMask = min( rainMask + saturate( ceil( _fa_[0 ].y - mask1.a ) ), 1.0 );
		mask1.xyz *= vec3( animMask * 1.0 );
		float dripMask = min( rainMask + saturate( ceil( _fa_[0 ].y - mask2.a ) ), 1.0 );
		mask2.xyz *= vec3( dripMask * 1.0 );
		color.xyz += refl1.xyz * overlay.xyz + refl1.xyz * overlay.xyz;
		color.xyz *= saturate( mask1.xyz + mask2.xyz ) * vec3( 1.0 + graze * 0.2 );
		color.xyz += refl2.xyz * vec3( graze );
		color.w += saturate( dot3( color.xyz, vec3( 0.2, 0.7, 0.1 ) ) );
		color += windowColor;
	}
	color = saturate( color );
	color.a *= vofi_Color.a;
	out_FragColor0 = color;
}
