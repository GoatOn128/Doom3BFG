#version 150

#include "global.inc"

uniform vec4 _fa_ [13];
uniform sampler2D samp_transmap;
uniform sampler2D samp_selfshadowmap;

in vec4 vofi_TexCoord0;
in vec4 vofi_TexCoord1;
in vec4 vofi_TexCoord2;
in vec4 vofi_TexCoord3;
in vec4 vofi_TexCoord4;
in vec4 gl_FragCoord;

out vec4 out_FragColor0;

void main() {
	vec4 maskMap = tex2D( samp_transmap, vofi_TexCoord0.xy );
	vec3 localNormal = normalize( maskMap.xyz - vec3( 0.5 ) );
	vec3 globalNormal;
	globalNormal.x = dot3( localNormal, vofi_TexCoord1 );
	globalNormal.y = dot3( localNormal, vofi_TexCoord2 );
	globalNormal.z = dot3( localNormal, vofi_TexCoord3 );
	globalNormal = normalize( globalNormal );
	vec3 fromViewer = normalize( vofi_TexCoord4.xyz );
	vec4 reflection;
	reflection.xyz = normalize( fromViewer - ( globalNormal * dot3( fromViewer, globalNormal ) * 2.0 ) );
	reflection.w = 0.0;
	vec3 color; if ( _fa_[0 ].x > 0 ) {
		vec3 selfShadow;
		vec3 thickness;
		float ambientOcclusion;
		{ if( _fa_[0 ].y > 0 ) {
				vec2 texcoord = screenPosToTexcoord( gl_FragCoord.xy, _fa_[1 ] );
				vec4 encoded = tex2D( samp_selfshadowmap, texcoord );
				encoded.xyz *= 2.0;
				selfShadow = max( encoded.xyz - 1.0, vec3( 0.0 ) );
				thickness = encoded.xyz + vec3( _fa_[2 ].y );
				ambientOcclusion = 1.0 - _fa_[3 ].x * ( 1.0 - encoded.w );
			} else {
				selfShadow = vec3( 1.0 );
				thickness = vec3( 100 );
				ambientOcclusion = 1.0;
			}
		};
		selfShadow.x = saturate( selfShadow.x + _fa_[4 ].w );
		selfShadow.y = saturate( selfShadow.y + _fa_[5 ].w );
		selfShadow.z = saturate( selfShadow.z + _fa_[6 ].w );
		vec3 worldPosition = vofi_TexCoord4.xyz + _fa_[7 ].xyz;
		vec3 lightDir0 = normalize( _fa_[4 ].xyz - worldPosition );
		vec3 lightDir1 = normalize( _fa_[5 ].xyz - worldPosition );
		vec3 lightDir2 = normalize( _fa_[6 ].xyz - worldPosition );
		color = ( pow( saturate( dot( reflection.xyz, lightDir0 ) ), 4.0 ) * maskMap.w * selfShadow.x ) * _fa_[8 ].xyz;
		color += ( pow( saturate( dot( reflection.xyz, lightDir1 ) ), 4.0 ) * maskMap.w * selfShadow.y ) * _fa_[9 ].xyz;
		color += ( pow( saturate( dot( reflection.xyz, lightDir2 ) ), 4.0 ) * maskMap.w * selfShadow.z ) * _fa_[10 ].xyz;
	} else {
		color = ( pow( saturate( dot( reflection.xyz, _fa_[11 ].xyz ) ), 4.0 ) * maskMap.w ) * _fa_[12 ].xyz;
	}
	out_FragColor0.xyz = color;
	out_FragColor0.w = 1.0;
}
