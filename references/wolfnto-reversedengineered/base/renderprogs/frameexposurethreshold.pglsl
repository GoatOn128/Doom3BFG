#version 150

#include "global.inc"

uniform vec4 _fa_ [3];
uniform sampler2D samp_frameexposuremap;
uniform sampler2D samp_viewcolormap;
uniform sampler2D samp_adaptiveluminance;

in vec4 gl_FragCoord;

out vec4 out_FragColor0;

void main() {
	float saturation = _fa_[0 ].x;
	float decay = _fa_[0 ].y;
	float minThreshold = _fa_[0 ].z;
	float maxThreshold = _fa_[0 ].w;
	float amount = _fa_[1 ].x;
	float rcpThreshold = 1.0 / max( maxThreshold - minThreshold, 0.000001 );
	vec2 texcoord = screenPosToTexcoord( gl_FragCoord.xy, _fa_[2 ] );
	vec3 frameExposure = tex2D( samp_frameexposuremap, texcoord.xy ).xyz;
	vec3 frontColor = tex2D( samp_viewcolormap, texcoord.xy ).xyz;
	vec4 luminance = tex2D( samp_adaptiveluminance, texcoord.xy );
	float threshold = mix( minThreshold, maxThreshold, luminance.x );
	float luma;
	{
		vec3 ituBT601 = vec3( 0.299, 0.587, 0.114 );
		luma = dot( frontColor, ituBT601 );
	};
	vec3 frontSaturated = mix( vec3( luma ), frontColor, saturation );
	vec3 frontScaled = frontSaturated * 0.5 * ( 1.5 / threshold );
	frontScaled = saturate( frontScaled - threshold - 0.0 );
	vec3 finalColor = saturate( frameExposure * vec3( decay ) + frontScaled );
	finalColor *= vec3( amount );
	out_FragColor0.xyz = finalColor.xyz;
	out_FragColor0.w = 1.0;
}
