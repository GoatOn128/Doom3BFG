#version 150

#include "global.inc"

uniform vec4 _fa_ [2];
uniform sampler2D samp_viewcolormap;

in vec4 gl_FragCoord;

out vec4 out_FragColor0;

void main() {
	vec2 texcoord = screenPosToTexcoord( gl_FragCoord.xy - 0.5, _fa_[0 ] );
	vec2 translate = _fa_[0 ].zw;
	vec4 samp0 = h4tex2D( samp_viewcolormap, clamp( texcoord.xy, _fa_[1 ].xy, _fa_[1 ].zw ) );
	vec3 total = pow3(samp0.rgb, 4.0);
	float alpha = samp0.a;
	texcoord.x += translate.x;
	vec4 samp1 = h4tex2D( samp_viewcolormap, clamp( texcoord.xy, _fa_[1 ].xy, _fa_[1 ].zw ) );
	total += pow3(samp1.rgb, 4.0);
	alpha = max( samp1.a, alpha);
	texcoord.y += translate.y;
	vec4 samp2 = h4tex2D( samp_viewcolormap, clamp( texcoord.xy, _fa_[1 ].xy, _fa_[1 ].zw ) );
	total += pow3(samp2.rgb, 4.0);
	alpha = max( samp2.a, alpha);
	texcoord.x -= translate.x;
	vec4 samp3 = h4tex2D( samp_viewcolormap, clamp( texcoord.xy, _fa_[1 ].xy, _fa_[1 ].zw ) );
	total += pow3(samp3.rgb, 4.0);
	alpha = max( samp3.a, alpha);
	out_FragColor0.rgb = pow3(total * 0.25, 1.0 / 4.0);
	out_FragColor0.a = alpha;
}
