#version 150

#include "global.inc"

uniform vec4 _fa_ [21];
uniform sampler2D samp_viewdepthmap;
uniform sampler2D samp_waterparmmap;
uniform sampler2D samp_sparebumpmap;
uniform sampler2D samp_sparebumpmap2;
uniform samplerCube samp_envmap;
uniform sampler2D samp_transmap;
uniform sampler2D samp_transmap1;

in vec4 gl_FragCoord;
in vec4 vofi_TexCoord5;
in vec4 vofi_TexCoord1;
in vec4 vofi_TexCoord2;
in vec4 vofi_TexCoord4;
in vec4 vofi_TexCoord3;
in vec4 vofi_TexCoord0;
in vec4 vofi_Color;

out vec4 out_FragColor0;

void main() {
	vec2 viewTexCoord = screenPosToTexcoord( gl_FragCoord.xy, _fa_[0 ] );
	vec4 windowPosition;
	windowPosition.z = tex2Ddepth( samp_viewdepthmap, viewTexCoord.xy );
	windowPosition.z = min( (1.0-(1e-7)), windowPosition.z );
	windowPosition.w = 1.0;
	windowPosition.xy = screenPosToTexcoord( gl_FragCoord.xy, _fa_[1 ] );
	vec4 globalPosition;
	globalPosition.x = dot4( windowPosition, _fa_[2 ] );
	globalPosition.y = dot4( windowPosition, _fa_[3 ] );
	globalPosition.z = dot4( windowPosition, _fa_[4 ] );
	globalPosition.w = dot4( windowPosition, _fa_[5 ] );
	globalPosition.xyz /= globalPosition.w;
	vec4 waterParms = tex2D( samp_waterparmmap, vofi_TexCoord5.xy );
	vec4 bump;
	bump.xy = tex2D( samp_sparebumpmap, vofi_TexCoord1.xy ).wy;
	bump.zw = tex2D( samp_sparebumpmap2, vofi_TexCoord1.zw ).wy;
	vec3 localNormal;
	localNormal.xy = ( bump.xy + bump.zw ) * 2.0 - 1.0;
	localNormal.z = sqrt( 1.0 - min( dot( localNormal.xy, localNormal.xy ), 1.0 ) );
	localNormal.xy *= vec2( _fa_[6 ].w );
	localNormal = SafeNormalize( localNormal );
	vec3 toViewer = normalize( vofi_TexCoord2.xyz );
	vec3 toLight = normalize( vofi_TexCoord4.xyz );
	vec3 halfVec = SafeNormalize( toViewer + toLight );
	float ndotv = dot( toViewer, localNormal );
	vec3 specular = vec3( 0.0 );
	vec3 diffuseFog = vec3( 0.0 );
	vec3 diffuseFoam = vec3( 0.0 );
	float tightFoam = 1.0;
	{
		float interpolatedZOverW = gl_FragCoord.z;
		float r1 = 1.0 / ( 1.0 - windowPosition.z );
		float r2 = 1.0 / ( 1.0 - interpolatedZOverW );
		float diff = r1 - r2;
		tightFoam = saturate( diff * 0.05 );
	}
	vec3 world_up = vec3( _fa_[7 ].z, _fa_[8 ].z, _fa_[9 ].z );
	float depth = dot( vofi_TexCoord3.xyz - globalPosition.xyz, world_up );
	float skyFade = floor( windowPosition.z + 0.000001 );
	float fogFade = saturate( ( depth - _fa_[6 ].y ) / max( _fa_[6 ].z - _fa_[6 ].y, 0.000001 ) );
	fogFade += fogFade - ( fogFade * fogFade );
	fogFade *= saturate( ( depth - _fa_[6 ].x ) / max( _fa_[6 ].y - _fa_[6 ].x, 0.000001 ) );
	fogFade = saturate( fogFade + skyFade );
	float colorFade = saturate( ( depth - _fa_[10 ].x ) / max( _fa_[10 ].y - _fa_[10 ].x, 0.000001 ) );
	colorFade += colorFade - ( colorFade * colorFade );
	colorFade = saturate( colorFade + skyFade );
	diffuseFog = mix( _fa_[11 ].xyz, _fa_[12 ].xyz, colorFade );
	vec3 vReflection = reflect( -toViewer.xyz, localNormal.xyz );
	vReflection.z = max( abs( vReflection.z ), 0.05 );
	vec4 tcEnv = vec4( vReflection.x, vReflection.y, vReflection.z, _fa_[13 ].x );
	vec3 reflection = texCUBE( samp_envmap, tcEnv.xyz ).xyz;
	specular += reflection * _fa_[14 ].xyz;
	vec3 foam1 = tex2D( samp_transmap, vofi_TexCoord0.xy + ( localNormal.xy ) * 0.002 ).xyz;
	vec3 foam2 = tex2D( samp_transmap1, vofi_TexCoord0.zw - ( localNormal.xy ) * 0.02 ).xyz;
	vec3 foam = foam1 * foam2;
	float foamFade = saturate( pow( ( 1.0 - abs( localNormal.z ) ) * _fa_[15 ].x, _fa_[15 ].y ) );
	diffuseFoam = foam * vec3( saturate( ( foamFade * _fa_[15 ].w ) + ( tightFoam * 0.000001 ) ) );
	float sunSpecular1 = pow( saturate( dot( halfVec, localNormal ) + _fa_[16 ].x ), _fa_[17 ].w );
	float sunSpecular2 = pow( saturate( dot( halfVec, localNormal ) + _fa_[16 ].y ), _fa_[18 ].w );
	specular += vec3( sunSpecular1 ) * _fa_[17 ].xyz;
	specular += vec3( sunSpecular2 ) * _fa_[18 ].xyz;
	float fresnel = pow( min( ( 1.0 - ndotv ) * _fa_[19 ].w, 1.0 ), 5.0 );
	fresnel = fresnel + _fa_[19 ].x * ( 1.0 - fresnel );
	specular *= vec3( fresnel );
	vec3 color = vec3( 0.0 );
	color += saturate( diffuseFog + diffuseFoam );
	color += specular;
	float specularFade = saturate( dot3( vec3( 0.2125, 0.7154, 0.0721 ), specular ) );
	float foamAlpha = saturate( dot3( vec3( 0.2125, 0.7154, 0.0721 ), diffuseFoam ) );
	specularFade *= saturate( fogFade + foamAlpha + tightFoam );
	specularFade *= specularFade;
	float alphaFade = fogFade + specularFade + foamAlpha;
	color = mix( _fa_[20 ].xyz, color, vofi_TexCoord4.w );
	out_FragColor0.xyz = color;
	out_FragColor0.w = saturate( alphaFade ) * vofi_Color.w * waterParms.w;
}
