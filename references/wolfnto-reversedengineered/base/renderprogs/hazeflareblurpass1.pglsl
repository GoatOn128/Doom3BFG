#version 150

#include "global.inc"

uniform vec4 _fa_ [5];
uniform sampler2D samp_glaremap;

in vec4 gl_FragCoord;

out vec4 out_FragColor0;

void main() {
	vec2 texcoord = screenPosToTexcoord( gl_FragCoord.xy, _fa_[0 ] );
	vec3 colorSum = vec3( 0.0 );
	int numSamples = 16;
	vec3 threshold = vec3( 0.1 );
	vec2 tstep = vec2( 0.0, 0.005 * _fa_[1 ].x );
	texcoord -= tstep * (numSamples * 0.5);
	for (int i = 0; i < numSamples; i++) {
		vec3 color = vec3( 0.0 );
		vec3 glare = tex2D( samp_glaremap, clamp( texcoord, _fa_[2 ].xy, _fa_[2 ].zw ) ).xyz;
		color += glare * 5.0;
		float bdist = _fa_[2 ].w - 2.0 * abs( 0.5* _fa_[2 ].w - texcoord.y );
		float borderMask = smoothstep( 0.0, 0.001 + 0.3 * _fa_[3 ].x, bdist);
		color *= mix( 1.0, borderMask, _fa_[4 ].x );
		colorSum += color;
		texcoord += tstep;
	}
	colorSum *= (1.0 / numSamples);
	out_FragColor0.xyz = colorSum.xyz;
	out_FragColor0.w = 1.0;
}
