#version 150

#include "global.inc"

uniform vec4 _fa_ [2];
uniform sampler2D samp_texturemap;
uniform sampler2D samp_viewdepthmap;
uniform sampler2D samp_distortionmap;
uniform sampler2D samp_distortionmap1;

in vec4 vofi_TexCoord0;
in vec4 gl_FragCoord;
in vec4 vofi_TexCoord1;
in vec4 vofi_TexCoord2;

out vec4 out_FragColor0;

void main() {
	vec2 mask = tex2D( samp_texturemap, vofi_TexCoord0.xy ).xy;
	clip( ( mask.x + mask.y ) - 0.01 );
	float interpolatedZOverW = gl_FragCoord.z;
	vec2 tc = screenPosToTexcoord( gl_FragCoord.xy, _fa_[0 ] );
	float dstDepth = tex2Ddepth( samp_viewdepthmap, tc );
	float srcDepth = interpolatedZOverW;
	float zReject = dstDepth - srcDepth;
	clip( zReject );
	vec3 localNormal1 = tex2D( samp_distortionmap, vofi_TexCoord1.xy ).xyz;
	vec3 localNormal2 = tex2D( samp_distortionmap1, vofi_TexCoord2.xy ).xyz;
	vec3 localNormal = ( localNormal1 + localNormal2 ) - 1.0;
	vec3 cameraNormal = localNormal;
	vec2 scale = _fa_[1 ].xy * mask * 0.5;
	out_FragColor0 = ComputeDistortion( -cameraNormal.xy * scale, 0.0 );
}
