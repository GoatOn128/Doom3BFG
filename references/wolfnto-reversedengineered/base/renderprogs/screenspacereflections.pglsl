#version 150

#include "global.inc"

uniform vec4 _fa_ [13];
uniform sampler2D samp_viewnormalmap;
uniform sampler2D samp_viewdepthmap;
uniform sampler2D samp_ssrnoise4x4;
uniform sampler2D samp_viewtarget;

in vec4 vofi_TexCoord0;

out vec4 out_FragColor0;

void main() {
	vec3 reflectionColor;
	{
		vec2 imageSize = _fa_[0 ].zw;
		vec4 viewNormalMapSample = tex2D( samp_viewnormalmap, vofi_TexCoord0.xy.xy );
		vec4 windowPosition;
		windowPosition.xy = vofi_TexCoord0.xy;
		windowPosition.z = tex2Ddepth( samp_viewdepthmap, windowPosition.xy );
		windowPosition.w = 1.0;
		vec4 globalPosition;
		globalPosition.x = dot4( windowPosition, _fa_[1 ] );
		globalPosition.y = dot4( windowPosition, _fa_[2 ] );
		globalPosition.z = dot4( windowPosition, _fa_[3 ] );
		globalPosition.w = dot4( windowPosition, _fa_[4 ] );
		globalPosition.xyz /= globalPosition.w;
		globalPosition.w = 1.0;
		vec3 globalNormal = viewNormalMapSample.xyz * 2.0 - 1.0;
		vec4 reflection;
		reflection.xyz = normalize( reflect( globalPosition.xyz - _fa_[5 ].xyz, globalNormal ) );
		reflection.w = 0.0;
		float specularScale = viewNormalMapSample.w;
		float facingViewFade = dot( reflection.xyz, _fa_[6 ].xyz );
		if ( specularScale > 1e-2 &&
		facingViewFade > 0.0 &&
		dot( cross( dFdx( globalPosition.xyz ), dFdy( globalPosition.xyz ) ), reflection.xyz ) > 0.0
		) {
			specularScale = min( 1.0, sqrt( specularScale * 1.5 ) );
			facingViewFade = min( 1.0, facingViewFade * 4.0 );
			vec3 rayHitColor = vec3( 0.0 );
			{
				float linearIterations = _fa_[7 ].x;
				float maxRaycastDistance = _fa_[7 ].y;
				vec4 clipPositionStart;
				vec4 clipPositionEnd;
				{
					clipPositionStart.x = dot4( globalPosition, _fa_[8 ] );
					clipPositionStart.y = dot4( globalPosition, _fa_[9 ] );
					clipPositionStart.z = dot4( globalPosition, _fa_[10 ] );
					clipPositionStart.w = dot4( globalPosition, _fa_[11 ] );
				};
				{
					clipPositionEnd.x = dot4( ( globalPosition + reflection * maxRaycastDistance ), _fa_[8 ] );
					clipPositionEnd.y = dot4( ( globalPosition + reflection * maxRaycastDistance ), _fa_[9 ] );
					clipPositionEnd.z = dot4( ( globalPosition + reflection * maxRaycastDistance ), _fa_[10 ] );
					clipPositionEnd.w = dot4( ( globalPosition + reflection * maxRaycastDistance ), _fa_[11 ] );
				};
				vec3 ndcPositionStart;
				vec3 ndcPositionEnd;
				{
					ndcPositionStart = clipPositionStart.xyz / clipPositionStart.w;
				};
				{
					ndcPositionEnd = clipPositionEnd.xyz / clipPositionEnd.w;
				};
				vec2 screenRay = ( ndcPositionEnd.xy - ndcPositionStart.xy ) * 0.5 + 0.5;
				int maxLinearIterations = max( int( length( screenRay * _fa_[0 ].xy ) * linearIterations ), 2 );
				vec3 ndcStep = ( ndcPositionEnd - ndcPositionStart ) / maxLinearIterations;
				vec3 ndcPosition = ndcPositionStart;
				vec3 screenPosition;
				vec4 noise = tex2Dlod( samp_ssrnoise4x4, vec4( vofi_TexCoord0.xy * imageSize * 0.25, 0, 0 ) );
				ndcPosition += ndcStep * ( noise.z - 0.5 );
				bool rayOccluded = false;
				int numLinearIterations;
				for ( numLinearIterations = 0; numLinearIterations < maxLinearIterations; numLinearIterations++ ) {
					ndcPosition += ndcStep;
					if ( ndcPosition.x < -1.0 || ndcPosition.x > 1.0 ||
					ndcPosition.y < -1.0 || ndcPosition.y > 1.0 ) {
						break;
					}
					{
						screenPosition.xy = ndcPosition.xy;
						screenPosition.z = ndcPosition.z;
						screenPosition = screenPosition * 0.5 + 0.5;
					};
					bool hit;
					float sampleDepth;
					{
						sampleDepth = tex2Ddepth( samp_viewdepthmap, screenPosition.xy );
						hit = sampleDepth < screenPosition.z;
					};
					if ( hit ) {
						vec3 ndcStepCopy = ndcStep;
						vec3 ndcPositionCopy = ndcPosition;
						if ( !rayOccluded ) {
							{
								for ( int i = 0; i < 5; i++ ) {
									ndcStep *= 0.5;
									ndcPosition -= ndcStep;
									bool hitBR;
									{
										screenPosition.xy = ndcPosition.xy;
										screenPosition.z = ndcPosition.z;
										screenPosition = screenPosition * 0.5 + 0.5;
									};
									{
										sampleDepth = tex2Ddepth( samp_viewdepthmap, screenPosition.xy );
										hitBR = sampleDepth < screenPosition.z;
									};
									if ( !hitBR ) {
										ndcPosition += ndcStep;
									}
								}
							};
						}
						float sampleDepthLinear = sampleDepth * _fa_[12 ].w / ( sampleDepth + _fa_[12 ].z );
						float screenZLinear = screenPosition.z * _fa_[12 ].w / ( screenPosition.z + _fa_[12 ].z );
						if ( abs( sampleDepthLinear - screenZLinear ) > 3 ) {
							ndcStep = ndcStepCopy;
							ndcPosition = ndcPositionCopy;
							rayOccluded = true;
							continue;
						}
						vec3 normal = tex2Dlod( samp_viewnormalmap, vec4( screenPosition.xy, 0, 0 ) ).rgb * 2.0 - 1.0;
						rayHitColor += tex2Dlod( samp_viewtarget, vec4( screenPosition.xy, 0, 0 ) ).rgb;
						rayHitColor *= 1.0 - float( numLinearIterations ) / float( maxLinearIterations );
						rayHitColor *= 1.0 - 4.0 * dot( screenPosition.xy - 0.5, screenPosition.xy - 0.5 );
						rayHitColor *= saturate( dot( normal, -reflection.xyz ) );
						break;
					} else {
						rayOccluded = false;
					}
				}
			};
			reflectionColor.rgb = rayHitColor * specularScale * facingViewFade;
		} else {
			reflectionColor.rgb = vec3( 0.0 );
		}
	};
	out_FragColor0.rgb = reflectionColor;
}
