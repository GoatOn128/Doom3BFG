#version 150

#include "global.inc"

uniform vec4 _va_ [9];

in vec4 in_Position;

out vec4 vofi_TexCoord0;
out vec4 vofi_Color;

void main() {
	gl_Position.x = dot4( in_Position, _va_[0 ] );
	gl_Position.y = dot4( in_Position, _va_[1 ] );
	gl_Position.z = dot4( in_Position, _va_[2 ] );
	gl_Position.w = dot4( in_Position, _va_[3 ] );
	vofi_TexCoord0.x = dot3( in_Position.xyz, _va_[4 ].xyz );
	vofi_TexCoord0.y = dot3( in_Position.xyz, _va_[5 ].xyz );
	vofi_TexCoord0.z = dot3( in_Position.xyz, _va_[6 ].xyz );
	vofi_TexCoord0.w = _va_[7 ].x;
	vofi_Color = _va_[8 ];
}
