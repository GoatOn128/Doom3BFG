#version 150

#include "global.inc"

uniform sampler2D samp_transmap;

in vec4 vofi_TexCoord0;
in vec4 vofi_Color;

out vec4 out_FragColor0;

void main() {
	vec4 final = tex2D( samp_transmap, vofi_TexCoord0.xy );
	float fog = saturate( exp2( vofi_TexCoord0.w ) );
	final.xyz *= fog;
	out_FragColor0 = final * vofi_Color;
}
