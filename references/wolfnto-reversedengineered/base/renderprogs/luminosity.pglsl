#version 150

#include "global.inc"

uniform vec4 _fa_ [2];
uniform sampler2D samp_viewcolormap;
uniform sampler2D samp_adaptiveluminance;


out vec4 out_FragColor0;

void main() {
	int SAMPLES = 9;
	float STEPSIZE = 1.0/(SAMPLES) * 0.75;
	float xSize = _fa_[0 ].z - _fa_[0 ].x;
	float ySize = _fa_[0 ].w - _fa_[0 ].y;
	vec4 tc = vec4( _fa_[0 ].x + xSize*0.5, _fa_[0 ].y + ySize*0.5, 0.0, 5.0 );
	vec3 total = vec3( 0.0 );
	for( int y = -(SAMPLES/2); y < ((SAMPLES+1)/2); y++ ) {
		for( int x = -(SAMPLES/2); x < ((SAMPLES+1)/2); x++ ) {
			vec3 colSample = tex2Dlod( samp_viewcolormap, tc +
			vec4( x*STEPSIZE*xSize, y*STEPSIZE*ySize, 0.0, 0.0 ) ).xyz;
			colSample = pow3( abs( colSample ), 2.2 );
			total += colSample;
		}
	}
	total *= ( 1.0 / (SAMPLES*SAMPLES) );
	total = pow3( total, 1.0 / 2.2 );
	float newLuminance;
	{
		vec3 ituBT601 = vec3( 0.299, 0.587, 0.114 );
		newLuminance = dot( total, ituBT601 );
	};
	float oldLuminance = tex2D( samp_adaptiveluminance, vec2( 0.5, 0.5 ) ).x;
	float decay = _fa_[1 ].w;
	out_FragColor0.xyz = vec3( oldLuminance + ( newLuminance - oldLuminance ) * decay );
	out_FragColor0.w = 1.0;
}
