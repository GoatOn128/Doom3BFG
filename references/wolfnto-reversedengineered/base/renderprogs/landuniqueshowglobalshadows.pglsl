#version 150

#include "global.inc"

uniform vec4 _fa_ [9];
uniform sampler2D samp_viewdepthmap;
uniform sampler2D samp_globalshadows;

in vec4 gl_FragCoord;

out vec4 out_FragColor0;

void main() {
	vec3 window;
	window.xy = screenPosToTexcoord( gl_FragCoord.xy, _fa_[0 ] );
	window.z = tex2Ddepth( samp_viewdepthmap, window.xy );
	vec3 device = ( window.xyz * 2.0 ) - 1.0;
	vec4 d;
	d.xyz = device;
	d.w = 1;
	vec4 wclip;
	wclip.x = dot4( d, _fa_[1 ] );
	wclip.y = dot4( d, _fa_[2 ] );
	wclip.z = dot4( d, _fa_[3 ] );
	wclip.w = dot4( d, _fa_[4 ] );
	wclip.xyzw /= wclip.w;
	vec4 light;
	light.x = dot4( wclip, _fa_[5 ] );
	light.y = dot4( wclip, _fa_[6 ] );
	light.z = dot4( wclip, _fa_[7 ] );
	light.w = dot4( wclip, _fa_[8 ] );
	float shadowVal = tex2D( samp_globalshadows, light.xy ).x;
	out_FragColor0 = vec4( shadowVal );
}
