#version 150

#include "global.inc"

uniform vec4 _fa_ [2];
uniform sampler2D samp_pagetablemap;
uniform sampler2D samp_physicalmappingsmap;
uniform sampler2D samp_physicalvmtrpagesmap1;
uniform sampler2D samp_physicalvmtrpagesmap2;

in vec4 vofi_TexCoord0;
in vec4 vofi_Color;
in vec4 vofi_TexCoord1;

out vec4 out_FragColor0;

void main() {
	vec2 texcoord = saturate( vofi_TexCoord0.xy ) * _fa_[0 ].xy + _fa_[0 ].zw;
	vec3 physCoord = VirtualToPhysical2( samp_pagetablemap, samp_physicalmappingsmap, texcoord );
	vec4 YCoCg = tex2D( samp_physicalvmtrpagesmap1, physCoord.xy );
	vec4 bumpPage = tex2D( samp_physicalvmtrpagesmap2, physCoord.xy );
	YCoCg.z = ( YCoCg.z * 31.875 ) + 1.0;
	YCoCg.z = 1.0 / YCoCg.z;
	YCoCg.xy *= YCoCg.z;
	vec4 diffuse;
	diffuse.x = dot4( YCoCg, matrixCoCg1YtoRGB1X );
	diffuse.y = dot4( YCoCg, matrixCoCg1YtoRGB1Y );
	diffuse.z = dot4( YCoCg, matrixCoCg1YtoRGB1Z );
	diffuse.w = bumpPage.w;
	diffuse *= vofi_Color;
	diffuse += vofi_TexCoord1;
	out_FragColor0.xyz = pow3( saturate( diffuse.xyz ), _fa_[1 ].x ) * vofi_Color.w;
	out_FragColor0.w = diffuse.w;
}
