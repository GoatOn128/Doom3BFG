#version 150

#include "global.inc"

uniform vec4 _fa_ [2];
uniform sampler2D samp_transmap1;

in vec4 gl_FragCoord;
in vec4 vofi_TexCoord0;
in vec4 vofi_Color;

out vec4 out_FragColor0;

void main() {
	float interpolatedZOverW = gl_FragCoord.z;
	vec2 tc = screenPosToTexcoord( gl_FragCoord.xy, _fa_[0 ] );
	vec4 final = tex2D( samp_transmap1, vofi_TexCoord0.xy ) * vofi_Color;
	float fogVal = vofi_TexCoord0.z;
	final.xyz *= saturate ( 3 * fogVal);
	out_FragColor0.xyz = final.xyz * final.w;
	out_FragColor0.xyz *= _fa_[1 ].xyz;
	out_FragColor0.w = 1.0;
}
