#version 150

#include "global.inc"

uniform vec4 _va_ [6];

in vec4 in_Position;


void main() {
	{
		vec4 localPosition = in_Position * _va_[0 ] + _va_[1 ];
		gl_Position.x = dot4( localPosition, _va_[2 ] );
		gl_Position.y = dot4( localPosition, _va_[3 ] );
		gl_Position.z = dot4( localPosition, _va_[4 ] );
		gl_Position.w = dot4( localPosition, _va_[5 ] );
	};
}
