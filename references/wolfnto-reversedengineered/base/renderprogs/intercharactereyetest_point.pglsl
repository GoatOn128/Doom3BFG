#version 150

#include "global.inc"

uniform vec4 _fa_ [18];
uniform sampler2DShadow samp_lightdepthcomparemap;
uniform sampler2D samp_lightprojectmap;
uniform sampler2D samp_lightfalloffmap;
uniform sampler2D samp_transmap1;
uniform sampler2D samp_transmap2;
uniform sampler2D samp_transmap;
uniform samplerCube samp_dynamicenvmap;

in vec4 vofi_TexCoord7;
in vec4 vofi_TexCoord4;
in vec4 vofi_TexCoord6;
in vec4 vofi_TexCoord0;
in vec4 vofi_TexCoord5;
in vec4 vofi_TexCoord1;
in vec4 vofi_TexCoord2;
in vec4 vofi_TexCoord3;

out vec4 out_FragColor0;

void main() {
	float shadow;
	vec4 color = vec4( 0.0 );
	shadow = 1.0;
	{
		vec3 absTexCoord = abs( vofi_TexCoord7.xyz );
		vec3 maxTexCoord = max( absTexCoord.xyz, max( absTexCoord.yzx, absTexCoord.zxy ) );
		vec4 axis;
		axis.xyz = vec3( greaterThanEqual( absTexCoord, maxTexCoord ) );
		axis.yz = saturate( axis.yz - axis.xx - axis.xy );
		axis.w = 0.0;
		vec4 rotate = axis.yxxy + axis.zwzw;
		vec4 flatTexCoord;
		flatTexCoord.x = dot( rotate.xy, vofi_TexCoord7.xz );
		flatTexCoord.y = dot( rotate.zw, vofi_TexCoord7.yz );
		flatTexCoord.z = -maxTexCoord.x;
		flatTexCoord.w = vofi_TexCoord7.w;
		float sBias = 0.5 + dot( axis.xyz, vec3( greaterThanEqual( vec3( 0, 0, 0 ), vofi_TexCoord7.xyz ) ) );
		float tBias = 0.5 + dot( axis.xyz, vec3( 0, 1, 2 ) );
		vec4 faceTexCoord;
		faceTexCoord.x = dot4( flatTexCoord, _fa_[0 ] + sBias * _fa_[1 ] );
		faceTexCoord.y = dot4( flatTexCoord, _fa_[2 ] + tBias * _fa_[1 ] );
		faceTexCoord.z = dot4( flatTexCoord, _fa_[3 ] );
		faceTexCoord.w = dot4( flatTexCoord, _fa_[1 ] );
		faceTexCoord.xyz /= faceTexCoord.w;
		faceTexCoord.xy *= _fa_[4 ].z;
		{
			float s = _fa_[4 ].y * 2.0;
			vec4 shadow4;
			{
				shadow4.x = shadow2Ddepth( samp_lightdepthcomparemap, faceTexCoord.xyz + s * vec3( -0.375, -0.125, 0 ) );
			};
			{
				shadow4.y = shadow2Ddepth( samp_lightdepthcomparemap, faceTexCoord.xyz + s * vec3( -0.125, 0.375, 0 ) );
			};
			{
				shadow4.z = shadow2Ddepth( samp_lightdepthcomparemap, faceTexCoord.xyz + s * vec3( 0.125, -0.375, 0 ) );
			};
			{
				shadow4.w = shadow2Ddepth( samp_lightdepthcomparemap, faceTexCoord.xyz + s * vec3( 0.375, 0.125, 0 ) );
			};
			shadow = dot( shadow4, vec4( 0.25 ) );
		};
	};
	vec3 fromViewer = vofi_TexCoord4.xyz;
	vec3 fromViewerNormalized = normalize( fromViewer );
	vec3 worldPosition = fromViewer + _fa_[5 ].xyz;
	vec3 lightDir = _fa_[6 ].xyz - worldPosition;
	vec3 lightDirNormalized = normalize( lightDir );
	vec3 lightColor = _fa_[7 ].xyz;
	{
		vec3 lightTexCoord = vofi_TexCoord6.xyz / vofi_TexCoord6.w;
		vec4 lpm = h4tex2D( samp_lightprojectmap, lightTexCoord.xy );
		vec4 lfm = h4tex2D( samp_lightfalloffmap, vec2( lightTexCoord.z, 0.5 ) );
		lpm.xyz = pow3( abs( lpm.xyz ), 2.2 );
		lfm.xyz = pow3( abs( lfm.xyz ), 2.2 );;;
		lightColor *= lpm.xyz * lfm.xyz;
	};
	vec3 localNormal;
	vec3 globalNormal;
	vec3 specNormal;
	vec4 reflection;
	vec4 normalTex = tex2D( samp_transmap1, vofi_TexCoord0.xy );
	vec4 shadowTex = tex2D( samp_transmap2, vofi_TexCoord0.zw );
	vec2 texCoords = vofi_TexCoord0.xy - ( vofi_TexCoord5.xy * normalTex.w * 0.15 );
	{
		texCoords = texCoords - vec2( 0.5 );
		float pupilDilateClamp = clamp( _fa_[8 ].x, -0.3, -0.05 );
		float dilateMask = saturate( length( texCoords * ( 2.5 / pupilDilateClamp ) ) );
		float dilateMask2 = 1.0 - saturate( length( vec3( texCoords, 0.0 ) * 5.3 ) );
		vec2 dilation = normalize( vec3( texCoords, 0.0 ) ).xy * dilateMask * dilateMask2 * pupilDilateClamp;
		texCoords += dilation;
		texCoords += 0.5;
	}
	vec4 diffuseTex = tex2D( samp_transmap, texCoords );
	vec3 eyeColor = diffuseTex.xyz * mix( _fa_[9 ].xyz, _fa_[10 ].xyz, vec3( diffuseTex.w ) );
	eyeColor *= vec3( 2.0 );
	eyeColor = pow3( abs( eyeColor ), 2.2 );
	shadowTex.xyz = pow3( abs( shadowTex.xyz ), 2.2 );
	localNormal = normalTex.xyz * 2.0 - 1.0;
	specNormal.x = dot3( localNormal, vofi_TexCoord1 );
	specNormal.y = dot3( localNormal, vofi_TexCoord2 );
	specNormal.z = dot3( localNormal, vofi_TexCoord3 );
	specNormal = normalize( specNormal );
	localNormal.xy = mix( localNormal.xy * vec2( -2.0 ), localNormal.xy, vec2( diffuseTex.w ) );
	localNormal = normalize( localNormal );
	globalNormal.x = dot3( localNormal, vofi_TexCoord1 );
	globalNormal.y = dot3( localNormal, vofi_TexCoord2 );
	globalNormal.z = dot3( localNormal, vofi_TexCoord3 );
	globalNormal = normalize( globalNormal );
	reflection.xyz = normalize( fromViewerNormalized - ( specNormal * dot3( fromViewerNormalized, specNormal ) * 2.0 ) );
	reflection.w = 0.0;
	vec3 envColor;
	{
		envColor = texCUBElod( samp_dynamicenvmap, reflection ).xyz;;
		envColor = pow3( abs( envColor ), 2.2 );
	};
	float fresnel;
	fresnel = 1.0 - saturate( dot( -fromViewerNormalized, specNormal ) );
	envColor *= ( 1.0 - diffuseTex.w ) + 0.2;
	envColor *= ( vofi_TexCoord5.w + 0.5 );
	envColor *= fresnel;
	envColor *= _fa_[11 ].xyz;
	float specularScale = 16.0 * saturate( 1.05 - diffuseTex.w );
	float specularPower = 128.0;
	{
		vec3 diffuseLight = vec3( 1.0 );
		vec3 specularLight = vec3( 1.0 );
		{
			float shadowFactor = ( shadow * _fa_[12 ].x ) + _fa_[12 ].y;
			lightColor *= shadowFactor;
		}
		float diffuseLightFactor = saturate( dot3( lightDirNormalized, globalNormal ) );
		float specularLightFactor = saturate( dot3( lightDirNormalized, reflection.xyz ) );
		diffuseLight *= lightColor * vec3( diffuseLightFactor );
		float specularBrightness;
		{
			float oneOverPi8 = 0.039808917197;
			float glossPowMax = max( specularPower, 0.000001 );
			specularBrightness = pow( max( specularLightFactor, 0.0 ), glossPowMax );
			specularBrightness *= ( glossPowMax + 8.0 ) * oneOverPi8;
			specularBrightness *= specularScale;
		};
		specularLight = lightColor * vec3( specularBrightness );
		specularLight += envColor * diffuseLight;
		{
			diffuseLight.xyz *= _fa_[13 ].xyz;
		};
		{
			specularLight.xyz *= _fa_[14 ].xyz * _fa_[15 ].xyz;
		};
		diffuseLight *= _fa_[16 ].xyz;
		specularLight *= _fa_[17 ].xyz;
		{
		};
		{
		};
		vec3 totalLight = vec3( 0.0 );
		totalLight += diffuseLight * eyeColor.xyz;
		totalLight += specularLight;
		totalLight *= shadowTex.xyz;
		color.xyz += totalLight;
		color.w = 0.0;
	}
	{
	};
	out_FragColor0 = color;
}
